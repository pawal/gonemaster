{
  "name": "gonemaster-analysis-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5175",
    "build": "vite build && node scripts/write-placeholder.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^22.12.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.1.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}

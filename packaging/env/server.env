# /etc/gonemaster/server.env
#
# Environment for the gonemaster-server systemd service.
# Edit and run:  systemctl restart gonemaster-server
#
# See gonemaster-server(1) and the gonemaster docs for the full set of
# GONEMASTER_* environment variables.

# Listen address. Default binds loopback only; front the service with
# nginx, caddy, or apache to expose externally.
GONEMASTER_LISTEN=127.0.0.1:8080

# Database. Default is local sqlite; the DSN is the file path.
GONEMASTER_DB_DRIVER=sqlite
GONEMASTER_DB_DSN=/var/lib/gonemaster/gonemaster.db

# Optional knobs
#GONEMASTER_WORKER_COUNT=4
#GONEMASTER_MAX_CONCURRENT_JOBS=16
#GONEMASTER_MIN_LEVEL=INFO
#GONEMASTER_DEBUG=false
#GONEMASTER_DB_RETENTION_DAYS=30
#GONEMASTER_READ_TIMEOUT=30s
#GONEMASTER_WRITE_TIMEOUT=60s
#GONEMASTER_IDLE_TIMEOUT=120s
#GONEMASTER_CROSS_JOB_HOT_CACHE=true
#GONEMASTER_CROSS_JOB_HOT_CACHE_TTL=60

# Public API rate-limiting
#GONEMASTER_PUBLIC_API_RATE_LIMIT_ENABLED=true
#GONEMASTER_PUBLIC_API_RATE_LIMIT_MAX=60
#GONEMASTER_PUBLIC_API_RATE_LIMIT_WINDOW=1m
#GONEMASTER_PUBLIC_API_ALLOW_PRIVATE_UNDELEGATED_IP=false

# Trusted reverse-proxy CIDRs (comma-separated). Required when serving
# through nginx/caddy/etc so client IPs are read from X-Forwarded-For.
#GONEMASTER_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Admin API authentication. Comma-separated token hashes that gate /api/v1.
# Empty (default) = open mode. Mint a token with:
#   gonemaster-server auth add-token --label NAME
# then paste the printed hash here and restart. See docs/server/authentication.md.
#GONEMASTER_ADMIN_TOKEN_HASHES=label=sha256:...

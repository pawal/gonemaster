msgid "IPv6 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv6 je zakázáno, dotaz \"{query_type}\" se neodesílá na {ns}/{address}."

msgctxt "DNSSEC:IPV6_DISABLED"
msgid "IPv6 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv6 je zakázáno, dotaz \"{query_type}\" se neodesílá na {ns}/{address}."

msgctxt "NAMESERVER:IPV6_DISABLED"
msgid "IPv6 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv6 je zakázán, dotaz \"{query_type}\" se neodesílá na {ns}/{address}."


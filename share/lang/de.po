msgctxt "SYSTEM:ERROR_CACHE_SKIP"
msgid "Skipping {query_type} query to {query_name} ({query_class}) at {address} over {protocol} for {ttl_seconds}s after network error."
msgstr "Überspringen der {query_type}-Abfrage an {query_name} ({query_class}) bei {address} über {protocol} für {ttl_seconds}s nach einem Netzwerkfehler."

msgctxt "BASIC:IPV6_ENABLED"
msgid "IPv6 is enabled, can send \"{query_type}\" query to {ns}/{address}."
msgstr "IPv6 ist aktiviert. Es wird eine '{query_type}'-Abfrage an {ns}/{address} gesendet."

msgctxt "BASIC:NO_A_RECORDS"
msgid "Nameserver {ns}/{address} did not return \"A\" record(s) for {domain}."
msgstr "Der Nameserver {ns}/{address} hat keine A-Records für '{domain}' zurückgegeben."

msgctxt "CONNECTIVITY:CN01_IPV4_DISABLED"
msgid ""
"IPv4 is disabled. No DNS queries are sent to these name servers: "
"\"{servers}\"."
msgstr "IPv4 ist deaktiviert. Es werden keine DNS-Abfragen an \"{servers}\" gesendet."

msgctxt "CONNECTIVITY:CN01_IPV6_DISABLED"
msgid ""
"IPv6 is disabled. No DNS queries are sent to these name servers: "
"\"{servers}\"."
msgstr "IPv6 ist deaktiviert. Es werden keine DNS-Abfragen an \"{servers}\" gesendet."

msgctxt "CONNECTIVITY:CN01_MISSING_NS_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds to a NS query with no NS records in the answer "
"section over UDP."
msgstr ""
"Der Nameserver {ns}/{address} antwortet auf eine NS-Abfrage über UDP ohne "
"NS-Records im Antwortabschnitt."

msgctxt "CONNECTIVITY:CN01_MISSING_SOA_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds to a SOA query with no SOA records in the answer "
"section over UDP."
msgstr ""
"Der Nameserver {ns}/{address} antwortet auf eine SOA-Abfrage über UDP ohne "
"SOA-Records im Antwortabschnitt."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_NS_QUERY_UDP"
msgid "Nameserver {ns}/{address} does not respond to NS queries over UDP."
msgstr "Der Nameserver {ns}/{address} antwortet nicht auf NS-Abfragen über UDP."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_SOA_QUERY_UDP"
msgid "Nameserver {ns}/{address} does not respond to SOA queries over UDP."
msgstr "Der Nameserver {ns}/{address} antwortet nicht auf SOA-Abfragen über UDP."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_UDP"
msgid "Nameserver {ns}/{address} does not respond to any queries over UDP."
msgstr "Der Nameserver {ns}/{address} antwortet nicht auf DNS-Abfragen über UDP."

msgctxt "CONNECTIVITY:CN01_NS_RECORD_NOT_AA_UDP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an NS query over "
"UDP."
msgstr "Der Nameserver {ns}/{address} gibt keine autoritative Antwort auf eine NS-Abfrage über UDP."

msgctxt "CONNECTIVITY:CN01_OK_UDP"
msgid "The following nameservers respond correctly to SOA and NS queries over UDP: \"{servers}\"."
msgstr "Die folgenden Nameserver antworten korrekt auf SOA- und NS-Abfragen über UDP: \"{servers}\"."

msgctxt "CONNECTIVITY:CN01_SOA_RECORD_NOT_AA_UDP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an SOA query over "
"UDP."
msgstr "Der Nameserver {ns}/{address} gibt keine autoritative Antwort auf eine SOA-Abfrage über UDP."

msgctxt "CONNECTIVITY:CN01_UNEXPECTED_RCODE_NS_QUERY_UDP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an NS query "
"over UDP."
msgstr ""
"Der Nameserver {ns}/{address} antwortet mit einem unerwarteten RCODE (\"{rcode}\") "
"auf eine NS-Abfrage über UDP."

msgctxt "CONNECTIVITY:CN01_UNEXPECTED_RCODE_SOA_QUERY_UDP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an SOA query "
"over UDP."
msgstr ""
"Der Nameserver {ns}/{address} antwortet mit einem unerwarteten RCODE (\"{rcode}\") "
"auf eine SOA-Abfrage über UDP."

msgctxt "CONNECTIVITY:CN01_WRONG_NS_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on NS queries over UDP."
msgstr ""
"Der Nameserver {ns}/{address} antwortet mit einem falschen Owner-Namen ({domain_found} "
"statt {domain_expected}) auf NS-Abfragen über UDP."

msgctxt "CONNECTIVITY:CN01_WRONG_SOA_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on SOA queries over UDP."
msgstr ""
"Der Nameserver {ns}/{address} antwortet mit einem falschen Owner-Namen ({domain_found} "
"statt {domain_expected}) auf SOA-Abfragen über UDP."

msgctxt "CONNECTIVITY:CN04_ERROR_PREFIX_DATABASE"
msgid "Prefix database error for IP address {address}."
msgstr "Präfix-Datenbankfehler für die IP-Adresse {address}."

msgctxt "CONNECTIVITY:CN04_IPV4_DIFFERENT_PREFIX"
msgid ""
"The following name server(s) are announced in unique IPv4 prefix(es): "
"\"{servers}\""
msgstr ""
"Die folgenden Nameserver sind in je einem eigenen IPv4-Präfix "
"angekündigt: \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV4_SAME_PREFIX"
msgid ""
"The following name server(s) are announced in the same IPv4 prefix "
"({prefixes}): \"{servers}\""
msgstr ""
"Die folgenden Nameserver sind im selben IPv4-Präfix ({prefixes}) "
"angekündigt: \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV4_SINGLE_PREFIX"
msgid ""
"All name server(s) IPv4 address(es) are announced in the same IPv4 prefix."
msgstr ""
"Alle IPv4-Adressen der Nameserver sind im selben IPv4-Präfix angekündigt."

msgctxt "CONNECTIVITY:CN04_IPV6_DIFFERENT_PREFIX"
msgid ""
"The following name server(s) are announced in unique IPv6 prefix(es): "
"\"{servers}\""
msgstr ""
"Die folgenden Nameserver sind in je einem eigenen IPv6-Präfix "
"angekündigt: \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV6_SAME_PREFIX"
msgid ""
"The following name server(s) are announced in the same IPv6 prefix "
"({prefixes}): \"{servers}\""
msgstr ""
"Die folgenden Nameserver sind im selben IPv6-Präfix ({prefixes}) "
"angekündigt: \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV6_SINGLE_PREFIX"
msgid ""
"All name server(s) IPv6 address(es) are announced in the same IPv6 prefix."
msgstr ""
"Alle IPv6-Adressen der Nameserver sind im selben IPv6-Präfix angekündigt."

msgctxt "CONNECTIVITY:ERROR_ASN_DATABASE"
msgid "ASN Database error. No data to analyze for {address}."
msgstr "Fehler in der AS-Datenbank. Keine Daten zur Analyse für {address}."

msgctxt "CONNECTIVITY:EMPTY_ASN_SET"
msgid "AS database returned no informations for IP address {address}."
msgstr "Die AS-Datenbank hat keine Informationen für die IP-Adresse {address} zurückgegeben."

msgctxt "CONNECTIVITY:IPV4_SAME_ASN"
msgid ""
"All authoritative nameservers have their IPv4 addresses in the same AS set "
"({asns})."
msgstr ""
"Alle autoritativen Nameserver haben ihre IPv4-Adressen in derselben "
"AS-Gruppe ({asns})."

msgctxt "CONNECTIVITY:IPV4_ONE_ASN"
msgid ""
"All authoritative nameservers have their IPv4 addresses in the same AS "
"({asn})."
msgstr ""
"Alle autoritativen Nameserver haben ihre IPv4-Adressen im selben "
"AS ({asn})."

msgctxt "CONNECTIVITY:IPV4_DIFFERENT_ASN"
msgid ""
"At least two IPv4 addresses of the authoritative nameservers are announced "
"by different AS sets. A merged list of all AS: ({asns})."
msgstr ""
"Mindestens zwei IPv4-Adressen der autoritativen Nameserver sind von "
"verschiedenen AS-Gruppen angekündigt. Eine zusammengeführte Liste "
"aller AS: ({asns})."

msgctxt "CONNECTIVITY:IPV6_SAME_ASN"
msgid ""
"All authoritative nameservers have their IPv6 addresses in the same AS set "
"({asns})."
msgstr ""
"Alle autoritativen Nameserver haben ihre IPv6-Adressen in derselben "
"AS-Gruppe ({asns})."

msgctxt "CONNECTIVITY:IPV6_ONE_ASN"
msgid ""
"All authoritative nameservers have their IPv6 addresses in the same AS "
"({asn})."
msgstr ""
"Alle autoritativen Nameserver haben ihre IPv6-Adressen im selben "
"AS ({asn})."

msgctxt "CONNECTIVITY:IPV6_DIFFERENT_ASN"
msgid ""
"At least two IPv6 addresses of the authoritative nameservers are announced "
"by different AS sets. A merged list of all AS: ({asns})."
msgstr ""
"Mindestens zwei IPv6-Adressen der autoritativen Nameserver sind von "
"verschiedenen AS-Gruppen angekündigt. Eine zusammengeführte Liste "
"aller AS: ({asns})."

msgctxt "CONNECTIVITY:ASN_INFOS_ANNOUNCE_BY"
msgid "Name server IP address \"{address}\" is announced by ASN {asns}."
msgstr "Die Nameserver-IP-Adresse \"{address}\" wird von ASN {asns} angekündigt."

msgctxt "CONSISTENCY:ADDRESSES_MATCH"
msgid "Glue records are consistent between glue and authoritative data."
msgstr "Glue-Records stimmen zwischen den Glue-Daten und den autoritativen Daten überein."

msgctxt "CONSISTENCY:CHILD_NS_FAILED"
msgid "Unexpected or erroneous reply from {ns}/{address}."
msgstr "Unerwartete oder fehlerhafte Antwort von {ns}/{address}."

msgctxt "CONSISTENCY:CHILD_ZONE_LAME"
msgid "Lame delegation."
msgstr "Unbrauchbare Delegation."

msgctxt "CONSISTENCY:EXTRA_ADDRESS_CHILD"
msgid ""
"Child has extra nameserver IP address(es) not listed at parent "
"({addresses})."
msgstr ""
"Die untergeordnete Zone hat zusätzliche Nameserver-IP-Adressen, "
"die in der übergeordneten Zone nicht aufgeführt sind ({addresses})."

msgctxt "CONSISTENCY:IN_BAILIWICK_ADDR_MISMATCH"
msgid ""
"In-bailiwick name server listed at parent has a mismatch between glue data "
"at parent ({parent_servers}) and any equivalent address record in child "
"zone ({zone_servers})."
msgstr ""
"Ein in der übergeordneten Zone aufgeführter In-Bailiwick-Nameserver weist "
"eine Abweichung zwischen den Glue-Daten der übergeordneten Zone "
"({parent_servers}) und entsprechenden Adressdatensätzen in der "
"untergeordneten Zone ({zone_servers}) auf."

msgctxt "CONSISTENCY:MULTIPLE_NS_SET"
msgid "Found {count} NS set(s)."
msgstr "{count} NS-Menge(n) gefunden."

msgctxt "CONSISTENCY:MULTIPLE_SOA_MNAMES"
msgid "Saw {count} SOA mname."
msgstr "{count} verschiedene SOA-MNAME-Werte gefunden."

msgctxt "CONSISTENCY:MULTIPLE_SOA_RNAMES"
msgid "Found {count} SOA rname(s)."
msgstr "{count} verschiedene SOA-RNAME-Werte gefunden."

msgctxt "CONSISTENCY:MULTIPLE_SOA_SERIALS"
msgid "Found {count} SOA serial number(s)."
msgstr "{count} verschiedene SOA-Seriennummern gefunden."

msgctxt "CONSISTENCY:MULTIPLE_SOA_TIME_PARAMETER_SET"
msgid "Found {count} SOA time parameter set(s)."
msgstr "{count} verschiedene SOA-Zeitparameter-Sätze gefunden."

msgctxt "CONSISTENCY:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "Nameserver {ns} hat nicht geantwortet."

msgctxt "DNSSEC:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "Nameserver {ns} hat nicht geantwortet."

msgctxt "ZONE:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "Nameserver {ns} hat nicht geantwortet."

msgctxt "CONSISTENCY:NO_RESPONSE_NS_QUERY"
msgid "No response from nameserver {ns}/{address} on NS queries."
msgstr "Keine Antwort vom Nameserver {ns}/{address} auf NS-Abfragen."

msgctxt "CONSISTENCY:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver {ns}/{address} on SOA queries."
msgstr "Keine Antwort vom Nameserver {ns}/{address} auf SOA-Abfragen."

msgctxt "CONSISTENCY:NS_SET"
msgid "Saw NS set ({ns_set_servers}) on following nameserver set : {servers}."
msgstr ""
"Die NS-Menge ({ns_set_servers}) wurde auf folgenden Nameservern "
"gefunden: {servers}."

msgctxt "CONSISTENCY:ONE_NS_SET"
msgid "A single NS set was found ({servers})."
msgstr "Genau eine NS-Menge wurde gefunden ({servers})."

msgctxt "CONSISTENCY:ONE_SOA_MNAME"
msgid "A single SOA mname value was seen ({mname})."
msgstr "Genau ein SOA-MNAME-Wert wurde gefunden ({mname})."

msgctxt "CONSISTENCY:ONE_SOA_RNAME"
msgid "A single SOA rname value was found ({rname})."
msgstr "Genau ein SOA-RNAME-Wert wurde gefunden ({rname})."

msgctxt "CONSISTENCY:ONE_SOA_SERIAL"
msgid "A single SOA serial number was found ({serial})."
msgstr "Genau eine SOA-Seriennummer wurde gefunden ({serial})."

msgctxt "CONSISTENCY:ONE_SOA_TIME_PARAMETER_SET"
msgid ""
"A single SOA time parameter set was seen (REFRESH={refresh},RETRY={retry},"
"EXPIRE={expire},MINIMUM={minimum})."
msgstr ""
"Genau ein SOA-Zeitparameter-Satz wurde gefunden "
"(REFRESH={refresh},RETRY={retry},EXPIRE={expire},MINIMUM={minimum})."

msgctxt "CONSISTENCY:OUT_OF_BAILIWICK_ADDR_MISMATCH"
msgid ""
"Out-of-bailiwick name server listed at parent with glue record has a "
"mismatch between the glue at the parent ({parent_servers}) and any "
"equivalent address record found in authoritative zone ({zone_servers})."
msgstr ""
"Ein Out-of-Bailiwick-Nameserver, der in der übergeordneten Zone mit "
"Glue-Record aufgeführt ist, weist eine Abweichung zwischen den Glue-Daten "
"der übergeordneten Zone ({parent_servers}) und entsprechenden "
"Adressdatensätzen in der autoritativen Zone ({zone_servers}) auf."

msgctxt "CONSISTENCY:SOA_RNAME"
msgid "Found SOA rname {rname} on following nameserver set : {servers}."
msgstr "SOA-RNAME {rname} wurde auf folgenden Nameservern gefunden: {servers}."

msgctxt "CONSISTENCY:SOA_SERIAL"
msgid "Saw SOA serial number {serial} on following nameserver set : {servers}."
msgstr ""
"SOA-Seriennummer {serial} wurde auf folgenden Nameservern "
"gefunden: {servers}."

msgctxt "CONSISTENCY:SOA_SERIAL_VARIATION"
msgid ""
"Difference between the smaller serial ({serial_min}) and the bigger one "
"({serial_max}) is greater than the maximum allowed ({max_variation})."
msgstr ""
"Die Differenz zwischen der kleinsten Seriennummer ({serial_min}) und der "
"größten ({serial_max}) überschreitet den maximal zulässigen Wert "
"({max_variation})."

msgctxt "CONSISTENCY:SOA_TIME_PARAMETER_SET"
msgid ""
"Saw SOA time parameter set (REFRESH={refresh}, RETRY={retry}, "
"EXPIRE={expire}, MINIMUM={minimum}) on following nameserver set : {servers}."
msgstr ""
"SOA-Zeitparameter-Satz (REFRESH={refresh}, RETRY={retry}, "
"EXPIRE={expire}, MINIMUM={minimum}) wurde auf folgenden Nameservern "
"gefunden: {servers}."

msgctxt "DNSSEC:DNSKEY_SMALLER_THAN_REC"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) smaller than the recommended one ({keysizerec})."
msgstr ""
"Der DNSKEY mit Tag {keytag} und Algorithmus {algo_num} ({algo_descr}) hat "
"eine Schlüsselgröße ({keysize}), die kleiner als die empfohlene "
"Größe ({keysizerec}) ist."

msgctxt "DNSSEC:DNSKEY_TOO_SMALL_FOR_ALGO"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) smaller than the minimum one ({keysizemin})."
msgstr ""
"Der DNSKEY mit Tag {keytag} und Algorithmus {algo_num} ({algo_descr}) hat "
"eine Schlüsselgröße ({keysize}), die kleiner als die minimal "
"zulässige Größe ({keysizemin}) für diesen Algorithmus ist."

msgctxt "DNSSEC:DNSKEY_TOO_LARGE_FOR_ALGO"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) larger than the maximum one ({keysizemax})."
msgstr ""
"Der DNSKEY mit Tag {keytag} und Algorithmus {algo_num} ({algo_descr}) hat "
"eine Schlüsselgröße ({keysize}), die größer als die maximal "
"zulässige Größe ({keysizemax}) für diesen Algorithmus ist."

msgctxt "DNSSEC:DS01_DS_ALGO_DEPRECATED"
msgid ""
"The DS record with keytag {keytag} uses a deprecated digest algorithm "
"{ds_algo_num} ({ds_algo_descr}). Fetched from parent name servers "
"\"{servers}\"."
msgstr ""
"Der DS-Record mit Keytag {keytag} verwendet den veralteten "
"Digest-Algorithmus {ds_algo_num} ({ds_algo_descr}). Abgerufen von den "
"Nameservern der übergeordneten Zone \"{servers}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_2_MISSING"
msgid ""
"No DS record created by digest algorithm 2 (SHA-256) is present for zone "
"{domain}."
msgstr ""
"Für die Zone {domain} ist kein DS-Record vorhanden, der mit "
"Digest-Algorithmus 2 (SHA-256) erstellt wurde."

msgctxt "DNSSEC:DS01_DS_ALGO_NOT_DS"
msgid ""
"DS record for zone {domain} with keytag {keytag} was created by digest "
"algorithm {ds_algo_num} ({ds_algo_mnemo}) which is not meant for DS. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der DS-Record für Zone {domain} mit Keytag {keytag} wurde mit "
"Digest-Algorithmus {ds_algo_num} ({ds_algo_mnemo}) erstellt, der nicht für "
"DS vorgesehen ist. Abgerufen von den Nameservern mit den IP-Adressen "
"\"{addresses}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_RESERVED"
msgid ""
"DS record for zone {domain} with keytag {keytag} was created with an "
"unassigned digest algorithm (algorithm number {ds_algo_num}). Fetched from "
"the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der DS-Record für Zone {domain} mit Keytag {keytag} wurde mit einem nicht "
"zugewiesenen Digest-Algorithmus (Algorithmusnummer {ds_algo_num}) erstellt. "
"Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS02_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der DNSKEY mit Tag {keytag} verwendet Algorithmus {algo_num} ({algo_mnemo}), "
"der von dieser Installation nicht unterstützt wird. Abgerufen von den "
"Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS08_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der DNSKEY mit Tag {keytag} verwendet Algorithmus {algo_num} ({algo_mnemo}), "
"der von dieser Installation nicht unterstützt wird. Abgerufen von den "
"Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS09_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der DNSKEY mit Tag {keytag} verwendet Algorithmus {algo_num} ({algo_mnemo}), "
"der von dieser Installation nicht unterstützt wird. Abgerufen von den "
"Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_FOR_ZONE_SIGNING"
msgid ""
"Flags field of DNSKEY record with tag {keytag} has not ZONE bit set although "
"DS with same tag is present in parent. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Das Flags-Feld des DNSKEY-Records mit Tag {keytag} hat das ZONE-Bit nicht "
"gesetzt, obwohl ein DS-Record mit demselben Tag in der übergeordneten Zone "
"vorhanden ist. Abgerufen von den Nameservern mit den IP-Adressen "
"\"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_SEP"
msgid ""
"Flags field of DNSKEY record with tag {keytag} has not SEP bit set although "
"DS with same tag is present in parent. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Das Flags-Feld des DNSKEY-Records mit Tag {keytag} hat das SEP-Bit nicht "
"gesetzt, obwohl ein DS-Record mit demselben Tag in der übergeordneten Zone "
"vorhanden ist. Abgerufen von den Nameservern mit den IP-Adressen "
"\"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_SIGNED_BY_ANY_DS"
msgid ""
"The DNSKEY RRset has not been signed by any DNSKEY matched by a DS record. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Das DNSKEY-RRset wurde von keinem DNSKEY signiert, auf den ein DS-Record "
"verweist. Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_DNSKEY_FOR_DS"
msgid ""
"The DNSKEY record with tag {keytag} that the DS refers to does not exist in "
"the DNSKEY RRset. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"Der DNSKEY-Record mit Tag {keytag}, auf den der DS-Record verweist, ist im "
"DNSKEY-RRset nicht vorhanden. Abgerufen von den Nameservern mit den "
"IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_MATCHING_DNSKEY_RRSIG"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY with tag {keytag} that the DS "
"record refers to. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"Das DNSKEY-RRset ist nicht vom DNSKEY mit Tag {keytag} signiert, auf den "
"der DS-Record verweist. Abgerufen von den Nameservern mit den IP-Adressen "
"\"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_MATCH_DS_DNSKEY"
msgid ""
"The DS record does not match the DNSKEY with tag {keytag} by algorithm or "
"digest. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"Der DS-Record stimmt hinsichtlich Algorithmus oder Digest nicht mit dem "
"DNSKEY mit Tag {keytag} überein. Abgerufen von den Nameservern mit den "
"IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_VALID_DNSKEY_FOR_ANY_DS"
msgid ""
"There is no valid DNSKEY matched by any of the DS records. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Es gibt keinen gültigen DNSKEY, auf den einer der DS-Records verweist. "
"Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS02_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Das DNSKEY-RRset ist mit einer RRSIG mit Tag {keytag} signiert, die durch "
"den zugehörigen DNSKEY nicht validiert werden kann. Abgerufen von den "
"Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS02_MATCH_DS_DNSKEY"
msgid ""
"The DS record matches the DNSKEY and the DNSKEY RRSIG is valid. Found at "
"the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der DS-Record stimmt mit dem DNSKEY überein und die DNSKEY-RRSIG ist "
"gültig. Gefunden bei den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS08_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Das DNSKEY-RRset ist mit einer RRSIG mit Tag {keytag} signiert, die durch "
"den zugehörigen DNSKEY nicht validiert werden kann. Abgerufen von den "
"Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS03_ERROR_RESPONSE_NSEC_QUERY"
msgid ""
"The following servers give erroneous response to NSEC query. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Die folgenden Server geben eine fehlerhafte Antwort auf eine NSEC-Abfrage. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_ERR_MULT_NSEC3"
msgid ""
"Multiple NSEC3 records when one is expected. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Mehrere NSEC3-Records gefunden, obwohl nur einer erwartet wurde. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_ERR_MULT_NSEC3"
msgid ""
"Multiple NSEC3 records when one is expected. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Mehrere NSEC3-Records gefunden, obwohl nur einer erwartet wurde. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_ILLEGAL_HASH_ALGO"
msgid ""
"The following servers respond with an illegal hash algorithm for NSEC3 "
"({algo_num}). Fetched from name servers \"{servers}\"."
msgstr ""
"Die folgenden Server antworten mit einem ungültigen Hash-Algorithmus für "
"NSEC3 ({algo_num}). Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_ILLEGAL_ITERATION_VALUE"
msgid ""
"The following servers respond with the NSEC3 iteration value {int}. The "
"recommended practice is to set this value to 0. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Die folgenden Server antworten mit dem NSEC3-Iterationswert {int}. "
"Empfohlene Praxis ist es, diesen Wert auf 0 zu setzen. Abgerufen von den "
"Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_ILLEGAL_SALT_LENGTH"
msgid ""
"The following servers respond with a non-empty salt in NSEC3 ({int} octets). "
"The recommended practice is to use an empty salt. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Die folgenden Server antworten mit einem nicht leeren Salt in NSEC3 "
"({int} Oktetts). Empfohlene Praxis ist die Verwendung eines leeren Salts. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_INCONSISTENT_HASH_ALGO"
msgid ""
"Inconsistent hash algorithm in NSEC3 in responses for the child zone from "
"different name servers."
msgstr ""
"Inkonsistenter Hash-Algorithmus in NSEC3 in den Antworten verschiedener "
"Nameserver für die untergeordnete Zone."

msgctxt "DNSSEC:DS03_INCONSISTENT_ITERATION"
msgid ""
"Inconsistent NSEC3 iteration value in responses for the child zone from "
"different name servers."
msgstr ""
"Inkonsistenter NSEC3-Iterationswert in den Antworten verschiedener "
"Nameserver für die untergeordnete Zone."

msgctxt "DNSSEC:DS03_INCONSISTENT_NSEC3_FLAGS"
msgid ""
"Inconsistent NSEC3 flag list in responses for the child zone from different "
"name servers."
msgstr ""
"Inkonsistente NSEC3-Flag-Liste in den Antworten verschiedener Nameserver "
"für die untergeordnete Zone."

msgctxt "DNSSEC:DS03_INCONSISTENT_SALT_LENGTH"
msgid ""
"Inconsistent salt length in NSEC3 in responses for the child zone from "
"different name servers."
msgstr ""
"Inkonsistente Salt-Länge in NSEC3 in den Antworten verschiedener "
"Nameserver für die untergeordnete Zone."

msgctxt "DNSSEC:DS03_LEGAL_EMPTY_SALT"
msgid ""
"The following servers respond with a legal empty salt in NSEC3. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Die folgenden Server antworten mit einem gültigen leeren Salt in NSEC3. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_LEGAL_HASH_ALGO"
msgid ""
"The following servers respond with a legal hash algorithm in NSEC3. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Die folgenden Server antworten mit einem gültigen Hash-Algorithmus in "
"NSEC3. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_LEGAL_ITERATION_VALUE"
msgid ""
"The following servers respond with NSEC3 iteration value set to zero (as "
"recommended). Fetched from name servers \"{servers}\"."
msgstr ""
"Die folgenden Server antworten mit dem NSEC3-Iterationswert null (wie "
"empfohlen). Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_NO_DNSSEC_SUPPORT"
msgid ""
"The zone is not DNSSEC signed or not properly DNSSEC signed. Testing for "
"NSEC3 has been skipped. Fetched from name servers \"{servers}\"."
msgstr ""
"Die Zone ist nicht DNSSEC-signiert oder nicht korrekt DNSSEC-signiert. "
"Der NSEC3-Test wurde übersprungen. Abgerufen von den Nameservern "
"\"{servers}\"."

msgctxt "DNSSEC:DS03_NO_NSEC3"
msgid ""
"The zone does not use NSEC3. Testing for NSEC3 has been skipped. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Die Zone verwendet kein NSEC3. Der NSEC3-Test wurde übersprungen. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_NO_RESPONSE_NSEC_QUERY"
msgid ""
"The following servers do not respond to NSEC query. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Die folgenden Server antworten nicht auf NSEC-Abfragen. Abgerufen von den "
"Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_NSEC3_OPT_OUT_DISABLED"
msgid ""
"The following servers respond with NSEC3 opt-out disabled (as recommended). "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Die folgenden Server antworten mit deaktiviertem NSEC3-Opt-out (wie "
"empfohlen). Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_NSEC3_OPT_OUT_ENABLED_NON_TLD"
msgid ""
"The following servers respond with NSEC3 opt-out enabled. The recommended "
"practice is to disable opt-out. Fetched from name servers \"{servers}\"."
msgstr ""
"Die folgenden Server antworten mit aktiviertem NSEC3-Opt-out. Empfohlene "
"Praxis ist es, Opt-out zu deaktivieren. Abgerufen von den Nameservern "
"\"{servers}\"."

msgctxt "DNSSEC:DS03_NSEC3_OPT_OUT_ENABLED_TLD"
msgid ""
"The following servers respond with NSEC3 opt-out enabled. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Die folgenden Server antworten mit aktiviertem NSEC3-Opt-out. Abgerufen "
"von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_SERVER_NO_DNSSEC_SUPPORT"
msgid ""
"The following name servers do not support DNSSEC or have not been properly "
"configured. Testing for NSEC3 has been skipped on those servers. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Die folgenden Nameserver unterstützen kein DNSSEC oder sind nicht "
"korrekt konfiguriert. Der NSEC3-Test wurde auf diesen Servern "
"übersprungen. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_SERVER_NO_NSEC3"
msgid ""
"The following name servers do not use NSEC3, but others do. Testing for "
"NSEC3 has been skipped on the following servers. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Die folgenden Nameserver verwenden kein NSEC3, während andere es tun. "
"Der NSEC3-Test wurde auf den folgenden Servern übersprungen. Abgerufen "
"von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS03_UNASSIGNED_FLAG_USED"
msgid ""
"The following servers respond with an NSEC3 record where an unassigned flag "
"is used (bit {int}). Fetched from name servers \"{servers}\"."
msgstr ""
"Die folgenden Server antworten mit einem NSEC3-Record, bei dem ein nicht "
"zugewiesenes Flag verwendet wird (Bit {int}). Abgerufen von den "
"Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type DNSKEY has already expired. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Die RRSIG mit Keytag {keytag} für den Typ DNSKEY ist bereits abgelaufen. "
"Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_NOT_YET_VALID"
msgid ""
"RRSIG with keytag {keytag} and covering type DNSKEY has inception date in "
"the future. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Die RRSIG mit Keytag {keytag} für den Typ DNSKEY hat ein "
"Gültigkeitsbeginn-Datum in der Zukunft. Abgerufen von den Nameservern "
"mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS08_MISSING_RRSIG_IN_RESPONSE"
msgid ""
"The DNSKEY RRset is not signed, which is against expectation. Fetched from "
"the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Das DNSKEY-RRset ist nicht signiert, was unerwartet ist. Abgerufen von "
"den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS08_NO_MATCHING_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which does not "
"match any DNSKEY record. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Das DNSKEY-RRset ist mit einer RRSIG mit Tag {keytag} signiert, die keinem "
"DNSKEY-Record entspricht. Abgerufen von den Nameservern mit den IP-Adressen "
"\"{addresses}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_VALID"
msgid ""
"The DNSKEY RRset has valid RRSIG records. Found at the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Das DNSKEY-RRset hat gültige RRSIG-Records. Gefunden bei den Nameservern "
"mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS09_MISSING_RRSIG_IN_RESPONSE"
msgid ""
"The SOA RRset is not signed, which is against expectation. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Das SOA-RRset ist nicht signiert, was unerwartet ist. Abgerufen von den "
"Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS09_NO_MATCHING_DNSKEY"
msgid ""
"The SOA RRset is signed with an RRSIG with tag {keytag} which does not match "
"any DNSKEY record. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Das SOA-RRset ist mit einer RRSIG mit Tag {keytag} signiert, die keinem "
"DNSKEY-Record entspricht. Abgerufen von den Nameservern mit den IP-Adressen "
"\"{addresses}\"."

msgctxt "DNSSEC:DS09_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The SOA RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Das SOA-RRset ist mit einer RRSIG mit Tag {keytag} signiert, die durch den "
"zugehörigen DNSKEY nicht validiert werden kann. Abgerufen von den "
"Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type SOA has already expired. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Die RRSIG mit Keytag {keytag} für den Typ SOA ist bereits abgelaufen. "
"Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_NOT_YET_VALID"
msgid ""
"RRSIG with keytag {keytag} and covering type SOA has inception date in the "
"future. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Die RRSIG mit Keytag {keytag} für den Typ SOA hat ein "
"Gültigkeitsbeginn-Datum in der Zukunft. Abgerufen von den Nameservern "
"mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_VALID"
msgid ""
"The SOA RRset has valid RRSIG records. Found at the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Das SOA-RRset hat gültige RRSIG-Records. Gefunden auf den Nameservern mit "
"den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS10_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from name servers "
"\"{addresses}\"."
msgstr ""
"Der DNSKEY-Record mit Key-Tag {keytag} verwendet den Algorithmus {algo_num} "
"({algo_mnemo}), der von dieser Installation nicht unterstützt wird. Abgerufen "
"von den Nameservern \"{addresses}\"."

msgctxt "DNSSEC:DS10_ERR_MULT_NSEC"
msgid ""
"Multiple NSEC records when one is expected. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Mehrere NSEC-Records gefunden, obwohl nur einer erwartet wurde. Abgerufen "
"von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_EXPECTED_NSEC_NSEC3_MISSING"
msgid ""
"The server responded with DNSKEY but not with expected NSEC or NSEC3. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Der Server antwortete mit DNSKEY, aber nicht mit dem erwarteten NSEC- oder "
"NSEC3-Record. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_HAS_NSEC"
msgid "The zone has NSEC records. Fetched from name servers \"{servers}\"."
msgstr "Die Zone hat NSEC-Records. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_HAS_NSEC3"
msgid "The zone has NSEC3 records. Fetched from name servers \"{servers}\"."
msgstr "Die Zone hat NSEC3-Records. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_INCONSISTENT_NSEC"
msgid ""
"Inconsistent responses from zone with NSEC. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Inkonsistente Antworten von der Zone mit NSEC. Abgerufen von den "
"Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_INCONSISTENT_NSEC3"
msgid ""
"Inconsistent responses from zone with NSEC3. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Inkonsistente Antworten von der Zone mit NSEC3. Abgerufen von den "
"Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_INCONSISTENT_NSEC_NSEC3"
msgid "The zone is inconsistent on NSEC and NSEC3. Fetched from name servers \"{servers}\"."
msgstr "Die Zone ist inkonsistent bezüglich NSEC und NSEC3. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_MIXED_NSEC_NSEC3"
msgid ""
"The zone responds with both NSEC and NSEC3, where only one of them is "
"expected. Fetched from name servers \"{servers}\"."
msgstr ""
"Die Zone antwortet sowohl mit NSEC als auch mit NSEC3, obwohl nur eines "
"erwartet wurde. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NONSTANDARD_NSEC_RESPONSE"
msgid ""
"NSEC query returned NSEC in the authority section instead of the answer "
"section (RFC 4470 / RFC 9824). Fetched from name servers \"{servers}\"."
msgstr ""
"Die NSEC-Abfrage lieferte NSEC im Authority-Abschnitt anstatt im "
"Antwort-Abschnitt (RFC 4470 / RFC 9824). Abgerufen von den Nameservern "
"\"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3PARAM_GIVES_ERR_ANSWER"
msgid ""
"Unexpected DNS record in the answer section on an NSEC3PARAM query. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Unerwarteter DNS-Record im Antwort-Abschnitt bei einer NSEC3PARAM-Abfrage. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3PARAM_MISMATCHES_APEX"
msgid ""
"The returned NSEC3PARAM record has an unexpected non-apex owner name. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Der zurückgegebene NSEC3PARAM-Record hat einen unerwarteten Owner-Namen, "
"der nicht dem Zonenapex entspricht. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3PARAM_QUERY_RESPONSE_ERR"
msgid ""
"No response or error in response on query for NSEC3PARAM. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Keine Antwort oder Fehler in der Antwort bei der Abfrage für NSEC3PARAM. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_ERR_TYPE_LIST"
msgid ""
"NSEC3 record for the zone apex with incorrect type list. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"NSEC3-Record für den Zonenapex mit falscher Typliste. Abgerufen von den "
"Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_MISMATCHES_APEX"
msgid ""
"The returned NSEC3 record unexpectedly does not match the zone name. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Der zurückgegebene NSEC3-Record stimmt unerwartet nicht mit dem Zonennamen "
"überein. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_MISSING_SIGNATURE"
msgid ""
"Missing RRSIG (signature) for the NSEC3 record or records. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Fehlende RRSIG-Signatur für den NSEC3-Record oder die NSEC3-Records. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_NODATA_MISSING_SOA"
msgid ""
"Missing SOA record in NODATA response with NSEC3. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Fehlender SOA-Record in der NODATA-Antwort mit NSEC3. Abgerufen von den "
"Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_NODATA_WRONG_SOA"
msgid ""
"Wrong owner name (\"{domain}\") on SOA record in NODATA response with NSEC3. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Falscher Owner-Name (\"{domain}\") im SOA-Record der NODATA-Antwort mit "
"NSEC3. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_NO_VERIFIED_SIGNATURE"
msgid ""
"The RRSIG (signature) for the NSEC3 record cannot be verified. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Die RRSIG-Signatur für den NSEC3-Record kann nicht verifiziert werden. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_EXPIRED"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC3 record has expired. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Die RRSIG-Signatur mit Key-Tag {keytag} für den NSEC3-Record ist abgelaufen. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_NOT_YET_VALID"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC3 record it not yet "
"valid. Fetched from name servers \"{servers}\"."
msgstr ""
"Die RRSIG-Signatur mit Key-Tag {keytag} für den NSEC3-Record ist noch nicht "
"gültig. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_NO_DNSKEY"
msgid ""
"There is no DNSKEY record matching the RRSIG (signature) with tag {keytag} "
"for the NSEC3 record. Fetched from name servers \"{servers}\"."
msgstr ""
"Es gibt keinen DNSKEY-Record, der zur RRSIG-Signatur mit Key-Tag {keytag} "
"für den NSEC3-Record passt. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_VERIFY_ERROR"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC3 record cannot be "
"verified. Fetched from name servers \"{servers}\"."
msgstr ""
"Die RRSIG-Signatur mit Key-Tag {keytag} für den NSEC3-Record kann nicht "
"verifiziert werden. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_ERR_TYPE_LIST"
msgid ""
"NSEC record for the zone apex with incorrect type list. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"NSEC-Record für den Zonenapex mit falscher Typliste. Abgerufen von den "
"Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_GIVES_ERR_ANSWER"
msgid ""
"Unexpected DNS record in the answer section on an NSEC query. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Unerwarteter DNS-Record im Antwort-Abschnitt bei einer NSEC-Abfrage. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_MISMATCHES_APEX"
msgid ""
"The returned NSEC record has an unexpected non-apex owner name. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Der zurückgegebene NSEC-Record hat einen unerwarteten Owner-Namen, der nicht "
"dem Zonenapex entspricht. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_MISSING_SIGNATURE"
msgid ""
"Missing RRSIG (signature) for the NSEC record or records. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Fehlende RRSIG-Signatur für den NSEC-Record oder die NSEC-Records. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_NODATA_MISSING_SOA"
msgid ""
"Missing SOA record in NODATA response with NSEC. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Fehlender SOA-Record in der NODATA-Antwort mit NSEC. Abgerufen von den "
"Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_NODATA_WRONG_SOA"
msgid ""
"Wrong owner name (\"{domain}\") on SOA record in NODATA response with NSEC. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Falscher Owner-Name (\"{domain}\") im SOA-Record der NODATA-Antwort mit "
"NSEC. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_NO_VERIFIED_SIGNATURE"
msgid ""
"There is no RRSIG (signature) for the NSEC record that can be verified. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Es gibt keine verifizierbare RRSIG-Signatur für den NSEC-Record. Abgerufen "
"von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_QUERY_RESPONSE_ERR"
msgid ""
"No response or error in response on query for NSEC. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Keine Antwort oder Fehler in der Antwort bei der Abfrage für NSEC. Abgerufen "
"von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_EXPIRED"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC record has expired. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Die RRSIG-Signatur mit Key-Tag {keytag} für den NSEC-Record ist abgelaufen. "
"Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_NOT_YET_VALID"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC record it not yet "
"valid. Fetched from name servers \"{servers}\"."
msgstr ""
"Die RRSIG-Signatur mit Key-Tag {keytag} für den NSEC-Record ist noch nicht "
"gültig. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_NO_DNSKEY"
msgid ""
"There is no DNSKEY record matching the RRSIG (signature) with tag {keytag} "
"for the NSEC record. Fetched from name servers \"{servers}\"."
msgstr ""
"Es gibt keinen DNSKEY-Record, der zur RRSIG-Signatur mit Key-Tag {keytag} "
"für den NSEC-Record passt. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_VERIFY_ERROR"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC record cannot be "
"verified. Fetched from name servers \"{servers}\"."
msgstr ""
"Die RRSIG-Signatur mit Key-Tag {keytag} für den NSEC-Record kann nicht "
"verifiziert werden. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_SERVER_NO_DNSSEC"
msgid ""
"The following name servers do not support DNSSEC or have not been properly "
"configured. Testing for NSEC and NSEC3 has been skipped on these servers. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Die folgenden Nameserver unterstützen DNSSEC nicht oder sind nicht korrekt "
"konfiguriert. Die Tests für NSEC und NSEC3 wurden auf diesen Servern "
"übersprungen. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS10_ZONE_NO_DNSSEC"
msgid ""
"The zone is not DNSSEC signed or not properly DNSSEC signed. Testing for "
"NSEC and NSEC3 has been skipped. Fetched from name servers \"{servers}\"."
msgstr ""
"Die Zone ist nicht oder nicht korrekt mit DNSSEC signiert. Die Tests für "
"NSEC und NSEC3 wurden übersprungen. Abgerufen von den Nameservern \"{servers}\"."

msgctxt "DNSSEC:DS11_INCONSISTENT_DS"
msgid "Parent name servers are inconsistent on the existence of DS."
msgstr "Die Nameserver der übergeordneten Zone sind inkonsistent bezüglich des Vorhandenseins von DS-Records."

msgctxt "DNSSEC:DS11_INCONSISTENT_SIGNED_ZONE"
msgid ""
"Name servers for the child zone are inconsistent on whether the zone is "
"signed or not."
msgstr ""
"Die Nameserver der untergeordneten Zone sind inkonsistent bezüglich der "
"Frage, ob die Zone signiert ist oder nicht."

msgctxt "DNSSEC:DS11_UNDETERMINED_DS"
msgid ""
"It cannot be determined if the parent zone has DS for the child zone or not."
msgstr ""
"Es kann nicht festgestellt werden, ob die übergeordnete Zone DS-Records für "
"die untergeordnete Zone hat oder nicht."

msgctxt "DNSSEC:DS11_UNDETERMINED_SIGNED_ZONE"
msgid "It cannot be determined if the child zone is signed or not."
msgstr "Es kann nicht festgestellt werden, ob die untergeordnete Zone signiert ist oder nicht."

msgctxt "DNSSEC:DS11_PARENT_WITHOUT_DS"
msgid ""
"No DS record for the child zone found on parent nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Kein DS-Record für die untergeordnete Zone auf den Nameservern der "
"übergeordneten Zone mit den IP-Adressen \"{addresses}\" gefunden."

msgctxt "DNSSEC:DS11_PARENT_WITH_DS"
msgid ""
"DS record for the child zone found on parent nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"DS-Record für die untergeordnete Zone auf den Nameservern der "
"übergeordneten Zone mit den IP-Adressen \"{addresses}\" gefunden."

msgctxt "DNSSEC:DS11_NS_WITH_SIGNED_ZONE"
msgid ""
"Signed child zone found on nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Signierte untergeordnete Zone auf Nameservern mit den IP-Adressen "
"\"{addresses}\" gefunden."

msgctxt "DNSSEC:DS11_NS_WITH_UNSIGNED_ZONE"
msgid ""
"Unsigned child zone found on nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Unsignierte untergeordnete Zone auf Nameservern mit den IP-Adressen "
"\"{addresses}\" gefunden."

msgctxt "DNSSEC:DS11_DS_BUT_UNSIGNED_ZONE"
msgid "The child zone is unsigned, but the parent zone has DS record."
msgstr "Die untergeordnete Zone ist unsigniert, aber die übergeordnete Zone hat DS-Records."

msgctxt "DNSSEC:DS11_CONSISTENT_SIGNED"
msgid "Parent DS and child DNSKEY are consistent - the zone is signed."
msgstr "Der DS der übergeordneten Zone und der DNSKEY der untergeordneten Zone sind konsistent - die Zone ist signiert."

msgctxt "DNSSEC:DS11_NO_PARENT_DS"
msgid "No DS records found at the parent - the zone is unsigned from the parent view."
msgstr "Keine DS-Records bei der übergeordneten Zone gefunden - die Zone gilt aus Sicht der übergeordneten Zone als unsigniert."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_DNSKEY"
msgid ""
"The DNSKEY RRset is not signed by algorithm {algo_num} ({algo_mnemo}) "
"present in the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Das DNSKEY-RRset ist nicht mit dem Algorithmus {algo_num} ({algo_mnemo}) "
"signiert, der im DNSKEY-RRset vorhanden ist. Abgerufen von den Nameservern "
"mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_NS"
msgid ""
"The NS RRset is not signed by algorithm {algo_num} ({algo_mnemo}) present in "
"the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Das NS-RRset ist nicht mit dem Algorithmus {algo_num} ({algo_mnemo}) "
"signiert, der im DNSKEY-RRset vorhanden ist. Abgerufen von den Nameservern "
"mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_SOA"
msgid ""
"The SOA RRset is not signed by algorithm {algo_num} ({algo_mnemo}) present "
"in the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Das SOA-RRset ist nicht mit dem Algorithmus {algo_num} ({algo_mnemo}) "
"signiert, der im DNSKEY-RRset vorhanden ist. Abgerufen von den Nameservern "
"mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALL_ALGOS_SIGNED"
msgid "All DNSKEY algorithms have RRSIG coverage in DNSKEY, SOA, and NS answers."
msgstr "Alle DNSKEY-Algorithmen haben RRSIG-Abdeckung in DNSKEY-, SOA- und NS-Antworten."

msgctxt "DNSSEC:DS15_CDS_NON_MUST_DIGEST"
msgid ""
"CDS records with non-mandatory digest types are found on nameservers that "
"resolve to IP addresses ({addresses}); parents ignore them."
msgstr ""
"CDS-Records mit nicht verpflichtenden Digest-Typen wurden auf Nameservern "
"mit den IP-Adressen ({addresses}) gefunden; die übergeordnete Zone "
"ignoriert sie."

msgctxt "DNSSEC:DS15_HAS_CDNSKEY_NO_CDS"
msgid ""
"CDNSKEY RRset is found on nameservers that resolve to IP addresses "
"({addresses}), but no CDS RRset."
msgstr ""
"CDNSKEY-RRset wurde auf Nameservern mit den IP-Adressen ({addresses}) "
"gefunden, aber kein CDS-RRset."

msgctxt "DNSSEC:DS15_HAS_CDS_AND_CDNSKEY"
msgid ""
"CDNSKEY and CDS RRsets are found on nameservers that resolve to IP addresses "
"({addresses})."
msgstr ""
"CDNSKEY- und CDS-RRsets wurden auf Nameservern mit den IP-Adressen "
"({addresses}) gefunden."

msgctxt "DNSSEC:DS15_HAS_CDS_NO_CDNSKEY"
msgid ""
"CDS RRset is found on nameservers that resolve to IP addresses "
"({addresses}), but no CDNSKEY RRset."
msgstr ""
"CDS-RRset wurde auf Nameservern mit den IP-Adressen ({addresses}) gefunden, "
"aber kein CDNSKEY-RRset."

msgctxt "DNSSEC:DS15_INCONSISTENT_CDNSKEY"
msgid "All servers do not have the same CDNSKEY RRset."
msgstr "Nicht alle Server haben dasselbe CDNSKEY-RRset."

msgctxt "DNSSEC:DS15_INCONSISTENT_CDS"
msgid "All servers do not have the same CDS RRset."
msgstr "Nicht alle Server haben dasselbe CDS-RRset."

msgctxt "DNSSEC:DS15_MISMATCH_CDS_CDNSKEY"
msgid ""
"Both CDS and CDNSKEY RRsets are found on nameservers that resolve to IP "
"addresses ({addresses}) but they do not match."
msgstr ""
"Sowohl CDS- als auch CDNSKEY-RRsets wurden auf Nameservern mit den "
"IP-Adressen ({addresses}) gefunden, aber sie stimmen nicht überein."

msgctxt "DNSSEC:DS15_NO_CDS_CDNSKEY"
msgid "No CDS or CDNSKEY RRsets are found on any name server."
msgstr "Auf keinem Nameserver wurden CDS- oder CDNSKEY-RRsets gefunden."

msgctxt "DNSSEC:DS16_CDS_INVALID_RRSIG"
msgid ""
"The CDS RRset is signed with an RRSIG with tag {keytag}, but the RRSIG does "
"not match the DNSKEY with the same key tag. Fetched from the nameservers "
"with IP addresses \"{addresses}\"."
msgstr ""
"Das CDS-RRset ist mit einer RRSIG mit Key-Tag {keytag} signiert, aber die "
"RRSIG stimmt nicht mit dem DNSKEY mit demselben Key-Tag überein. Abgerufen "
"von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NON_SEP_DNSKEY"
msgid ""
"The CDS record with tag {keytag} matches a DNSKEY record with SEP bit (bit "
"15) unset. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der CDS-Record mit Key-Tag {keytag} entspricht einem DNSKEY-Record, bei "
"dem das SEP-Bit (Bit 15) nicht gesetzt ist. Abgerufen von den Nameservern "
"mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NON_ZONE_DNSKEY"
msgid ""
"The CDS record with tag {keytag} matches a DNSKEY record with zone bit (bit "
"7) unset. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der CDS-Record mit Key-Tag {keytag} entspricht einem DNSKEY-Record, bei "
"dem das Zone-Key-Bit (Bit 7) nicht gesetzt ist. Abgerufen von den "
"Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NO_DNSKEY"
msgid ""
"The CDS record with tag {keytag} does not match any DNSKEY record. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der CDS-Record mit Key-Tag {keytag} entspricht keinem DNSKEY-Record. "
"Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_NOT_SIGNED_BY_CDS"
msgid ""
"The CDS RRset is not signed by the DNSKEY that the CDS record with tag "
"{keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Das CDS-RRset ist nicht mit dem DNSKEY signiert, auf den der CDS-Record "
"mit Key-Tag {keytag} verweist. Abgerufen von den Nameservern mit den "
"IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_SIGNED_BY_UNKNOWN_DNSKEY"
msgid ""
"The CDS RRset is signed by RRSIG with tag {keytag} but that is not in the "
"DNSKEY RRset. Fetched from the nameservers with P addresses \"{addresses}\"."
msgstr ""
"Das CDS-RRset ist mit einer RRSIG mit Key-Tag {keytag} signiert, die jedoch "
"nicht im DNSKEY-RRset enthalten ist. Abgerufen von den Nameservern mit den "
"IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_UNSIGNED"
msgid ""
"The CDS RRset is not signed. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Das CDS-RRset ist nicht signiert. Abgerufen von den Nameservern mit den "
"IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_WITHOUT_DNSKEY"
msgid ""
"A CDS RRset exists, but no DNSKEY record exists. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Ein CDS-RRset ist vorhanden, aber es gibt keinen DNSKEY-Record. Abgerufen "
"von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS16_DELETE_CDS"
msgid ""
"A single \"delete\" CDS record is found on the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Ein einzelner CDS-Record vom Typ \"delete\" wurde auf den Nameservern mit "
"den IP-Adressen \"{addresses}\" gefunden."

msgctxt "DNSSEC:DS16_DNSKEY_NOT_SIGNED_BY_CDS"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY that the CDS record with tag "
"{keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Das DNSKEY-RRset ist nicht mit dem DNSKEY signiert, auf den der CDS-Record "
"mit Key-Tag {keytag} verweist. Abgerufen von den Nameservern mit den "
"IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS16_MIXED_DELETE_CDS"
msgid ""
"The CDS RRset is a mixture between \"delete\" record and other records. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Das CDS-RRset enthält eine Mischung aus \"delete\"-Records und anderen "
"Records. Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_INVALID_RRSIG"
msgid ""
"The CDNSKEY RRset is signed with an RRSIG with tag {keytag}, but the RRSIG "
"does not match the DNSKEY with the same key tag. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Das CDNSKEY-RRset ist mit einer RRSIG mit Key-Tag {keytag} signiert, aber "
"die RRSIG stimmt nicht mit dem DNSKEY mit demselben Key-Tag überein. "
"Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_IS_NON_SEP"
msgid ""
"The CDNSKEY record with tag {keytag} has the SEP bit (bit 15) unset. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der CDNSKEY-Record mit Key-Tag {keytag} hat das SEP-Bit (Bit 15) nicht "
"gesetzt. Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_IS_NON_ZONE"
msgid ""
"The CDNSKEY record with tag {keytag} has the zone bit (bit 7) unset. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der CDNSKEY-Record mit Key-Tag {keytag} hat das Zone-Key-Bit (Bit 7) nicht "
"gesetzt. Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_MATCHES_NO_DNSKEY"
msgid ""
"The CDNSKEY record with tag {keytag} does not match any DNSKEY record. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Der CDNSKEY-Record mit Key-Tag {keytag} entspricht keinem DNSKEY-Record. "
"Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_NOT_SIGNED_BY_CDNSKEY"
msgid ""
"The CDNSKEY RRset is not signed by the DNSKEY that the CDNSKEY record with "
"tag {keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Das CDNSKEY-RRset ist nicht mit dem DNSKEY signiert, auf den der "
"CDNSKEY-Record mit Key-Tag {keytag} verweist. Abgerufen von den Nameservern "
"mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_SIGNED_BY_UNKNOWN_DNSKEY"
msgid ""
"The CDNSKEY RRset is signed by RRSIG with tag {keytag} but that is not in "
"the DNSKEY RRset. Fetched from the nameservers with P addresses "
"\"{addresses}\"."
msgstr ""
"Das CDNSKEY-RRset ist mit einer RRSIG mit Key-Tag {keytag} signiert, die "
"jedoch nicht im DNSKEY-RRset enthalten ist. Abgerufen von den Nameservern "
"mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_UNSIGNED"
msgid ""
"The CDNSKEY RRset is not signed. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Das CDNSKEY-RRset ist nicht signiert. Abgerufen von den Nameservern mit den "
"IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_WITHOUT_DNSKEY"
msgid ""
"A CDNSKEY RRset exists, but no DNSKEY record exists. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Ein CDNSKEY-RRset ist vorhanden, aber es gibt keinen DNSKEY-Record. "
"Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS17_DELETE_CDNSKEY"
msgid ""
"A single \"delete\" CDNSKEY record is found on the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Ein einzelner CDNSKEY-Record vom Typ \"delete\" wurde auf den Nameservern "
"mit den IP-Adressen \"{addresses}\" gefunden."

msgctxt "DNSSEC:DS17_DNSKEY_NOT_SIGNED_BY_CDNSKEY"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY that the CDNSKEY record with "
"tag {keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Das DNSKEY-RRset ist nicht mit dem DNSKEY signiert, auf den der "
"CDNSKEY-Record mit Key-Tag {keytag} verweist. Abgerufen von den Nameservern "
"mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS17_MIXED_DELETE_CDNSKEY"
msgid ""
"The CDNSKEY RRset is a mixture between \"delete\" record and other records. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Das CDNSKEY-RRset enthält eine Mischung aus \"delete\"-Records und anderen "
"Records. Abgerufen von den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS18_NO_MATCH_CDS_RRSIG_DS"
msgid ""
"The CDS RRset is not signed with a DNSKEY record that a DS record points to. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Das CDS-RRset ist nicht mit einem DNSKEY-Record signiert, auf den ein "
"DS-Record verweist. Abgerufen von den Nameservern mit den IP-Adressen "
"\"{addresses}\"."

msgctxt "DNSSEC:DS18_NO_MATCH_CDNSKEY_RRSIG_DS"
msgid ""
"The CDNSKEY RRset is not signed with a DNSKEY record that a DS record points "
"to. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Das CDNSKEY-RRset ist nicht mit einem DNSKEY-Record signiert, auf den ein "
"DS-Record verweist. Abgerufen von den Nameservern mit den IP-Adressen "
"\"{addresses}\"."

msgctxt "DNSSEC:DS18_MATCH_CDNSKEY_RRSIG_DS"
msgid ""
"The CDNSKEY RRset is signed by a DS-linked DNSKEY. Found at the nameservers "
"with IP addresses \"{addresses}\"."
msgstr ""
"Das CDNSKEY-RRset ist mit einem DS-verknüpften DNSKEY signiert. Gefunden auf "
"den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS18_MATCH_CDS_RRSIG_DS"
msgid ""
"The CDS RRset is signed by a DS-linked DNSKEY. Found at the nameservers "
"with IP addresses \"{addresses}\"."
msgstr ""
"Das CDS-RRset ist mit einem DS-verknüpften DNSKEY signiert. Gefunden auf "
"den Nameservern mit den IP-Adressen \"{addresses}\"."

msgctxt "DNSSEC:DS18_CDS_MATCHES_DS"
msgid "The CDS RRset content matches the parent DS RRset. No key change signaled."
msgstr "Der Inhalt des CDS-RRsets stimmt mit dem DS-RRset der übergeordneten Zone überein. Kein Schlüsselwechsel signalisiert."

msgctxt "DNSSEC:DS18_CDS_ROLLOVER_SIGNALED"
msgid "The CDS RRset content differs from the parent DS RRset, signaling a key change. CDS keytags: {cds_keytags}. DS keytags: {ds_keytags}."
msgstr "Der Inhalt des CDS-RRsets unterscheidet sich vom DS-RRset der übergeordneten Zone und signalisiert einen Schlüsselwechsel. CDS-Key-Tags: {cds_keytags}. DS-Key-Tags: {ds_keytags}."

msgctxt "DNSSEC:DS18_CDNSKEY_MATCHES_DS"
msgid "The CDNSKEY RRset content matches the parent DS RRset. No key change signaled."
msgstr "Der Inhalt des CDNSKEY-RRsets stimmt mit dem DS-RRset der übergeordneten Zone überein. Kein Schlüsselwechsel signalisiert."

msgctxt "DNSSEC:DS18_CDNSKEY_ROLLOVER_SIGNALED"
msgid "The CDNSKEY RRset content differs from the parent DS RRset, signaling a key change. CDNSKEY keytags: {cdnskey_keytags}. DS keytags: {ds_keytags}."
msgstr "Der Inhalt des CDNSKEY-RRsets unterscheidet sich vom DS-RRset der übergeordneten Zone und signalisiert einen Schlüsselwechsel. CDNSKEY-Key-Tags: {cdnskey_keytags}. DS-Key-Tags: {ds_keytags}."

msgctxt "DNSSEC:DS18_NO_CDS_CDNSKEY_BUT_ROLLOVER_EVIDENCE"
msgid "No CDS or CDNSKEY RRset found, but other rollover evidence is present. The operator likely uses on-demand CDS/CDNSKEY publication."
msgstr "Kein CDS- oder CDNSKEY-RRset gefunden, aber andere Rollover-Hinweise sind vorhanden. Der Betreiber verwendet wahrscheinlich eine bedarfsgesteuerte CDS/CDNSKEY-Veröffentlichung."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_DOUBLE_SIG"
msgid "The DNSKEY RRset is signed by more than one KSK keytag ({keytags}). A double-signature rollover phase may be in progress."
msgstr "Das DNSKEY-RRset ist mit mehr als einem KSK-Key-Tag ({keytags}) signiert. Möglicherweise ist eine Rollover-Phase mit Doppelsignatur im Gange."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_DNSKEY_WITHOUT_DS"
msgid "Child SEP DNSKEY keytag(s) {keytags} have no matching DS record at the parent. A new KSK may be waiting for the parent DS to be updated."
msgstr "Die SEP-DNSKEY-Key-Tag(s) {keytags} der untergeordneten Zone haben keinen passenden DS-Record bei der übergeordneten Zone. Ein neuer KSK wartet möglicherweise darauf, dass der DS der übergeordneten Zone aktualisiert wird."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_DS_WITHOUT_DNSKEY"
msgid "Parent DS keytag(s) {keytags} have no matching DNSKEY at the child. The old KSK may have been removed from the child zone."
msgstr "Die DS-Key-Tag(s) {keytags} der übergeordneten Zone haben keinen passenden DNSKEY in der untergeordneten Zone. Der alte KSK wurde möglicherweise aus der untergeordneten Zone entfernt."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_MULTI_KSK"
msgid "Multiple SEP-flagged DNSKEYs found at the child zone (keytags: {keytags}). A KSK rollover may be in progress."
msgstr "Mehrere DNSKEY-Records mit gesetztem SEP-Flag in der untergeordneten Zone gefunden (Key-Tags: {keytags}). Möglicherweise ist ein KSK-Rollover im Gange."

msgctxt "DNSSEC:DS19_BADKEY_FERMAT"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus vulnerable to Fermat factorization (close primes) on name server(s) "
"{servers}."
msgstr ""
"Der DNSKEY-Record mit Key-Tag {keytag} und Algorithmus {algo_descr} "
"({algo_num}) hat ein RSA-Modulus, das für die Fermat-Faktorisierung "
"(nahe beieinanderliegende Primzahlen) anfällig ist, auf Nameserver(n) "
"{servers}."

msgctxt "DNSSEC:DS19_BADKEY_PATTERN"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus with suspicious repeating byte pattern on name server(s) {servers}."
msgstr ""
"Der DNSKEY-Record mit Key-Tag {keytag} und Algorithmus {algo_descr} "
"({algo_num}) hat ein RSA-Modulus mit verdächtigem sich wiederholendem "
"Byte-Muster auf Nameserver(n) {servers}."

msgctxt "DNSSEC:DS19_BADKEY_ROCA"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) is "
"vulnerable to ROCA attack (CVE-2017-15361) on name server(s) {servers}."
msgstr ""
"Der DNSKEY-Record mit Key-Tag {keytag} und Algorithmus {algo_descr} "
"({algo_num}) ist für den ROCA-Angriff (CVE-2017-15361) anfällig auf "
"Nameserver(n) {servers}."

msgctxt "DNSSEC:DS19_BADKEY_RSA_INVALID"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has "
"invalid RSA parameters ({subtest}) on name server(s) {servers}."
msgstr ""
"Der DNSKEY-Record mit Key-Tag {keytag} und Algorithmus {algo_descr} "
"({algo_num}) hat ungültige RSA-Parameter ({subtest}) auf Nameserver(n) "
"{servers}."

msgctxt "DNSSEC:DS19_BADKEY_SMALL_D"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"private exponent recoverable via Wiener's attack on name server(s) {servers}."
msgstr ""
"Der DNSKEY-Record mit Key-Tag {keytag} und Algorithmus {algo_descr} "
"({algo_num}) hat einen privaten RSA-Exponenten, der über den Wiener-Angriff "
"wiederhergestellt werden kann, auf Nameserver(n) {servers}."

msgctxt "DNSSEC:DS19_BADKEY_SMALL_FACTORS"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus with small prime factors on name server(s) {servers}."
msgstr ""
"Der DNSKEY-Record mit Key-Tag {keytag} und Algorithmus {algo_descr} "
"({algo_num}) hat ein RSA-Modulus mit kleinen Primfaktoren auf Nameserver(n) "
"{servers}."

msgctxt "DNSSEC:DS19_BLOCKLIST_NOT_FOUND"
msgid ""
"Badkeys blocklist data not found. Blocklist check skipped. Run 'gonemaster "
"--badkeys-update' to download the blocklist."
msgstr ""
"Badkeys-Sperrlisten-Daten nicht gefunden. Sperrlistenprüfung übersprungen. "
"Führen Sie 'gonemaster --badkeys-update' aus, um die Sperrliste "
"herunterzuladen."

msgctxt "DNSSEC:DS19_KEY_OK"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) passed "
"all badkey checks on name server(s) {servers}."
msgstr ""
"Der DNSKEY-Record mit Key-Tag {keytag} und Algorithmus {algo_descr} "
"({algo_num}) hat alle Badkey-Prüfungen auf Nameserver(n) {servers} bestanden."

msgctxt "DNSSEC:DS19_NO_DNSKEY"
msgid "No DNSKEY records found at zone apex on name server(s) {servers}."
msgstr "Keine DNSKEY-Records am Zonenapex auf Nameserver(n) {servers} gefunden."

msgctxt "DNSSEC:DS19_NO_RESPONSE"
msgid ""
"No name server produced a usable DNSKEY response for badkey checking on "
"name server(s) {servers}."
msgstr ""
"Kein Nameserver hat eine verwendbare DNSKEY-Antwort für die Badkey-Prüfung "
"auf Nameserver(n) {servers} geliefert."

msgctxt "DNSSEC:DS20_BITMAP_OK"
msgid "NSEC/NSEC3 type bitmap at the zone apex correctly includes all observed RR types on name server(s) {servers}."
msgstr "Die NSEC/NSEC3-Typ-Bitmap am Zonenapex enthält korrekt alle beobachteten RR-Typen auf Nameserver(n) {servers}."

msgctxt "DNSSEC:DS20_NO_BITMAP"
msgid "No NSEC or NSEC3 type bitmap could be obtained for the zone apex on name server(s) {servers}."
msgstr "Für den Zonenapex konnte keine NSEC- oder NSEC3-Typ-Bitmap von Nameserver(n) {servers} abgerufen werden."

msgctxt "DNSSEC:DS20_NO_DNSSEC"
msgid "No nameserver returned a usable DNSKEY; NSEC/NSEC3 bitmap check skipped on name server(s) {servers}."
msgstr "Kein Nameserver hat einen verwendbaren DNSKEY zurückgegeben; die NSEC/NSEC3-Bitmap-Prüfung wurde auf Nameserver(n) {servers} übersprungen."

msgctxt "DNSSEC:DS20_NSEC3_BITMAP_MISMATCHES_RRTYPE"
msgid "RR type {query_type} exists at the zone apex but is missing from the NSEC3 type bitmap on name server(s) {servers}. This enables cache poisoning via RFC 8198 aggressive negative caching."
msgstr "Der RR-Typ {query_type} existiert am Zonenapex, fehlt aber in der NSEC3-Typ-Bitmap auf Nameserver(n) {servers}. Dies ermöglicht Cache-Vergiftung durch aggressives negatives Caching gemäß RFC 8198."

msgctxt "DNSSEC:DS20_NSEC_BITMAP_MISMATCHES_RRTYPE"
msgid "RR type {query_type} exists at the zone apex but is missing from the NSEC type bitmap on name server(s) {servers}. This enables cache poisoning via RFC 8198 aggressive negative caching."
msgstr "Der RR-Typ {query_type} existiert am Zonenapex, fehlt aber in der NSEC-Typ-Bitmap auf Nameserver(n) {servers}. Dies ermöglicht Cache-Vergiftung durch aggressives negatives Caching gemäß RFC 8198."

msgctxt "DNSSEC:DS21_ALGO_NOT_SUPPORTED"
msgid "Parent DS RRSIG with keytag {keytag} uses unsupported algorithm {algo_num} ({algo_mnemo}); skipping verification on parent name server(s) {addresses}."
msgstr "Die RRSIG des DS der übergeordneten Zone mit Key-Tag {keytag} verwendet den nicht unterstützten Algorithmus {algo_num} ({algo_mnemo}); die Verifizierung auf den Nameservern der übergeordneten Zone {addresses} wird übersprungen."

msgctxt "DNSSEC:DS21_DS_RRSIG_EXPIRED"
msgid "Parent DS RRSIG with keytag {keytag} has expired on parent name server(s) {addresses}."
msgstr "Die RRSIG des DS der übergeordneten Zone mit Key-Tag {keytag} ist auf den Nameservern der übergeordneten Zone {addresses} abgelaufen."

msgctxt "DNSSEC:DS21_DS_RRSIG_NOT_VALID_BY_DNSKEY"
msgid "Parent DS RRSIG with keytag {keytag} cannot be verified by any matching parent DNSKEY on parent name server(s) {addresses}."
msgstr "Die RRSIG des DS der übergeordneten Zone mit Key-Tag {keytag} kann durch keinen passenden DNSKEY der übergeordneten Zone auf den Nameservern der übergeordneten Zone {addresses} verifiziert werden."

msgctxt "DNSSEC:DS21_DS_RRSIG_NOT_VERIFIABLE"
msgid "Parent returned a signed DS RRset, but no covering RRSIG could be verified against the parent DNSKEY on parent name server(s) {addresses}. Validating resolvers will fail to resolve the child zone."
msgstr "Die übergeordnete Zone hat ein signiertes DS-RRset zurückgegeben, aber keine abdeckende RRSIG konnte gegen den DNSKEY der übergeordneten Zone auf den Nameservern der übergeordneten Zone {addresses} verifiziert werden. Validierende Resolver können die untergeordnete Zone nicht auflösen."

msgctxt "DNSSEC:DS21_DS_RRSIG_NOT_YET_VALID"
msgid "Parent DS RRSIG with keytag {keytag} has an inception time in the future on parent name server(s) {addresses}."
msgstr "Die RRSIG des DS der übergeordneten Zone mit Key-Tag {keytag} hat einen Inceptionszeitpunkt in der Zukunft auf den Nameservern der übergeordneten Zone {addresses}."

msgctxt "DNSSEC:DS21_DS_RRSIG_VERIFIED"
msgid "Parent DS RRset is correctly signed and verifies against the parent DNSKEY on parent name server(s) {addresses}."
msgstr "Das DS-RRset der übergeordneten Zone ist korrekt signiert und wird gegen den DNSKEY der übergeordneten Zone auf den Nameservern der übergeordneten Zone {addresses} verifiziert."

msgctxt "DNSSEC:DS21_NO_DNSKEY_FOR_DS_RRSIG"
msgid "Parent DS RRSIG references DNSKEY keytag {keytag}, but no matching DNSKEY is published at the parent apex on parent name server(s) {addresses}."
msgstr "Die RRSIG des DS der übergeordneten Zone verweist auf den DNSKEY-Key-Tag {keytag}, aber kein passender DNSKEY ist am Apex der übergeordneten Zone auf den Nameservern der übergeordneten Zone {addresses} veröffentlicht."

msgctxt "DNSSEC:DS21_NO_DS_RRSIG"
msgid "Parent returned the DS RRset without any covering RRSIG on parent name server(s) {addresses}."
msgstr "Die übergeordnete Zone hat das DS-RRset ohne eine abdeckende RRSIG auf den Nameservern der übergeordneten Zone {addresses} zurückgegeben."

msgctxt "DNSSEC:DS21_NO_PARENT_ZONE"
msgid "No parent zone is available; DNSSEC21 cannot run."
msgstr "Keine übergeordnete Zone verfügbar; DNSSEC21 kann nicht ausgeführt werden."

msgctxt "DNSSEC:DS21_PARENT_DNSKEY_MISSING"
msgid "Parent did not return an authoritative DNSKEY response, so DS RRSIG verification was skipped on parent name server(s) {addresses}."
msgstr "Die übergeordnete Zone hat keine autoritative DNSKEY-Antwort zurückgegeben, daher wurde die Verifizierung der DS-RRSIG auf den Nameservern der übergeordneten Zone {addresses} übersprungen."

msgctxt "NAMESERVER:NO_EDNS_SUPPORT"
msgid "Nameserver {ns}/{address} does not support EDNS0 (replies with FORMERR)."
msgstr "Der Nameserver {ns}/{address} unterstützt EDNS0 nicht (antwortet mit FORMERR)."

msgctxt "NAMESERVER:NO_RECURSOR"
msgid "The following nameservers are not recursors: {servers}."
msgstr "Die folgenden Nameserver sind keine rekursiven Resolver: {servers}."

msgctxt "NAMESERVER:NO_RESOLUTION"
msgid "No nameserver was successfully resolved to an IP address."
msgstr "Kein Nameserver konnte erfolgreich in eine IP-Adresse aufgelöst werden."

msgctxt "NAMESERVER:NO_RESPONSE"
msgid "No response from {ns} asking for {domain}."
msgstr "Keine Antwort von {ns} bei der Abfrage nach {domain}."

msgctxt "NAMESERVER:NO_UPWARD_REFERRAL"
msgid ""
"None of the following nameservers returns an upward referral : {servers}."
msgstr ""
"Keiner der folgenden Nameserver gibt eine Aufwärtsweitergabe zurück: "
"{servers}."

msgctxt "NAMESERVER:NS_ERROR"
msgid "Erroneous response from nameserver {ns}/{address}."
msgstr "Fehlerhafte Antwort vom Nameserver {ns}/{address}."

msgctxt "NAMESERVER:N10_EDNS_RESPONSE_ERROR"
msgid ""
"Expected RCODE but received erroneous response to an EDNS version 1 query. "
"Fetched from the nameservers with IP addresses {addresses}"
msgstr ""
"Erwarteter RCODE, aber fehlerhafte Antwort auf eine EDNS-Version-1-Abfrage "
"erhalten. Abgerufen von den Nameservern mit den IP-Adressen {addresses}."

msgctxt "NAMESERVER:N10_NO_RESPONSE_EDNS1_QUERY"
msgid ""
"No response to an EDNS version 1 query. Fetched from the nameservers with IP "
"addresses {addresses}"
msgstr ""
"Keine Antwort auf eine EDNS-Version-1-Abfrage. Abgerufen von den Nameservern "
"mit den IP-Adressen {addresses}."

msgctxt "NAMESERVER:N10_UNEXPECTED_RCODE"
msgid ""
"Erroneous RCODE (\"{rcode}\") in response to an EDNS version 1 query. "
"Fetched from the nameservers with IP addresses {addresses}"
msgstr ""
"Fehlerhafter RCODE (\"{rcode}\") in der Antwort auf eine "
"EDNS-Version-1-Abfrage. Abgerufen von den Nameservern mit den IP-Adressen "
"{addresses}."

msgctxt "NAMESERVER:N11_NO_EDNS"
msgid ""
"The DNS response, on query with unknown EDNS option-code, does not contain "
"any EDNS from name servers \"{addresses}\"."
msgstr ""
"Die DNS-Antwort auf eine Abfrage mit unbekanntem EDNS-Options-Code enthält "
"kein EDNS von den Nameservern \"{addresses}\"."

msgctxt "NAMESERVER:N11_NO_RESPONSE"
msgid ""
"There is no response on query with unknown EDNS option-code from name "
"servers \"{addresses}\"."
msgstr ""
"Es gibt keine Antwort auf eine Abfrage mit unbekanntem EDNS-Options-Code "
"von den Nameservern \"{addresses}\"."

msgctxt "NAMESERVER:N11_RETURNS_UNKNOWN_OPTION_CODE"
msgid ""
"The DNS response contains an unknown EDNS option-code. Returned from name "
"servers \"{addresses}\"."
msgstr ""
"Die DNS-Antwort enthält einen unbekannten EDNS-Options-Code. Zurückgegeben "
"von den Nameservern \"{addresses}\"."

msgctxt "NAMESERVER:N11_UNEXPECTED_ANSWER_SECTION"
msgid ""
"The DNS response, on query with unknown EDNS option-code, does not contain "
"the expected SOA record in the answer section from name servers "
"\"{addresses}\"."
msgstr ""
"Die DNS-Antwort auf eine Abfrage mit unbekanntem EDNS-Option-Code enthält "
"nicht den erwarteten SOA-Record im Antwortabschnitt der Nameserver "
"\"{addresses}\"."

msgctxt "NAMESERVER:N11_UNEXPECTED_RCODE"
msgid ""
"The DNS response, on query with unknown EDNS option-code, has unexpected "
"RCODE name \"{rcode}\" from name servers \"{addresses}\"."
msgstr ""
"Die DNS-Antwort auf eine Abfrage mit unbekanntem EDNS-Option-Code enthält "
"den unerwarteten RCODE \"{rcode}\" von den Nameservern \"{addresses}\"."

msgctxt "NAMESERVER:N11_UNSET_AA"
msgid ""
"The DNS response, on query with unknown EDNS option-code, is unexpectedly "
"not authoritative from name servers \"{addresses}\"."
msgstr ""
"Die DNS-Antwort auf eine Abfrage mit unbekanntem EDNS-Option-Code ist "
"unerwartet nicht autoritativ von den Nameservern \"{addresses}\"."

msgctxt "NAMESERVER:N15_ERROR_ON_VERSION_QUERY"
msgid ""
"The following name server(s) do not respond or respond with SERVFAIL to "
"software version query \"{query_name}\". Returned from name servers: "
"\"{servers}\""
msgstr ""
"Die folgenden Nameserver antworten nicht oder antworten mit SERVFAIL auf "
"die Versionsabfrage \"{query_name}\". Nameserver: \"{servers}\"."

msgctxt "NAMESERVER:N15_NO_VERSION_REVEALED"
msgid ""
"The following name server(s) do not reveal the software version. Returned "
"from name servers \"{servers}\""
msgstr ""
"Die folgenden Nameserver geben die Softwareversion nicht preis. "
"Nameserver: \"{servers}\"."

msgctxt "NAMESERVER:N15_SOFTWARE_VERSION"
msgid ""
"The following name server(s) respond to software version query "
"\"{query_name}\" with string \"{string}\". Returned from name servers: "
"\"{servers}\""
msgstr ""
"Die folgenden Nameserver antworten auf die Versionsabfrage \"{query_name}\" "
"mit dem String \"{string}\". Nameserver: \"{servers}\"."

msgctxt "NAMESERVER:N15_WRONG_CLASS"
msgid ""
"The following name server(s) do not return CH class record(s) on CH class "
"query. Returned from name servers \"{servers}\""
msgstr ""
"Die folgenden Nameserver geben bei einer CH-Klassen-Abfrage keine "
"CH-Klassen-Records zurück. Nameserver: \"{servers}\"."

msgctxt "NAMESERVER:N16_HAS_NSID"
msgid ""
"The following name server(s) responded to an NSID query (RFC 5001) with "
"NSID value \"{nsid}\". Returned from name servers \"{servers}\""
msgstr ""
"Die folgenden Nameserver haben auf eine NSID-Abfrage (RFC 5001) mit dem "
"NSID-Wert \"{nsid}\" geantwortet. Nameserver: \"{servers}\"."

msgctxt "NAMESERVER:N16_NO_NSID_REVEALED"
msgid ""
"The following name server(s) did not include an NSID option in response to "
"an NSID query (RFC 5001). Returned from name servers \"{servers}\""
msgstr ""
"Die folgenden Nameserver haben bei einer NSID-Abfrage (RFC 5001) keine "
"NSID-Option in die Antwort aufgenommen. Nameserver: \"{servers}\"."

msgctxt "NAMESERVER:N16_NO_RESPONSE"
msgid ""
"The following name server(s) did not respond to an NSID query (RFC 5001). "
"Returned from name servers \"{servers}\""
msgstr ""
"Die folgenden Nameserver haben auf eine NSID-Abfrage (RFC 5001) nicht "
"geantwortet. Nameserver: \"{servers}\"."

msgctxt "NAMESERVER:N16_UNEXPECTED_RCODE"
msgid ""
"The following name server(s) returned an unexpected RCODE \"{rcode}\" in "
"response to an NSID query (RFC 5001). Returned from name servers: "
"\"{servers}\""
msgstr ""
"Die folgenden Nameserver haben bei einer NSID-Abfrage (RFC 5001) den "
"unerwarteten RCODE \"{rcode}\" zurückgegeben. Nameserver: \"{servers}\"."

msgctxt "NAMESERVER:QNAME_CASE_INSENSITIVE"
msgid "The following nameservers do not preserve original case of the queried name ({domain}): {servers}."
msgstr "Die folgenden Nameserver bewahren die ursprüngliche Groß-/Kleinschreibung des abgefragten Namens ({domain}) nicht: {servers}."

msgctxt "NAMESERVER:QNAME_CASE_SENSITIVE"
msgid "The following nameservers preserve original case of queried names ({domain}): {servers}."
msgstr "Die folgenden Nameserver bewahren die ursprüngliche Groß-/Kleinschreibung des abgefragten Namens ({domain}): {servers}."

msgctxt "NAMESERVER:SAME_SOURCE_IP"
msgid "All nameservers reply with same IP used to query them."
msgstr "Alle Nameserver antworten mit derselben IP-Adresse, an die die Abfrage gerichtet wurde."

msgctxt "NAMESERVER:UPWARD_REFERRAL"
msgid "The following nameservers return an upward referral: {servers}."
msgstr "Die folgenden Nameserver senden ein Referral zur übergeordneten Zone: {servers}."

msgctxt "NAMESERVER:UPWARD_REFERRAL_IRRELEVANT"
msgid "Upward referral tests skipped for root zone."
msgstr "Referral-Tests zur übergeordneten Zone werden für die Root-Zone übersprungen."

msgctxt "NAMESERVER:Z_FLAGS_NOTCLEAR"
msgid "Nameserver {ns}/{address} has one or more unknown EDNS Z flag bits set."
msgstr "Nameserver {ns}/{address} hat ein oder mehrere unbekannte EDNS-Z-Flag-Bits gesetzt."

msgctxt "SYNTAX:DISCOURAGED_DOUBLE_DASH"
msgid ""
"Domain name ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Der Domainname ({domain}) hat ein Label ({label}) mit einem Doppelbindestrich "
"('--') an Position 3 und 4 (mit einem anderen Präfix als 'xn--')."

msgctxt "SYNTAX:INITIAL_HYPHEN"
msgid ""
"Domain name ({domain}) has a label ({label}) starting with an hyphen ('-')."
msgstr ""
"Der Domainname ({domain}) hat ein Label ({label}), das mit einem "
"Bindestrich ('-') beginnt."

msgctxt "SYNTAX:MNAME_DISCOURAGED_DOUBLE_DASH"
msgid ""
"SOA MNAME ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"SOA MNAME ({domain}) hat ein Label ({label}) mit einem Doppelbindestrich "
"('--') an Position 3 und 4 (mit einem anderen Präfix als 'xn--')."

msgctxt "SYNTAX:MNAME_NON_ALLOWED_CHARS"
msgid "Found illegal characters in SOA MNAME ({domain})."
msgstr "Im SOA MNAME ({domain}) wurden unzulässige Zeichen gefunden."

msgctxt "SYNTAX:MNAME_NUMERIC_TLD"
msgid "SOA MNAME ({domain}) within a 'numeric only' TLD ({tld})."
msgstr "SOA MNAME ({domain}) befindet sich unter einer ausschließlich numerischen TLD ({tld})."

msgctxt "SYNTAX:MNAME_SYNTAX_OK"
msgid "SOA MNAME ({domain}) syntax is valid."
msgstr "SOA MNAME ({domain}) hat eine gültige Syntax."

msgctxt "SYNTAX:MX_DISCOURAGED_DOUBLE_DASH"
msgid ""
"Domain name MX ({domain}) has a label ({label}) with a double hyphen ('--') "
"in position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Der MX-Domainname ({domain}) hat ein Label ({label}) mit einem "
"Doppelbindestrich ('--') an Position 3 und 4 (mit einem anderen Präfix als 'xn--')."

msgctxt "SYNTAX:MX_NON_ALLOWED_CHARS"
msgid "Found illegal characters in MX ({domain})."
msgstr "Im MX ({domain}) wurden unzulässige Zeichen gefunden."

msgctxt "SYNTAX:MX_NUMERIC_TLD"
msgid "Domain name MX ({domain}) within a 'numeric only' TLD ({tld})."
msgstr "Der MX-Domainname ({domain}) befindet sich unter einer ausschließlich numerischen TLD ({tld})."

msgctxt "SYNTAX:MX_SYNTAX_OK"
msgid "Domain name MX ({domain}) syntax is valid."
msgstr "Der MX-Domainname ({domain}) hat eine gültige Syntax."

msgctxt "SYNTAX:NAMESERVER_DISCOURAGED_DOUBLE_DASH"
msgid ""
"Nameserver ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Der Nameserver ({domain}) hat ein Label ({label}) mit einem "
"Doppelbindestrich ('--') an Position 3 und 4 (mit einem anderen Präfix als 'xn--')."

msgctxt "SYNTAX:NAMESERVER_NON_ALLOWED_CHARS"
msgid "Found illegal characters in the nameserver ({domain})."
msgstr "Im Nameserver-Namen ({domain}) wurden unzulässige Zeichen gefunden."

msgctxt "SYNTAX:NAMESERVER_NUMERIC_TLD"
msgid "Nameserver ({domain}) within a 'numeric only' TLD ({tld})."
msgstr "Der Nameserver ({domain}) befindet sich unter einer ausschließlich numerischen TLD ({tld})."

msgctxt "SYNTAX:NAMESERVER_SYNTAX_OK"
msgid "The following nameservers have valid syntax: {servers}."
msgstr "Die folgenden Nameserver haben eine gültige Syntax: {servers}."

msgctxt "SYNTAX:NON_ALLOWED_CHARS"
msgid "Found illegal characters in the domain name ({domain})."
msgstr "Im Domainnamen ({domain}) wurden unzulässige Zeichen gefunden."

msgctxt "SYNTAX:NO_DOUBLE_DASH"
msgid ""
"Domain name ({domain}) has no label with a double hyphen ('--') in position "
"3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Der Domainname ({domain}) hat kein Label mit einem Doppelbindestrich ('--') "
"an Position 3 und 4 ohne das Präfix 'xn--'."

msgctxt "SYNTAX:NO_ENDING_HYPHENS"
msgid "Neither end of any label in the domain name ({domain}) has a hyphen."
msgstr "Kein Label im Domainnamen ({domain}) beginnt oder endet mit einem Bindestrich."

msgctxt "SYNTAX:NO_RESPONSE_MX_QUERY"
msgid "No response from nameserver(s) on MX queries."
msgstr "Keine Antwort von den Nameservern auf MX-Abfragen."

msgctxt "ZONE:NO_RESPONSE_MX_QUERY"
msgid "No response from nameserver(s) on MX queries."
msgstr "Keine Antwort von den Nameservern auf MX-Abfragen."

msgctxt "SYNTAX:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver(s) on SOA queries."
msgstr "Keine Antwort von den Nameservern auf SOA-Abfragen."

msgctxt "ZONE:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver(s) on SOA queries."
msgstr "Keine Antwort von den Nameservern auf SOA-Abfragen."

msgctxt "SYNTAX:ONLY_ALLOWED_CHARS"
msgid "No illegal characters in the domain name ({domain})."
msgstr "Im Domainnamen ({domain}) sind keine unzulässigen Zeichen vorhanden."

msgctxt "SYNTAX:RNAME_MAIL_DOMAIN_INVALID"
msgid ""
"The SOA RNAME mail domain ({domain}) cannot be resolved to a mail server "
"with an IP address."
msgstr ""
"Die SOA-RNAME-Maildomain ({domain}) kann nicht zu einem Mailserver mit "
"einer IP-Adresse aufgelöst werden."

msgctxt "SYNTAX:RNAME_MAIL_DOMAIN_LOCALHOST"
msgid ""
"The SOA RNAME mail domain ({domain}) resolved to a mail server with "
"localhost ({localhost}) IP address."
msgstr ""
"Die SOA-RNAME-Maildomain ({domain}) wurde zu einem Mailserver mit einer "
"Localhost-IP-Adresse ({localhost}) aufgelöst."

msgctxt "SYNTAX:RNAME_MAIL_ILLEGAL_CNAME"
msgid ""
"The SOA RNAME mail domain ({domain}) refers to an address which is an alias "
"(CNAME)."
msgstr ""
"Die SOA-RNAME-Maildomain ({domain}) verweist auf eine Adresse, die ein "
"Alias (CNAME) ist."

msgctxt "SYNTAX:RNAME_MISUSED_AT_SIGN"
msgid "Misused '@' character found in SOA RNAME field ({rname})."
msgstr "Im SOA-RNAME-Feld ({rname}) wurde ein fehlerhaft verwendetes '@'-Zeichen gefunden."

msgctxt "SYNTAX:RNAME_NO_AT_SIGN"
msgid "There is no misused '@' character in the SOA RNAME field ({rname})."
msgstr "Im SOA-RNAME-Feld ({rname}) ist kein fehlerhaft verwendetes '@'-Zeichen vorhanden."

msgctxt "SYNTAX:RNAME_RFC822_INVALID"
msgid "Illegal character(s) found in SOA RNAME field ({rname})."
msgstr "Im SOA-RNAME-Feld ({rname}) wurden unzulässige Zeichen gefunden."

msgctxt "SYNTAX:RNAME_RFC822_VALID"
msgid "The SOA RNAME field ({rname}) is compliant with RFC2822."
msgstr "Das SOA-RNAME-Feld ({rname}) entspricht RFC2822."

msgctxt "SYNTAX:TERMINAL_HYPHEN"
msgid ""
"Domain name ({domain}) has a label ({label}) ending with a hyphen ('-')."
msgstr ""
"Der Domainname ({domain}) hat ein Label ({label}), das mit einem "
"Bindestrich ('-') endet."

msgctxt "ZONE:RETRY_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'retry' value ({retry}) is less than the recommended one "
"({required_retry})."
msgstr ""
"Der SOA-'retry'-Wert ({retry}) liegt unter dem empfohlenen Wert "
"({required_retry})."

msgctxt "ZONE:RETRY_MINIMUM_VALUE_OK"
msgid ""
"SOA 'retry' value ({retry}) is at least equal to the minimum recommended "
"value ({required_retry})."
msgstr ""
"Der SOA-'retry'-Wert ({retry}) erreicht mindestens den empfohlenen "
"Mindestwert ({required_retry})."

msgctxt "ZONE:MNAME_IS_CNAME"
msgid "SOA 'mname' value ({mname}) refers to a NS which is an alias (CNAME)."
msgstr "Der SOA-'mname'-Wert ({mname}) verweist auf einen Nameserver, der ein Alias (CNAME) ist."

msgctxt "ZONE:MNAME_IS_NOT_CNAME"
msgid ""
"SOA 'mname' value ({mname}) refers to a NS which is not an alias (CNAME)."
msgstr "Der SOA-'mname'-Wert ({mname}) verweist auf einen Nameserver, der kein Alias (CNAME) ist."

msgctxt "ZONE:REFRESH_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'refresh' value ({refresh}) is less than the recommended one "
"({required_refresh})."
msgstr ""
"Der SOA-'refresh'-Wert ({refresh}) liegt unter dem empfohlenen Wert "
"({required_refresh})."

msgctxt "ZONE:REFRESH_MINIMUM_VALUE_OK"
msgid ""
"SOA 'refresh' value ({refresh}) is at least equal to the minimum recommended "
"value ({required_refresh})."
msgstr ""
"Der SOA-'refresh'-Wert ({refresh}) erreicht mindestens den empfohlenen "
"Mindestwert ({required_refresh})."

msgctxt "ZONE:EXPIRE_LOWER_THAN_REFRESH"
msgid ""
"SOA 'expire' value ({expire}) is lower than the SOA 'refresh' value "
"({refresh})."
msgstr ""
"Der SOA-'expire'-Wert ({expire}) ist niedriger als der SOA-'refresh'-Wert "
"({refresh})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_HIGHER"
msgid ""
"SOA 'minimum' value ({minimum}) is higher than the recommended one "
"({highest_minimum})."
msgstr ""
"Der SOA-'minimum'-Wert ({minimum}) liegt über dem empfohlenen Wert "
"({highest_minimum})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_LOWER"
msgid ""
"SOA 'minimum' value ({minimum}) is less than the recommended one "
"({lowest_minimum})."
msgstr ""
"Der SOA-'minimum'-Wert ({minimum}) liegt unter dem empfohlenen Wert "
"({lowest_minimum})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_OK"
msgid ""
"SOA 'minimum' value ({minimum}) is between the recommended ones "
"({lowest_minimum}/{highest_minimum})."
msgstr ""
"Der SOA-'minimum'-Wert ({minimum}) liegt im empfohlenen Bereich "
"({lowest_minimum}/{highest_minimum})."

msgctxt "ZONE:EXPIRE_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'expire' value ({expire}) is less than the recommended one "
"({required_expire})."
msgstr ""
"Der SOA-'expire'-Wert ({expire}) liegt unter dem empfohlenen Wert "
"({required_expire})."

msgctxt "ZONE:REFRESH_LOWER_THAN_RETRY"
msgid ""
"SOA 'refresh' value ({refresh}) is lower than the SOA 'retry' value "
"({retry})."
msgstr ""
"Der SOA-'refresh'-Wert ({refresh}) ist niedriger als der SOA-'retry'-Wert "
"({retry})."

msgctxt "ZONE:REFRESH_HIGHER_THAN_RETRY"
msgid ""
"SOA 'refresh' value ({refresh}) is higher than the SOA 'retry' value "
"({retry})."
msgstr ""
"Der SOA-'refresh'-Wert ({refresh}) ist höher als der SOA-'retry'-Wert "
"({retry})."

msgctxt "ZONE:MX_RECORD_IS_CNAME"
msgid "MX record for the domain is pointing to a CNAME."
msgstr "Der MX-Record der Domain verweist auf ein CNAME."

msgctxt "ZONE:MX_RECORD_IS_NOT_CNAME"
msgid "MX record for the domain is not pointing to a CNAME."
msgstr "Der MX-Record der Domain verweist nicht auf ein CNAME."

msgctxt "ZONE:MULTIPLE_SOA"
msgid ""
"Nameserver {ns}/{address} responds with multiple ({count}) SOA records on SOA queries."
msgstr ""
"Nameserver {ns}/{address} antwortet auf SOA-Abfragen mit mehreren ({count}) SOA-Records."

msgctxt "ZONE:NO_SOA_IN_RESPONSE"
msgid ""
"Response from nameserver {ns}/{address} on SOA queries does not contain SOA record."
msgstr ""
"Die Antwort von Nameserver {ns}/{address} auf SOA-Abfragen enthält keinen SOA-Record."

msgctxt "ZONE:MNAME_HAS_NO_ADDRESS"
msgid "No IP address found for SOA 'mname' nameserver ({mname})."
msgstr "Für den SOA-'mname'-Nameserver ({mname}) wurde keine IP-Adresse gefunden."

msgctxt "ZONE:ONE_SOA"
msgid "A unique SOA record is returned by all nameservers of the zone."
msgstr "Alle Nameserver der Zone liefern denselben SOA-Record."

msgctxt "ZONE:EXPIRE_MINIMUM_VALUE_OK"
msgid ""
"SOA 'expire' value ({expire}) is higher than the minimum recommended value "
"({required_expire}) and not lower than the 'refresh' value ({refresh})."
msgstr ""
"Der SOA-'expire'-Wert ({expire}) liegt mindestens beim empfohlenen "
"Mindestwert ({required_expire}) und nicht unter dem 'refresh'-Wert ({refresh})."

msgctxt "ZONE:WRONG_SOA"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({owner} instead of {query_name}) "
"on SOA queries."
msgstr ""
"Nameserver {ns}/{address} antwortet auf SOA-Abfragen mit einem falschen "
"Owner-Namen ({owner} statt {query_name})."

msgctxt "ZONE:Z01_MNAME_HAS_LOCALHOST_ADDR"
msgid ""
"SOA MNAME name server \"{ns}\" resolves to a localhost IP address "
"({address})."
msgstr ""
"Der SOA-MNAME-Nameserver \"{ns}\" wird zu einer Localhost-IP-Adresse "
"({address}) aufgelöst."

msgctxt "ZONE:Z01_MNAME_IS_DOT"
msgid ""
"SOA MNAME is specified as \".\" which usually means \"no server\". Fetched "
"from name servers \"{addresses}\"."
msgstr ""
"SOA MNAME ist als \".\" angegeben, was normalerweise \"kein Server\" "
"bedeutet. Abgerufen von den Nameservern \"{addresses}\"."

msgctxt "ZONE:Z01_MNAME_IS_LOCALHOST"
msgid ""
"SOA MNAME name server is \"localhost\", which is invalid. Fetched from name "
"servers \"{addresses}\"."
msgstr ""
"Der SOA-MNAME-Nameserver lautet \"localhost\", was ungültig ist. "
"Abgerufen von den Nameservern \"{addresses}\"."

msgctxt "ZONE:Z01_MNAME_IS_MASTER"
msgid "SOA MNAME name server(s) \"{servers}\" appears to be master."
msgstr "Die SOA-MNAME-Nameserver \"{servers}\" erscheinen als Master."

msgctxt "ZONE:Z01_MNAME_MISSING_SOA_RECORD"
msgid ""
"SOA MNAME name server \"{ns}/{address}\" responds to an SOA query with no SOA records "
"in the answer section."
msgstr ""
"Der SOA-MNAME-Nameserver \"{ns}/{address}\" antwortet auf eine SOA-Abfrage "
"ohne SOA-Records im Antwortabschnitt."

msgctxt "ZONE:Z01_MNAME_NO_RESPONSE"
msgid "SOA MNAME name server \"{ns}/{address}\" does not respond to an SOA query."
msgstr "Der SOA-MNAME-Nameserver \"{ns}/{address}\" antwortet nicht auf eine SOA-Abfrage."

msgctxt "ZONE:Z01_MNAME_NOT_AUTHORITATIVE"
msgid "SOA MNAME name server \"{ns}/{address}\" is not authoritative for the zone."
msgstr "Der SOA-MNAME-Nameserver \"{ns}/{address}\" ist nicht autoritativ für die Zone."

msgctxt "ZONE:Z01_MNAME_NOT_IN_NS_LIST"
msgid ""
"SOA MNAME name server \"{ns}\" is not listed as NS record for the zone."
msgstr ""
"Der SOA-MNAME-Nameserver \"{ns}\" ist nicht als NS-Record für die Zone eingetragen."

msgctxt "ZONE:Z01_MNAME_NOT_MASTER"
msgid ""
"SOA MNAME name server(s) \"{servers}\" do not have the highest SOA SERIAL "
"(expected \"{soaserial}\" but got \"{soaserial_list}\")"
msgstr ""
"Die SOA-MNAME-Nameserver \"{servers}\" haben nicht die höchste "
"SOA-Seriennummer (erwartet \"{soaserial}\", erhalten \"{soaserial_list}\")."

msgctxt "ZONE:Z01_MNAME_NOT_RESOLVE"
msgid ""
"SOA MNAME name server \"{ns}\" cannot be resolved into an IP address."
msgstr ""
"Der SOA-MNAME-Nameserver \"{ns}\" kann nicht zu einer IP-Adresse aufgelöst werden."

msgctxt "ZONE:Z01_MNAME_UNEXPECTED_RCODE"
msgid ""
"SOA MNAME name server \"{ns}/{address}\" gives unexpected RCODE name (\"{rcode}\") in "
"response to an SOA query."
msgstr ""
"Der SOA-MNAME-Nameserver \"{ns}/{address}\" antwortet auf eine SOA-Abfrage "
"mit dem unerwarteten RCODE \"{rcode}\"."

msgctxt "ZONE:Z09_INCONSISTENT_MX"
msgid "Some name servers return an MX RRset while others return none."
msgstr "Einige Nameserver geben ein MX-RRset zurück, während andere keines zurückgeben."

msgctxt "ZONE:Z09_INCONSISTENT_MX_DATA"
msgid "The MX RRset data is inconsistent between the name servers."
msgstr "Die MX-RRset-Daten sind zwischen den Nameservern inkonsistent."

msgctxt "ZONE:Z09_MISSING_MAIL_TARGET"
msgid "The child zone has no mail target (no MX)."
msgstr "Die untergeordnete Zone hat kein Mailziel (kein MX)."

msgctxt "ZONE:Z09_MX_DATA"
msgid ""
"Mail targets in the MX RRset \"{mail_targets}\" returned from name "
"servers \"{addresses}\"."
msgstr ""
"Mailziele im MX-RRset \"{mail_targets}\", zurückgegeben von den "
"Nameservern \"{addresses}\"."

msgctxt "ZONE:Z09_MX_FOUND"
msgid "MX RRset was returned by name servers \"{addresses}\"."
msgstr "Ein MX-RRset wurde von den Nameservern \"{addresses}\" zurückgegeben."

msgctxt "ZONE:Z09_NON_AUTH_MX_RESPONSE"
msgid ""
"Non-authoritative response on MX query from name servers \"{addresses}\"."
msgstr ""
"Nicht-autoritative Antwort auf eine MX-Abfrage von den Nameservern \"{addresses}\"."

msgctxt "ZONE:Z09_NO_MX_FOUND"
msgid "No MX RRset was returned by name servers \"{addresses}\"."
msgstr "Von den Nameservern \"{addresses}\" wurde kein MX-RRset zurückgegeben."

msgctxt "ZONE:Z09_NO_RESPONSE_MX_QUERY"
msgid "No response on MX query from name servers \"{addresses}\"."
msgstr "Keine Antwort auf eine MX-Abfrage von den Nameservern \"{addresses}\"."

msgctxt "ZONE:Z09_NULL_MX_NON_ZERO_PREF"
msgid "The zone has a Null MX with non-zero preference."
msgstr "Die Zone hat einen Null-MX-Record mit einem Präferenzwert ungleich null."

msgctxt "ZONE:Z09_NULL_MX_WITH_OTHER_MX"
msgid "The zone has a Null MX mixed with other MX records."
msgstr "Die Zone hat einen Null-MX-Record zusammen mit anderen MX-Records."

msgctxt "ZONE:Z09_ROOT_EMAIL_DOMAIN"
msgid "Root zone with an unexpected MX RRset (non-Null MX)."
msgstr "Root-Zone mit einem unerwarteten MX-RRset (Nicht-Null-MX)."

msgctxt "ZONE:Z09_TLD_EMAIL_DOMAIN"
msgid "The zone is a TLD and has an unexpected MX RRset (non-Null MX)."
msgstr "Die Zone ist eine TLD und hat ein unerwartetes MX-RRset (Nicht-Null-MX)."

msgctxt "ZONE:Z09_UNEXPECTED_RCODE_MX"
msgid ""
"Unexpected RCODE value ({rcode}) on the MX query from name servers "
"\"{addresses}\"."
msgstr ""
"Unerwarteter RCODE-Wert ({rcode}) bei der MX-Abfrage von den Nameservern "
"\"{addresses}\"."

msgctxt "ZONE:Z11_INCONSISTENT_SPF_POLICIES"
msgid ""
"One or more name servers do not publish the same SPF policy as the others."
msgstr ""
"Ein oder mehrere Nameserver veröffentlichen nicht dieselbe SPF-Policy wie die anderen."

msgctxt "ZONE:Z11_DIFFERENT_SPF_POLICIES_FOUND"
msgid ""
"The following name servers returned the same SPF policy, but other name "
"servers returned a different policy. Name servers: {addresses}."
msgstr ""
"Die folgenden Nameserver gaben dieselbe SPF-Policy zurück, aber andere "
"Nameserver gaben eine abweichende Policy zurück. Nameserver: {addresses}."

msgctxt "ZONE:Z11_NO_SPF_FOUND"
msgid "No SPF policy was found for {domain}."
msgstr "Für {domain} wurde keine SPF-Policy gefunden."

msgctxt "ZONE:Z11_UNABLE_TO_CHECK_FOR_SPF"
msgid ""
"None of the zone's name servers responded with an authoritative response to "
"queries for SPF policies."
msgstr ""
"Keiner der Nameserver der Zone hat auf Abfragen zu SPF-Policies autoritativ geantwortet."

msgctxt "ZONE:Z12_CSYNC_FOUND"
msgid "CSYNC record found at zone apex on the following nameservers with SOA serial {serial}, flags {flags}, and type bitmap {type_bitmap}: {servers}."
msgstr "Ein CSYNC-Record wurde am Zone-Apex auf den folgenden Nameservern gefunden, mit SOA-Seriennummer {serial}, Flags {flags} und Typ-Bitmap {type_bitmap}: {servers}."

msgctxt "ZONE:Z12_INCONSISTENT_CSYNC"
msgid "CSYNC record content differs across authoritative name servers."
msgstr "Der Inhalt des CSYNC-Records unterscheidet sich zwischen den autoritativen Nameservern."

msgctxt "ZONE:Z12_MIXED_PRESENCE"
msgid "CSYNC record is present on some name servers but absent on others."
msgstr "Ein CSYNC-Record ist bei einigen Nameservern vorhanden, aber bei anderen nicht."

msgctxt "ZONE:Z12_MULTIPLE_CSYNC"
msgid "{count} CSYNC records found at zone apex on name server {ns}/{address}."
msgstr "{count} CSYNC-Records am Zone-Apex auf Nameserver {ns}/{address} gefunden."

msgctxt "ZONE:Z12_NO_CSYNC"
msgid "No CSYNC record found at zone apex on name servers: {servers}."
msgstr "Kein CSYNC-Record am Zone-Apex auf den Nameservern gefunden: {servers}."

msgctxt "ZONE:Z12_SERIAL_MISMATCH"
msgid ""
"CSYNC SOA serial {csync_serial} fails RFC 7477 serial precondition against current "
"SOA serial "
"{soa_serial} on name server {ns}."
msgstr ""
"CSYNC-SOA-Seriennummer {csync_serial} erfüllt die Seriennummer-Vorbedingung "
"gemäß RFC 7477 nicht gegenüber der aktuellen SOA-Seriennummer {soa_serial} "
"auf Nameserver {ns}."

msgctxt "ZONE:Z13_NO_SPF_FOUND"
msgid "No SPF record found for {domain}; skipping DNS lookup count check."
msgstr "Kein SPF-Record für {domain} gefunden; Prüfung der DNS-Auflösungsanzahl wird übersprungen."

msgctxt "ZONE:Z13_SPF_LOOKUP_COUNT_EXCEEDED"
msgid ""
"The SPF policy for {domain} requires {count} DNS lookups, exceeding the "
"configured limit of {limit} (RFC 7208 Section 4.6.4)."
msgstr ""
"Die SPF-Policy für {domain} erfordert {count} DNS-Auflösungen, was das "
"konfigurierte Limit von {limit} überschreitet (RFC 7208, Abschnitt 4.6.4)."

msgctxt "ZONE:Z13_SPF_LOOKUP_COUNT_OK"
msgid ""
"The SPF policy for {domain} requires {count} DNS lookups, within the "
"allowed limit."
msgstr ""
"Die SPF-Policy für {domain} erfordert {count} DNS-Auflösungen, innerhalb "
"des zulässigen Limits."

msgctxt "ZONE:Z13_SPF_LOOKUP_LOOP"
msgid ""
"The SPF policy for {domain} contains a recursive loop: {loop_domain} was "
"visited more than once during include/redirect resolution."
msgstr ""
"Die SPF-Policy für {domain} enthält eine rekursive Schleife: {loop_domain} "
"wurde bei der include/redirect-Auflösung mehr als einmal besucht."

msgctxt "ZONE:Z13_SPF_MACRO_TARGET"
msgid ""
"The SPF policy for {domain} references {target} via include or redirect, "
"but the target contains SPF macros that can only be expanded at SMTP time "
"(RFC 7208 Section 7); its DNS lookup count is not audited."
msgstr ""
"Die SPF-Policy für {domain} referenziert {target} über include oder "
"redirect, aber das Ziel enthält SPF-Makros, die nur zur SMTP-Zeit expandiert "
"werden können (RFC 7208, Abschnitt 7); die Anzahl der DNS-Auflösungen für "
"diesen Zweig wird nicht geprüft."

msgctxt "ZONE:Z13_SPF_PTR_DEPRECATED"
msgid ""
"The SPF policy for {domain} uses the deprecated ptr mechanism "
"(RFC 7208 Section 5.5)."
msgstr ""
"Die SPF-Policy für {domain} verwendet den veralteten ptr-Mechanismus "
"(RFC 7208, Abschnitt 5.5)."

msgctxt "ZONE:Z13_SPF_RECURSIVE_ERROR"
msgid ""
"The SPF policy for {domain} references {target} via include or redirect, "
"but that target could not be resolved."
msgstr ""
"Die SPF-Policy für {domain} referenziert {target} über include oder "
"redirect, aber das Ziel konnte nicht aufgelöst werden."

msgctxt "ZONE:Z13_UNABLE_TO_CHECK"
msgid ""
"None of the zone's name servers responded with an authoritative response to "
"queries for SPF policies; unable to check DNS lookup count."
msgstr ""
"Keiner der Nameserver der Zone hat auf Abfragen zu SPF-Policies autoritativ "
"geantwortet; die Anzahl der DNS-Auflösungen kann nicht geprüft werden."

msgctxt "ZONE:Z14_DUPLICATE_SCHEME_HASH"
msgid ""
"ZONEMD records at zone apex on name server {ns} contain duplicate "
"(Scheme, Hash) pair: scheme {scheme}, hash {hash}."
msgstr ""
"ZONEMD-Records am Zone-Apex auf Nameserver {ns} enthalten ein doppeltes "
"(Schema, Hash)-Paar: Schema {scheme}, Hash {hash}."

msgctxt "ZONE:Z14_INCONSISTENT_ZONEMD"
msgid "ZONEMD record content differs across authoritative name servers."
msgstr "Der Inhalt des ZONEMD-Records unterscheidet sich zwischen den autoritativen Nameservern."

msgctxt "ZONE:Z14_MIXED_PRESENCE"
msgid "ZONEMD record is present on some name servers but absent on others."
msgstr "Ein ZONEMD-Record ist bei einigen Nameservern vorhanden, aber bei anderen nicht."

msgctxt "ZONE:Z14_NO_ZONEMD"
msgid "No ZONEMD record found at zone apex on name servers: {servers}."
msgstr "Kein ZONEMD-Record am Zone-Apex auf den Nameservern gefunden: {servers}."

msgctxt "ZONE:Z14_SERIAL_MISMATCH"
msgid ""
"ZONEMD serial {zonemd_serial} does not match current SOA serial "
"{soa_serial} on name server {ns}."
msgstr ""
"ZONEMD-Seriennummer {zonemd_serial} stimmt nicht mit der aktuellen "
"SOA-Seriennummer {soa_serial} auf Nameserver {ns} überein."

msgctxt "ZONE:Z14_UNSUPPORTED_HASH"
msgid ""
"ZONEMD record on name server {ns} uses hash algorithm {hash}, which is "
"outside the IANA-assigned set verifiable by standard tooling (1 = SHA-384, "
"2 = SHA-512)."
msgstr ""
"Der ZONEMD-Record auf Nameserver {ns} verwendet den Hash-Algorithmus {hash}, "
"der außerhalb der von der IANA zugewiesenen und mit Standardwerkzeugen "
"prüfbaren Menge liegt (1 = SHA-384, 2 = SHA-512)."

msgctxt "ZONE:Z14_ZONEMD_FOUND"
msgid ""
"ZONEMD record found at zone apex: serial {serial}, scheme {scheme}, "
"hash algorithm {hash}, digest {digest}. Name servers: {servers}."
msgstr ""
"Ein ZONEMD-Record wurde am Zone-Apex gefunden: Seriennummer {serial}, "
"Schema {scheme}, Hash-Algorithmus {hash}, Digest {digest}. Nameserver: {servers}."

msgctxt "SYSTEM:CANNOT_CONTINUE"
msgid "Not enough data about {domain} was found to be able to run tests."
msgstr "Es wurden nicht genügend Daten über {domain} gefunden, um Tests durchführen zu können."

msgctxt "SYSTEM:DEPENDENCY_VERSION"
msgid "Using prerequisite module {name} version {version}."
msgstr "Voraussetzungsmodul {name} in Version {version} wird verwendet."

msgctxt "SYSTEM:GLOBAL_VERSION"
msgid "Using version {version} of the Gonemaster engine."
msgstr "Version {version} der Gonemaster-Engine wird verwendet."

msgctxt "SYSTEM:IPV6_AUTO_DISABLED"
msgid "IPv6 automatically disabled: {reason}."
msgstr "IPv6 wurde automatisch deaktiviert: {reason}."

msgctxt "SYSTEM:LOGGER_CALLBACK_ERROR"
msgid "Logger callback died with error: {exception}"
msgstr "Der Logger-Callback ist mit einem Fehler abgebrochen: {exception}."

msgctxt "SYSTEM:MODULE_ERROR"
msgid "Fatal error in {module}: {msg}"
msgstr "Schwerwiegender Fehler in {module}: {msg}."

msgctxt "SYSTEM:MODULE_VERSION"
msgid "Using module {module} version {version}."
msgstr "Modul {module} in Version {version} wird verwendet."

msgctxt "SYSTEM:MODULE_END"
msgid "Module {module} finished running."
msgstr "Modul {module} wurde abgeschlossen."

msgctxt "SYSTEM:NO_NETWORK"
msgid "Both IPv4 and IPv6 are disabled."
msgstr "Sowohl IPv4 als auch IPv6 sind deaktiviert."

msgctxt "SYSTEM:UNKNOWN_METHOD"
msgid "Request to run unknown method {testcase} in module {module}."
msgstr "Anfrage zur Ausführung der unbekannten Methode {testcase} in Modul {module}."

msgctxt "SYSTEM:UNKNOWN_MODULE"
msgid ""
"Request to run {testcase} in unknown module {module}. Known modules: "
"{module_list}."
msgstr ""
"Anfrage zur Ausführung von {testcase} in unbekanntem Modul {module}. "
"Bekannte Module: {module_list}."

msgctxt "SYSTEM:FAKE_DELEGATION_TO_SELF"
msgid ""
"Name server {ns} not adding fake delegation for domain {domain} to itself."
msgstr ""
"Nameserver {ns} fügt keine simulierte Delegation der Domain {domain} zu sich selbst hinzu."

msgctxt "SYSTEM:FAKE_DELEGATION_IN_ZONE_NO_IP"
msgid ""
"The fake delegation of domain {domain} includes an in-zone name server "
"{ns} without mandatory glue (without IP address)."
msgstr ""
"Die simulierte Delegation der Domain {domain} enthält den zoneninternen "
"Nameserver {ns} ohne den erforderlichen Glue-Record (ohne IP-Adresse)."

msgctxt "SYSTEM:FAKE_DELEGATION_NO_IP"
msgid ""
"The fake delegation of domain {domain} includes a name server {ns} that "
"cannot be resolved to any IP address."
msgstr ""
"Die simulierte Delegation der Domain {domain} enthält den Nameserver {ns}, "
"der nicht zu einer IP-Adresse aufgelöst werden kann."

msgctxt "SYSTEM:PACKET_BIG"
msgid "Big packet size ({size}) (try with \"{command}\")."
msgstr "Große Paketgröße ({size}) (Versuch mit \"{command}\")."

msgctxt "ADDRESS:A01_ADDR_NOT_GLOBALLY_REACHABLE"
msgid "IP address(es) not listed as globally reachable: \"{servers}\"."
msgstr "IP-Adresse(n) nicht als global erreichbar gelistet: \"{servers}\"."

msgctxt "ADDRESS:A01_DOCUMENTATION_ADDR"
msgid "IP address(es) intended for documentation purposes: \"{servers}\"."
msgstr "IP-Adresse(n) für Dokumentationszwecke vorgesehen: \"{servers}\"."

msgctxt "ADDRESS:A01_GLOBALLY_REACHABLE_ADDR"
msgid "All tested nameservers in {servers} are globally reachable."
msgstr "Alle getesteten Nameserver in {servers} sind global erreichbar."

msgctxt "ADDRESS:A01_NO_GLOBALLY_REACHABLE_ADDR"
msgid "None of the name servers IP addresses are listed as globally reachable."
msgstr "Keine der Nameserver-IP-Adressen ist als global erreichbar gelistet."

msgctxt "ADDRESS:A01_NO_NAME_SERVERS_FOUND"
msgid "No name servers found."
msgstr "Keine Nameserver gefunden."

msgctxt "BASIC:B01_CHILD_NOT_EXIST"
msgid "The zone \"{domain}\" does not exist as a zone."
msgstr "Die Zone \"{domain}\" existiert nicht als Zone."

msgctxt "DNSSEC:DS01_DS_ALGO_OK"
msgid "DS record with key tag {keytag} and digest algorithm {ds_algo_num} ({ds_algo_descr}) is acceptable. Fetched from name servers {servers}."
msgstr "DS-Record mit Keytag {keytag} und Digest-Algorithmus {ds_algo_num} ({ds_algo_descr}) ist akzeptabel. Abgerufen von den Nameservern {servers}."

msgctxt "DNSSEC:DS01_ROOT_N_NO_UNDEL_DS"
msgid "No undelegated DS records provided for the root zone."
msgstr "Für die Root-Zone wurden keine undelegierten DS-Records angegeben."

msgctxt "DNSSEC:DS01_UNDEL_N_NO_UNDEL_DS"
msgid "No undelegated DS records provided for this test."
msgstr "Für diesen Test wurden keine undelegierten DS-Records angegeben."

msgctxt "DNSSEC:DS05_ALGO_OK"
msgid "DNSKEY with key tag {keytag} uses algorithm {algo_num} ({algo_descr}, {algo_mnemo}) which is acceptable. Fetched from name servers {servers}."
msgstr "DNSKEY mit Keytag {keytag} verwendet Algorithmus {algo_num} ({algo_descr}, {algo_mnemo}), der akzeptabel ist. Abgerufen von den Nameservern {servers}."

msgctxt "DNSSEC:DS07_DS_FOR_SIGNED_ZONE"
msgid "DS records are published in the parent zone for the signed zone."
msgstr "DS-Records für die signierte Zone sind in der übergeordneten Zone veröffentlicht."

msgctxt "DNSSEC:DS07_DS_ON_PARENT_SERVER"
msgid "DS records found on parent name servers {servers}."
msgstr "DS-Records wurden auf den Nameservern der übergeordneten Zone {servers} gefunden."

msgctxt "DNSSEC:DS07_NOT_SIGNED"
msgid "The zone is not signed."
msgstr "Die Zone ist nicht signiert."

msgctxt "DNSSEC:DS07_NO_DS_FOR_SIGNED_ZONE"
msgid "The parent zone has no DS record for the signed child zone."
msgstr "Die übergeordnete Zone hat keinen DS-Record für die signierte untergeordnete Zone."

msgctxt "DNSSEC:DS07_SIGNED"
msgid "The zone is signed with DNSSEC."
msgstr "Die Zone ist mit DNSSEC signiert."

msgctxt "DNSSEC:DS07_SIGNED_ON_SERVER"
msgid "Signed responses received from name servers {servers}."
msgstr "Signierte Antworten wurden von den Nameservern {servers} empfangen."

msgctxt "ZONE:Z11_NO_SPF_NON_MAIL_DOMAIN"
msgid "No SPF policy found for {domain}, which is not a mail domain."
msgstr "Für {domain} wurde keine SPF-Policy gefunden; dies ist keine Maildomain."

msgctxt "ZONE:Z11_NULL_SPF_NON_MAIL_DOMAIN"
msgid "Null SPF policy found for {domain}, which is not a mail domain."
msgstr "Für {domain} wurde eine Null-SPF-Policy gefunden; dies ist keine Maildomain."

msgctxt "ZONE:Z11_SPF_SYNTAX_OK"
msgid "SPF syntax is correct for {domain}."
msgstr "Die SPF-Syntax für {domain} ist korrekt."

msgctxt "SYSTEM:CLI_HEADER_SECONDS"
msgid "Seconds"
msgstr "Sekunden"

msgctxt "SYSTEM:CLI_HEADER_LEVEL"
msgid "Level"
msgstr "Stufe"

msgctxt "SYSTEM:CLI_HEADER_MESSAGE"
msgid "Message"
msgstr "Nachricht"

msgctxt "CONNECTIVITY:CN04_ASN_INFOS_ANNOUNCE_IN"
msgid "Name server IP address \"{address}\" is announced in prefix \"{prefixes}\"."
msgstr "Die Nameserver-IP-Adresse \"{address}\" ist im IP-Präfix \"{prefixes}\" angekündigt."

msgctxt "CONNECTIVITY:CN04_ASN_INFOS_RAW"
msgid "The ASN data for name server IP address \"{address}\" is \"{data}\"."
msgstr "Die ASN-Daten für die Nameserver-IP-Adresse \"{address}\" lauten \"{data}\"."

msgctxt "CONSISTENCY:SOA_MNAME"
msgid "Found SOA mname {mname} on following nameserver set : {servers}."
msgstr "SOA-MNAME {mname} wurde auf folgenden Nameservern gefunden: {servers}."

msgctxt "BASIC:LOOP_PROTECTION"
msgid "Loop protection triggered in {caller} for child zone {child_zone_name} at zone {zone_name} (query name {intermediate_query_name})."
msgstr "Schleifenschutz wurde in {caller} für die untergeordnete Zone {child_zone_name} bei Zone {zone_name} ausgelöst (Abfragename {intermediate_query_name})."

msgctxt "CONNECTIVITY:CN02_MISSING_NS_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds to a NS query with no NS records in the answer "
"section over TCP."
msgstr ""
"Nameserver {ns}/{address} antwortet auf eine NS-Abfrage über TCP ohne "
"NS-Records im Antwortabschnitt."

msgctxt "CONNECTIVITY:CN02_MISSING_SOA_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds to a SOA query with no SOA records in the answer "
"section over TCP."
msgstr ""
"Nameserver {ns}/{address} antwortet auf eine SOA-Abfrage über TCP ohne "
"SOA-Records im Antwortabschnitt."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_NS_QUERY_TCP"
msgid "Nameserver {ns}/{address} does not respond to NS queries over TCP."
msgstr "Nameserver {ns}/{address} antwortet nicht auf NS-Abfragen über TCP."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_SOA_QUERY_TCP"
msgid "Nameserver {ns}/{address} does not respond to SOA queries over TCP."
msgstr "Nameserver {ns}/{address} antwortet nicht auf SOA-Abfragen über TCP."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_TCP"
msgid "Nameserver {ns}/{address} does not respond to any queries over TCP."
msgstr "Nameserver {ns}/{address} antwortet nicht auf DNS-Abfragen über TCP."

msgctxt "CONNECTIVITY:CN02_NS_RECORD_NOT_AA_TCP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an NS query over "
"TCP."
msgstr "Nameserver {ns}/{address} gibt keine autoritative Antwort auf eine NS-Abfrage über TCP."

msgctxt "CONNECTIVITY:CN02_SOA_RECORD_NOT_AA_TCP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an SOA query over "
"TCP."
msgstr "Nameserver {ns}/{address} gibt keine autoritative Antwort auf eine SOA-Abfrage über TCP."

msgctxt "CONNECTIVITY:CN02_UNEXPECTED_RCODE_NS_QUERY_TCP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an NS query "
"over TCP."
msgstr ""
"Nameserver {ns}/{address} antwortet mit dem unerwarteten RCODE ({rcode}) auf "
"eine NS-Abfrage über TCP."

msgctxt "CONNECTIVITY:CN02_UNEXPECTED_RCODE_SOA_QUERY_TCP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an SOA query "
"over TCP."
msgstr ""
"Nameserver {ns}/{address} antwortet mit dem unerwarteten RCODE ({rcode}) auf "
"eine SOA-Abfrage über TCP."

msgctxt "CONNECTIVITY:CN02_WRONG_NS_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on NS queries over TCP."
msgstr ""
"Nameserver {ns}/{address} antwortet mit einem falschen Owner-Namen "
"({domain_found} statt {domain_expected}) auf NS-Abfragen über TCP."

msgctxt "CONNECTIVITY:CN02_WRONG_SOA_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on SOA queries over TCP."
msgstr ""
"Nameserver {ns}/{address} antwortet mit einem falschen Owner-Namen "
"({domain_found} statt {domain_expected}) auf SOA-Abfragen über TCP."

msgctxt "CONNECTIVITY:CN02_OK_TCP"
msgid "The following nameservers respond correctly to SOA and NS queries over TCP: \"{servers}\"."
msgstr "Die folgenden Nameserver antworten korrekt auf SOA- und NS-Abfragen über TCP: \"{servers}\"."

msgctxt "CONNECTIVITY:ASN_INFOS_ANNOUNCE_IN"
msgid "Name server IP address \"{address}\" is announced in prefix \"{prefixes}\"."
msgstr "Die Nameserver-IP-Adresse \"{address}\" ist im IP-Präfix \"{prefixes}\" angekündigt."

msgctxt "CONNECTIVITY:ASN_INFOS_RAW"
msgid "The ASN data for name server IP address \"{address}\" is \"{data}\"."
msgstr "Die ASN-Daten für die Nameserver-IP-Adresse \"{address}\" lauten \"{data}\"."

msgctxt "CONNECTIVITY:CN04_EMPTY_PREFIX_SET"
msgid "Prefix database returned no information for IP address {address}."
msgstr "Die Präfix-Datenbank lieferte keine Information für die IP-Adresse {address}."

msgctxt "DNSSEC:DURATION_LONG"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a duration of "
"{duration} seconds, which is too long."
msgstr ""
"RRSIG mit Keytag {keytag} und abgedeckten Typen {types} hat eine Gültigkeit "
"von {duration} Sekunden, was zu lang ist."

msgctxt "DNSSEC:DURATION_OK"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a duration of "
"{duration} seconds, which is just fine."
msgstr ""
"RRSIG mit Keytag {keytag} und abgedeckten Typen {types} hat eine Gültigkeit "
"von {duration} Sekunden, was akzeptabel ist."

msgctxt "DNSSEC:EXTRA_PROCESSING_BROKEN"
msgid ""
"Server at {address} sent {keys} DNSKEY records, and {sigs} RRSIG records."
msgstr ""
"Der Nameserver bei {address} hat {keys} DNSKEY-Records und {sigs} "
"RRSIG-Records gesendet."

msgctxt "DNSSEC:EXTRA_PROCESSING_OK"
msgid "Server at {address} sent {keys} DNSKEY records and {sigs} RRSIG records."
msgstr ""
"Der Nameserver bei {address} hat {keys} DNSKEY-Records und {sigs} "
"RRSIG-Records gesendet."

msgctxt "DNSSEC:KEY_SIZE_OK"
msgid "All keys from the DNSKEY RRset have the correct size."
msgstr "Alle Schlüssel im DNSKEY-RRset haben die korrekte Größe."

msgctxt "DNSSEC:NO_RESPONSE_DNSKEY"
msgid "Nameserver {ns}/{address} responded with no DNSKEY record(s)."
msgstr "Nameserver {ns}/{address} hat keine DNSKEY-Records zurückgegeben."

msgctxt "DNSSEC:REMAINING_LONG"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a remaining "
"validity of {duration} seconds, which is too long."
msgstr ""
"RRSIG mit Keytag {keytag} und abgedeckten Typen {types} hat eine verbleibende "
"Gültigkeit von {duration} Sekunden, was zu lang ist."

msgctxt "DNSSEC:REMAINING_SHORT"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a remaining "
"validity of {duration} seconds, which is too short."
msgstr ""
"RRSIG mit Keytag {keytag} und abgedeckten Typen {types} hat eine verbleibende "
"Gültigkeit von {duration} Sekunden, was zu kurz ist."

msgctxt "DNSSEC:RRSIG_EXPIRATION"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} expires at : {date}."
msgstr ""
"RRSIG mit Keytag {keytag} und abgedeckten Typen {types} läuft ab am: {date}."

msgctxt "DNSSEC:RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has already expired "
"(expiration is: {expiration})."
msgstr ""
"RRSIG mit Keytag {keytag} und abgedeckten Typen {types} ist bereits abgelaufen "
"(Ablaufdatum: {expiration})."

msgctxt "DELEGATION:ARE_AUTHORITATIVE"
msgid ""
"All these nameservers are confirmed to be authoritative : {servers}."
msgstr ""
"Alle folgenden Nameserver sind als autoritativ bestätigt: {servers}."

msgctxt "DELEGATION:CHILD_DISTINCT_NS_IP"
msgid "All the IP addresses used by the nameservers in child are unique."
msgstr "Alle IP-Adressen der Nameserver in der untergeordneten Zone sind eindeutig."

msgctxt "DELEGATION:CHILD_NS_SAME_IP"
msgid "IP {address} in child refers to multiple nameservers ({servers})."
msgstr "IP-Adresse {address} in der untergeordneten Zone ist mehreren Nameservern zugeordnet ({servers})."

msgctxt "DELEGATION:DEL_DISTINCT_NS_IP"
msgid "All the IP addresses used by the nameservers in parent are unique."
msgstr "Alle IP-Adressen der Nameserver in der Delegation sind eindeutig."

msgctxt "DELEGATION:DEL_NS_SAME_IP"
msgid "IP {address} in parent refers to multiple nameservers ({servers})."
msgstr "IP-Adresse {address} in der Delegation ist mehreren Nameservern zugeordnet ({servers})."

msgctxt "DELEGATION:DISTINCT_IP_ADDRESS"
msgid "All the IP addresses used by the nameservers are unique."
msgstr "Alle IP-Adressen der Nameserver sind eindeutig."

msgctxt "DELEGATION:ENOUGH_IPV4_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers that resolve to IPv4 addresses. "
"Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Die untergeordnete Zone listet genügend Nameserver ({count}), die zu "
"IPv4-Adressen auflösen. Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:ENOUGH_IPV4_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers that resolve to IPv4 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Die Delegation listet genügend Nameserver ({count}), die zu "
"IPv4-Adressen auflösen. Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:ENOUGH_IPV6_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers that resolve to IPv6 addresses. "
"Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Die untergeordnete Zone listet genügend Nameserver ({count}), die zu "
"IPv6-Adressen auflösen. Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:ENOUGH_IPV6_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers that resolve to IPv6 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Die Delegation listet genügend Nameserver ({count}), die zu "
"IPv6-Adressen auflösen. Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:ENOUGH_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers. Lower limit set to {minimum}. Name "
"servers: {servers}"
msgstr ""
"Die untergeordnete Zone listet genügend Nameserver ({count}). "
"Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:ENOUGH_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers. Lower limit set to {minimum}. "
"Name servers: {servers}"
msgstr ""
"Die Delegation listet genügend Nameserver ({count}). "
"Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:EXTRA_NAME_CHILD"
msgid "Child has nameserver(s) not listed at parent ({extra})."
msgstr "Die untergeordnete Zone hat Nameserver, die in der übergeordneten Zone nicht gelistet sind ({extra})."

msgctxt "DELEGATION:EXTRA_NAME_PARENT"
msgid "Parent has nameserver(s) not listed at the child ({extra})."
msgstr "Die übergeordnete Zone hat Nameserver in der Delegation, die in der untergeordneten Zone nicht gelistet sind ({extra})."

msgctxt "DELEGATION:IS_NOT_AUTHORITATIVE"
msgid "Nameserver {ns}/{address} response is not authoritative on {proto} port 53."
msgstr "Nameserver {ns}/{address} gibt keine autoritative Antwort auf {proto} Port 53."

msgctxt "DELEGATION:NAMES_MATCH"
msgid "All of the nameserver names are listed both at parent and child."
msgstr "Alle Nameserver-Namen sind sowohl in der übergeordneten als auch in der untergeordneten Zone gelistet."

msgctxt "DELEGATION:NO_RESPONSE"
msgid ""
"Nameserver {ns} did not respond to a query for name {query_name} and type "
"{query_type}."
msgstr ""
"Nameserver {ns} hat nicht auf eine Abfrage nach Name {query_name} und "
"Typ {query_type} geantwortet."

msgctxt "DELEGATION:NOT_ENOUGH_IPV4_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers that resolve to IPv4 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Die untergeordnete Zone listet nicht genügend Nameserver ({count}), die zu "
"IPv4-Adressen auflösen. Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:NOT_ENOUGH_IPV4_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers that resolve to IPv4 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Die Delegation listet nicht genügend Nameserver ({count}), die zu "
"IPv4-Adressen auflösen. Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:NOT_ENOUGH_IPV6_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers that resolve to IPv6 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Die untergeordnete Zone listet nicht genügend Nameserver ({count}), die zu "
"IPv6-Adressen auflösen. Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:NOT_ENOUGH_IPV6_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers that resolve to IPv6 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Die Delegation listet nicht genügend Nameserver ({count}), die zu "
"IPv6-Adressen auflösen. Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:NOT_ENOUGH_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers. Lower limit set to "
"{minimum}. Name servers: {servers}"
msgstr ""
"Die untergeordnete Zone listet nicht genügend Nameserver ({count}). "
"Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:NOT_ENOUGH_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers. Lower limit set to "
"{minimum}. Name servers: {servers}"
msgstr ""
"Die Delegation listet nicht genügend Nameserver ({count}). "
"Untergrenze: {minimum}. Nameserver: {servers}."

msgctxt "DELEGATION:NO_IPV4_NS_CHILD"
msgid ""
"Child lists no nameserver that resolves to an IPv4 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Die untergeordnete Zone listet keinen Nameserver, der zu einer IPv4-Adresse "
"auflöst. Wenn welche vorhanden wären, wäre die Mindestanzahl {minimum}."

msgctxt "DELEGATION:NO_IPV4_NS_DEL"
msgid ""
"Delegation lists no nameserver that resolves to an IPv4 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Die Delegation listet keinen Nameserver, der zu einer IPv4-Adresse auflöst. "
"Wenn welche vorhanden wären, wäre die Mindestanzahl {minimum}."

msgctxt "DELEGATION:NO_IPV6_NS_CHILD"
msgid ""
"Child lists no nameserver that resolves to an IPv6 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Die untergeordnete Zone listet keinen Nameserver, der zu einer IPv6-Adresse "
"auflöst. Wenn welche vorhanden wären, wäre die Mindestanzahl {minimum}."

msgctxt "DELEGATION:NO_IPV6_NS_DEL"
msgid ""
"Delegation lists no nameserver that resolves to an IPv6 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Die Delegation listet keinen Nameserver, der zu einer IPv6-Adresse auflöst. "
"Wenn welche vorhanden wären, wäre die Mindestanzahl {minimum}."

msgctxt "DELEGATION:NS_IS_CNAME"
msgid "Nameserver {ns} RR points to CNAME."
msgstr "Der Nameserver-Record {ns} verweist auf ein CNAME."

msgctxt "DELEGATION:NO_NS_CNAME"
msgid "No nameserver points to CNAME alias."
msgstr "Kein Nameserver verweist auf ein CNAME-Alias."

msgctxt "DELEGATION:REFERRAL_SIZE_LARGE"
msgid ""
"The smallest possible legal referral packet is larger than 512 but within "
"1232 octets (it is {size}); it needs EDNS to be returned over UDP."
msgstr ""
"Das kleinstmögliche gültige Referral-Paket ist größer als 512, aber innerhalb "
"von 1232 Bytes ({size}); es benötigt EDNS, um über UDP übertragen zu werden."

msgctxt "DELEGATION:REFERRAL_SIZE_TOO_LARGE"
msgid ""
"The smallest possible legal referral packet is larger than 512 octets (it is "
"{size})."
msgstr ""
"Das kleinstmögliche gültige Referral-Paket ist größer als 512 Bytes ({size})."

msgctxt "DELEGATION:REFERRAL_SIZE_OK"
msgid ""
"The smallest possible legal referral packet is smaller than 513 octets (it "
"is {size})."
msgstr ""
"Das kleinstmögliche gültige Referral-Paket ist kleiner als 513 Bytes ({size})."

msgctxt "DELEGATION:SAME_IP_ADDRESS"
msgid "IP {address} refers to multiple nameservers ({servers})."
msgstr "IP-Adresse {address} ist mehreren Nameservern zugeordnet ({servers})."

msgctxt "DELEGATION:SOA_EXISTS"
msgid "All the nameservers have SOA record."
msgstr "Alle Nameserver haben einen SOA-Record."

msgctxt "DELEGATION:SOA_NOT_EXISTS"
msgid "Empty NOERROR response to SOA query was received from {ns}/{address}."
msgstr "Eine leere NOERROR-Antwort auf eine SOA-Abfrage wurde von {ns}/{address} empfangen."

msgctxt "DELEGATION:TOTAL_NAME_MISMATCH"
msgid "None of the nameservers listed at the parent are listed at the child."
msgstr "Keiner der in der übergeordneten Zone gelisteten Nameserver ist in der untergeordneten Zone gelistet."

msgctxt "DELEGATION:UNEXPECTED_RCODE"
msgid ""
"Nameserver {ns} answered query for name {query_name} and type {query_type} with "
"RCODE {rcode}."
msgstr ""
"Nameserver {ns} hat eine Abfrage nach Name {query_name} und Typ {query_type} "
"mit RCODE {rcode} beantwortet."

msgctxt "NAMESERVER:AAAA_BAD_RDATA"
msgid ""
"Nameserver {ns}/{address} answered AAAA query with an unexpected RDATA length "
"({length} instead of 16)."
msgstr ""
"Nameserver {ns}/{address} hat eine AAAA-Abfrage mit unerwarteter RDATA-Länge "
"({length} statt 16) beantwortet."

msgctxt "NAMESERVER:AAAA_QUERY_DROPPED"
msgid "Nameserver {ns}/{address} dropped AAAA query."
msgstr "Nameserver {ns}/{address} hat die AAAA-Abfrage nicht beantwortet."

msgctxt "NAMESERVER:AAAA_UNEXPECTED_RCODE"
msgid "Nameserver {ns}/{address} answered AAAA query with an unexpected rcode ({rcode})."
msgstr "Nameserver {ns}/{address} hat eine AAAA-Abfrage mit dem unerwarteten RCODE ({rcode}) beantwortet."

msgctxt "NAMESERVER:AAAA_WELL_PROCESSED"
msgid ""
"The following nameservers answer AAAA queries without problems : {servers}."
msgstr "Die folgenden Nameserver beantworten AAAA-Abfragen ohne Probleme: {servers}."

msgctxt "NAMESERVER:A_UNEXPECTED_RCODE"
msgid "Nameserver {ns}/{address} answered A query with an unexpected rcode ({rcode})."
msgstr "Nameserver {ns}/{address} hat eine A-Abfrage mit dem unerwarteten RCODE ({rcode}) beantwortet."

msgctxt "NAMESERVER:AXFR_AVAILABLE"
msgid "The following nameservers allow zone transfer using AXFR: {servers}."
msgstr "Die folgenden Nameserver erlauben Zonentransfer per AXFR: {servers}."

msgctxt "NAMESERVER:AXFR_FAILURE"
msgid "AXFR not available on the following nameservers: {servers}."
msgstr "AXFR ist auf den folgenden Nameservern nicht verfügbar: {servers}."

msgctxt "NAMESERVER:BREAKS_ON_EDNS"
msgid "No response from {ns}/{address} when EDNS is used in query asking for {domain}."
msgstr "Keine Antwort von {ns}/{address} bei Abfragen mit EDNS nach {domain}."

msgctxt "NAMESERVER:CAN_BE_RESOLVED"
msgid "All nameservers succeeded to resolve to an IP address."
msgstr "Alle Nameserver konnten erfolgreich zu einer IP-Adresse aufgelöst werden."

msgctxt "NAMESERVER:CAN_NOT_BE_RESOLVED"
msgid ""
"The following nameservers failed to resolve to an IP address : {servers}."
msgstr ""
"Die folgenden Nameserver konnten nicht zu einer IP-Adresse aufgelöst werden: {servers}."

msgctxt "NAMESERVER:CASE_QUERIES_RESULTS_DIFFER"
msgid ""
"When asked for {query_type} records on \"{domain}\" with different cases, all "
"servers do not reply consistently."
msgstr ""
"Bei Abfragen nach {query_type}-Records für \"{domain}\" mit verschiedenen "
"Schreibweisen antworten nicht alle Nameserver konsistent."

msgctxt "NAMESERVER:CASE_QUERIES_RESULTS_OK"
msgid ""
"When asked for {query_type} records on \"{domain}\" with different cases, all "
"servers reply consistently."
msgstr ""
"Bei Abfragen nach {query_type}-Records für \"{domain}\" mit verschiedenen "
"Schreibweisen antworten alle Nameserver konsistent."

msgctxt "NAMESERVER:CASE_QUERY_DIFFERENT_ANSWER"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns different answers."
msgstr ""
"Bei Abfragen nach {query_type}-Records für \"{query1}\" und \"{query2}\" "
"gibt Nameserver {ns}/{address} unterschiedliche Antworten."

msgctxt "NAMESERVER:CASE_QUERY_DIFFERENT_RC"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns different RCODE (\"{rcode1}\" vs \"{rcode2}\")."
msgstr ""
"Bei Abfragen nach {query_type}-Records für \"{query1}\" und \"{query2}\" "
"gibt Nameserver {ns}/{address} unterschiedliche RCODEs (\"{rcode1}\" vs. \"{rcode2}\")."

msgctxt "NAMESERVER:CASE_QUERY_NO_ANSWER"
msgid ""
"When asked for {query_type} records on \"{domain}\", nameserver {ns}/{address} returns "
"nothing."
msgstr ""
"Bei Abfragen nach {query_type}-Records für \"{domain}\" gibt Nameserver "
"{ns}/{address} keine Antwort."

msgctxt "NAMESERVER:CASE_QUERY_SAME_ANSWER"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns same answers."
msgstr ""
"Bei Abfragen nach {query_type}-Records für \"{query1}\" und \"{query2}\" "
"gibt Nameserver {ns}/{address} dieselben Antworten."

msgctxt "NAMESERVER:CASE_QUERY_SAME_RC"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns same RCODE \"{rcode}\"."
msgstr ""
"Bei Abfragen nach {query_type}-Records für \"{query1}\" und \"{query2}\" "
"gibt Nameserver {ns}/{address} denselben RCODE \"{rcode}\"."

msgctxt "NAMESERVER:DIFFERENT_SOURCE_IP"
msgid ""
"Nameserver {ns}/{address} replies on a SOA query with a different source address "
"({source})."
msgstr ""
"Nameserver {ns}/{address} beantwortet eine SOA-Abfrage von einer anderen "
"Quelladresse ({source})."

msgctxt "NAMESERVER:EDNS0_SUPPORT"
msgid "The following nameservers support EDNS0 : {servers}."
msgstr "Die folgenden Nameserver unterstützen EDNS0: {servers}."

msgctxt "NAMESERVER:EDNS_RESPONSE_WITHOUT_EDNS"
msgid ""
"Response without EDNS from {ns}/{address} on query with EDNS0 asking for {domain}."
msgstr ""
"Antwort ohne EDNS von {ns}/{address} auf eine Abfrage mit EDNS0 nach {domain}."

msgctxt "NAMESERVER:EDNS_VERSION_ERROR"
msgid ""
"Incorrect version of EDNS (expected 0) in response from {ns}/{address} on query with "
"EDNS (version 0) asking for {domain}."
msgstr ""
"Falsche EDNS-Version (erwartet 0) in der Antwort von {ns}/{address} auf eine "
"Abfrage mit EDNS (Version 0) nach {domain}."

msgctxt "NAMESERVER:IS_A_RECURSOR"
msgid "The following nameservers are recursors: {servers}."
msgstr "Die folgenden Nameserver sind rekursive Resolver: {servers}."

msgctxt "NAMESERVER:MISSING_OPT_IN_TRUNCATED"
msgid ""
"Nameserver {ns}/{address} replies on an EDNS query with a truncated response without "
"EDNS."
msgstr ""
"Nameserver {ns}/{address} antwortet auf eine EDNS-Abfrage mit einer "
"trunkierten Antwort ohne EDNS."

msgctxt "SYNTAX:NO_RESPONSE"
msgid "No response from {ns} asking for {domain}."
msgstr "Keine Antwort von {ns} auf eine Abfrage nach {domain}."

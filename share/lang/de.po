msgid ""
"Ambiguous downcasing of character \"{unicode_name}\" in the domain name. Use "
"all lower case instead."
msgstr ""
"Der Domainname enthält den Großbuchstaben \"{unicode_name}\". Es ist unklar, "
"wie er in den entsprechenden Kleinbuchstaben umgewandelt werden soll. "
"Verwenden Sie stattdessen nur Kleinbuchstaben."

msgid "Domain name is too long (more than 253 characters with no final dot)."
msgstr "Der Domainname ist zu lang (mehr als 253 Zeichen ohne abschließenden Punkt)."

msgid "Domain name is empty."
msgstr "Der Domainname ist leer."

msgid "Domain name starts with dot."
msgstr "Der Domainname beginnt mit einem Punkt."

msgid ""
"Domain name has an ASCII label (\"{label}\") with a character not permitted."
msgstr ""
"Der Domainname hat ein Label (\"{label}\"), das nur aus ASCII-Zeichen besteht, "
"aber ein unzulassiges Zeichen enthält."

msgid ""
"Domain name has a non-ASCII label (\"{label}\") which is not a valid U-label."
msgstr ""
"Der Domainname enthält ein Label (\"{label}\"), das nicht nur aus ASCII-Zeichen "
"besteht, aber kein gültiges U-Label gemäß IDN ist."

msgid "Domain name has repeated dots."
msgstr "Der Domainname enthält aufeinanderfolgende Punkte."

msgid ""
"Domain name has a label that is too long (more than 63 characters), "
"\"{label}\"."
msgstr ""
"Der Domainname enthält ein Label, das zu lang ist (mehr als 63 Zeichen): "
"\"{label}\"."

msgctxt "ADDRESS:NAMESERVER_IP_WITHOUT_REVERSE"
msgid "Nameserver {ns} has an IP address ({address}) without PTR configured."
msgstr ""
"Der Nameserver {ns} hat eine IP-Adresse ({address}) ohne konfigurierten "
"Reverse-DNS-Record (PTR)."

msgctxt "ADDRESS:NAMESERVER_IP_PTR_MISMATCH"
msgid ""
"Nameserver {ns} has an IP address ({address}) with mismatched PTR result "
"({ptr_names})."
msgstr ""
"Der Nameserver '{ns}' hat eine IP-Adresse ({address}) mit einem nicht "
"übereinstimmenden Reverse-DNS-Record (PTR): '{ptr_names}'."

msgctxt "ADDRESS:NAMESERVERS_IP_WITH_REVERSE"
msgid "Reverse DNS entry exists for each Nameserver IP address."
msgstr "Für jede Nameserver-IP-Adresse existiert ein Reverse-DNS-Record (PTR)."

msgctxt "ADDRESS:NAMESERVER_IP_PTR_MATCH"
msgid "Every reverse DNS entry matches name server name."
msgstr "Jeder Reverse-DNS-Record (PTR) stimmt mit dem entsprechenden Nameserver-Namen überein."

msgctxt "ADDRESS:NO_RESPONSE_PTR_QUERY"
msgid "No response from nameserver(s) on PTR query ({domain})."
msgstr "Keine Antwort vom Nameserver auf eine PTR-Abfrage ({domain})."


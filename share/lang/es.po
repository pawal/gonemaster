msgctxt "ADDRESS:A01_ADDR_NOT_GLOBALLY_REACHABLE"
msgid "IP address(es) not listed as globally reachable: \"{servers}\"."
msgstr "Dirección(es) IP no listadas como accesibles globalmente: \"{servers}\"."

msgctxt "ADDRESS:A01_DOCUMENTATION_ADDR"
msgid "IP address(es) intended for documentation purposes: \"{servers}\"."
msgstr "Dirección(es) IP destinadas a propósitos de documentación: \"{servers}\"."

msgctxt "ADDRESS:A01_GLOBALLY_REACHABLE_ADDR"
msgid "All tested nameservers in {servers} are globally reachable."
msgstr "Todos los servidores de nombres probados en {servers} son accesibles globalmente."

msgctxt "ADDRESS:A01_NO_GLOBALLY_REACHABLE_ADDR"
msgid "None of the name servers IP addresses are listed as globally reachable."
msgstr "Ninguna de las direcciones IP de los servidores de nombres está listada como accesible globalmente."

msgctxt "ADDRESS:A01_NO_NAME_SERVERS_FOUND"
msgid "No name servers found."
msgstr "No se encontraron servidores de nombres."

msgctxt "BASIC:B01_CHILD_NOT_EXIST"
msgid "The zone \"{domain}\" does not exist as a zone."
msgstr "La zona \"{domain}\" no existe como zona."

msgctxt "DNSSEC:DS01_DS_ALGO_OK"
msgid "DS record with key tag {keytag} and digest algorithm {ds_algo_num} ({ds_algo_descr}) is acceptable. Fetched from name servers {servers}."
msgstr "El registro DS con la etiqueta de clave {keytag} y el algoritmo de resumen {ds_algo_num} ({ds_algo_descr}) es aceptable. Obtenido de los servidores de nombres {servers}."

msgctxt "DNSSEC:DS01_ROOT_N_NO_UNDEL_DS"
msgid "No undelegated DS records provided for the root zone."
msgstr "No se proporcionaron registros DS no delegados para la zona raíz."

msgctxt "DNSSEC:DS01_UNDEL_N_NO_UNDEL_DS"
msgid "No undelegated DS records provided for this test."
msgstr "No se proporcionaron registros DS no delegados para esta prueba."

msgctxt "DNSSEC:DS05_ALGO_OK"
msgid "DNSKEY with key tag {keytag} uses algorithm {algo_num} ({algo_descr}, {algo_mnemo}) which is acceptable. Fetched from name servers {servers}."
msgstr "La clave DNSKEY con etiqueta {keytag} usa el algoritmo {algo_num} ({algo_descr}, {algo_mnemo}) que es aceptable. Obtenido de los servidores de nombres {servers}."

msgctxt "DNSSEC:DS07_DS_FOR_SIGNED_ZONE"
msgid "DS records are published in the parent zone for the signed zone."
msgstr "Los registros DS están publicados en la zona padre para la zona firmada."

msgctxt "DNSSEC:DS07_DS_ON_PARENT_SERVER"
msgid "DS records found on parent name servers {servers}."
msgstr "Registros DS encontrados en los servidores de nombres padre {servers}."

msgctxt "DNSSEC:DS07_NOT_SIGNED"
msgid "The zone is not signed."
msgstr "La zona no está firmada."

msgctxt "DNSSEC:DS07_NO_DS_FOR_SIGNED_ZONE"
msgid "The parent zone has no DS record for the signed child zone."
msgstr "La zona padre no tiene registro DS para la zona hijo firmada."

msgctxt "DNSSEC:DS07_SIGNED"
msgid "The zone is signed with DNSSEC."
msgstr "La zona está firmada con DNSSEC."

msgctxt "DNSSEC:DS07_SIGNED_ON_SERVER"
msgid "Signed responses received from name servers {servers}."
msgstr "Respuestas firmadas recibidas de los servidores de nombres {servers}."

msgctxt "ZONE:Z11_NO_SPF_NON_MAIL_DOMAIN"
msgid "No SPF policy found for {domain}, which is not a mail domain."
msgstr "No se encontró política SPF para {domain}, que no es un dominio de correo."

msgctxt "ZONE:Z11_NULL_SPF_NON_MAIL_DOMAIN"
msgid "Null SPF policy found for {domain}, which is not a mail domain."
msgstr "Política SPF nula encontrada para {domain}, que no es un dominio de correo."

msgctxt "ZONE:Z11_SPF_SYNTAX_OK"
msgid "SPF syntax is correct for {domain}."
msgstr "La sintaxis SPF es correcta para {domain}."

msgctxt "SYSTEM:CLI_HEADER_SECONDS"
msgid "Seconds"
msgstr "Segundos"

msgctxt "SYSTEM:CLI_HEADER_LEVEL"
msgid "Level"
msgstr "Nivel"

msgctxt "SYSTEM:CLI_HEADER_MESSAGE"
msgid "Message"
msgstr "Mensaje"

msgctxt "CONNECTIVITY:CN04_ASN_INFOS_ANNOUNCE_IN"
msgid "Name server IP address \"{address}\" is announced in prefix \"{prefixes}\"."
msgstr ""
"El servidor de nombres con la dirección IP \"{address}\" es anunciado en el "
"prefijo \"{prefixes}\"."

msgctxt "CONNECTIVITY:CN04_ASN_INFOS_RAW"
msgid "The ASN data for name server IP address \"{address}\" is \"{data}\"."
msgstr ""
"Los datos de ASN para el servidor de nombres con la dirección IP \"{address}\" "
"son \"{data}\"."

msgctxt "CONSISTENCY:SOA_MNAME"
msgid "Found SOA mname {mname} on following nameserver set : {servers}."
msgstr ""
"Se encontró el campo {mname} del SOA en el siguiente grupo de servidores de "
"nombres : {servers}."

msgctxt "BASIC:LOOP_PROTECTION"
msgid "Loop protection triggered in {caller} for child zone {child_zone_name} at zone {zone_name} (query name {intermediate_query_name})."
msgstr "La protección de bucle se activó en {caller} para la zona hija {child_zone_name} en la zona {zone_name} (nombre de consulta {intermediate_query_name})."

msgctxt "DNSSEC:DS02_RSA_EXPONENT_UNSUPPORTED"
msgid ""
"The RRSIG with keytag {keytag} could not be verified because the DNSKEY uses an RSA public exponent that this installation does not support. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El RRSIG con tag {keytag} no pudo ser validado porque el DNSKEY usa un exponente público RSA que esta instalación no soporta. Obtenido de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS08_RSA_EXPONENT_UNSUPPORTED"
msgid ""
"The RRSIG with keytag {keytag} could not be verified because the DNSKEY uses an RSA public exponent that this installation does not support. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El RRSIG con tag {keytag} no pudo ser validado porque el DNSKEY usa un exponente público RSA que esta instalación no soporta. Obtenido de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS09_RSA_EXPONENT_UNSUPPORTED"
msgid ""
"The RRSIG with keytag {keytag} could not be verified because the DNSKEY uses an RSA public exponent that this installation does not support. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El RRSIG con tag {keytag} no pudo ser validado porque el DNSKEY usa un exponente público RSA que esta instalación no soporta. Obtenido de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS01_KEY_ALGO_OK"
msgid "The DS record with keytag {keytag} references DNSKEY algorithm {ds_key_algo_num} ({ds_key_algo_descr}). Fetched from name servers \"{servers}\"."
msgstr "El registro DS con tag {keytag} referencia el algoritmo de DNSKEY {ds_key_algo_num} ({ds_key_algo_descr}). Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS01_KEY_ALGO_NOT_RECOMMENDED"
msgid "The DS record with keytag {keytag} references unrecommended DNSKEY algorithm {ds_key_algo_num} ({ds_key_algo_descr}). Fetched from name servers \"{servers}\"."
msgstr "El registro DS con tag {keytag} referencia el algoritmo de DNSKEY {ds_key_algo_num} ({ds_key_algo_descr}), que no se recomienda. Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS01_KEY_ALGO_DEPRECATED"
msgid "The DS record with keytag {keytag} references deprecated DNSKEY algorithm {ds_key_algo_num} ({ds_key_algo_descr}). Fetched from name servers \"{servers}\"."
msgstr "El registro DS con tag {keytag} referencia el algoritmo de DNSKEY obsoleto {ds_key_algo_num} ({ds_key_algo_descr}). Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS01_KEY_ALGO_NOT_ZONE_SIGN"
msgid "The DS record with keytag {keytag} references DNSKEY algorithm {ds_key_algo_num} ({ds_key_algo_descr}) which is not meant for zone signing. Fetched from name servers \"{servers}\"."
msgstr "El registro DS con tag {keytag} referencia el algoritmo de DNSKEY {ds_key_algo_num} ({ds_key_algo_descr}), que no está destinado a la firma de zonas. Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS01_KEY_ALGO_PRIVATE"
msgid "The DS record with keytag {keytag} references DNSKEY algorithm {ds_key_algo_num} ({ds_key_algo_descr}) which is reserved for private use. Fetched from name servers \"{servers}\"."
msgstr "El registro DS con tag {keytag} referencia el algoritmo de DNSKEY {ds_key_algo_num} ({ds_key_algo_descr}), que está reservado para uso privado. Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS01_KEY_ALGO_RESERVED"
msgid "The DS record with keytag {keytag} references reserved DNSKEY algorithm {ds_key_algo_num} ({ds_key_algo_descr}). Fetched from name servers \"{servers}\"."
msgstr "El registro DS con tag {keytag} referencia el algoritmo de DNSKEY reservado {ds_key_algo_num} ({ds_key_algo_descr}). Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS01_KEY_ALGO_UNASSIGNED"
msgid "The DS record with keytag {keytag} references unassigned DNSKEY algorithm {ds_key_algo_num} ({ds_key_algo_descr}). Fetched from name servers \"{servers}\"."
msgstr "El registro DS con tag {keytag} referencia el algoritmo de DNSKEY no asignado {ds_key_algo_num} ({ds_key_algo_descr}). Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS02_DS_ALGO_DNSKEY_MISMATCH"
msgid "The DS record with keytag {keytag} specifies algorithm {ds_key_algo_num} ({ds_key_algo_mnemo}), but the DNSKEY record it matches uses algorithm {algo_num} ({algo_mnemo}). Validating resolvers ignore this DS record. Found at the nameservers with IP addresses \"{addresses}\"."
msgstr "El registro DS con tag {keytag} especifica el algoritmo {ds_key_algo_num} ({ds_key_algo_mnemo}), pero el registro DNSKEY con el que coincide usa el algoritmo {algo_num} ({algo_mnemo}). Los resolutores validadores ignoran este registro DS. Obtenido de los servidores de nombres con direcciones IP \"{addresses}\"."

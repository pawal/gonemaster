msgid "IPv6 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "Desactivado IPv6, no se enviará la consulta \"{query_type}\" hacia {ns}/{address}."

msgctxt "SYSTEM:SKIP_IPV6_DISABLED"
msgid "IPv6 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "Desactivado IPv6, no se enviará la consulta \"{query_type}\" hacia {ns}/{address}."

msgctxt "SYSTEM:ERROR_CACHE_SKIP"
msgid "Skipping {query_type} query to {query_name} ({query_class}) at {address} over {protocol} for {ttl_seconds}s after network error."
msgstr "Se omite la consulta {query_type} a {query_name} ({query_class}) en {address} por {protocol} durante {ttl_seconds}s tras un error de red."

msgctxt "BASIC:IPV6_ENABLED"
msgid "IPv6 is enabled, can send \"{query_type}\" query to {ns}/{address}."
msgstr "Activado IPv6, se puede enviar la consulta \"{query_type}\" hacia {ns}/{address}."

msgctxt "BASIC:NO_A_RECORDS"
msgid "Nameserver {ns}/{address} did not return \"A\" record(s) for {domain}."
msgstr ""
"El servidor de nombres {ns}/{address} no entregó registro(s) \"A\" para {domain}."

msgctxt "CONNECTIVITY:CN01_IPV4_DISABLED"
msgid ""
"IPv4 is disabled. No DNS queries are sent to these name servers: "
"\"{servers}\"."
msgstr ""
"IPv4 está desactivado. No se enviarán consultas DNS a estos servidores de "
"nombres: \"{servers}\"."

msgctxt "CONNECTIVITY:CN01_IPV6_DISABLED"
msgid ""
"IPv6 is disabled. No DNS queries are sent to these name servers: "
"\"{servers}\"."
msgstr ""
"IPv6 está desactivado. No se enviarán consultas DNS a estos servidores de "
"nombres: \"{servers}\"."

msgctxt "CONNECTIVITY:CN01_MISSING_NS_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds to a NS query with no NS records in the answer "
"section over UDP."
msgstr ""
"El servidor de nombres {ns}/{address} responde sin registros NS en la sección de "
"respuesta, ante una consulta NS sobre UDP."

msgctxt "CONNECTIVITY:CN01_MISSING_SOA_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds to a SOA query with no SOA records in the answer "
"section over UDP."
msgstr ""
"El servidor de nombres {ns}/{address} responde sin registros SOA en la sección de "
"respuesta, ante una consulta SOA sobre UDP."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_NS_QUERY_UDP"
msgid "Nameserver {ns}/{address} does not respond to NS queries over UDP."
msgstr "El servidor de nombres {ns}/{address} no responde a consultas NS usando UDP."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_SOA_QUERY_UDP"
msgid "Nameserver {ns}/{address} does not respond to SOA queries over UDP."
msgstr "El servidor de nombres {ns}/{address} no responde a consultas SOA usando UDP."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_UDP"
msgid "Nameserver {ns}/{address} does not respond to any queries over UDP."
msgstr "El servidor de nombres {ns}/{address} no responde a ninguna consulta usando UDP."

msgctxt "CONNECTIVITY:CN01_NS_RECORD_NOT_AA_UDP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an NS query over "
"UDP."
msgstr ""
"El servidor de nombres {ns}/{address} no entrega una respuesta autoritativa a una "
"consulta NS usando UDP."

msgctxt "CONNECTIVITY:CN01_OK_UDP"
msgid "The following nameservers respond correctly to SOA and NS queries over UDP: \"{servers}\"."
msgstr "Los siguientes servidores de nombres responden correctamente a las consultas SOA y NS por UDP: \"{servers}\"."

msgctxt "CONNECTIVITY:CN01_SOA_RECORD_NOT_AA_UDP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an SOA query over "
"UDP."
msgstr ""
"El servidor de nombres {ns}/{address} no entrega una respuesta autoritativa a una "
"consulta SOA usando UDP."

msgctxt "CONNECTIVITY:CN01_UNEXPECTED_RCODE_NS_QUERY_UDP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an NS query "
"over UDP."
msgstr ""
"El servidor de nombres{ns}/{address} responde con un código RCODE inesperado ({rcode}) "
"a una consulta NS usando UDP."

msgctxt "CONNECTIVITY:CN01_UNEXPECTED_RCODE_SOA_QUERY_UDP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an SOA query "
"over UDP."
msgstr ""
"El servidor de nombres {ns}/{address} responde con un código RCODE inesperado "
"({rcode}) a una consulta SOA usando UDP."

msgctxt "CONNECTIVITY:CN01_WRONG_NS_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on NS queries over UDP."
msgstr ""
"El servidor de nombres {ns}/{address} responde con un nombre \"owner\" incorrecto "
"({domain_found} en vez de {domain_expected}) a consultas NS usando UDP."

msgctxt "CONNECTIVITY:CN01_WRONG_SOA_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on SOA queries over UDP."
msgstr ""
"El servidor de nombres {ns}/{address} responde con un nombre \"owner\" incorrecto "
"({domain_found} en vez de {domain_expected}) a consultas SOA usando UDP."

msgctxt "CONNECTIVITY:CN02_MISSING_NS_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds to a NS query with no NS records in the answer "
"section over TCP."
msgstr ""
"El servidor de nombres {ns}/{address} responde sin registros NS en la sección de "
"respuesta frente a una consulta NS usando TCP."

msgctxt "CONNECTIVITY:CN02_MISSING_SOA_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds to a SOA query with no SOA records in the answer "
"section over TCP."
msgstr ""
"El servidor de nombres {ns}/{address} responde sin registros SOA en la sección de "
"respuesta frente a una consulta SOA usando TCP."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_NS_QUERY_TCP"
msgid "Nameserver {ns}/{address} does not respond to NS queries over TCP."
msgstr "El servidor de nombres {ns}/{address} no responde a consultas NS usando TCP."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_SOA_QUERY_TCP"
msgid "Nameserver {ns}/{address} does not respond to SOA queries over TCP."
msgstr "El servidor de nombres {ns}/{address} no responde a consultas SOA usando TCP."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_TCP"
msgid "Nameserver {ns}/{address} does not respond to any queries over TCP."
msgstr ""
"El servidor de nombres {ns}/{address} no responde a ninguna consultas usando TCP."

msgctxt "CONNECTIVITY:CN02_NS_RECORD_NOT_AA_TCP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an NS query over "
"TCP."
msgstr ""
"El servidor de nombres {ns}/{address} no entrega una respuesta autoritativa a una "
"consulta NS usando TCP."

msgctxt "CONNECTIVITY:CN02_SOA_RECORD_NOT_AA_TCP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an SOA query over "
"TCP."
msgstr ""
"El servidor de nombres {ns}/{address} no entrega una respuesta autoritativa a una "
"consulta SOA usando TCP."

msgctxt "CONNECTIVITY:CN02_UNEXPECTED_RCODE_NS_QUERY_TCP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an NS query "
"over TCP."
msgstr ""
"El servidor de nombres{ns}/{address} responde con un código RCODE inesperado ({rcode}) "
"a una consulta NS usando TCP."

msgctxt "CONNECTIVITY:CN02_UNEXPECTED_RCODE_SOA_QUERY_TCP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an SOA query "
"over TCP."
msgstr ""
"El servidor de nombres {ns}/{address} responde con un código RCODE inesperado "
"({rcode}) a una consulta SOA usando TCP."

msgctxt "CONNECTIVITY:CN02_WRONG_NS_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on NS queries over TCP."
msgstr ""
"El servidor de nombres {ns}/{address} responde con un nombre \"owner\" incorrecto "
"({domain_found} en vez de {domain_expected}) a una consulta NS usando TCP."

msgctxt "CONNECTIVITY:CN02_WRONG_SOA_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on SOA queries over TCP."
msgstr ""
"El servidor de nombres {ns}/{address} responde con un nombre \"owner\" incorrecto "
"({domain_found} en vez de {domain_expected}) a una consulta SOA usando TCP."

msgctxt "CONNECTIVITY:CN02_OK_TCP"
msgid "The following nameservers respond correctly to SOA and NS queries over TCP: \"{servers}\"."
msgstr "Los siguientes servidores de nombres responden correctamente a las consultas SOA y NS por TCP: \"{servers}\"."

msgctxt "CONNECTIVITY:ASN_INFOS_ANNOUNCE_IN"
msgid "Name server IP address \"{address}\" is announced in prefix \"{prefixes}\"."
msgstr ""
"El servidor de nombres con la dirección IP \"{address}\" es anunciado en el "
"prefijo \"{prefixes}\"."

msgctxt "CONNECTIVITY:ASN_INFOS_RAW"
msgid "The ASN data for name server IP address \"{address}\" is \"{data}\"."
msgstr ""
"Los datos de ASN para el servidor de nombres con la dirección IP \"{address}\" "
"son \"{data}\"."

msgctxt "CONNECTIVITY:CN04_EMPTY_PREFIX_SET"
msgid "Prefix database returned no information for IP address {address}."
msgstr ""
"La base de datos de prefijos no tiene información para la dirección IP "
"{address}."

msgctxt "CONNECTIVITY:CN04_ERROR_PREFIX_DATABASE"
msgid "Prefix database error for IP address {address}."
msgstr "Error con la base de datos de prefijos para la dirección {address}."

msgctxt "CONNECTIVITY:CN04_IPV4_DIFFERENT_PREFIX"
msgid ""
"The following name server(s) are announced in unique IPv4 prefix(es): "
"\"{servers}\""
msgstr ""
"Los siguientes servidores de nombres son anunciados en un(os) prefijo(s) "
"IPv4 único: \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV4_SAME_PREFIX"
msgid ""
"The following name server(s) are announced in the same IPv4 prefix "
"({prefixes}): \"{servers}\""
msgstr ""
"Los siguientes servidores de nombres son anunciados en el mismo prefijo IPv4 "
"({prefixes}): \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV4_SINGLE_PREFIX"
msgid ""
"All name server(s) IPv4 address(es) are announced in the same IPv4 prefix."
msgstr ""
"Todas las direcciones IPv4 de (los) servidor(es) de nombres son anunciadas "
"en el mismo prefijo IPv4."

msgctxt "CONNECTIVITY:CN04_IPV6_DIFFERENT_PREFIX"
msgid ""
"The following name server(s) are announced in unique IPv6 prefix(es): "
"\"{servers}\""
msgstr ""
"Los siguientes servidores de nombres son anunciados en un(os) prefijo(s) "
"IPv6 único: \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV6_SAME_PREFIX"
msgid ""
"The following name server(s) are announced in the same IPv6 prefix "
"({prefixes}): \"{servers}\""
msgstr ""
"Los siguientes servidores de nombres son anunciados en el mismo prefijo IPv6 "
"({prefixes}): \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV6_SINGLE_PREFIX"
msgid ""
"All name server(s) IPv6 address(es) are announced in the same IPv6 prefix."
msgstr ""
"Todas las direcciones IPv6 de (los) servidor(es) de nombres son anunciadas "
"en el mismo prefijo IPv6."

msgctxt "CONNECTIVITY:ERROR_ASN_DATABASE"
msgid "ASN Database error. No data to analyze for {address}."
msgstr ""
"Error con la base de datos de números ASN. No hay datos para analizar "
"{address}."

msgctxt "CONNECTIVITY:EMPTY_ASN_SET"
msgid "AS database returned no informations for IP address {address}."
msgstr ""
"La base de datos de números ASN no tiene información para la dirección IP "
"{address}."

msgctxt "CONNECTIVITY:IPV4_SAME_ASN"
msgid ""
"All authoritative nameservers have their IPv4 addresses in the same AS set "
"({asns})."
msgstr ""
"Todos los servidores de nombres autoritativos tienen sus direcciones IPv4 en "
"el mismo grupo de AS ({asns})."

msgctxt "CONNECTIVITY:IPV4_ONE_ASN"
msgid ""
"All authoritative nameservers have their IPv4 addresses in the same AS "
"({asn})."
msgstr ""
"Todos los servidores de nombres autoritativos tienen sus direcciones IPv4 en "
"el mismo AS ({asn})."

msgctxt "CONNECTIVITY:IPV4_DIFFERENT_ASN"
msgid ""
"At least two IPv4 addresses of the authoritative nameservers are announced "
"by different AS sets. A merged list of all AS: ({asns})."
msgstr ""
"Al menos dos direcciones IPv4 de los servidores de nombres autoritativos son "
"anunciadas por grupos de AS distintos. Una lista combinada de todos los AS: "
"({asns})."

msgctxt "CONNECTIVITY:IPV6_SAME_ASN"
msgid ""
"All authoritative nameservers have their IPv6 addresses in the same AS set "
"({asns})."
msgstr ""
"Todos los servidores de nombres autoritativos tienen sus direcciones IPv6 en "
"el mismo grupo de AS ({asns})."

msgctxt "CONNECTIVITY:IPV6_ONE_ASN"
msgid ""
"All authoritative nameservers have their IPv6 addresses in the same AS "
"({asn})."
msgstr ""
"Todos los servidores de nombres autoritativos tienen sus direcciones IPv6 en "
"el mismo AS ({asn})."

msgctxt "CONNECTIVITY:IPV6_DIFFERENT_ASN"
msgid ""
"At least two IPv6 addresses of the authoritative nameservers are announced "
"by different AS sets. A merged list of all AS: ({asns})."
msgstr ""
"Al menos dos direcciones IPv6 de los servidores de nombres autoritativos son "
"anunciadas por grupos de AS distintos. Una lista combinada de todos los AS: "
"({asns})."

msgctxt "CONNECTIVITY:ASN_INFOS_ANNOUNCE_BY"
msgid "Name server IP address \"{address}\" is announced by ASN {asns}."
msgstr ""
"El servidor de nombres con la dirección IP \"{address}\" es anunciado por el "
"ASN {asns}."

msgctxt "CONSISTENCY:ADDRESSES_MATCH"
msgid "Glue records are consistent between glue and authoritative data."
msgstr ""
"Los registros \"glue\" son consistentes entre los datos \"glue\" y los "
"autoritativos."

msgctxt "CONSISTENCY:CHILD_NS_FAILED"
msgid "Unexpected or erroneous reply from {ns}/{address}."
msgstr "Respuesta inesperada o incorrecta desde {ns}/{address}."

msgctxt "CONSISTENCY:CHILD_ZONE_LAME"
msgid "Lame delegation."
msgstr "Delegación defectuosa (lame)."

msgctxt "CONSISTENCY:DELEGATION_NS_SET"
msgid "Saw delegation NS set ({ns_set_servers}) from parent name server(s) ({servers})."
msgstr "Se observó el grupo de NS ({ns_set_servers}) en la delegación de los servidores de nombres ({servers})."

msgctxt "CONSISTENCY:EXTRA_ADDRESS_CHILD"
msgid ""
"Child has extra nameserver IP address(es) not listed at parent "
"({addresses})."
msgstr ""
"El hijo tiene direccion(es) IP adicionales de servidores de nombre no "
"presentes en el padre ({addresses})."

msgctxt "CONSISTENCY:IN_DOMAIN_ADDR_MISMATCH"
msgid ""
"In-domain name server {ns} listed at parent has a mismatch between glue "
"data at parent ({parent_servers}) and the address records in the child "
"zone ({zone_servers})."
msgstr ""
"El servidor de nombres dependiente (\"in-domain\") {ns} presente en el "
"padre no calza entre los datos \"glue\" en el padre ({parent_servers}) "
"y las direcciones en el hijo ({zone_servers})."

msgctxt "CONSISTENCY:INCONSISTENT_NS_TTL"
msgid "Name servers serve the zone's NS records with {count} distinct TTL values."
msgstr "Los servidores de nombres sirven los registros NS de la zona con {count} valores de TTL distintos."

msgctxt "CONSISTENCY:MISSING_ADDRESS_CHILD"
msgid ""
"In-domain name server {ns} has glue in the delegation but no address "
"record in the child zone."
msgstr ""
"El servidor de nombres dependiente (\"in-domain\") {ns} tiene datos "
"\"glue\" en la delegación, pero el hijo no publica ninguna dirección "
"para él."

msgctxt "CONSISTENCY:MULTIPLE_DELEGATION_NS_SET"
msgid "Found {count} different delegation NS sets at the parent name servers. Name server names not served by all parents: ({ns_names})."
msgstr "Se encontraron {count} grupos de NS diferentes en la delegación de los servidores de nombres de la zona padre. Nombres de servidores de nombres que no entregan todos los servidores padre: ({ns_names})."

msgctxt "CONSISTENCY:MULTIPLE_NS_SET"
msgid "Found {count} NS set(s)."
msgstr "Se encontraron {count} grupo(s) de NS."

msgctxt "CONSISTENCY:MULTIPLE_SOA_MNAMES"
msgid "Saw {count} SOA mname."
msgstr "Se encontraron {count} campos mname en el SOA."

msgctxt "CONSISTENCY:MULTIPLE_SOA_RNAMES"
msgid "Found {count} SOA rname(s)."
msgstr "Se encontraron {count} campos rname en el SOA."

msgctxt "CONSISTENCY:MULTIPLE_SOA_SERIALS"
msgid "Found {count} SOA serial number(s)."
msgstr "Se encontraron {count} números seriales en el SOA."

msgctxt "CONSISTENCY:MULTIPLE_SOA_TIME_PARAMETER_SET"
msgid "Found {count} SOA time parameter set(s)."
msgstr "Se encontraron {count} grupos de parámetros de tiempo en el SOA."

msgctxt "CONSISTENCY:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "El servidor de nombres {ns} no respondió."

msgctxt "DNSSEC:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "El servidor de nombres {ns} no respondió."

msgctxt "ZONE:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "El servidor de nombres {ns} no respondió."

msgctxt "CONSISTENCY:NO_RESPONSE_NS_QUERY"
msgid "No response from nameserver {ns}/{address} on NS queries."
msgstr "No hay respuesta del servidor de nombres {ns}/{address} a las consultas NS."

msgctxt "CONSISTENCY:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver {ns}/{address} on SOA queries."
msgstr "No hay respuesta del servidor de nombres {ns}/{address} a las consultas SOA."

msgctxt "CONSISTENCY:NS_SET"
msgid "Saw NS set ({ns_set_servers}) on following nameserver set : {servers}."
msgstr ""
"Se encontró un grupo de NS ({ns_set_servers}) en el siguiente grupo de "
"servidores de nombres : {servers}."

msgctxt "CONSISTENCY:ONE_NS_SET"
msgid "A single NS set was found ({servers})."
msgstr "Se encontró un grupo de NS único ({servers})."

msgctxt "CONSISTENCY:ONE_SOA_MNAME"
msgid "A single SOA mname value was seen ({mname})."
msgstr "Se encontró un valor único del campo mname del registro SOA ({mname})."

msgctxt "CONSISTENCY:ONE_SOA_RNAME"
msgid "A single SOA rname value was found ({rname})."
msgstr "Se encontró un valor único del campo rname del registro SOA ({rname})."

msgctxt "CONSISTENCY:ONE_SOA_SERIAL"
msgid "A single SOA serial number was found ({serial})."
msgstr ""
"Se encontró un valor único de número serial del registro SOA ({serial})."

msgctxt "CONSISTENCY:ONE_SOA_TIME_PARAMETER_SET"
msgid ""
"A single SOA time parameter set was seen (REFRESH={refresh},RETRY={retry},"
"EXPIRE={expire},MINIMUM={minimum})."
msgstr ""
"Se encontró un valor único de parámetros de tiempo del registro SOA "
"(REFRESH={refresh},RETRY={retry},EXPIRE={expire},MINIMUM={minimum})."

msgctxt "CONSISTENCY:NOT_IN_DOMAIN_ADDR_MISMATCH"
msgid ""
"Not-in-domain name server listed at parent with glue record has a "
"mismatch between the glue at the parent ({parent_servers}) and any "
"equivalent address record found in authoritative zone ({zone_servers})."
msgstr ""
"Un servidor de nombres fuera de dependencia (\"not-in-domain\") presente "
"en el padre no calza entre los datos \"glue\" en el padre "
"({parent_servers}) y todas las direcciones equivalentes en el hijo "
"({zone_servers})."

msgctxt "CONSISTENCY:SOA_RNAME"
msgid "Found SOA rname {rname} on following nameserver set : {servers}."
msgstr ""
"Se encontró el campo {rname} del SOA en el siguiente grupo de servidores de "
"nombres : {servers}."

msgctxt "CONSISTENCY:SOA_SERIAL"
msgid "Saw SOA serial number {serial} on following nameserver set : {servers}."
msgstr ""
"Se encontró el número serial{serial} del SOA en el siguiente grupo de "
"servidores de nombres : {servers}."

msgctxt "CONSISTENCY:SOA_SERIAL_VARIATION"
msgid ""
"Difference between the smaller serial ({serial_min}) and the bigger one "
"({serial_max}) is greater than the maximum allowed ({max_variation})."
msgstr ""
"La diferencia entre el número serial más pequeño ({serial_min}) y el más "
"grande ({serial_max}) es mayor que el máximo permitido ({max_variation})."

msgctxt "CONSISTENCY:SOA_TIME_PARAMETER_SET"
msgid ""
"Saw SOA time parameter set (REFRESH={refresh}, RETRY={retry}, "
"EXPIRE={expire}, MINIMUM={minimum}) on following nameserver set : {servers}."
msgstr ""
"Se encontró el grupo de parámetros de tiempo del SOA \"REFRESH={refresh}, "
"RETRY={retry}, EXPIRE={expire}, MINIMUM={minimum}\" en el siguiente grupo de "
"servidores de nombres : {servers}."

msgctxt "DNSSEC:DNSKEY_SMALLER_THAN_REC"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) smaller than the recommended one ({keysizerec})."
msgstr ""
"La llave DNSKEY con tag {keytag} que usa el algoritmo {algo_num} "
"({algo_descr}) tiene un tamaño ({keysize}) más pequeño que el recomendable "
"({keysizerec})."

msgctxt "DNSSEC:DNSKEY_TOO_SMALL_FOR_ALGO"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) smaller than the minimum one ({keysizemin})."
msgstr ""
"La llave DNSKEY con tag {keytag} que usa el algoritmo {algo_num} "
"({algo_descr}) tiene un tamaño ({keysize}) más pequeño que el mínimo "
"({keysizemin})."

msgctxt "DNSSEC:DNSKEY_TOO_LARGE_FOR_ALGO"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) larger than the maximum one ({keysizemax})."
msgstr ""
"La llave DNSKEY con tag {keytag} que usa el algoritmo {algo_num} "
"({algo_descr}) tiene un tamaño ({keysize}) más grande que el máximo "
"({keysizemax})."

msgctxt "DNSSEC:DS01_DS_ALGO_DEPRECATED"
msgid ""
"The DS record with keytag {keytag} uses a deprecated digest algorithm "
"{ds_algo_num} ({ds_algo_descr}). Fetched from parent name servers "
"\"{servers}\"."
msgstr ""
"El registro DS con tag {keytag} utiliza el algoritmo de resumen "
"(\"digest\") obsoleto {ds_algo_num} ({ds_algo_descr}). Obtenido de los "
"servidores de nombres padre \"{servers}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_2_MISSING"
msgid ""
"No DS record created by digest algorithm 2 (SHA-256) is present for zone "
"{domain}."
msgstr ""
"No existe registro DS creado por el algoritmo de resumen 2 (SHA-256) para la "
"zona {domain}."

msgctxt "DNSSEC:DS01_DS_ALGO_NOT_DS"
msgid ""
"DS record for zone {domain} with keytag {keytag} was created by digest "
"algorithm {ds_algo_num} ({ds_algo_mnemo}) which is not meant for DS. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El registro DS para la zona {domain} con tag {keytag} fue creado por un "
"algoritmo de resumen (\"digest\") {ds_algo_num} ({ds_algo_mnemo}) que no "
"está destinado para DS. Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_RESERVED"
msgid ""
"DS record for zone {domain} with keytag {keytag} was created with an "
"unassigned digest algorithm (algorithm number {ds_algo_num}). Fetched from "
"the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El registro DS para la zona {domain} con tag {keytag} fue creado por un "
"algoritmo de resumen (\"digest\") (número de algoritmo {ds_algo_num} que no "
"está asignado. Obtenido de los servidores de nombres con direcciones IP "
"\"{addresses}\"."

msgctxt "DNSSEC:DS02_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses algorithm {algo_num} ({algo_mnemo}), which is "
"not supported by this installation. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"El registro DNSKEY con tag {keytag} usa un algoritmo no soportado "
"{algo_num} ({algo_mnemo}) por esta instalación. Obtenido de los servidores "
"de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS08_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses algorithm {algo_num} ({algo_mnemo}), which is "
"not supported by this installation. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"El registro DNSKEY con tag {keytag} usa un algoritmo no soportado "
"{algo_num} ({algo_mnemo}) por esta instalación. Obtenido de los servidores "
"de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS09_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses algorithm {algo_num} ({algo_mnemo}), which is "
"not supported by this installation. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"El registro DNSKEY con tag {keytag} usa un algoritmo no soportado "
"{algo_num} ({algo_mnemo}) por esta instalación. Obtenido de los servidores "
"de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_FOR_ZONE_SIGNING"
msgid ""
"Flags field of DNSKEY record with tag {keytag} has not ZONE bit set although "
"DS with same tag is present in parent. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"El campo Flags del registro DNSKEY con tag {keytag} no tiene encendido el "
"bit ZONE, pese a que hay un DS con el mismo tag en el padre. Obtenido de los "
"servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_SEP"
msgid ""
"Flags field of DNSKEY record with tag {keytag} has not SEP bit set although "
"DS with same tag is present in parent. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"El campo Flags del registro DNSKEY con tag {keytag} no tiene encendido el "
"bit SEP, pese a que hay un DS con el mismo tag en el padre. Obtenido de los "
"servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_SIGNED_BY_ANY_DS"
msgid ""
"The DNSKEY RRset has not been signed by any DNSKEY matched by a DS record. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El grupo de registros (RRset) DNSKEY no está firmado por algún registro "
"DNSKEY que calce con un registro DS. Obtenido de los servidores de nombres "
"con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_DNSKEY_FOR_DS"
msgid ""
"The DNSKEY record with tag {keytag} that the DS refers to does not exist in "
"the DNSKEY RRset. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"El registro DNSKEY con tag {keytag}, que es referido desde el DS, no existe "
"en el grupo de llaves (RRset) del DNSKEY. Obtenido de los servidores de "
"nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_MATCHING_DNSKEY_RRSIG"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY with tag {keytag} that the DS "
"record refers to. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"El grupo de llaves (RRset) del DNSKEY no está firmado por la DNSKEY con tag "
"{keytag}, que es referida desde el registro DS. Obtenido de los servidores "
"de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_MATCH_DS_DNSKEY"
msgid ""
"The DS record does not match the DNSKEY with tag {keytag} by algorithm or "
"digest. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"El registro DS no calza con la DNSKEY con tag {keytag}, por algoritmo o "
"resumen (digest). Obtenido de los servidores de nombres con direcciones IP "
"\"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_VALID_DNSKEY_FOR_ANY_DS"
msgid ""
"There is no valid DNSKEY matched by any of the DS records. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"No hay DNSKEY válido que calce con alguno de los registros DS. Obtenido de "
"los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS02_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"El grupo de llaves (RRset) del DNSKEY está firmado por un RRSIG con tag "
"{keytag} que no puede ser validada por la llave DNSKEY corresponiente. "
"Obtenido de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS02_MATCH_DS_DNSKEY"
msgid ""
"The DS record matches the DNSKEY and the DNSKEY RRSIG is valid. Found at "
"the nameservers with IP addresses \"{addresses}\"."
msgstr "El registro DS coincide con el DNSKEY y el RRSIG del DNSKEY es válido. Encontrado en los servidores de nombres con las direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS08_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"El grupo de llaves (RRset) del DNSKEY está firmado por un RRSIG con tag "
"{keytag} que no puede ser validada por la llave DNSKEY corresponiente. "
"Obtenido de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS03_ERROR_RESPONSE_NSEC_QUERY"
msgid ""
"The following servers give erroneous response to NSEC query. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Los siguientes servidores entregan respuestas incorrectas a consultas NSEC. "
"Obtenido de los servidores de nombres: \"{servers}\"."

msgctxt "DNSSEC:DS03_ERR_MULT_NSEC3"
msgid ""
"Multiple NSEC3 records when one is expected. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Hay múltiples registros NSEC3 y se espera solo uno. Obtenido desde los "
"servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_ERR_MULT_NSEC3"
msgid ""
"Multiple NSEC3 records when one is expected. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Hay múltiples registros NSEC3 y se espera solo uno. Obtenido desde los "
"servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS03_ILLEGAL_HASH_ALGO"
msgid ""
"The following servers respond with an illegal hash algorithm for NSEC3 "
"({algo_num}). Fetched from name servers \"{servers}\"."
msgstr ""
"Los siguientes servidores responden con un algoritmo de hash ilegal "
"({algo_num}) para NSEC3. Obtenido de los servidores de nombres: "
"\"{servers}\"."

msgctxt "DNSSEC:DS03_ILLEGAL_ITERATION_VALUE"
msgid ""
"The following servers respond with the NSEC3 iteration value {int}. The "
"recommended practice is to set this value to 0. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Los siguientes servidores responden con un valor de iteración NSEC3 {int}. "
"La práctica recomendada es dejar este valor en 0. Obtenido de los servidores "
"de nombres: \"{servers}\"."

msgctxt "DNSSEC:DS03_ILLEGAL_SALT_LENGTH"
msgid ""
"The following servers respond with a non-empty salt in NSEC3 ({int} octets). "
"The recommended practice is to use an empty salt. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Los siguientes servidores responden con un salt no vacío en NSEC3 ({int} "
"octetos). La práctica recomendada es usar un salt vacío. Obtenido desde los "
"servidores de nombre \"{servers}\"."

msgctxt "DNSSEC:DS03_INCONSISTENT_HASH_ALGO"
msgid ""
"Inconsistent hash algorithm in NSEC3 in responses for the child zone from "
"different name servers."
msgstr ""
"Se obtienen respuestas inconsistentes de algoritmo de hash en NSEC3 para la "
"zona hija, desde distintos servidores de nombre."

msgctxt "DNSSEC:DS03_INCONSISTENT_ITERATION"
msgid ""
"Inconsistent NSEC3 iteration value in responses for the child zone from "
"different name servers."
msgstr ""
"Se obtienen respuestas inconsistentes de valor de iteraciones en NSEC3 para "
"la zona hija, desde distintos servidores de nombre."

msgctxt "DNSSEC:DS03_INCONSISTENT_NSEC3_FLAGS"
msgid ""
"Inconsistent NSEC3 flag list in responses for the child zone from different "
"name servers."
msgstr ""
"Se obtienen respuestas inconsistentes de lista de flags en NSEC3 para la "
"zona hija, desde distintos servidores de nombre."

msgctxt "DNSSEC:DS03_INCONSISTENT_SALT_LENGTH"
msgid ""
"Inconsistent salt length in NSEC3 in responses for the child zone from "
"different name servers."
msgstr ""
"Se obtienen respuestas inconsistentes de largo de salt en NSEC3 para la zona "
"hija, desde distintos servidores de nombre."

msgctxt "DNSSEC:DS03_LEGAL_EMPTY_SALT"
msgid ""
"The following servers respond with a legal empty salt in NSEC3. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Los siguientes servidores responden con un correcto salt vacío NSEC3. "
"Obtenido de los servidores de nombres: \"{servers}\"."

msgctxt "DNSSEC:DS03_LEGAL_HASH_ALGO"
msgid ""
"The following servers respond with a legal hash algorithm in NSEC3. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Los siguientes servidores responden con un algoritmo de salt NSEC3 correcto. "
"Obtenido de los servidores de nombres: \"{servers}\"."

msgctxt "DNSSEC:DS03_LEGAL_ITERATION_VALUE"
msgid ""
"The following servers respond with NSEC3 iteration value set to zero (as "
"recommended). Fetched from name servers \"{servers}\"."
msgstr ""
"Los siguientes servidores responden con un valor cero para la iteración "
"NSEC3 (según lo recomendado). Obtenido de los servidores de nombres: "
"\"{servers}\"."

msgctxt "DNSSEC:DS03_NO_DNSSEC_SUPPORT"
msgid ""
"The zone is not DNSSEC signed or not properly DNSSEC signed. Testing for "
"NSEC3 has been skipped. Fetched from name servers \"{servers}\"."
msgstr ""
"La zona no está firmada con DNSSEC o tiene problemas. Las pruebas de NSEC3 "
"serán suspendidas. Obtenido desde los servidores de nombre \"{servers}\"."

msgctxt "DNSSEC:DS03_NO_NSEC3"
msgid ""
"The zone does not use NSEC3. Testing for NSEC3 has been skipped. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"La zona no usa NSEC3. Las pruebas para NSEC3 han sido ignoradas. Obtenido de "
"los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS03_NO_RESPONSE_NSEC_QUERY"
msgid ""
"The following servers do not respond to NSEC query. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Los siguientes servidores no responden a consultas NSEC. Obtenido de los "
"servidores de nombres: \"{servers}\"."

msgctxt "DNSSEC:DS03_NSEC3_OPT_OUT_DISABLED"
msgid ""
"The following servers respond with NSEC3 opt-out disabled (as recommended). "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Los siguientes servidores responden con el opt-out NSEC3 inhabilitado (tal "
"como está recomendado). Obtenido de los servidores de nombres: \"{servers}\"."

msgctxt "DNSSEC:DS03_NSEC3_OPT_OUT_ENABLED_NON_TLD"
msgid ""
"The following servers respond with NSEC3 opt-out enabled. The recommended "
"practice is to disable opt-out. Fetched from name servers \"{servers}\"."
msgstr ""
"Los siguientes servidores responden con el opt-out NSEC3 habilitado. La "
"práctica recomendada es inhabilitar opt-out. Obtenido de los servidores de "
"nombres: \"{servers}\"."

msgctxt "DNSSEC:DS03_NSEC3_OPT_OUT_ENABLED_TLD"
msgid ""
"The following servers respond with NSEC3 opt-out enabled. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Los siguientes servidores responden con el opt-out NSEC3 habilitado. "
"Obtenido de los servidores de nombres: \"{servers}\"."

msgctxt "DNSSEC:DS03_SERVER_NO_DNSSEC_SUPPORT"
msgid ""
"The following name servers do not support DNSSEC or have not been properly "
"configured. Testing for NSEC3 has been skipped on those servers. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Los siguientes servidores no soportan DNSSEC o no han sido correctamente "
"configurados. Las pruebas NSEC3 serán omitidas en estos servidores. Obtenido "
"de los servidores de nombres: \"{servers}\"."

msgctxt "DNSSEC:DS03_SERVER_NO_NSEC3"
msgid ""
"The following name servers do not use NSEC3, but others do. Testing for "
"NSEC3 has been skipped on the following servers. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Los siguientes servidores no usan NSEC3, pero otros sí. Las pruebas NSEC3 "
"serán omitidas en los siguientes servidores. Obtenido de los servidores de "
"nombres: \"{servers}\"."

msgctxt "DNSSEC:DS03_UNASSIGNED_FLAG_USED"
msgid ""
"The following servers respond with an NSEC3 record where an unassigned flag "
"is used (bit {int}). Fetched from name servers \"{servers}\"."
msgstr ""
"Los siguientes servidores responden con un registro NSEC3 que utiliza un "
"flag sin asignar (bit {int}). Obtenido de los servidores de nombres: "
"\"{servers}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type DNSKEY has already expired. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La firma RRSIG con tag de llave {keytag} y que cubre el tipo DNSKEY está "
"expirada. Obtenido de los servidores de nombres con direcciones IP "
"\"{addresses}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_NOT_YET_VALID"
msgid ""
"RRSIG with keytag {keytag} and covering type DNSKEY has inception date in "
"the future. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La firma RRSIG con tag de llave {keytag} y que cubre el tipo DNSKEY tiene su "
"fecha de comienzo en el futuro. Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS08_MISSING_RRSIG_IN_RESPONSE"
msgid ""
"The DNSKEY RRset is not signed, which is against expectation. Fetched from "
"the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El grupo de llaves (RRset) del DNSKEY no está firmado, que va en contra de "
"lo esperado. Obtenido de los servidores de nombres con direcciones IP "
"\"{addresses}\"."

msgctxt "DNSSEC:DS08_NO_MATCHING_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which does not "
"match any DNSKEY record. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"El grupo de llaves (RRset) del DNSKEY está firmado con un RRSIG con tag "
"{keytag} que no calza con ningún registro DNSKEY. Obtenido de los servidores "
"de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_VALID"
msgid ""
"The DNSKEY RRset has valid RRSIG records. Found at the nameservers with IP "
"addresses \"{addresses}\"."
msgstr "El conjunto de registros DNSKEY tiene registros RRSIG válidos. Encontrado en los servidores de nombres con las direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS09_MISSING_RRSIG_IN_RESPONSE"
msgid ""
"The SOA RRset is not signed, which is against expectation. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El registro SOA no está firmado, que va en contra de lo esperado. Obtenido "
"de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS09_NO_MATCHING_DNSKEY"
msgid ""
"The SOA RRset is signed with an RRSIG with tag {keytag} which does not match "
"any DNSKEY record. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"El registro SOA está firmado con un RRSIG con tag {keytag} que no calza con "
"ningún registro DNSKEY. Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS09_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The SOA RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"El registro SOA está firmado con un RRSIG con tag {keytag} que no puede ser "
"validado con el DNSKEY correspondiente. Obtenido de los servidores de "
"nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type SOA has already expired. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La firma RRSIG con tag de llave {keytag} y que cubre el tipo SOA está "
"expirada. Obtenido de los servidores de nombres con direcciones IP "
"\"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_NOT_YET_VALID"
msgid ""
"RRSIG with keytag {keytag} and covering type SOA has inception date in the "
"future. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La firma RRSIG con tag de llave {keytag} y que cubre el tipo SOA tiene su "
"fecha de comienzo en el futuro. Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_VALID"
msgid ""
"The SOA RRset has valid RRSIG records. Found at the nameservers with IP "
"addresses \"{addresses}\"."
msgstr "El conjunto de registros SOA tiene registros RRSIG válidos. Encontrado en los servidores de nombres con las direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS10_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses algorithm {algo_num} ({algo_mnemo}), which is "
"not supported by this installation. Fetched from name servers "
"\"{addresses}\"."
msgstr ""
"El registro DNSKEY con tag {keytag} usa un algoritmo no soportado "
"{algo_num} ({algo_mnemo}) en esta instalación. Obtenido de los servidores "
"de nombres \"{addresses}\"."

msgctxt "DNSSEC:DS10_ERR_MULT_NSEC"
msgid ""
"Multiple NSEC records when one is expected. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Hay múltiples registros NSEC3 y se espera solo uno. Obtenido desde los "
"servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_EXPECTED_NSEC_NSEC3_MISSING"
msgid ""
"The server responded with DNSKEY but not with expected NSEC or NSEC3. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"El servidor respondió con DNSKEY pero no con los esperados NSEC o NSEC3. "
"Obtenido de los servidores de nombre \"{servers}\"."

msgctxt "DNSSEC:DS10_HAS_NSEC"
msgid "The zone has NSEC records. Fetched from name servers \"{servers}\"."
msgstr ""
"La zona tiene registros NSEC. Obtenido de los servidores de nombres "
"\"{servers}\"."

msgctxt "DNSSEC:DS10_HAS_NSEC3"
msgid "The zone has NSEC3 records. Fetched from name servers \"{servers}\"."
msgstr ""
"La zona tiene registros NSEC3. Obtenido de los servidores de nombres "
"\"{servers}\"."

msgctxt "DNSSEC:DS10_INCONSISTENT_NSEC"
msgid ""
"Inconsistent responses from zone with NSEC. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Respuestas inconsistentes de la zona con NSEC. Obtenido de los servidores de "
"nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_INCONSISTENT_NSEC3"
msgid ""
"Inconsistent responses from zone with NSEC3. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Respuestas inconsistentes de la zona con NSEC3. Obtenido de los servidores "
"de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_INCONSISTENT_NSEC_NSEC3"
msgid "The zone is inconsistent on NSEC and NSEC3. Fetched from name servers \"{servers}\"."
msgstr "La zona es inconsistente entre NSEC y NSEC3. Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_MIXED_NSEC_NSEC3"
msgid ""
"The zone responds with both NSEC and NSEC3, where only one of them is "
"expected. Fetched from name servers \"{servers}\"."
msgstr ""
"La zona responde con NSEC y NSEC3, pero debería ser solo uno de ellos. "
"Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NONSTANDARD_NSEC_RESPONSE"
msgid ""
"NSEC query returned NSEC in the authority section instead of the answer "
"section (RFC 4470 / RFC 9824). Fetched from name servers \"{servers}\"."
msgstr ""
"La consulta NSEC devolvió el registro NSEC en la sección de autoridad en "
"lugar de la sección de respuesta (RFC 4470 / RFC 9824). Obtenido desde los "
"servidores de nombre \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3PARAM_GIVES_ERR_ANSWER"
msgid ""
"Unexpected DNS record in the answer section on an NSEC3PARAM query. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Registro DNS inesperado en la sección \"answer\", ante una consulta "
"NSEC3PARAM. Obtenido desde los servidores de nombre \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3PARAM_MISMATCHES_APEX"
msgid ""
"The returned NSEC3PARAM record has an unexpected non-apex owner name. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"El registro NSEC3PARAM retornado tiene un nombre de origen inesperado fuera "
"del ápex. Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3PARAM_QUERY_RESPONSE_ERR"
msgid ""
"No response or error in response on query for NSEC3PARAM. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"No hay respuesta o hay un error en la respuesta a una consulta NSEC3PARAM. "
"Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_ERR_TYPE_LIST"
msgid ""
"NSEC3 record for the zone apex with incorrect type list. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"El registro NSEC3 para el ápex de la zona tiene una lista de tipos "
"incorrecta. Obtenido desde los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_MISMATCHES_APEX"
msgid ""
"The returned NSEC3 record unexpectedly does not match the zone name. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"El registro NSEC3 retornado inesperadamente no calza con el nombre de la "
"zona. Obtenido de los servidores de nombre \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_MISSING_SIGNATURE"
msgid ""
"Missing RRSIG (signature) for the NSEC3 record or records. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Faltan las firmas (RRSIG) en el registro o registros NSEC3. Obtenido de los "
"servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_NODATA_MISSING_SOA"
msgid ""
"Missing SOA record in NODATA response with NSEC3. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Falta el registro SOA en la respuesta NODATA con NSEC3. Obtenido desde los "
"servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_NODATA_WRONG_SOA"
msgid ""
"Wrong owner name (\"{domain}\") on SOA record in NODATA response with NSEC3. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"El nombre de origen (\"{domain}\") es incorrecto en el registro SOA, para la "
"respuesta NODATA con NSEC3. Obtenido de los servidores de nombre "
"\"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_NO_VERIFIED_SIGNATURE"
msgid ""
"The RRSIG (signature) for the NSEC3 record cannot be verified. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Las firmas (RRSIG) para el registro NSEC3 no pueden ser verificadas. "
"Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_EXPIRED"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC3 record has expired. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"La firma RRSIG con tag de llave {keytag} para el registro NSEC3 está "
"expirada. Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_NOT_YET_VALID"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC3 record it not yet "
"valid. Fetched from name servers \"{servers}\"."
msgstr ""
"La firma RRSIG con tag {keytag} para el registro NSEC3 aún no es válida. "
"Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_NO_DNSKEY"
msgid ""
"There is no DNSKEY record matching the RRSIG (signature) with tag {keytag} "
"for the NSEC3 record. Fetched from name servers \"{servers}\"."
msgstr ""
"No existe registro DNSKEY que calce con el tag {keytag} de la firma RRSIG "
"para el registro NSEC3. Obtenido de los servidores de nombre \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_VERIFY_ERROR"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC3 record cannot be "
"verified. Fetched from name servers \"{servers}\"."
msgstr ""
"Las firmas (RRSIG) con tag {keytag} para el registro NSEC3 no pueden ser "
"verificadas. Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_ERR_TYPE_LIST"
msgid ""
"NSEC record for the zone apex with incorrect type list. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"El registro NSEC para el ápex de la zona tiene una lista de tipos "
"incorrecta. Obtenido desde los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_GIVES_ERR_ANSWER"
msgid ""
"Unexpected DNS record in the answer section on an NSEC query. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Registro DNS inesperado en la sección \"answer\", ante una consulta NSEC. "
"Obtenido desde los servidores de nombre \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_MISMATCHES_APEX"
msgid ""
"The returned NSEC record has an unexpected non-apex owner name. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"El registro NSEC retornado tiene un nombre de origen inesperado fuera del "
"ápex. Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_MISSING_SIGNATURE"
msgid ""
"Missing RRSIG (signature) for the NSEC record or records. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Faltan las firmas (RRSIG) en el registro o registros NSEC. Obtenido de los "
"servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_NODATA_MISSING_SOA"
msgid ""
"Missing SOA record in NODATA response with NSEC. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Falta el registro SOA en la respuesta NODATA con NSEC. Obtenido desde los "
"servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_NODATA_WRONG_SOA"
msgid ""
"Wrong owner name (\"{domain}\") on SOA record in NODATA response with NSEC. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"El nombre de origen (\"{domain}\") es incorrecto en el registro SOA, para la "
"respuesta NODATA con NSEC. Obtenido de los servidores de nombre "
"\"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_NO_VERIFIED_SIGNATURE"
msgid ""
"There is no RRSIG (signature) for the NSEC record that can be verified. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"No existen RRSIG (firmas) para el registro NSEC que puedan ser verificadas. "
"Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_QUERY_RESPONSE_ERR"
msgid ""
"No response or error in response on query for NSEC. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"No hay respuesta o hay un error en la respuesta a una consulta NSEC. "
"Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_EXPIRED"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC record has expired. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"La firma RRSIG con tag de llave {keytag} para el registro NSEC está "
"expirada. Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_NOT_YET_VALID"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC record it not yet "
"valid. Fetched from name servers \"{servers}\"."
msgstr ""
"La firma RRSIG con tag {keytag} para el registro NSEC aún no es válida. "
"Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_NO_DNSKEY"
msgid ""
"There is no DNSKEY record matching the RRSIG (signature) with tag {keytag} "
"for the NSEC record. Fetched from name servers \"{servers}\"."
msgstr ""
"No existe registro DNSKEY que calce con el tag {keytag} de la firma RRSIG "
"para el registro NSEC. Obtenido de los servidores de nombre \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_VERIFY_ERROR"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC record cannot be "
"verified. Fetched from name servers \"{servers}\"."
msgstr ""
"Las firmas (RRSIG) con tag {keytag} para el registro NSEC no pueden ser "
"verificadas. Obtenido de los servidores de nombres \"{servers}\"."

msgctxt "DNSSEC:DS10_SERVER_NO_DNSSEC"
msgid ""
"The following name servers do not support DNSSEC or have not been properly "
"configured. Testing for NSEC and NSEC3 has been skipped on these servers. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Los siguientes servidores no soportan DNSSEC o no han sido correctamente "
"configurados. Las pruebas NSEC y NSEC3 serán omitidas en estos servidores. "
"Obtenido de los servidores de nombres: \"{servers}\"."

msgctxt "DNSSEC:DS10_ZONE_NO_DNSSEC"
msgid ""
"The zone is not DNSSEC signed or not properly DNSSEC signed. Testing for "
"NSEC and NSEC3 has been skipped. Fetched from name servers \"{servers}\"."
msgstr ""
"La zona no está firmada con DNSSEC o tiene problemas. Las pruebas de NSEC y "
"NSEC3 serán suspendidas. Obtenido desde los servidores de nombre "
"\"{servers}\"."

msgctxt "DNSSEC:DS11_INCONSISTENT_DS"
msgid "Parent name servers are inconsistent on the existence of DS."
msgstr ""
"Los servidores de nombre padre son inconsistentes en la existencia del DS."

msgctxt "DNSSEC:DS11_INCONSISTENT_SIGNED_ZONE"
msgid ""
"Name servers for the child zone are inconsistent on whether the zone is "
"signed or not."
msgstr ""
"Los servidores de nombre para la zona hija son inconsistentes sobre si la "
"zona está firmada o no."

msgctxt "DNSSEC:DS11_UNDETERMINED_DS"
msgid ""
"It cannot be determined if the parent zone has DS for the child zone or not."
msgstr ""
"No se puede determinar si la zona padre tiene DS para la zona hija o no."

msgctxt "DNSSEC:DS11_UNDETERMINED_SIGNED_ZONE"
msgid "It cannot be determined if the child zone is signed or not."
msgstr "No se puede determinar si la zona hija está firmada o no."

msgctxt "DNSSEC:DS11_PARENT_WITHOUT_DS"
msgid ""
"No DS record for the child zone found on parent nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"No hay registro DS para la zona hija en los servidores de nombre del padre "
"con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS11_PARENT_WITH_DS"
msgid ""
"DS record for the child zone found on parent nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Encontrado registro DS para la zona hija en los servidores de nombre del "
"padre con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS11_NS_WITH_SIGNED_ZONE"
msgid ""
"Signed child zone found on nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Se encontró zona hija firmada en los servidores de nombres con direcciones "
"IP \"{addresses}\"."

msgctxt "DNSSEC:DS11_NS_WITH_UNSIGNED_ZONE"
msgid ""
"Unsigned child zone found on nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Se encontró zona hija sin firmar en los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS11_DS_BUT_UNSIGNED_ZONE"
msgid "The child zone is unsigned, but the parent zone has DS record."
msgstr "La zona hija no está firmada, pero la zona padre tiene registro DS."

msgctxt "DNSSEC:DS11_CONSISTENT_SIGNED"
msgid "Parent DS and child DNSKEY are consistent - the zone is signed."
msgstr "El DS del padre y el DNSKEY del hijo son coherentes - la zona está firmada."

msgctxt "DNSSEC:DS11_NO_PARENT_DS"
msgid "No DS records found at the parent - the zone is unsigned from the parent view."
msgstr "No se encontraron registros DS en el padre - la zona no está firmada desde el punto de vista del padre."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_DNSKEY"
msgid ""
"The DNSKEY RRset is not signed by algorithm {algo_num} ({algo_mnemo}) "
"present in the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"El grupo de llaves (RRset) del DNSKEY no está firmado por el algoritmo "
"{algo_num} ({algo_mnemo}) presente en el RRset DNSKEY. Obtenido de los "
"servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_NS"
msgid ""
"The NS RRset is not signed by algorithm {algo_num} ({algo_mnemo}) present in "
"the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"El grupo de registros (RRset) NS no está firmado por el algoritmo {algo_num} "
"({algo_mnemo}) presente en el RRset DNSKEY. Obtenido de los servidores de "
"nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_SOA"
msgid ""
"The SOA RRset is not signed by algorithm {algo_num} ({algo_mnemo}) present "
"in the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"El registro SOA no está firmado por el algoritmo {algo_num} ({algo_mnemo}) "
"presente en el RRset DNSKEY. Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALL_ALGOS_SIGNED"
msgid "All DNSKEY algorithms have RRSIG coverage in DNSKEY, SOA, and NS answers."
msgstr "Todos los algoritmos DNSKEY tienen cobertura RRSIG en las respuestas DNSKEY, SOA y NS."

msgctxt "DNSSEC:DS15_CDS_NON_MUST_DIGEST"
msgid ""
"CDS records with non-mandatory digest types are found on nameservers that "
"resolve to IP addresses ({addresses}); parents ignore them."
msgstr ""
"Los servidores de nombres que corresponden a las direcciones IP "
"\"{addresses}\" entregan registros CDS con tipos de resumen no "
"obligatorios; la zona padre los ignora."

msgctxt "DNSSEC:DS15_HAS_CDNSKEY_NO_CDS"
msgid ""
"CDNSKEY RRset is found on nameservers that resolve to IP addresses "
"({addresses}), but no CDS RRset."
msgstr ""
"Los servidores de nombres que corresponden a las direcciones IP "
"\"{addresses}\" entregan registros CDNSKEY, pero no existen registros CDS."

msgctxt "DNSSEC:DS15_HAS_CDS_AND_CDNSKEY"
msgid ""
"CDNSKEY and CDS RRsets are found on nameservers that resolve to IP addresses "
"({addresses})."
msgstr ""
"Los servidores de nombres que corresponden a las direcciones IP "
"\"{addresses}\" entregan registros CDNSKEY y CDS."

msgctxt "DNSSEC:DS15_HAS_CDS_NO_CDNSKEY"
msgid ""
"CDS RRset is found on nameservers that resolve to IP addresses "
"({addresses}), but no CDNSKEY RRset."
msgstr ""
"Los servidores de nombres que corresponden a las direcciones IP "
"\"{addresses}\" entregan registros CDS, pero no existen registros CDNSKEY."

msgctxt "DNSSEC:DS15_INCONSISTENT_CDNSKEY"
msgid "All servers do not have the same CDNSKEY RRset."
msgstr "Todos los servidores no tienen los mismos registros CDNSKEY."

msgctxt "DNSSEC:DS15_INCONSISTENT_CDS"
msgid "All servers do not have the same CDS RRset."
msgstr "Todos los servidores no tienen los mismos registros CDS."

msgctxt "DNSSEC:DS15_MISMATCH_CDS_CDNSKEY"
msgid ""
"Both CDS and CDNSKEY RRsets are found on nameservers that resolve to IP "
"addresses ({addresses}) but they do not match."
msgstr ""
"Los servidores de nombres que corresponden a las direcciones IP "
"\"{addresses}\" entregan registros CDS y CDNSKEY, pero no calzan."

msgctxt "DNSSEC:DS15_NO_CDS_CDNSKEY"
msgid "No CDS or CDNSKEY RRsets are found on any name server."
msgstr "No existen registros CDS ni CDNSKEY en ningún servidor de nombres."

msgctxt "DNSSEC:DS16_CDS_INVALID_RRSIG"
msgid ""
"The CDS RRset is signed with an RRSIG with tag {keytag}, but the RRSIG does "
"not match the DNSKEY with the same key tag. Fetched from the nameservers "
"with IP addresses \"{addresses}\"."
msgstr ""
"Los registros CDS están firmados con un RRSIG con tag {keytag}, pero el "
"RRSIG no calza con el DNSKEY con el mismo tag. Obtenido de los servidores de "
"nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NON_SEP_DNSKEY"
msgid ""
"The CDS record with tag {keytag} matches a DNSKEY record with SEP bit (bit "
"15) unset. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El registro CDS con tag {keytag} calza con un registro DNSKEY que no tiene "
"encendido el bit SEP (bit 15). Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NON_ZONE_DNSKEY"
msgid ""
"The CDS record with tag {keytag} matches a DNSKEY record with zone bit (bit "
"7) unset. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El registro CDS con tag {keytag} calza con un registro DNSKEY que no tiene "
"encendido el bit ZONE (bit 7). Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NO_DNSKEY"
msgid ""
"The CDS record with tag {keytag} does not match any DNSKEY record. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El registro CDS con tag {keytag} no calza con ningún registro DNSKEY. "
"Obtenido de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_NOT_SIGNED_BY_CDS"
msgid ""
"The CDS RRset is not signed by the DNSKEY that the CDS record with tag "
"{keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"El grupo de registros (RRset) CDS no está firmado por el DNSKEY que el "
"registro CDS con tag {keytag} apunta. Obtenido de los servidores de nombres "
"con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_SIGNED_BY_UNKNOWN_DNSKEY"
msgid ""
"The CDS RRset is signed by RRSIG with tag {keytag} but that is not in the "
"DNSKEY RRset. Fetched from the nameservers with P addresses \"{addresses}\"."
msgstr ""
"Los registros CDS están firmados por un RRSIG con tag {keytag}, pero no "
"existe dentro del grupo de DNSKEY. Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_UNSIGNED"
msgid ""
"The CDS RRset is not signed. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Los registros CDS no están firmados. Obtenido de los servidores de nombres "
"con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_WITHOUT_DNSKEY"
msgid ""
"A CDS RRset exists, but no DNSKEY record exists. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Existe un registro CDS, pero no hay registros DNSKEY. Obtenido de los "
"servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS16_DELETE_CDS"
msgid ""
"A single \"delete\" CDS record is found on the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Existe un único registro CDS de borrado (\"delete\") en los servidores de "
"nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS16_DNSKEY_NOT_SIGNED_BY_CDS"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY that the CDS record with tag "
"{keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Los registros DNSKEY no están firmados con el DNSKEY que es referido por el "
"registro CDS con tag {keytag}. Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS16_MIXED_DELETE_CDS"
msgid ""
"The CDS RRset is a mixture between \"delete\" record and other records. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Los registros CDS son una mezcla de registros de borrado (\"delete\") y "
"otros registros. Obtenido de los servidores de nombres con direcciones IP "
"\"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_INVALID_RRSIG"
msgid ""
"The CDNSKEY RRset is signed with an RRSIG with tag {keytag}, but the RRSIG "
"does not match the DNSKEY with the same key tag. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Los registros DNSKEY están firmados con un RRSIG con tag {keytag}, pero el "
"RRSIG no calza con el DNSKEY con el mismo tag. Obtenido de los servidores de "
"nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_IS_NON_SEP"
msgid ""
"The CDNSKEY record with tag {keytag} has the SEP bit (bit 15) unset. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El registro CDNSKEY con tag {keytag} no tiene encendido el bit SEP (bit 15). "
"Obtenido de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_IS_NON_ZONE"
msgid ""
"The CDNSKEY record with tag {keytag} has the zone bit (bit 7) unset. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El registro CDNSKEY con tag {keytag} no tiene encendido el bit ZONE (bit 7). "
"Obtenido de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_MATCHES_NO_DNSKEY"
msgid ""
"The CDNSKEY record with tag {keytag} does not match any DNSKEY record. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El registro CDNSKEY con tag {keytag} no calza con ningún registro DNSKEY. "
"Obtenido de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_NOT_SIGNED_BY_CDNSKEY"
msgid ""
"The CDNSKEY RRset is not signed by the DNSKEY that the CDNSKEY record with "
"tag {keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"El grupo de registros (RRset) CDNSKEY no está firmado por el DNSKEY que el "
"registro CDNSKEY con tag {keytag} apunta. Obtenido de los servidores de "
"nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_SIGNED_BY_UNKNOWN_DNSKEY"
msgid ""
"The CDNSKEY RRset is signed by RRSIG with tag {keytag} but that is not in "
"the DNSKEY RRset. Fetched from the nameservers with P addresses "
"\"{addresses}\"."
msgstr ""
"Los registros CDNSKEY están firmados por un RRSIG con tag {keytag}, pero no "
"se encuentra en el grupo de DNSKEY. Obtenido de los servidores de nombres "
"con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_UNSIGNED"
msgid ""
"The CDNSKEY RRset is not signed. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Los registros CDNSKEY no están firmados. Obtenido de los servidores de "
"nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_WITHOUT_DNSKEY"
msgid ""
"A CDNSKEY RRset exists, but no DNSKEY record exists. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Existen registros CDNSKEY, pero no se encuentran registros DNSKEY. Obtenido "
"de los servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS17_DELETE_CDNSKEY"
msgid ""
"A single \"delete\" CDNSKEY record is found on the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Existe un único registro CDNSKEY de borrado (\"delete\") en los servidores "
"de nombres con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS17_DNSKEY_NOT_SIGNED_BY_CDNSKEY"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY that the CDNSKEY record with "
"tag {keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Los registros DNSKEY no están firmados con el DNSKEY que es referido por el "
"registro CDNSKEY con tag {keytag}. Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS17_MIXED_DELETE_CDNSKEY"
msgid ""
"The CDNSKEY RRset is a mixture between \"delete\" record and other records. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Los registros CDNSKEY son una mezcla de registros de borrado (\"delete\") y "
"otros registros. Obtenido de los servidores de nombres con direcciones IP "
"\"{addresses}\"."

msgctxt "DNSSEC:DS18_NO_MATCH_CDS_RRSIG_DS"
msgid ""
"The CDS RRset is not signed with a DNSKEY record that a DS record points to. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El grupo de registros (RRset) CDS no está firmado con un registro DNSKEY que "
"un registro DS apunte. Obtenido de los servidores de nombres con direcciones "
"IP \"{addresses}\"."

msgctxt "DNSSEC:DS18_NO_MATCH_CDNSKEY_RRSIG_DS"
msgid ""
"The CDNSKEY RRset is not signed with a DNSKEY record that a DS record points "
"to. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"El grupo de registros (RRset) CDNSKEY no está firmado con un registro DNSKEY "
"que un registro DS apunte. Obtenido de los servidores de nombres con "
"direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS18_MATCH_CDNSKEY_RRSIG_DS"
msgid ""
"The CDNSKEY RRset is signed by a DS-linked DNSKEY. Found at the nameservers "
"with IP addresses \"{addresses}\"."
msgstr "El conjunto de registros CDNSKEY está firmado por un DNSKEY vinculado a un DS. Encontrado en los servidores de nombres con las direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS18_MATCH_CDS_RRSIG_DS"
msgid ""
"The CDS RRset is signed by a DS-linked DNSKEY. Found at the nameservers "
"with IP addresses \"{addresses}\"."
msgstr "El conjunto de registros CDS está firmado por un DNSKEY vinculado a un DS. Encontrado en los servidores de nombres con las direcciones IP \"{addresses}\"."


msgctxt "DNSSEC:DS18_CDS_MATCHES_DS"
msgid "The CDS RRset content matches the parent DS RRset. No key change signaled."
msgstr "El contenido del conjunto de registros CDS coincide con el conjunto de registros DS del padre. No se ha señalado ningún cambio de clave."

msgctxt "DNSSEC:DS18_CDS_ROLLOVER_SIGNALED"
msgid "The CDS RRset content differs from the parent DS RRset, signaling a key change. CDS keytags: {cds_keytags}. DS keytags: {ds_keytags}."
msgstr "El contenido del conjunto de registros CDS difiere del conjunto de registros DS del padre, lo que señala un cambio de clave. Keytags CDS: {cds_keytags}. Keytags DS: {ds_keytags}."

msgctxt "DNSSEC:DS18_CDNSKEY_MATCHES_DS"
msgid "The CDNSKEY RRset content matches the parent DS RRset. No key change signaled."
msgstr "El contenido del conjunto de registros CDNSKEY coincide con el conjunto de registros DS del padre. No se ha señalado ningún cambio de clave."

msgctxt "DNSSEC:DS18_CDNSKEY_ROLLOVER_SIGNALED"
msgid "The CDNSKEY RRset content differs from the parent DS RRset, signaling a key change. CDNSKEY keytags: {cdnskey_keytags}. DS keytags: {ds_keytags}."
msgstr "El contenido del conjunto de registros CDNSKEY difiere del conjunto de registros DS del padre, lo que señala un cambio de clave. Keytags CDNSKEY: {cdnskey_keytags}. Keytags DS: {ds_keytags}."

msgctxt "DNSSEC:DS18_NO_CDS_CDNSKEY_BUT_ROLLOVER_EVIDENCE"
msgid "No CDS or CDNSKEY RRset found, but other rollover evidence is present. The operator likely uses on-demand CDS/CDNSKEY publication."
msgstr "No se encontró ningún conjunto de registros CDS o CDNSKEY, pero hay otra evidencia de rollover. Es probable que el operador use publicación CDS/CDNSKEY bajo demanda."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_DOUBLE_SIG"
msgid "The DNSKEY RRset is signed by more than one KSK keytag ({keytags}). A double-signature rollover phase may be in progress."
msgstr "El conjunto de registros DNSKEY está firmado por más de un keytag KSK ({keytags}). Puede haber una fase de rollover con doble firma en curso."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_DNSKEY_WITHOUT_DS"
msgid "Child SEP DNSKEY keytag(s) {keytags} have no matching DS record at the parent. A new KSK may be waiting for the parent DS to be updated."
msgstr "Los keytags SEP DNSKEY {keytags} de la zona hija no tienen un registro DS correspondiente en el padre. Una nueva KSK puede estar esperando a que se actualice el DS del padre."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_DS_WITHOUT_DNSKEY"
msgid "Parent DS keytag(s) {keytags} have no matching DNSKEY at the child. The old KSK may have been removed from the child zone."
msgstr "Los keytags DS {keytags} del padre no tienen una DNSKEY correspondiente en la zona hija. La KSK antigua puede haber sido retirada de la zona hija."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_MULTI_KSK"
msgid "Multiple SEP-flagged DNSKEYs found at the child zone (keytags: {keytags}). A KSK rollover may be in progress."
msgstr "Se encontraron varias DNSKEY con la bandera SEP en la zona hija (keytags: {keytags}). Puede haber un rollover de KSK en curso."

msgctxt "DNSSEC:DS19_BADKEY_FERMAT"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus vulnerable to Fermat factorization (close primes) on name server(s) "
"{servers}."
msgstr "DNSKEY con keytag {keytag} y algoritmo {algo_descr} ({algo_num}) tiene un módulo RSA vulnerable a la factorización de Fermat (primos cercanos) en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS19_BADKEY_PATTERN"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus with suspicious repeating byte pattern on name server(s) {servers}."
msgstr "DNSKEY con keytag {keytag} y algoritmo {algo_descr} ({algo_num}) tiene un módulo RSA con un patrón sospechoso de bytes repetidos en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS19_BADKEY_ROCA"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) is "
"vulnerable to ROCA attack (CVE-2017-15361) on name server(s) {servers}."
msgstr "DNSKEY con keytag {keytag} y algoritmo {algo_descr} ({algo_num}) es vulnerable al ataque ROCA (CVE-2017-15361) en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS19_BADKEY_RSA_INVALID"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has "
"invalid RSA parameters ({subtest}) on name server(s) {servers}."
msgstr "DNSKEY con keytag {keytag} y algoritmo {algo_descr} ({algo_num}) tiene parámetros RSA no válidos ({subtest}) en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS19_BADKEY_SMALL_D"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"private exponent recoverable via Wiener's attack on name server(s) {servers}."
msgstr "DNSKEY con keytag {keytag} y algoritmo {algo_descr} ({algo_num}) tiene un exponente privado RSA recuperable mediante el ataque de Wiener en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS19_BADKEY_SMALL_FACTORS"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus with small prime factors on name server(s) {servers}."
msgstr "DNSKEY con keytag {keytag} y algoritmo {algo_descr} ({algo_num}) tiene un módulo RSA con factores primos pequeños en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS19_BLOCKLIST_NOT_FOUND"
msgid ""
"Badkeys blocklist data not found. Blocklist check skipped. Run 'gonemaster "
"--badkeys-update' to download the blocklist."
msgstr "No se encontraron los datos de la lista de bloqueo de Badkeys. Se omitió la comprobación de la lista de bloqueo. Ejecute 'gonemaster --badkeys-update' para descargar la lista de bloqueo."

msgctxt "DNSSEC:DS19_KEY_OK"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) passed "
"all badkey checks on name server(s) {servers}."
msgstr "DNSKEY con keytag {keytag} y algoritmo {algo_descr} ({algo_num}) superó todas las comprobaciones de badkeys en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS19_NO_DNSKEY"
msgid "No DNSKEY records found at zone apex on name server(s) {servers}."
msgstr "No se encontraron registros DNSKEY en el ápex de la zona en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS19_NO_RESPONSE"
msgid ""
"No name server produced a usable DNSKEY response for badkey checking on "
"name server(s) {servers}."
msgstr "Ningún servidor de nombres produjo una respuesta DNSKEY utilizable para la comprobación de badkeys en los servidores de nombres {servers}."


msgctxt "DNSSEC:DS20_BITMAP_OK"
msgid "NSEC/NSEC3 type bitmap at the zone apex correctly includes all observed RR types on name server(s) {servers}."
msgstr "El bitmap de tipos NSEC/NSEC3 en el ápex de la zona incluye correctamente todos los tipos RR observados en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS20_NO_BITMAP"
msgid "No NSEC or NSEC3 type bitmap could be obtained for the zone apex on name server(s) {servers}."
msgstr "No se pudo obtener ningún bitmap de tipos NSEC o NSEC3 para el ápex de la zona en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS20_NO_DNSSEC"
msgid "No nameserver returned a usable DNSKEY; NSEC/NSEC3 bitmap check skipped on name server(s) {servers}."
msgstr "Ningún servidor de nombres devolvió un DNSKEY utilizable; se omitió la comprobación del bitmap NSEC/NSEC3 en los servidores de nombres {servers}."

msgctxt "DNSSEC:DS20_NSEC3_BITMAP_MISMATCHES_RRTYPE"
msgid "RR type {query_type} exists at the zone apex but is missing from the NSEC3 type bitmap on name server(s) {servers}. This enables cache poisoning via RFC 8198 aggressive negative caching."
msgstr "El tipo RR {query_type} existe en el ápex de la zona pero falta en el bitmap de tipos NSEC3 en los servidores de nombres {servers}. Esto permite el envenenamiento de caché mediante la caché negativa agresiva de la RFC 8198."

msgctxt "DNSSEC:DS20_NSEC_BITMAP_MISMATCHES_RRTYPE"
msgid "RR type {query_type} exists at the zone apex but is missing from the NSEC type bitmap on name server(s) {servers}. This enables cache poisoning via RFC 8198 aggressive negative caching."
msgstr "El tipo RR {query_type} existe en el ápex de la zona pero falta en el bitmap de tipos NSEC en los servidores de nombres {servers}. Esto permite el envenenamiento de caché mediante la caché negativa agresiva de la RFC 8198."
msgid "{parent} sent a DS record, but {child} did not send a DNSKEY record."
msgstr "{parent} sent a DS record, but {child} did not send a DNSKEY record."

msgctxt "DNSSEC:DS21_ALGO_NOT_SUPPORTED"
msgid "Parent DS RRSIG with keytag {keytag} uses unsupported algorithm {algo_num} ({algo_mnemo}); skipping verification on parent name server(s) {addresses}."
msgstr "La firma RRSIG de la zona padre que cubre el registro DS con tag {keytag} usa un algoritmo no soportado {algo_num} ({algo_mnemo}). Se omitió la validación en los servidores de nombres de la zona padre con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_DS_RRSIG_EXPIRED"
msgid "Parent DS RRSIG with keytag {keytag} has expired on parent name server(s) {addresses}."
msgstr "La firma RRSIG de la zona padre que cubre el registro DS con tag {keytag} está expirada en los servidores de nombres de la zona padre con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_DS_RRSIG_NOT_VALID_BY_DNSKEY"
msgid "Parent DS RRSIG with keytag {keytag} cannot be verified by any matching parent DNSKEY on parent name server(s) {addresses}."
msgstr "La firma RRSIG de la zona padre que cubre el registro DS con tag {keytag} no puede ser validada por ningún DNSKEY correspondiente de la zona padre en los servidores de nombres de la zona padre con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_DS_RRSIG_NOT_VERIFIABLE"
msgid "Parent returned a signed DS RRset, but no covering RRSIG could be verified against the parent DNSKEY on parent name server(s) {addresses}. Validating resolvers will fail to resolve the child zone."
msgstr "La zona padre retornó un conjunto de registros DS firmado, pero ninguna firma RRSIG de cobertura pudo ser validada contra el DNSKEY de la zona padre en los servidores de nombres de la zona padre con direcciones IP \"{addresses}\". Los resolutores validantes no podrán resolver la zona hija."

msgctxt "DNSSEC:DS21_DS_RRSIG_NOT_YET_VALID"
msgid "Parent DS RRSIG with keytag {keytag} has an inception time in the future on parent name server(s) {addresses}."
msgstr "La firma RRSIG de la zona padre que cubre el registro DS con tag {keytag} tiene su fecha de comienzo en el futuro en los servidores de nombres de la zona padre con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_DS_RRSIG_VERIFIED"
msgid "Parent DS RRset is correctly signed and verifies against the parent DNSKEY on parent name server(s) {addresses}."
msgstr "El conjunto de registros DS de la zona padre está correctamente firmado y se valida contra el DNSKEY de la zona padre en los servidores de nombres de la zona padre con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_NO_DNSKEY_FOR_DS_RRSIG"
msgid "Parent DS RRSIG references DNSKEY keytag {keytag}, but no matching DNSKEY is published at the parent apex on parent name server(s) {addresses}."
msgstr "La firma RRSIG de la zona padre que cubre el registro DS hace referencia al DNSKEY con tag {keytag}, pero no hay ningún DNSKEY correspondiente publicado en el apex de la zona padre en los servidores de nombres de la zona padre con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_NO_DS_RRSIG"
msgid "Parent returned the DS RRset without any covering RRSIG on parent name server(s) {addresses}."
msgstr "La zona padre retornó el conjunto de registros DS sin ninguna firma RRSIG de cobertura en los servidores de nombres de la zona padre con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_NO_PARENT_ZONE"
msgid "No parent zone is available; DNSSEC21 cannot run."
msgstr "No hay ninguna zona padre disponible. La prueba DNSSEC21 no puede ejecutarse."

msgctxt "DNSSEC:DS21_PARENT_DNSKEY_MISSING"
msgid "Parent did not return an authoritative DNSKEY response, so DS RRSIG verification was skipped on parent name server(s) {addresses}."
msgstr "La zona padre no retornó una respuesta DNSKEY autoritativa, por lo que la validación de la firma RRSIG que cubre el registro DS se omitió en los servidores de nombres de la zona padre con direcciones IP \"{addresses}\"."

msgctxt "DNSSEC:DURATION_LONG"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a duration of "
"{duration} seconds, which is too long."
msgstr ""
"La firma RRSIG con tag de llave {keytag} y cobertura de tipos {types} tiene "
"una duración de {duration} segundos, que es demasiado larga."

msgctxt "DNSSEC:DURATION_OK"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a duration of "
"{duration} seconds, which is just fine."
msgstr ""
"La firma RRSIG con tag de llave {keytag} y cobertura de tipos {types} tiene "
"una duración de {duration} segundos, que está correcta."

msgctxt "DNSSEC:EXTRA_PROCESSING_BROKEN"
msgid ""
"Server at {address} sent {keys} DNSKEY records, and {sigs} RRSIG records."
msgstr ""
"El servidor en {address} entregó {keys} registros DNSKEY, y {sigs} registros "
"RRSIG."

msgctxt "DNSSEC:EXTRA_PROCESSING_OK"
msgid "Server at {address} sent {keys} DNSKEY records and {sigs} RRSIG records."
msgstr ""
"El servidor en {address} entregó {keys} registros DNSKEY y {sigs} registros "
"RRSIG."

msgctxt "DNSSEC:KEY_SIZE_OK"
msgid "All keys from the DNSKEY RRset have the correct size."
msgstr "Todas las llaves de los registros DNSKEY tienen el tamaño correcto."

msgctxt "DNSSEC:NO_RESPONSE_DNSKEY"
msgid "Nameserver {ns}/{address} responded with no DNSKEY record(s)."
msgstr "El servidor de nombres {ns}/{address} no entrega ningún registro DNSKEY."

msgctxt "DNSSEC:REMAINING_LONG"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a remaining "
"validity of {duration} seconds, which is too long."
msgstr ""
"La firma RRSIG con tag de llave {keytag} y cobertura de tipos {types} tiene "
"una validez restante de {duration} segundos, que es demasiado larga."

msgctxt "DNSSEC:REMAINING_SHORT"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a remaining "
"validity of {duration} seconds, which is too short."
msgstr ""
"La firma RRSIG con tag de llave {keytag} y cobertura de tipos {types} tiene "
"una validez restante de {duration} segundos, que es demasiado corta."

msgctxt "DNSSEC:RRSIG_EXPIRATION"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} expires at : {date}."
msgstr ""
"La firma RRSIG con tag de llave {keytag} y cobertura de tipos {types} expira "
"en : {date}."

msgctxt "DNSSEC:RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has already expired "
"(expiration is: {expiration})."
msgstr ""
"La firma RRSIG con tag de llave {keytag} y cobertura de tipos {types} ya "
"está expirada (expiración fue en: {expiration})."

msgctxt "DELEGATION:ARE_AUTHORITATIVE"
msgid ""
"All these nameservers are confirmed to be authoritative : {servers}."
msgstr ""
"Los siguientes servidores de nombres responden autoritativamente : "
"{servers}."

msgctxt "DELEGATION:CHILD_DISTINCT_NS_IP"
msgid "All the IP addresses used by the nameservers in child are unique."
msgstr ""
"Todas las direcciones IP usadas por los servidores de nombre hijos son "
"únicas."

msgctxt "DELEGATION:CHILD_NS_SAME_IP"
msgid "IP {address} in child refers to multiple nameservers ({servers})."
msgstr ""
"La dirección IP {address} en el hijo se refiere a múltiples servidores de "
"nombres ({servers})."

msgctxt "DELEGATION:DEL_DISTINCT_NS_IP"
msgid "All the IP addresses used by the nameservers in parent are unique."
msgstr ""
"Todas las direcciones IP usadas por los servidores de nombre en el padre son "
"únicas."

msgctxt "DELEGATION:DEL_NS_SAME_IP"
msgid "IP {address} in parent refers to multiple nameservers ({servers})."
msgstr ""
"La dirección IP {address} en el padre se refiere a múltiples servidores de "
"nombres ({servers})."

msgctxt "DELEGATION:DISTINCT_IP_ADDRESS"
msgid "All the IP addresses used by the nameservers are unique."
msgstr ""
"Todas las direcciones IP usadas por los servidores de nombre son únicas."

msgctxt "DELEGATION:ENOUGH_IPV4_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers that resolve to IPv4 addresses. "
"Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"El hijo entrega suficientes ({count}) servidores de nombre que resuelven a "
"direcciones IPv4. El límite inferior es {minimum}. Servidores de nombre: "
"{servers}"

msgctxt "DELEGATION:ENOUGH_IPV4_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers that resolve to IPv4 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"La delegación entrega suficientes ({count}) servidores de nombre que "
"resuelven a direcciones IPv4. El límite inferior es {minimum}. Servidores de "
"nombre: {servers}"

msgctxt "DELEGATION:ENOUGH_IPV6_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers that resolve to IPv6 addresses. "
"Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"El hijo entrega suficientes ({count}) servidores de nombre que resuelven a "
"direcciones IPv6. El límite inferior es {minimum}. Servidores de nombre: "
"{servers}"

msgctxt "DELEGATION:ENOUGH_IPV6_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers that resolve to IPv6 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"La delegación entrega suficientes ({count}) servidores de nombre que "
"resuelven a direcciones IPv6. El límite inferior es {minimum}. Servidores de "
"nombre: {servers}"

msgctxt "DELEGATION:ENOUGH_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers. Lower limit set to {minimum}. Name "
"servers: {servers}"
msgstr ""
"El hijo entrega suficientes ({count}) servidores de nombre. El límite "
"inferior es {minimum}. Servidores de nombre: {servers}"

msgctxt "DELEGATION:ENOUGH_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers. Lower limit set to {minimum}. "
"Name servers: {servers}"
msgstr ""
"La delegación entrega suficientes ({count}) servidores de nombre. El límite "
"inferior es {minimum}. Servidores de nombre: {servers}"

msgctxt "DELEGATION:EXTRA_NAME_CHILD"
msgid "Child has nameserver(s) not listed at parent ({extra})."
msgstr ""
"El hijo tiene servidores de nombres que no aparecen en el padre ({extra})."

msgctxt "DELEGATION:EXTRA_NAME_PARENT"
msgid "Parent has nameserver(s) not listed at the child ({extra})."
msgstr ""
"El padre tiene servidores de nombres que no aparecen en el hijo ({extra})."

msgctxt "DELEGATION:IN_DOMAIN_GLUE_MISSING"
msgid "In-domain nameserver {ns} has no glue address record (A or AAAA) in the parent referral."
msgstr "El servidor de nombres dependiente (in-domain) {ns} no tiene ningún registro glue de dirección (A o AAAA) en la delegación de la zona padre."

msgctxt "DELEGATION:IS_NOT_AUTHORITATIVE"
msgid "Nameserver {ns}/{address} response is not authoritative on {proto} port 53."
msgstr ""
"El servidor de nombres {ns}/{address} entrega una respuesta que no es autoritativa en "
"{proto} puerto 53."

msgctxt "DELEGATION:NAMES_MATCH"
msgid "All of the nameserver names are listed both at parent and child."
msgstr ""
"Todos los nombres de servidores de nombres aparecen tanto en el padre con en "
"el hijo."

msgctxt "DELEGATION:NO_RESPONSE"
msgid ""
"Nameserver {ns} did not respond to a query for name {query_name} and type "
"{query_type}."
msgstr ""
"El servidor de nombres {ns} no respondió a una consulta por nombre "
"{query_name} y tipo {query_type}."

msgctxt "DELEGATION:NOT_ENOUGH_IPV4_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers that resolve to IPv4 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"El hijo no entrega suficientes ({count}) servidores de nombre que resuelvan "
"a direcciones IPv4. El límite inferior es {minimum}. Servidores de nombre: "
"{servers}"

msgctxt "DELEGATION:NOT_ENOUGH_IPV4_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers that resolve to IPv4 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"La delegación no entrega suficientes ({count}) servidores de nombre que "
"resuelven a direcciones IPv4. El límite inferior es {minimum}. Servidores de "
"nombre: {servers}"

msgctxt "DELEGATION:NOT_ENOUGH_IPV6_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers that resolve to IPv6 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"El hijo no entrega suficientes ({count}) servidores de nombre que resuelvan "
"a direcciones IPv6. El límite inferior es {minimum}. Servidores de nombre: "
"{servers}"

msgctxt "DELEGATION:NOT_ENOUGH_IPV6_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers that resolve to IPv6 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"La delegación no entrega suficientes ({count}) servidores de nombre que "
"resuelven a direcciones IPv6. El límite inferior es {minimum}. Servidores de "
"nombre: {servers}"

msgctxt "DELEGATION:NOT_ENOUGH_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers. Lower limit set to "
"{minimum}. Name servers: {servers}"
msgstr ""
"El hijo no entrega suficientes ({count}) servidores de nombre. El límite "
"inferior es {minimum}. Servidores de nombre: {servers}"

msgctxt "DELEGATION:NOT_ENOUGH_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers. Lower limit set to "
"{minimum}. Name servers: {servers}"
msgstr ""
"La delegación no entrega suficientes ({count}) servidores de nombre. El "
"límite inferior es {minimum}. Servidores de nombre: {servers}"

msgctxt "DELEGATION:NO_IPV4_NS_CHILD"
msgid ""
"Child lists no nameserver that resolves to an IPv4 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"El hijo no entrega ningún servidor de nombres que resuelva a una dirección "
"IPv4. El mínimo es {minimum}."

msgctxt "DELEGATION:NO_IPV4_NS_DEL"
msgid ""
"Delegation lists no nameserver that resolves to an IPv4 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"La delegación no entrega ningún servidor de nombres que resuelva a una "
"dirección IPv4. El mínimo es {minimum}."

msgctxt "DELEGATION:NO_IPV6_NS_CHILD"
msgid ""
"Child lists no nameserver that resolves to an IPv6 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"El hijo no entrega ningún servidor de nombres que resuelva a una dirección "
"IPv6. El mínimo es {minimum}."

msgctxt "DELEGATION:NO_IPV6_NS_DEL"
msgid ""
"Delegation lists no nameserver that resolves to an IPv6 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"La delegación no entrega ningún servidor de nombres que resuelva a una "
"dirección IPv6. El mínimo es {minimum}."

msgctxt "DELEGATION:NS_IS_CNAME"
msgid "Nameserver {ns} RR points to CNAME."
msgstr "El servidor de nombres {ns} apunta a un alias CNAME."

msgctxt "DELEGATION:NO_NS_CNAME"
msgid "No nameserver points to CNAME alias."
msgstr "Ningún servidor de nombres apunta a un alias CNAME."

msgctxt "DELEGATION:REFERRAL_SIZE_LARGE"
msgid ""
"The smallest possible legal referral packet is larger than 512 but within "
"1232 octets (it is {size}); it needs EDNS to be returned over UDP."
msgstr ""
"El paquete más pequeño posible de redirección (referral) es superior a 512 "
"pero no supera los 1232 octetos (actualmente es {size}); necesita EDNS para "
"enviarse por UDP."

msgctxt "DELEGATION:REFERRAL_SIZE_TOO_LARGE"
msgid ""
"The smallest possible legal referral packet is larger than 512 octets (it is "
"{size})."
msgstr ""
"El paquete más pequeño posible de redirección (referral) es superior a 512 "
"octetos (actualmente es {size})."

msgctxt "DELEGATION:REFERRAL_SIZE_OK"
msgid ""
"The smallest possible legal referral packet is smaller than 513 octets (it "
"is {size})."
msgstr ""
"El paquete más pequeño posible de redirección (referral) es inferior a 513 "
"octetos (actualmente es {size})."

msgctxt "DELEGATION:SAME_IP_ADDRESS"
msgid "IP {address} refers to multiple nameservers ({servers})."
msgstr ""
"La dirección IP {address} es usada por distintos servidores de nombres "
"({servers})."

msgctxt "DELEGATION:SOA_EXISTS"
msgid "All the nameservers have SOA record."
msgstr "Todos los servidores de nombres tienen registro SOA."

msgctxt "DELEGATION:SOA_NOT_EXISTS"
msgid "Empty NOERROR response to SOA query was received from {ns}/{address}."
msgstr ""
"Se recibió una respuesta vacía NOERROR a una consulta SOA en el servidor de "
"nombres {ns}/{address}."

msgctxt "DELEGATION:TOTAL_NAME_MISMATCH"
msgid "None of the nameservers listed at the parent are listed at the child."
msgstr ""
"Ninguno de los servidores de nombres que aparecen en el padre se encuentran "
"en el hijo."

msgctxt "DELEGATION:UNEXPECTED_RCODE"
msgid ""
"Nameserver {ns} answered query for name {query_name} and type {query_type} with "
"RCODE {rcode}."
msgstr ""
"El servidor de nombres {ns} respondió a una consulta por nombre {query_name} "
"y tipo {query_type} con RCODE {rcode}."

msgctxt "NAMESERVER:AAAA_BAD_RDATA"
msgid ""
"Nameserver {ns}/{address} answered AAAA query with an unexpected RDATA length "
"({length} instead of 16)."
msgstr ""
"El servidor de nombres {ns}/{address} respondió a una consulta AAAA con un largo de "
"RDATA inesperado ({length} en vez de 16)."

msgctxt "NAMESERVER:AAAA_QUERY_DROPPED"
msgid "Nameserver {ns}/{address} dropped AAAA query."
msgstr "El servidor de nombres {ns}/{address} no responde a las consultas AAAA."

msgctxt "NAMESERVER:AAAA_UNEXPECTED_RCODE"
msgid "Nameserver {ns}/{address} answered AAAA query with an unexpected rcode ({rcode})."
msgstr ""
"El servidor de nombres {ns}/{address} respondió a una consulta AAAA con un rcode "
"inesperado ({rcode})."

msgctxt "NAMESERVER:AAAA_WELL_PROCESSED"
msgid ""
"The following nameservers answer AAAA queries without problems : {servers}."
msgstr ""
"Los siguientes servidores de nombres responden a las consultas AAAA sin "
"problemas : {servers}."

msgctxt "NAMESERVER:A_UNEXPECTED_RCODE"
msgid "Nameserver {ns}/{address} answered A query with an unexpected rcode ({rcode})."
msgstr ""
"El servidor de nombres {ns}/{address} respondió a una consulta A con un rcode "
"inesperado ({rcode})."

msgctxt "NAMESERVER:AXFR_AVAILABLE"
msgid "The following nameservers allow zone transfer using AXFR: {servers}."
msgstr "Los siguientes servidores de nombres permiten transferencias de zona usando AXFR: {servers}."

msgctxt "NAMESERVER:AXFR_FAILURE"
msgid "AXFR not available on the following nameservers: {servers}."
msgstr "AXFR no está disponible en los siguientes servidores de nombres: {servers}."

msgctxt "NAMESERVER:BREAKS_ON_EDNS"
msgid "No response from {ns}/{address} when EDNS is used in query asking for {domain}."
msgstr ""
"No hay respuesta en el servidor de nombres {ns}/{address} cuando se utiliza EDNS al "
"consultar por {domain}."

msgctxt "NAMESERVER:CAN_BE_RESOLVED"
msgid "All nameservers succeeded to resolve to an IP address."
msgstr ""
"Todos los servidores de nombres pueden ser resueltos exitosamente a una "
"dirección IP."

msgctxt "NAMESERVER:CAN_NOT_BE_RESOLVED"
msgid ""
"The following nameservers failed to resolve to an IP address : {servers}."
msgstr ""
"Los siguientes servidores de nombres fallan en su resolución a una dirección "
"IP : {servers}."

msgctxt "NAMESERVER:CASE_QUERIES_RESULTS_DIFFER"
msgid ""
"When asked for {query_type} records on \"{domain}\" with different cases, all "
"servers do not reply consistently."
msgstr ""
"Las consultas de registros de tipo {query_type} en el dominio \"{domain}\" con "
"mayúsculas y minúsculas mezcladas, tienen respuestas inconsistentes entre "
"todos los servidores."

msgctxt "NAMESERVER:CASE_QUERIES_RESULTS_OK"
msgid ""
"When asked for {query_type} records on \"{domain}\" with different cases, all "
"servers reply consistently."
msgstr ""
"Las consultas de registros de tipo {query_type} en el dominio \"{domain}\" con "
"mayúsculas y minúsculas mezcladas, tienen respuestas consistentes entre "
"todos los servidores."

msgctxt "NAMESERVER:CASE_QUERY_DIFFERENT_ANSWER"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns different answers."
msgstr ""
"El servidor de nombres {ns}/{address} entrega respuestas distintas ante consultas de "
"registros de tipo {query_type} en \"{query1}\" y \"{query2}\"."

msgctxt "NAMESERVER:CASE_QUERY_DIFFERENT_RC"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns different RCODE (\"{rcode1}\" vs \"{rcode2}\")."
msgstr ""
"El servidor de nombres {ns}/{address} entrega RCODE distintos (\"{rcode1}\" vs "
"\"{rcode2}\") ante consultas de registros de tipo {query_type} en \"{query1}\" y "
"\"{query2}\"."

msgctxt "NAMESERVER:CASE_QUERY_NO_ANSWER"
msgid ""
"When asked for {query_type} records on \"{domain}\", nameserver {ns}/{address} returns "
"nothing."
msgstr ""
"El servidor de nombres {ns}/{address} no responde ante consultas de tipo {query_type} en "
"\"{domain}\"."

msgctxt "NAMESERVER:CASE_QUERY_SAME_ANSWER"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns same answers."
msgstr ""
"El servidor de nombres {ns}/{address} entrega las mismas respuestas ante consultas de "
"registros de tipo {query_type} en \"{query1}\" y \"{query2}\"."

msgctxt "NAMESERVER:CASE_QUERY_SAME_RC"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns same RCODE \"{rcode}\"."
msgstr ""
"El servidor de nombres {ns}/{address} entrega el mismo RCODE ({rcode}) ante consultas "
"de registros de tipo {query_type} en \"{query1}\" y \"{query2}\"."

msgctxt "NAMESERVER:DIFFERENT_SOURCE_IP"
msgid ""
"Nameserver {ns}/{address} replies on a SOA query with a different source address "
"({source})."
msgstr ""
"El servidor de nombres {ns}/{address} responde a una consulta SOA con una dirección de "
"origen (\"source\") distinta ({source})."

msgctxt "NAMESERVER:EDNS_RESPONSE_WITHOUT_EDNS"
msgid ""
"Response without EDNS from {ns}/{address} on query with EDNS0 asking for {domain}."
msgstr ""
"El servidor de nombres {ns}/{address} responde sin EDNS ante una consulta con EDNS0 "
"por {domain}."

msgctxt "NAMESERVER:EDNS_VERSION_ERROR"
msgid ""
"Incorrect version of EDNS (expected 0) in response from {ns}/{address} on query with "
"EDNS (version 0) asking for {domain}."
msgstr ""
"El servidor de nombres {ns}/{address} responde con una versión EDNS incorrecta (debe "
"ser 0) ante una consulta con EDNS versión 0 por {domain}."

msgctxt "NAMESERVER:EDNS0_SUPPORT"
msgid "The following nameservers support EDNS0 : {servers}."
msgstr "Los siguientes servidores de nombres soportan EDNS0 : {servers}."

msgctxt "NAMESERVER:IS_A_RECURSOR"
msgid "The following nameservers are recursors: {servers}."
msgstr "Los siguientes servidores de nombres permiten la recursión: {servers}."

msgctxt "NAMESERVER:MISSING_OPT_IN_TRUNCATED"
msgid ""
"Nameserver {ns}/{address} replies on an EDNS query with a truncated response without "
"EDNS."
msgstr ""
"El servidor de nombres {ns}/{address} responde a una consulta EDNS con una respuesta "
"truncada sin EDNS."

msgctxt "NAMESERVER:NO_EDNS_SUPPORT"
msgid "Nameserver {ns}/{address} does not support EDNS0 (replies with FORMERR)."
msgstr ""
"El servidor de nombres {ns}/{address} no soporta EDNS0 (responde con código FORMERR)."

msgctxt "NAMESERVER:NO_RECURSOR"
msgid "The following nameservers are not recursors: {servers}."
msgstr "Los siguientes servidores de nombres no permiten recursión: {servers}."

msgctxt "NAMESERVER:NO_RESOLUTION"
msgid "No nameserver was successfully resolved to an IP address."
msgstr "Ningún servidor de nombres pudo ser resuelto a una dirección IP."

msgctxt "NAMESERVER:NO_RESPONSE"
msgid "No response from {ns} asking for {domain}."
msgstr "No hay respuesta desde {ns} a las consultas por {domain}."

msgctxt "SYNTAX:NO_RESPONSE"
msgid "No response from {ns} asking for {domain}."
msgstr "No hay respuesta desde {ns} a las consultas por {domain}."

msgctxt "NAMESERVER:NO_UPWARD_REFERRAL"
msgid ""
"None of the following nameservers returns an upward referral : {servers}."
msgstr ""
"Ninguno de los siguientes servidores de nombres responde con una redirección "
"superior (upward referral) : {servers}."

msgctxt "NAMESERVER:NS_ERROR"
msgid "Erroneous response from nameserver {ns}/{address}."
msgstr "El servidor de nombres {ns}/{address} responde incorrectamente."

msgctxt "NAMESERVER:N10_EDNS_RESPONSE_ERROR"
msgid ""
"Expected RCODE but received erroneous response to an EDNS version 1 query. "
"Fetched from the nameservers with IP addresses {addresses}"
msgstr ""
"Se espera un RCODE pero se recibe una respuesta errónea a una consulta con "
"EDNS versión 1. Obtenido de los servidores de nombres con direcciones IP "
"\"{addresses}\"."

msgctxt "NAMESERVER:N10_NO_RESPONSE_EDNS1_QUERY"
msgid ""
"No response to an EDNS version 1 query. Fetched from the nameservers with IP "
"addresses {addresses}"
msgstr ""
"No hay respuesta a una consulta con EDNS versión 1. Obtenido de los "
"servidores de nombres con direcciones IP \"{addresses}\"."

msgctxt "NAMESERVER:N10_UNEXPECTED_RCODE"
msgid ""
"Erroneous RCODE (\"{rcode}\") in response to an EDNS version 1 query. "
"Fetched from the nameservers with IP addresses {addresses}"
msgstr ""
"Se obtiene un RCODE erróneo (\"{rcode}\") en respuesta a una consulta con "
"EDNS versión 1. Obtenido de los servidores de nombres con direcciones IP "
"\"{addresses}\"."

msgctxt "NAMESERVER:N11_NO_EDNS"
msgid ""
"The DNS response, on query with unknown EDNS option-code, does not contain "
"any EDNS from name servers \"{addresses}\"."
msgstr ""
"La respuesta DNS, ante una pregunta con un código de opción EDNS "
"desconocido, no contiene ningún EDNS desde los servidores de nombre "
"\"{addresses}\"."

msgctxt "NAMESERVER:N11_NO_RESPONSE"
msgid ""
"There is no response on query with unknown EDNS option-code from name "
"servers \"{addresses}\"."
msgstr ""
"No existe respuesta ante una pregunta con una opción de código EDNS "
"desconocida desde los servidores de nombres \"{addresses}\"."

msgctxt "NAMESERVER:N11_RETURNS_UNKNOWN_OPTION_CODE"
msgid ""
"The DNS response contains an unknown EDNS option-code. Returned from name "
"servers \"{addresses}\"."
msgstr ""
"La respuesta DNS contiene un código de opción EDNS desconocido. Obtenido de "
"los servidores de nombres \"{addresses}\"."

msgctxt "NAMESERVER:N11_UNEXPECTED_ANSWER_SECTION"
msgid ""
"The DNS response, on query with unknown EDNS option-code, does not contain "
"the expected SOA record in the answer section from name servers "
"\"{addresses}\"."
msgstr ""
"La respuesta DNS, ante una consulta con un código de opción EDNS "
"desconocido, no contiene el registro SOA esperable en la sección de "
"respuesta desde los servidores de nombre \"{addresses}\"."

msgctxt "NAMESERVER:N11_UNEXPECTED_RCODE"
msgid ""
"The DNS response, on query with unknown EDNS option-code, has unexpected "
"RCODE name \"{rcode}\" from name servers \"{addresses}\"."
msgstr ""
"La respuesta DNS, ante una consulta con un código de opción EDNS "
"desconocido, tiene un nombre RCODE \"{rcode}\" inesperado desde los "
"servidores de nombre \"{addresses}\"."

msgctxt "NAMESERVER:N11_UNSET_AA"
msgid ""
"The DNS response, on query with unknown EDNS option-code, is unexpectedly "
"not authoritative from name servers \"{addresses}\"."
msgstr ""
"La respuesta DNS, ante una consulta con un código de opción EDNS "
"desconocido, es inesperadamente no autoritativa desde los servidores de "
"nombre \"{addresses}\"."

msgctxt "NAMESERVER:N15_ERROR_ON_VERSION_QUERY"
msgid ""
"The following name server(s) did not answer the software version query "
"\"{query_name}\" (no response or SERVFAIL). Returned from name servers: "
"\"{servers}\""
msgstr ""
"Los siguientes servidores de nombre no respondieron a la consulta de versión "
"de software \"{query_name}\" (sin respuesta o SERVFAIL). Obtenido de los "
"servidores de nombre: \"{servers}\""

msgctxt "NAMESERVER:N15_NO_VERSION_REVEALED"
msgid ""
"The following name server(s) do not disclose their software version. "
"Returned from name servers: \"{servers}\""
msgstr ""
"Los siguientes servidores de nombre no revelan su versión de software. "
"Obtenido de los servidores de nombre: \"{servers}\""

msgctxt "NAMESERVER:N15_SOFTWARE_VERSION"
msgid ""
"The following name server(s) disclose their software version in the reply to "
"query \"{query_name}\": \"{string}\". This is informational only; some "
"operators prefer to hide it. Returned from name servers: \"{servers}\""
msgstr ""
"Los siguientes servidores de nombre revelan su versión de software en la "
"respuesta a la consulta \"{query_name}\": \"{string}\". Esto es solo "
"informativo; algunos operadores prefieren ocultarla. Obtenido de los "
"servidores de nombre: \"{servers}\""

msgctxt "NAMESERVER:N15_WRONG_CLASS"
msgid ""
"The following name server(s) answered a CHAOS (CH) class query with a record "
"in the wrong class. Returned from name servers: \"{servers}\""
msgstr ""
"Los siguientes servidores de nombre respondieron a una consulta de clase "
"CHAOS (CH) con un registro de clase incorrecta. Obtenido de los servidores "
"de nombre: \"{servers}\""

msgctxt "NAMESERVER:N16_HAS_NSID"
msgid ""
"The following name server(s) responded to an NSID query (RFC 5001) with "
"NSID value \"{nsid}\". Returned from name servers \"{servers}\""
msgstr ""
"Los siguientes servidores de nombre respondieron a una consulta NSID "
"(RFC 5001) con el valor NSID \"{nsid}\". Obtenido de los servidores de "
"nombre: \"{servers}\""

msgctxt "NAMESERVER:N16_NO_NSID_REVEALED"
msgid ""
"The following name server(s) did not include an NSID option in response to "
"an NSID query (RFC 5001). Returned from name servers \"{servers}\""
msgstr ""
"Los siguientes servidores de nombre no incluyeron la opción NSID en la "
"respuesta a una consulta NSID (RFC 5001). Obtenido de los servidores de "
"nombre: \"{servers}\""

msgctxt "NAMESERVER:N16_NO_RESPONSE"
msgid ""
"The following name server(s) did not respond to an NSID query (RFC 5001). "
"Returned from name servers \"{servers}\""
msgstr ""
"Los siguientes servidores de nombre no respondieron a una consulta NSID "
"(RFC 5001). Obtenido de los servidores de nombre: \"{servers}\""

msgctxt "NAMESERVER:N16_UNEXPECTED_RCODE"
msgid ""
"The following name server(s) returned an unexpected RCODE \"{rcode}\" in "
"response to an NSID query (RFC 5001). Returned from name servers: "
"\"{servers}\""
msgstr ""
"Los siguientes servidores de nombre devolvieron un RCODE inesperado "
"\"{rcode}\" en respuesta a una consulta NSID (RFC 5001). Obtenido de los "
"servidores de nombre: \"{servers}\""

msgctxt "NAMESERVER:N17_COOKIE_SUPPORTED"
msgid "The following name server(s) returned a well-formed DNS Cookie (RFC 7873): \"{servers}\"."
msgstr "Los siguientes servidores de nombre devolvieron una DNS Cookie bien formada (RFC 7873): \"{servers}\"."

msgctxt "NAMESERVER:N17_COOKIE_ENFORCED"
msgid "The following name server(s) enforce DNS Cookies and returned a well-formed Server Cookie (RFC 7873): \"{servers}\"."
msgstr "Los siguientes servidores de nombre exigen DNS Cookies y devolvieron una Server Cookie bien formada (RFC 7873): \"{servers}\"."

msgctxt "NAMESERVER:N17_NO_COOKIE"
msgid "The following name server(s) did not return a DNS Cookie (RFC 7873): \"{servers}\"."
msgstr "Los siguientes servidores de nombre no devolvieron una DNS Cookie (RFC 7873): \"{servers}\"."

msgctxt "NAMESERVER:N17_COOKIE_ROUNDTRIP_OK"
msgid "The following name server(s) did not reject the Server Cookie they issued on a follow-up query (RFC 7873): \"{servers}\"."
msgstr "Los siguientes servidores de nombre no rechazaron la Server Cookie que emitieron en una consulta de seguimiento (RFC 7873): \"{servers}\"."

msgctxt "NAMESERVER:N17_COOKIE_CLIENT_ONLY"
msgid "The following name server(s) echoed only the Client Cookie and returned no Server Cookie (RFC 7873): \"{servers}\"."
msgstr "Los siguientes servidores de nombre solo reflejaron la Client Cookie y no devolvieron una Server Cookie (RFC 7873): \"{servers}\"."

msgctxt "NAMESERVER:N17_COOKIE_MALFORMED"
msgid "The following name server(s) returned a malformed DNS Cookie of {cookie_bytes} bytes (RFC 7873 allows 8 or 16 to 40): \"{servers}\"."
msgstr "Los siguientes servidores de nombre devolvieron una DNS Cookie mal formada de {cookie_bytes} bytes (RFC 7873 permite 8 o de 16 a 40): \"{servers}\"."

msgctxt "NAMESERVER:N17_COOKIE_SELF_REJECT"
msgid "The following name server(s) rejected with BADCOOKIE, even after a retry, a Server Cookie they had just issued (RFC 7873): \"{servers}\"."
msgstr "Los siguientes servidores de nombre rechazaron con BADCOOKIE, incluso tras un reintento, una Server Cookie que acababan de emitir (RFC 7873): \"{servers}\"."

msgctxt "NAMESERVER:N17_NO_RESPONSE"
msgid "The following name server(s) did not respond to a DNS Cookie probe (RFC 7873): \"{servers}\"."
msgstr "Los siguientes servidores de nombre no respondieron a una sonda de DNS Cookie (RFC 7873): \"{servers}\"."

msgctxt "NAMESERVER:N18_NO_EXTENDED_ERROR"
msgid "The following name server(s) responded without an Extended DNS Error (RFC 8914): \"{servers}\"."
msgstr "Los siguientes servidores de nombre respondieron sin un Extended DNS Error (RFC 8914): \"{servers}\"."

msgctxt "NAMESERVER:N18_EXTENDED_ERROR_REPORTED"
msgid "The following name server(s) returned Extended DNS Error (RFC 8914) {info_code} ({info_name}): \"{extra_text}\". Returned from name servers \"{servers}\"."
msgstr "Los siguientes servidores de nombre devolvieron el Extended DNS Error (RFC 8914) {info_code} ({info_name}): \"{extra_text}\". Devuelto por los servidores de nombre \"{servers}\"."

msgctxt "NAMESERVER:N18_SERVER_ERROR_REPORTED"
msgid "The following name server(s) reported a server-side problem via Extended DNS Error (RFC 8914) {info_code} ({info_name}): \"{extra_text}\". Returned from name servers \"{servers}\"."
msgstr "Los siguientes servidores de nombre informaron de un problema del lado del servidor mediante Extended DNS Error (RFC 8914) {info_code} ({info_name}): \"{extra_text}\". Devuelto por los servidores de nombre \"{servers}\"."

msgctxt "NAMESERVER:N18_RESOLVER_BEHAVIOR_REPORTED"
msgid "The following name server(s) returned an Extended DNS Error (RFC 8914) {info_code} ({info_name}) normally produced by a recursive resolver, which may indicate a resolver is answering on an authoritative address or an unusual server configuration: \"{extra_text}\". Returned from name servers \"{servers}\"."
msgstr "Los siguientes servidores de nombre devolvieron un Extended DNS Error (RFC 8914) {info_code} ({info_name}) que normalmente produce un resolver recursivo, lo que puede indicar que un resolver responde en una dirección autoritativa o una configuración de servidor inusual: \"{extra_text}\". Devuelto por los servidores de nombre \"{servers}\"."

msgctxt "NAMESERVER:N18_FILTERED_RESPONSE"
msgid "The following name server(s) returned a filtering Extended DNS Error (RFC 8914) {info_code} ({info_name}), indicating a policy middlebox in the path: \"{extra_text}\". Returned from name servers \"{servers}\"."
msgstr "Los siguientes servidores de nombre devolvieron un Extended DNS Error (RFC 8914) de filtrado {info_code} ({info_name}), lo que indica un middlebox de filtrado en la ruta: \"{extra_text}\". Devuelto por los servidores de nombre \"{servers}\"."

msgctxt "NAMESERVER:N18_NO_RESPONSE"
msgid "The following name server(s) did not respond to an Extended DNS Error probe (RFC 8914): \"{servers}\"."
msgstr "Los siguientes servidores de nombre no respondieron a una sonda de Extended DNS Error (RFC 8914): \"{servers}\"."

msgctxt "NAMESERVER:QNAME_CASE_INSENSITIVE"
msgid "The following nameservers do not preserve original case of the queried name ({domain}): {servers}."
msgstr "Los siguientes servidores de nombres no conservan la mezcla de mayúsculas y minúsculas de la consulta original ({domain}): {servers}."

msgctxt "NAMESERVER:QNAME_CASE_SENSITIVE"
msgid "The following nameservers preserve original case of queried names ({domain}): {servers}."
msgstr "Los siguientes servidores de nombres mantienen la mezcla de mayúsculas y minúsculas de la consulta original ({domain}): {servers}."

msgctxt "NAMESERVER:SAME_SOURCE_IP"
msgid "All nameservers reply with same IP used to query them."
msgstr ""
"Todos los servidores de nombres responden con la misma IP usada para las "
"consultas."

msgctxt "NAMESERVER:UPWARD_REFERRAL"
msgid "The following nameservers return an upward referral: {servers}."
msgstr "Los siguientes servidores de nombres responden con una redirección superior (upward referral): {servers}."

msgctxt "NAMESERVER:UPWARD_REFERRAL_IRRELEVANT"
msgid "Upward referral tests skipped for root zone."
msgstr ""
"Las pruebas de redirección superior (upward referral) se omiten para la zona "
"raíz."

msgctxt "NAMESERVER:Z_FLAGS_NOTCLEAR"
msgid "Nameserver {ns}/{address} has one or more unknown EDNS Z flag bits set."
msgstr ""
"El servidor de nombres {ns}/{address} tiene encendidos uno o más flags \"Z\" "
"desconocidos en EDNS."

msgctxt "SYNTAX:DISCOURAGED_DOUBLE_DASH"
msgid ""
"Domain name ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"El nombre de dominio '{domain}' tiene una etiqueta ({label}) con un doble "
"guión ('--') en las posiciones 3 y 4 (con un prefijo que no es 'xn--')."

msgctxt "SYNTAX:INITIAL_HYPHEN"
msgid ""
"Domain name ({domain}) has a label ({label}) starting with an hyphen ('-')."
msgstr ""
"El nombre de dominio '{domain}' tiene una etiqueta ({label}) que comienza "
"con un guión ('-')."

msgctxt "SYNTAX:MNAME_DISCOURAGED_DOUBLE_DASH"
msgid ""
"SOA MNAME ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"El campo MNAME del SOA ({domain}) tiene una etiqueta ({label}) con un doble "
"guión ('--') en las posiciones 3 y 4 (con un prefijo que no es 'xn--')."

msgctxt "SYNTAX:MNAME_NON_ALLOWED_CHARS"
msgid "Found illegal characters in SOA MNAME ({domain})."
msgstr ""
"Se encontraron caracteres ilegales en el campo MNAME del SOA ({domain})."

msgctxt "SYNTAX:MNAME_NUMERIC_TLD"
msgid "SOA MNAME ({domain}) within a 'numeric only' TLD ({tld})."
msgstr ""
"El campo MNAME del SOA ({domain}) está dentro de un TLD 'sólo "
"numérico' ({tld})."

msgctxt "SYNTAX:MNAME_SYNTAX_OK"
msgid "SOA MNAME ({domain}) syntax is valid."
msgstr "La sintaxis del campo MNAME del SOA ({domain}) es válida."

msgctxt "SYNTAX:MX_DISCOURAGED_DOUBLE_DASH"
msgid ""
"Domain name MX ({domain}) has a label ({label}) with a double hyphen ('--') "
"in position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"El registro MX del nombre de dominio '{domain}' tiene una etiqueta ({label}) "
"con un doble guión ('--') en las posiciones 3 y 4 (con un prefijo que no es "
"'xn--')."

msgctxt "SYNTAX:MX_NON_ALLOWED_CHARS"
msgid "Found illegal characters in MX ({domain})."
msgstr "Se encontraron caracteres ilegales en el registro MX ({domain})."

msgctxt "SYNTAX:MX_NUMERIC_TLD"
msgid "Domain name MX ({domain}) within a 'numeric only' TLD ({tld})."
msgstr ""
"El registro MX del nombre de dominio '{domain}' está dentro de un TLD 'sólo "
"numérico' ({tld})."

msgctxt "SYNTAX:MX_SYNTAX_OK"
msgid "Domain name MX ({domain}) syntax is valid."
msgstr "La sintaxis del registro MX ({domain}) es válida."

msgctxt "SYNTAX:NAMESERVER_DISCOURAGED_DOUBLE_DASH"
msgid ""
"Nameserver ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"El servidor de nombres ({domain}) tiene una etiqueta ({label}) con un doble "
"guión ('--') en las posiciones 3 y 4 (con un prefijo que no es 'xn--')."

msgctxt "SYNTAX:NAMESERVER_NON_ALLOWED_CHARS"
msgid "Found illegal characters in the nameserver ({domain})."
msgstr ""
"Se encontraron caracteres ilegales en el servidor de nombres ({domain})."

msgctxt "SYNTAX:NAMESERVER_NUMERIC_TLD"
msgid "Nameserver ({domain}) within a 'numeric only' TLD ({tld})."
msgstr ""
"El servidor de nombres ({domain}) está dentro de un TLD 'sólo "
"numérico' ({tld})."

msgctxt "SYNTAX:NAMESERVER_SYNTAX_OK"
msgid "The following nameservers have valid syntax: {servers}."
msgstr "Los siguientes servidores de nombres tienen una sintaxis válida: {servers}."

msgctxt "SYNTAX:NON_ALLOWED_CHARS"
msgid "Found illegal characters in the domain name ({domain})."
msgstr "Se encontraron caracteres ilegales en el nombre de dominio '{domain}'."

msgctxt "SYNTAX:NO_DOUBLE_DASH"
msgid ""
"Domain name ({domain}) has no label with a double hyphen ('--') in position "
"3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"El nombre de dominio '{domain}' no tiene ninguna etiqueta con un doble guión "
"('--') en las posiciones 3 y 4 (con un prefijo que no es 'xn--')."

msgctxt "SYNTAX:NO_ENDING_HYPHENS"
msgid "Neither end of any label in the domain name ({domain}) has a hyphen."
msgstr ""
"Ninguna etiqueta del nombre de dominio '{domain}' termina con un guión ('-')."

msgctxt "SYNTAX:NO_RESPONSE_MX_QUERY"
msgid "No response from nameserver(s) on MX queries."
msgstr "No hay respuesta de los servidores de nombres a consultas MX."

msgctxt "ZONE:NO_RESPONSE_MX_QUERY"
msgid "No response from nameserver(s) on MX queries."
msgstr "No hay respuesta de los servidores de nombres a consultas MX."

msgctxt "SYNTAX:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver(s) on SOA queries."
msgstr "No hay respuesta de los servidores de nombres a consultas SOA."

msgctxt "ZONE:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver(s) on SOA queries."
msgstr "No hay respuesta de los servidores de nombres a consultas SOA."

msgctxt "SYNTAX:ONLY_ALLOWED_CHARS"
msgid "No illegal characters in the domain name ({domain})."
msgstr "No existen caracteres ilegales en el nombre de dominio '{domain}'."

msgctxt "SYNTAX:RNAME_MAIL_DOMAIN_INVALID"
msgid ""
"The SOA RNAME mail domain ({domain}) cannot be resolved to a mail server "
"with an IP address."
msgstr ""
"El campo RNAME del SOA tiene un dominio de correo ({domain}) que no puede "
"ser resuelto a un servidor de correo con dirección IP."

msgctxt "SYNTAX:RNAME_MAIL_DOMAIN_LOCALHOST"
msgid ""
"The SOA RNAME mail domain ({domain}) resolved to a mail server with "
"localhost ({localhost}) IP address."
msgstr ""
"El campo RNAME del SOA tiene un dominio de correo ({domain}) que resuelve a "
"un servidor de correo con dirección IP localhost ({localhost})."

msgctxt "SYNTAX:RNAME_MAIL_ILLEGAL_CNAME"
msgid ""
"The SOA RNAME mail domain ({domain}) refers to an address which is an alias "
"(CNAME)."
msgstr ""
"El campo RNAME del SOA tiene un dominio de correo ({domain}) que refiere a "
"una dirección que es un alias (CNAME)."

msgctxt "SYNTAX:RNAME_MISUSED_AT_SIGN"
msgid "Misused '@' character found in SOA RNAME field ({rname})."
msgstr ""
"Se encontró el carácter incorrecto '@' en el campo RNAME del registro SOA "
"({rname})."

msgctxt "SYNTAX:RNAME_NO_AT_SIGN"
msgid "There is no misused '@' character in the SOA RNAME field ({rname})."
msgstr ""
"No se encuentra el carácter incorrecto '@' en el campo RNAME del registro "
"SOA ({rname})."

msgctxt "SYNTAX:RNAME_RFC822_INVALID"
msgid "Illegal character(s) found in SOA RNAME field ({rname})."
msgstr ""
"Se encontraron caracteres ilegales en el campo RNAME del SOA ({rname})."

msgctxt "SYNTAX:RNAME_RFC822_VALID"
msgid "The SOA RNAME field ({rname}) is compliant with RFC2822."
msgstr "El campo RNAME del SOA ({rname}) es compatible con el RFC2822."

msgctxt "SYNTAX:TERMINAL_HYPHEN"
msgid ""
"Domain name ({domain}) has a label ({label}) ending with a hyphen ('-')."
msgstr ""
"El nombre de dominio '{domain}' tiene una etiqueta ({label}) que termina con "
"guión ('-')."

msgctxt "ZONE:RETRY_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'retry' value ({retry}) is less than the recommended one "
"({required_retry})."
msgstr ""
"El valor 'retry' del registro SOA ({retry}) es menor al recomendable "
"({required_retry})."

msgctxt "ZONE:RETRY_MINIMUM_VALUE_OK"
msgid ""
"SOA 'retry' value ({retry}) is at least equal to the minimum recommended "
"value ({required_retry})."
msgstr ""
"El valor de reintento ('retry') del SOA ({retry}) es al menos igual al valor "
"mínimo recomendado ({required_retry})."

msgctxt "ZONE:MNAME_IS_CNAME"
msgid "SOA 'mname' value ({mname}) refers to a NS which is an alias (CNAME)."
msgstr ""
"El valor del campo 'mname' del SOA ({mname}) refiere a un NS que es un alias "
"(CNAME)."

msgctxt "ZONE:MNAME_IS_NOT_CNAME"
msgid ""
"SOA 'mname' value ({mname}) refers to a NS which is not an alias (CNAME)."
msgstr ""
"El valor del campo 'mname' del SOA ({mname}) refiere a un NS que no es un "
"alias (CNAME)."

msgctxt "ZONE:REFRESH_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'refresh' value ({refresh}) is less than the recommended one "
"({required_refresh})."
msgstr ""
"El valor 'refresh' del registro SOA ({refresh}) es menor al recomendable "
"({required_refresh})."

msgctxt "ZONE:REFRESH_MINIMUM_VALUE_OK"
msgid ""
"SOA 'refresh' value ({refresh}) is at least equal to the minimum recommended "
"value ({required_refresh})."
msgstr ""
"El valor de refresco ('refresh') del SOA ({refresh}) es al menos igual al "
"valor mínimo recomendado ({required_refresh})."

msgctxt "ZONE:EXPIRE_LOWER_THAN_REFRESH"
msgid ""
"SOA 'expire' value ({expire}) is lower than the SOA 'refresh' value "
"({refresh})."
msgstr ""
"El valor 'expire' ({expire}) del registro SOA es menor que el valor "
"'refresh' ({refresh})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_HIGHER"
msgid ""
"SOA 'minimum' value ({minimum}) is higher than the recommended one "
"({highest_minimum})."
msgstr ""
"El valor 'minimum' del registro SOA ({minimum}) es mayor que el recomendable "
"({highest_minimum})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_LOWER"
msgid ""
"SOA 'minimum' value ({minimum}) is less than the recommended one "
"({lowest_minimum})."
msgstr ""
"El valor 'minimum' del registro SOA ({minimum}) es menor que el recomendable "
"({lowest_minimum})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_OK"
msgid ""
"SOA 'minimum' value ({minimum}) is between the recommended ones "
"({lowest_minimum}/{highest_minimum})."
msgstr ""
"El valor 'minimum' del registro SOA ({minimum}) está dentro de los valores "
"recomendables ({lowest_minimum} - {highest_minimum})."

msgctxt "ZONE:EXPIRE_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'expire' value ({expire}) is less than the recommended one "
"({required_expire})."
msgstr ""
"El valor 'expire' del registro SOA ({expire}) es menor que el recomendable "
"({required_expire})."

msgctxt "ZONE:REFRESH_LOWER_THAN_RETRY"
msgid ""
"SOA 'refresh' value ({refresh}) is lower than the SOA 'retry' value "
"({retry})."
msgstr ""
"El valor 'refresh' del registro SOA ({refresh}) es menor que el valor "
"'retry' ({retry})."

msgctxt "ZONE:REFRESH_HIGHER_THAN_RETRY"
msgid ""
"SOA 'refresh' value ({refresh}) is higher than the SOA 'retry' value "
"({retry})."
msgstr ""
"El valor 'refresh' del registro SOA ({refresh}) es mayor que el valor "
"'retry' ({retry})."

msgctxt "ZONE:MX_RECORD_IS_CNAME"
msgid "MX record for the domain is pointing to a CNAME."
msgstr "El registro MX del dominio apunta a un alias CNAME."

msgctxt "ZONE:MX_RECORD_IS_NOT_CNAME"
msgid "MX record for the domain is not pointing to a CNAME."
msgstr "El registro MX del dominio no apunta a un alias CNAME."

msgctxt "ZONE:MULTIPLE_SOA"
msgid ""
"Nameserver {ns}/{address} responds with multiple ({count}) SOA records on SOA queries."
msgstr ""
"El servidor de nombres {ns}/{address} responde con múltiples ({count}) registros SOA "
"ante consultas de tipo SOA."

msgctxt "ZONE:NO_SOA_IN_RESPONSE"
msgid ""
"Response from nameserver {ns}/{address} on SOA queries does not contain SOA record."
msgstr ""
"El servidor de nombres {ns}/{address} responde sin registros SOA ante una consulta de "
"tipo SOA."

msgctxt "ZONE:MNAME_HAS_NO_ADDRESS"
msgid "No IP address found for SOA 'mname' nameserver ({mname})."
msgstr ""
"No se encuentra dirección IP para el servidor de nombres 'mname' del "
"registro SOA ({mname})."

msgctxt "ZONE:ONE_SOA"
msgid "A unique SOA record is returned by all nameservers of the zone."
msgstr ""
"Todos los servidores de nombres de la zona responden con un único registro "
"SOA."

msgctxt "ZONE:EXPIRE_MINIMUM_VALUE_OK"
msgid ""
"SOA 'expire' value ({expire}) is higher than the minimum recommended value "
"({required_expire}) and not lower than the 'refresh' value ({refresh})."
msgstr ""
"El valor 'expire' del registro SOA ({expire}) es mayor que el mínimo "
"recomendable ({required_expire}) y no es menor que el valor "
"'refresh' ({refresh})."

msgctxt "ZONE:WRONG_SOA"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({owner} instead of {query_name}) "
"on SOA queries."
msgstr ""
"El servidor de nombres {ns}/{address} responde con un nombre \"owner\" incorrecto "
"({owner} en vez de {query_name}) a una consulta SOA."

msgctxt "ZONE:APEX_DNAME"
msgid "Nameserver {ns}/{address} returns a DNAME record at the zone apex."
msgstr "El servidor de nombres {ns}/{address} devuelve un registro DNAME en el apex de la zona."

msgctxt "ZONE:SOA_AND_CNAME"
msgid "Nameserver {ns}/{address} returns a CNAME record at the zone apex alongside the SOA record."
msgstr ""
"El servidor de nombres {ns}/{address} devuelve un registro CNAME en el apex de la zona "
"junto con el registro SOA."

msgctxt "ZONE:Z01_MNAME_HAS_LOCALHOST_ADDR"
msgid ""
"SOA MNAME name server \"{ns}\" resolves to a localhost IP address "
"({address})."
msgstr ""
"El servidor de nombres del MNAME del SOA \"{ns}\" resuelve a una "
"dirección IP de localhost ({address})."

msgctxt "ZONE:Z01_MNAME_IS_DOT"
msgid ""
"SOA MNAME is specified as \".\" which usually means \"no server\". Fetched "
"from name servers \"{addresses}\"."
msgstr ""
"El MNAME del SOA está definido como \".\", lo que usualmente significa \"no "
"hay servidor\". Obtenido desde los servidores de nombres \"{addresses}\"."

msgctxt "ZONE:Z01_MNAME_IS_LOCALHOST"
msgid ""
"SOA MNAME name server is \"localhost\", which is invalid. Fetched from name "
"servers \"{addresses}\"."
msgstr ""
"El servidor de nombres MNAME del SOA es \"localhost\", lo que es inválido. "
"Obtenido desde los servidores de nombres \"{addresses}\"."

msgctxt "ZONE:Z01_MNAME_IS_MASTER"
msgid "SOA MNAME name server(s) \"{servers}\" appears to be master."
msgstr ""
"El(los) servidor(es) de nombres del MNAME del SOA \"{servers}\" parecen ser "
"maestros."

msgctxt "ZONE:Z01_MNAME_MISSING_SOA_RECORD"
msgid ""
"SOA MNAME name server \"{ns}/{address}\" responds to an SOA query with no SOA records "
"in the answer section."
msgstr ""
"El servidor de nombres del MNAME del SOA \"{ns}/{address}\" responde sin registros SOA "
"en la sección de respuesta frente a una consulta SOA."

msgctxt "ZONE:Z01_MNAME_NO_RESPONSE"
msgid "SOA MNAME name server \"{ns}/{address}\" does not respond to an SOA query."
msgstr ""
"El servidor de nombres del MNAME del SOA \"{ns}/{address}\" no responde a una consulta "
"SOA."

msgctxt "ZONE:Z01_MNAME_NOT_AUTHORITATIVE"
msgid "SOA MNAME name server \"{ns}/{address}\" is not authoritative for the zone."
msgstr ""
"El servidor de nombres del MNAME del SOA \"{ns}/{address}\" no es autoritativo para la "
"zona."

msgctxt "ZONE:Z01_MNAME_NOT_IN_NS_LIST"
msgid ""
"SOA MNAME name server \"{ns}\" is not listed as NS record for the zone."
msgstr ""
"El servidor de nombres del MNAME del SOA \"{ns}\" no está listado como "
"registro NS para la zona."

msgctxt "ZONE:Z01_MNAME_NOT_MASTER"
msgid ""
"SOA MNAME name server(s) \"{servers}\" do not have the highest SOA SERIAL "
"(expected \"{soaserial}\" but got \"{soaserial_list}\")"
msgstr ""
"El(los) servidor(es) de nombres del MNAME del SOA \"{servers}\" no tiene(n) "
"el SERIAL de SOA más alto (esperado \"{soaserial}\" pero obtenido "
"\"{soaserial_list}\")"

msgctxt "ZONE:Z01_MNAME_NOT_RESOLVE"
msgid ""
"SOA MNAME name server \"{ns}\" cannot be resolved into an IP address."
msgstr ""
"El servidor de nombres del MNAME del SOA \"{ns}\" no puede resolverse a "
"una dirección IP."

msgctxt "ZONE:Z01_MNAME_UNEXPECTED_RCODE"
msgid ""
"SOA MNAME name server \"{ns}/{address}\" gives unexpected RCODE name (\"{rcode}\") in "
"response to an SOA query."
msgstr ""
"El servidor de nombres del MNAME del SOA \"{ns}/{address}\" entrega un nombre RCODE "
"inesperado (\"{rcode}\") en respuesta a una consulta SOA."

msgctxt "ZONE:Z09_INCONSISTENT_MX"
msgid "Some name servers return an MX RRset while others return none."
msgstr ""
"Algunos servidores de nombres entregan un conjunto de registros (\"RRset\") "
"para MX, pero otros no entregan nada."

msgctxt "ZONE:Z09_INCONSISTENT_MX_DATA"
msgid "The MX RRset differs between name servers: \"{servers}\" return the mail targets \"{mail_targets}\"."
msgstr "El RRset de MX difiere entre los servidores de nombres: \"{servers}\" entregan los destinos de correo \"{mail_targets}\"."

msgctxt "ZONE:Z09_MISSING_MAIL_TARGET"
msgid "The child zone has no mail target (no MX)."
msgstr "La zona hija no tiene destino de correo (no existe MX)."

msgctxt "ZONE:Z09_MX_DATA"
msgid ""
"Mail targets in the MX RRset \"{mail_targets}\" returned from name "
"servers \"{servers}\"."
msgstr ""
"Se obtienen los destinos de correo \"{mail_targets}\" en el RRset de MX, "
"desde los servidores de nombres \"{servers}\"."

msgctxt "ZONE:Z09_MX_FOUND"
msgid "MX RRset was returned by name servers \"{servers}\"."
msgstr ""
"El RRset del MX fue entregado por los servidores de nombres \"{servers}\"."

msgctxt "ZONE:Z09_NON_AUTH_MX_RESPONSE"
msgid ""
"Non-authoritative response on MX query from name servers \"{addresses}\"."
msgstr ""
"Hay una respuesta no-autoritativa para la consulta MX desde los servidores "
"de nombres \"{addresses}\"."

msgctxt "ZONE:Z09_NO_MX_FOUND"
msgid "No MX RRset was returned by name servers \"{servers}\"."
msgstr ""
"No se entregó RRset MX desde los servidores de nombres \"{servers}\"."

msgctxt "ZONE:Z09_NO_RESPONSE_MX_QUERY"
msgid "No response on MX query from name servers \"{addresses}\"."
msgstr ""
"No hay respuesta ante una consulta MX desde los servidores de nombres "
"\"{addresses}\"."

msgctxt "ZONE:Z09_NULL_MX_NON_ZERO_PREF"
msgid "The zone has a Null MX with non-zero preference."
msgstr "La zona tiene un MX nulo con preferencia no-cero."

msgctxt "ZONE:Z09_NULL_MX_WITH_OTHER_MX"
msgid "The zone has a Null MX mixed with other MX records."
msgstr "La zona tiene un MX nulo mezclado con otros registros MX."

msgctxt "ZONE:Z09_ROOT_EMAIL_DOMAIN"
msgid "Root zone with an unexpected MX RRset (non-Null MX): \"{mail_targets}\"."
msgstr "Zona raíz con un RRset MX inesperado (MX no-nulo): \"{mail_targets}\"."

msgctxt "ZONE:Z09_TLD_EMAIL_DOMAIN"
msgid "The zone is a TLD and has an unexpected MX RRset (non-Null MX): \"{mail_targets}\"."
msgstr "La zona es un TLD y tiene un RRset MX inesperado (MX no-nulo): \"{mail_targets}\"."

msgctxt "ZONE:Z09_ARPA_EMAIL_DOMAIN"
msgid "The zone is in the ARPA tree and has an unexpected MX RRset (non-Null MX): \"{mail_targets}\"."
msgstr "La zona está en el árbol ARPA y tiene un RRset MX inesperado (MX no-nulo): \"{mail_targets}\"."

msgctxt "ZONE:Z09_NO_MX_FOUND_OR_EXPECTED"
msgid "MX RRset was neither found nor expected for the zone."
msgstr "No se encontró ni se esperaba un RRset MX para la zona."

msgctxt "ZONE:Z09_NO_SERVERS_MX_RESPONSE"
msgid "No server responds to MX query."
msgstr "Ningún servidor responde a la consulta MX."

msgctxt "ZONE:Z09_VALID_NULL_MX"
msgid "The zone has a valid Null MX record as the only MX record."
msgstr "La zona tiene un MX nulo válido como único registro MX."

msgctxt "ZONE:Z09_UNEXPECTED_RCODE_MX"
msgid ""
"Unexpected RCODE value ({rcode}) on the MX query from name servers "
"\"{addresses}\"."
msgstr ""
"Valor de RCODE inesperado ({rcode}) ante una consulta MX desde los "
"servidores de nombre \"{addresses}\"."

msgctxt "ZONE:Z11_INCONSISTENT_SPF_POLICIES"
msgid ""
"One or more name servers do not publish the same SPF policy as the others."
msgstr ""
"Uno o más servidores de nombre no publican la misma política SPF que los "
"otros."

msgctxt "ZONE:Z11_DIFFERENT_SPF_POLICIES_FOUND"
msgid ""
"The following name servers returned the same SPF policy, but other name "
"servers returned a different policy. Name servers: {addresses}."
msgstr ""
"Los siguientes servidores de nombre entregan la misma política SPF, pero "
"otros servidores entregan una política distinta. Servidores de nombre: "
"{addresses}."

msgctxt "ZONE:Z11_NO_SPF_FOUND"
msgid "No SPF policy was found for {domain}."
msgstr "No se encuentra una política SPF para {domain}."

msgctxt "ZONE:Z11_UNABLE_TO_CHECK_FOR_SPF"
msgid ""
"None of the zone’s name servers responded with an authoritative response to "
"queries for SPF policies."
msgstr ""
"Ninguno de los servidores de nombre de la zona responde con una respuesta "
"autoritativa a una consulta de política SPF."

msgctxt "ZONE:Z12_CSYNC_FOUND"
msgid "CSYNC record found at zone apex on the following nameservers with SOA serial {serial}, flags {flags}, and type bitmap {type_bitmap}: {servers}."
msgstr "Registro CSYNC encontrado en el ápice de la zona en los siguientes servidores de nombres con número de serie SOA {serial}, indicadores {flags} y mapa de tipos {type_bitmap}: {servers}."

msgctxt "ZONE:Z12_INCONSISTENT_CSYNC"
msgid "CSYNC record content differs across authoritative name servers."
msgstr "El contenido del registro CSYNC difiere entre los servidores de nombres autoritativos."

msgctxt "ZONE:Z12_MIXED_PRESENCE"
msgid "CSYNC record is present on some name servers but absent on others."
msgstr "El registro CSYNC está presente en algunos servidores de nombres pero ausente en otros."

msgctxt "ZONE:Z12_MULTIPLE_CSYNC"
msgid "{count} CSYNC records found at zone apex on name server {ns}/{address}."
msgstr ""
"Se encontraron {count} registros CSYNC en el ápice de la zona en el servidor de "
"nombres {ns}/{address}."

msgctxt "ZONE:Z12_NO_CSYNC"
msgid "No CSYNC record found at zone apex on name servers: {servers}."
msgstr ""
"No se encontró ningún registro CSYNC en el ápice de la zona en los servidores de "
"nombres: {servers}."

msgctxt "ZONE:Z12_SERIAL_MISMATCH"
msgid ""
"CSYNC SOA serial {csync_serial} fails RFC 7477 serial precondition against current "
"SOA serial "
"{soa_serial} on name server {ns}."
msgstr ""
"El número de serie SOA de CSYNC {csync_serial} no coincide con el número de serie "
"SOA actual {soa_serial} en el servidor de nombres {ns}."

msgctxt "ZONE:Z13_NO_SPF_FOUND"
msgid "No SPF record found for {domain}; skipping DNS lookup count check."
msgstr ""
"No se encontró ningún registro SPF para {domain}; se omite la verificación del "
"número de consultas DNS."

msgctxt "ZONE:Z13_SPF_LOOKUP_COUNT_EXCEEDED"
msgid ""
"The SPF policy for {domain} requires {count} DNS lookups, exceeding the "
"configured limit of {limit} (RFC 7208 Section 4.6.4)."
msgstr ""
"La política SPF de {domain} requiere {count} consultas DNS, superando el límite "
"configurado de {limit} (RFC 7208 sección 4.6.4)."

msgctxt "ZONE:Z13_SPF_LOOKUP_COUNT_OK"
msgid ""
"The SPF policy for {domain} requires {count} DNS lookups, within the "
"allowed limit."
msgstr ""
"La política SPF de {domain} requiere {count} consultas DNS, dentro del límite "
"permitido."

msgctxt "ZONE:Z13_SPF_LOOKUP_LOOP"
msgid ""
"The SPF policy for {domain} contains a recursive loop: {loop_domain} was "
"visited more than once during include/redirect resolution."
msgstr ""
"La política SPF de {domain} contiene un bucle recursivo: {loop_domain} fue "
"visitado más de una vez durante la resolución de include/redirect."

msgctxt "ZONE:Z13_SPF_MACRO_TARGET"
msgid ""
"The SPF policy for {domain} references {target} via include or redirect, "
"but the target contains SPF macros that can only be expanded at SMTP time "
"(RFC 7208 Section 7); its DNS lookup count is not audited."
msgstr ""
"La política SPF de {domain} hace referencia a {target} mediante include o "
"redirect, pero el destino contiene macros SPF que solo pueden expandirse en "
"tiempo SMTP (RFC 7208 sección 7); el recuento de búsquedas DNS de esa rama "
"no se audita."

msgctxt "ZONE:Z13_SPF_PTR_DEPRECATED"
msgid ""
"The SPF policy for {domain} uses the deprecated ptr mechanism "
"(RFC 7208 Section 5.5)."
msgstr ""
"La política SPF de {domain} utiliza el mecanismo ptr obsoleto "
"(RFC 7208 sección 5.5)."

msgctxt "ZONE:Z13_SPF_RECURSIVE_ERROR"
msgid ""
"The SPF policy for {domain} references {target} via include or redirect, "
"but that target could not be resolved."
msgstr ""
"La política SPF de {domain} hace referencia a {target} mediante include o "
"redirect, pero no se pudo resolver el destino."

msgctxt "ZONE:Z13_UNABLE_TO_CHECK"
msgid ""
"None of the zone's name servers responded with an authoritative response to "
"queries for SPF policies; unable to check DNS lookup count."
msgstr ""
"Ninguno de los servidores de nombres de la zona respondió con una respuesta "
"autoritativa a las consultas de políticas SPF; no se puede verificar el número "
"de consultas DNS."

msgctxt "ZONE:Z14_DUPLICATE_SCHEME_HASH"
msgid ""
"ZONEMD records at zone apex on name server {ns} contain duplicate "
"(Scheme, Hash) pair: scheme {scheme}, hash {hash}."
msgstr ""
"Los registros ZONEMD en el vértice de zona del servidor de nombres {ns} "
"contienen el par (Esquema, Hash) duplicado: esquema {scheme}, hash {hash}."

msgctxt "ZONE:Z14_INCONSISTENT_ZONEMD"
msgid "ZONEMD record content differs across authoritative name servers."
msgstr "El contenido del registro ZONEMD difiere entre los servidores de nombres autoritativos."

msgctxt "ZONE:Z14_MIXED_PRESENCE"
msgid "ZONEMD record is present on some name servers but absent on others."
msgstr "El registro ZONEMD está presente en algunos servidores de nombres pero ausente en otros."

msgctxt "ZONE:Z14_NO_ZONEMD"
msgid "No ZONEMD record found at zone apex on name servers: {servers}."
msgstr ""
"No se encontró ningún registro ZONEMD en el vértice de zona en los servidores "
"de nombres: {servers}."

msgctxt "ZONE:Z14_SERIAL_MISMATCH"
msgid ""
"ZONEMD serial {zonemd_serial} does not match current SOA serial "
"{soa_serial} on name server {ns}."
msgstr ""
"El serial ZONEMD {zonemd_serial} no coincide con el serial SOA actual "
"{soa_serial} en el servidor de nombres {ns}."

msgctxt "ZONE:Z14_UNSUPPORTED_HASH"
msgid ""
"ZONEMD record on name server {ns} uses hash algorithm {hash}, which is "
"outside the IANA-assigned set verifiable by standard tooling (1 = SHA-384, "
"2 = SHA-512)."
msgstr ""
"El registro ZONEMD en el servidor de nombres {ns} usa el algoritmo de hash "
"{hash}, que está fuera del conjunto asignado por IANA verificable por las "
"herramientas estándar (1 = SHA-384, 2 = SHA-512)."

msgctxt "ZONE:Z14_ZONEMD_FOUND"
msgid ""
"ZONEMD record found at zone apex: serial {serial}, scheme {scheme}, "
"hash algorithm {hash}, digest {digest}. Name servers: {servers}."
msgstr ""
"Registro ZONEMD encontrado en el vértice de zona: serial {serial}, "
"esquema {scheme}, algoritmo de hash {hash}, digest {digest}. "
"Servidores de nombres: {servers}."

msgctxt "ZONE:Z15_CAA_FOUND"
msgid ""
"CAA record found at zone apex: flags {caa_flags}, property "
"\"{caa_property}\", value \"{caa_value}\". Name servers: {servers}."
msgstr ""
"Registro CAA encontrado en el vértice de zona: banderas {caa_flags}, "
"propiedad \"{caa_property}\", valor \"{caa_value}\". Servidores de "
"nombres: {servers}."

msgctxt "ZONE:Z15_INCONSISTENT_CAA"
msgid "CAA record content differs across authoritative name servers."
msgstr ""
"El contenido de los registros CAA difiere entre los servidores de "
"nombres autoritativos."

msgctxt "ZONE:Z15_INVALID_IODEF_VALUE"
msgid ""
"CAA iodef value \"{caa_value}\" is not a valid mailto, http or https "
"URL."
msgstr ""
"El valor CAA iodef \"{caa_value}\" no es una URL mailto, http o "
"https válida."

msgctxt "ZONE:Z15_INVALID_ISSUE_VALUE"
msgid ""
"CAA {caa_property} value \"{caa_value}\" does not follow the RFC "
"8659 syntax; certificate authorities treat a malformed value as "
"forbidding issuance."
msgstr ""
"El valor CAA {caa_property} \"{caa_value}\" no sigue la sintaxis del "
"RFC 8659; las autoridades de certificación tratan un valor mal "
"formado como una prohibición de emisión."

msgctxt "ZONE:Z15_INVALID_PROPERTY_TAG"
msgid ""
"CAA record has an invalid property tag \"{caa_property}\" (value "
"\"{caa_value}\"); property tags must consist of ASCII letters and "
"digits."
msgstr ""
"El registro CAA tiene una etiqueta de propiedad no válida "
"\"{caa_property}\" (valor \"{caa_value}\"); las etiquetas de "
"propiedad solo pueden contener letras y dígitos ASCII."

msgctxt "ZONE:Z15_ISSUANCE_FORBIDDEN"
msgid ""
"The CAA policy at the zone apex forbids all certificate issuance for "
"this domain."
msgstr ""
"La política CAA en el vértice de zona prohíbe toda emisión de "
"certificados para este dominio."

msgctxt "ZONE:Z15_ISSUE_CONTRADICTION"
msgid ""
"CAA {caa_property} records both forbid all issuance (\";\") and "
"permit specific certificate authorities; the forbidding record has "
"no effect."
msgstr ""
"Los registros CAA {caa_property} prohíben toda emisión (\";\") y a "
"la vez permiten a autoridades de certificación concretas; el "
"registro que prohíbe no tiene efecto."

msgctxt "ZONE:Z15_MIXED_PRESENCE"
msgid "CAA records are present on some name servers but absent on others."
msgstr ""
"Los registros CAA están presentes en algunos servidores de nombres "
"pero ausentes en otros."

msgctxt "ZONE:Z15_NO_CAA"
msgid ""
"No CAA records found at zone apex on name servers: {servers}. Any "
"certificate authority may issue certificates for this domain."
msgstr ""
"No se encontró ningún registro CAA en el vértice de zona en los "
"servidores de nombres: {servers}. Cualquier autoridad de "
"certificación puede emitir certificados para este dominio."

msgctxt "ZONE:Z15_NO_CAA_TLD"
msgid ""
"No CAA records found at zone apex on name servers: {servers}. This "
"is a top-level domain or the root zone, which publishes no issuance "
"policy for the names below it."
msgstr ""
"No se encontró ningún registro CAA en el vértice de zona en los "
"servidores de nombres: {servers}. Se trata de un dominio de primer "
"nivel o de la zona raíz, que no publica ninguna política de emisión "
"para los nombres inferiores."

msgctxt "ZONE:Z15_NO_RESPONSE_CAA_QUERY"
msgid "No response on CAA query from name servers \"{addresses}\"."
msgstr ""
"No hay respuesta ante una consulta CAA desde los servidores de "
"nombres \"{addresses}\"."

msgctxt "ZONE:Z15_RESERVED_FLAGS"
msgid ""
"CAA record with property \"{caa_property}\" and value "
"\"{caa_value}\" sets reserved flag bits ({caa_flags}); only the "
"issuer critical flag (128) is defined."
msgstr ""
"El registro CAA con la propiedad \"{caa_property}\" y el valor "
"\"{caa_value}\" activa bits de bandera reservados ({caa_flags}); "
"solo está definida la bandera issuer critical (128)."

msgctxt "ZONE:Z15_UNEXPECTED_RCODE_CAA"
msgid ""
"Unexpected RCODE value ({rcode}) on the CAA query from name servers "
"\"{addresses}\". A certificate authority that cannot complete the "
"CAA lookup may refuse to issue certificates."
msgstr ""
"Valor de RCODE inesperado ({rcode}) ante una consulta CAA desde los "
"servidores de nombres \"{addresses}\". Una autoridad de "
"certificación que no pueda completar la búsqueda CAA puede negarse a "
"emitir certificados."

msgctxt "ZONE:Z15_UNKNOWN_PROPERTY"
msgid ""
"CAA record uses unknown property \"{caa_property}\"; certificate "
"authorities ignore properties they do not recognize."
msgstr ""
"El registro CAA usa la propiedad desconocida \"{caa_property}\"; las "
"autoridades de certificación ignoran las propiedades que no "
"reconocen."

msgctxt "ZONE:Z15_UNKNOWN_PROPERTY_CRITICAL"
msgid ""
"CAA record marks the unknown or unusable property \"{caa_property}\" "
"as critical (flags {caa_flags}); conforming certificate authorities "
"will not issue any certificate for this domain."
msgstr ""
"El registro CAA marca como crítica la propiedad desconocida o "
"inutilizable \"{caa_property}\" (banderas {caa_flags}); las "
"autoridades de certificación conformes no emitirán ningún "
"certificado para este dominio."

msgctxt "SYSTEM:CANNOT_CONTINUE"
msgid "Not enough data about {domain} was found to be able to run tests."
msgstr ""
"No hay suficiente información sobre {domain} que permita ejecutar las "
"pruebas."

msgctxt "SYSTEM:DEPENDENCY_VERSION"
msgid "Using prerequisite module {name} version {version}."
msgstr "Usando el módulo de requisito previo {name} versión {version}."

msgctxt "SYSTEM:GLOBAL_VERSION"
msgid "Using version {version} of the Gonemaster engine."
msgstr "Usando la versión {version} del motor Gonemaster."

msgctxt "SYSTEM:IPV6_AUTO_DISABLED"
msgid "IPv6 automatically disabled: {reason}."
msgstr "IPv6 desactivado automáticamente: {reason}."

msgctxt "SYSTEM:LOGGER_CALLBACK_ERROR"
msgid "Logger callback died with error: {exception}"
msgstr "La llamada al registro de operación murió con el error: {exception}"

msgctxt "SYSTEM:MODULE_ERROR"
msgid "Fatal error in {module}: {msg}"
msgstr "Error fatal en {module}: {msg}"

msgctxt "SYSTEM:MODULE_VERSION"
msgid "Using module {module} version {version}."
msgstr "Usando el módulo {module} versión {version}."

msgctxt "SYSTEM:MODULE_END"
msgid "Module {module} finished running."
msgstr "El módulo {module} finalizó su ejecución."

msgctxt "SYSTEM:NON_GLOBAL_QUERY_BLOCKED"
msgid "Query to {ns} skipped: {address} is a private or non-globally-reachable address."
msgstr "Consulta a {ns} omitida: {address} es una dirección privada o no accesible globalmente."

msgctxt "SYSTEM:NO_NETWORK"
msgid "Both IPv4 and IPv6 are disabled."
msgstr "Está desactivado IPv4 e IPv6."

msgctxt "SYSTEM:UNKNOWN_METHOD"
msgid "Request to run unknown method {testcase} in module {module}."
msgstr ""
"Solicitud de ejecutar un método desconocido {testcase} en el módulo {module}."

msgctxt "SYSTEM:UNKNOWN_MODULE"
msgid ""
"Request to run {testcase} in unknown module {module}. Known modules: "
"{module_list}."
msgstr ""
"Solicitud de ejecutar {testcase} en un módulo desconocido {module}. Módulos "
"conocidosL: {module_list}."

msgctxt "SYSTEM:FAKE_DELEGATION_TO_SELF"
msgid ""
"Name server {ns} not adding fake delegation for domain {domain} to itself."
msgstr ""
"El servidor de nombres {ns} agrega una delegación falsa para el dominio "
"{domain} hacia sí mismo."

msgctxt "SYSTEM:FAKE_DELEGATION_IN_ZONE_NO_IP"
msgid ""
"The fake delegation of domain {domain} includes an in-zone name server "
"{ns} without mandatory glue (without IP address)."
msgstr ""
"La delegación falsa del dominio {domain} incluye un servidor de nombres "
"{ns} \"dentro de la zona\" (in-zone) sin el registro \"glue\" "
"obligatorio (sin dirección IP)."

msgctxt "SYSTEM:FAKE_DELEGATION_NO_IP"
msgid ""
"The fake delegation of domain {domain} includes a name server {ns} that "
"cannot be resolved to any IP address."
msgstr ""
"La delegación falsa del dominio {domain} incluye un servidor de nombres "
"{ns} que no puede ser resuelto a ninguna dirección IP."

msgctxt "SYSTEM:PACKET_BIG"
msgid "Big packet size ({size}) (try with \"{command}\")."
msgstr ""
"El tamaño del paquete es demasiado grande ({size}) (intente con el comando "
"\"{command}\")."


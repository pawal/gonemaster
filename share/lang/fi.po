msgctxt "BASIC:A_QUERY_NO_RESPONSES"
msgid "Nameservers did not respond to A query."
msgstr "Nimipalvelimet eivät vastanneet A-tietue kyselyyn."

msgctxt "BASIC:B01_CHILD_IS_ALIAS"
msgid ""
"\"{domain_child}\" is not a zone. It is an alias for \"{domain_target}\". "
"Run a test for \"{domain_target}\" instead. Returned from name servers "
"\"{servers}\"."
msgstr ""
"\"{domain_child}\" ei ole vyöhyke. Se on alias verkkotunnukselle "
"\"{domain_target}\". Suorita sen sijaan testi verkkotunnukselle "
"{domain_target}. Vastaus nimipalvelimilta \"{servers}\"."

msgctxt "BASIC:B01_CHILD_FOUND"
msgid "The zone \"{domain}\" is found."
msgstr "Vyöhyke \"{domain}\" löytyy."

msgctxt "BASIC:B01_CHILD_NOT_EXIST"
msgid "The zone \"{domain}\" does not exist as a zone."
msgstr "Vyöhyke \"{domain}\" ei ole olemassa."

msgctxt "BASIC:B01_INCONSISTENT_ALIAS"
msgid "The alias for \"{domain}\" is inconsistent between name servers."
msgstr ""
"Verkkotunnuksen \"{domain}\" alias on epäjohdonmukainen nimipalvelimien "
"välillä."

msgctxt "BASIC:B01_INCONSISTENT_DELEGATION"
msgid ""
"The name servers for parent zone \"{domain_parent}\" give inconsistent "
"delegation of \"{domain_child}\". Returned from name servers \"{servers}\"."
msgstr ""
"Ylemmän vyöhykkeen \"{domain_parent}\" nimipalvelimet antavat epäjohdonmukaisen "
"delegoinnin \"{domain_child}\". Vastaus nimipalvelimilta \"{servers}\"."

msgctxt "BASIC:B01_NO_CHILD"
msgid ""
"\"{domain_child}\" does not exist as a DNS zone. Try to test "
"\"{domain_super}\" instead."
msgstr ""
"\"{domain_child}\" ei ole olemassa DNS-vyöhykkeenä. Kokeile sen sijaan "
"testata verkkotunnusta \"{domain_super}\"."

msgctxt "BASIC:B01_PARENT_DISREGARDED"
msgid ""
"This is a test of an undelegated domain so finding the parent zone is "
"disregarded."
msgstr ""
"Tämä on delegoimattoman verkkotunnuksen testi, joten ylemmän vyöhykkeen "
"etsiminen sivuutetaan."

msgctxt "BASIC:B01_PARENT_FOUND"
msgid ""
"The parent zone is \"{domain}\" as returned from name servers "
"\"{servers}\"."
msgstr ""
"Ylempi vyöhyke on \"{domain}\", joka palautui nimipalvelimilta \"{servers}\"."

msgctxt "BASIC:B01_PARENT_NOT_FOUND"
msgid "The parent zone cannot be found."
msgstr "Ylempää vyöhykettä ei löydy."

msgctxt "BASIC:B01_PARENT_NXDOMAIN_HIDES_DELEGATION"
msgid ""
"Parent nameserver \"{ns}/{address}\" returns NXDOMAIN for \"{query_name}\" but "
"also has a delegation for \"{domain_child}\". This violates RFC 8020. The zone "
"is still testable through the delegation, but the parent operator should fix "
"this."
msgstr ""
"Ylemmän vyöhykkeen nimipalvelin \"{ns}/{address}\" palauttaa NXDOMAIN-vastauksen "
"nimelle \"{query_name}\", mutta sillä on silti delegointi nimelle "
"\"{domain_child}\". Tämä rikkoo RFC 8020:a. Vyöhykettä voidaan silti testata "
"delegoinnin kautta, mutta ylemmän vyöhykkeen operaattorin tulisi korjata tämä."

msgctxt "BASIC:B01_PARENT_UNDETERMINED"
msgid "The parent zone cannot be determined on name servers \"{servers}\"."
msgstr "Ylempää vyöhykettä ei voida määrittää nimipalvelimilla \"{servers}\"."

msgctxt "BASIC:B01_ROOT_HAS_NO_PARENT"
msgid "This is a test of the root zone which has no parent zone."
msgstr "Tämä on juurivyöhykkeen testi, jolla ei ole ylempää vyöhykettä."

msgctxt "BASIC:B01_SERVER_ZONE_ERROR"
msgid ""
"Unexpected response on query for \"{query_name}\" with query type "
"\"{query_type}\" to \"{ns}/{address}\"."
msgstr ""
"Odottamaton vastaus kyselyyn nimelle \"{query_name}\" kyselytyypillä "
"\"{query_type}\" kohteeseen \"{ns}/{address}\"."

msgctxt "BASIC:B02_AUTH_RESPONSE_SOA"
msgid ""
"Authoritative answer on SOA query for \"{domain}\" is returned by name "
"servers \"{servers}\"."
msgstr ""
"Autoritatiivinen vastaus SOA-tietue kyselyyn verkkotunnukselle \"{domain}\" "
"palautuu nimipalvelimilta \"{servers}\"."

msgctxt "BASIC:B02_NO_DELEGATION"
msgid ""
"There is no delegation (name servers) for \"{domain}\" which means it does "
"not exist as a zone."
msgstr ""
"Verkkotunnukselle \"{domain}\" ei ole delegointia (nimipalvelimia), mikä "
"tarkoittaa, että sitä ei ole olemassa."

msgctxt "BASIC:B02_NO_WORKING_NS"
msgid "There is no working name server for \"{domain}\" so it is unreachable."
msgstr ""
"Verkkotunnukselle \"{domain}\" ei ole toimivaa nimipalvelinta, joten siihen "
"ei saada yhteyttä."

msgctxt "BASIC:B02_NS_BROKEN"
msgid "Broken response from name server \"{ns}\" on an SOA query."
msgstr "Rikkinäinen vastaus nimipalvelimelta {ns} SOA-kyselyyn."

msgctxt "BASIC:B02_NS_NOT_AUTH"
msgid ""
"Name server \"{ns}\" does not give an authoritative answer on an SOA query."
msgstr "Nimipalvelin {ns} ei vastannut autoritatiivisesti SOA-kyselyyn."

msgctxt "BASIC:B02_NS_NO_IP_ADDR"
msgid "Name server \"{ns}\" cannot be resolved into an IP address."
msgstr "Nimipalvelinta \"{ns}\" ei voida muuttaa IP-osoitteeksi."

msgctxt "BASIC:B02_NS_NO_RESPONSE"
msgid "Name server \"{ns}\" does not respond to an SOA query."
msgstr "Nimipalvelin {ns} ei vastaa SOA-kyselyyn."

msgctxt "BASIC:B02_UNEXPECTED_RCODE"
msgid ""
"Name server \"{ns}\" responds with an unexpected RCODE name (\"{rcode}\") on "
"an SOA query."
msgstr ""
"Nimipalvelin \"{ns}\" vastaa odottamattomalla RCODE-nimellä (\"{rcode}\") "
"SOA-kyselyyn."

msgctxt "ADDRESS:CNAME_CHAIN_TOO_LONG"
msgid "CNAME chain for {query_name} exceeds the maximum allowed length."
msgstr ""
"Nimen {query_name} CNAME-ketju ylittää sallitun enimmäispituuden."

msgctxt "BASIC:CNAME_CHAIN_TOO_LONG"
msgid "CNAME chain for {query_name} exceeds the maximum allowed length."
msgstr ""
"Nimen {query_name} CNAME-ketju ylittää sallitun enimmäispituuden."

msgctxt "CONNECTIVITY:CNAME_CHAIN_TOO_LONG"
msgid "CNAME chain for {query_name} exceeds the maximum allowed length."
msgstr ""
"Nimen {query_name} CNAME-ketju ylittää sallitun enimmäispituuden."

msgctxt "ADDRESS:CNAME_TARGET_UNRESOLVED"
msgid "CNAME target {cname_target} for {query_name} could not be resolved."
msgstr ""
"CNAME-kohdetta {cname_target} nimelle {query_name} ei voitu selvittää."

msgctxt "BASIC:CNAME_TARGET_UNRESOLVED"
msgid "CNAME target {cname_target} for {query_name} could not be resolved."
msgstr ""
"CNAME-kohdetta {cname_target} nimelle {query_name} ei voitu selvittää."

msgctxt "CONNECTIVITY:CNAME_TARGET_UNRESOLVED"
msgid "CNAME target {cname_target} for {query_name} could not be resolved."
msgstr ""
"CNAME-kohdetta {cname_target} nimelle {query_name} ei voitu selvittää."

msgctxt "ADDRESS:CNAME_TOO_MANY_RECORDS"
msgid "Too many CNAME records in the answer for {query_name}."
msgstr "Liian monta CNAME-tietuetta vastauksessa nimelle {query_name}."

msgctxt "BASIC:CNAME_TOO_MANY_RECORDS"
msgid "Too many CNAME records in the answer for {query_name}."
msgstr "Liian monta CNAME-tietuetta vastauksessa nimelle {query_name}."

msgctxt "CONNECTIVITY:CNAME_TOO_MANY_RECORDS"
msgid "Too many CNAME records in the answer for {query_name}."
msgstr "Liian monta CNAME-tietuetta vastauksessa nimelle {query_name}."

msgctxt "BASIC:HAS_A_RECORDS"
msgid "Nameserver {ns}/{address} returned \"A\" record(s) for {domain}."
msgstr ""
"Nimipalvelin {ns}/{address} palautti yhden tai useamman ”A”-tietueen kohteelle "
"{domain}."

msgctxt "BASIC:HAS_NAMESERVER_NO_WWW_A_TEST"
msgid "Functional nameserver found. \"A\" query for www.{zname} test skipped."
msgstr ""
"Toimiva nimipalvelin löytyi. ”A”-kysely www.{zname} testiä varten ohitettiin."

msgctxt "BASIC:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "CONNECTIVITY:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "CONSISTENCY:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "DNSSEC:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "DELEGATION:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "NAMESERVER:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "SYNTAX:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "ZONE:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "SYSTEM:SKIP_IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "BASIC:IPV4_ENABLED"
msgid "IPv4 is enabled, can send \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 on käytössä ja voi lähettää kyselyn \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "BASIC:IPV6_DISABLED"
msgid "IPv6 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv6 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."


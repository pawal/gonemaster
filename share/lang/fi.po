msgctxt "SYSTEM:SKIP_IPV6_DISABLED"
msgid "IPv6 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv6 ei ole käytössä, ei lähetä kyselyä \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "SYSTEM:ERROR_CACHE_SKIP"
msgid "Skipping {query_type} query to {query_name} ({query_class}) at {address} over {protocol} for {ttl_seconds}s after network error."
msgstr "Ohitetaan {query_type}-kysely kohteeseen {query_name} ({query_class}) osoitteessa {address} protokollalla {protocol} {ttl_seconds}s ajan verkko-virheen jälkeen."

msgctxt "BASIC:IPV6_ENABLED"
msgid "IPv6 is enabled, can send \"{query_type}\" query to {ns}/{address}."
msgstr "IPv6 on käytössä ja voi lähettää kyselyn \"{query_type}\" kohteelle {ns}/{address}."

msgctxt "BASIC:NO_A_RECORDS"
msgid "Nameserver {ns}/{address} did not return \"A\" record(s) for {domain}."
msgstr "Nimipalvelin {ns}/{address} ei palauttanut \"A”-tietueita kohteelle {domain}."

msgctxt "CONNECTIVITY:CN01_IPV4_DISABLED"
msgid ""
"IPv4 is disabled. No DNS queries are sent to these name servers: "
"\"{servers}\"."
msgstr ""
"IPv4 on poistettu käytöstä. Näihin nimipalvelimiin ei lähetetä DNS-kyselyjä: "
"\"{servers}\"."

msgctxt "CONNECTIVITY:CN01_IPV6_DISABLED"
msgid ""
"IPv6 is disabled. No DNS queries are sent to these name servers: "
"\"{servers}\"."
msgstr ""
"IPv6 on poistettu käytöstä. Näihin nimipalvelimiin ei lähetetä DNS-kyselyjä: "
"\"{servers}\"."

msgctxt "CONNECTIVITY:CN01_MISSING_NS_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds to a NS query with no NS records in the answer "
"section over UDP."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa NS-kyselyyn ilman NS-tietueita vastausosiossa UDP:n "
"yli."

msgctxt "CONNECTIVITY:CN01_MISSING_SOA_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds to a SOA query with no SOA records in the answer "
"section over UDP."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa SOA-kyselyyn ilman SOA-tietueita vastausosiossa UDP:"
"n yli."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_NS_QUERY_UDP"
msgid "Nameserver {ns}/{address} does not respond to NS queries over UDP."
msgstr "Nimipalvelin {ns}/{address} ei vastaa NS-kyselyihin UDP:n yli."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_SOA_QUERY_UDP"
msgid "Nameserver {ns}/{address} does not respond to SOA queries over UDP."
msgstr "Nimipalvelin {ns}/{address} ei vastannut SOA-kyselyyn UDP:n yli."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_UDP"
msgid "Nameserver {ns}/{address} does not respond to any queries over UDP."
msgstr "Nimipalvelin {ns}/{address} ei vastaa mihinkään kyselyihin UDP:n yli."

msgctxt "CONNECTIVITY:CN01_NS_RECORD_NOT_AA_UDP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an NS query over "
"UDP."
msgstr ""
"Nimipalvelin {ns}/{address} ei anna autoritatiivista vastausta NS-kyselyyn UDP:n yli."

msgctxt "CONNECTIVITY:CN01_SOA_RECORD_NOT_AA_UDP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an SOA query over "
"UDP."
msgstr ""
"Nimipalvelin {ns}/{address} ei vastannut autoritatiivisesti SOA-kyselyyn UDP:n yli."

msgctxt "CONNECTIVITY:CN01_UNEXPECTED_RCODE_NS_QUERY_UDP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an NS query "
"over UDP."
msgstr ""
"Nimipalvelin {ns}/{address} antoi vastaukseksi odottamattoman RCODE ({rcode}) NS-"
"kyselyyn UDP:n yli."

msgctxt "CONNECTIVITY:CN01_UNEXPECTED_RCODE_SOA_QUERY_UDP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an SOA query "
"over UDP."
msgstr ""
"Nimipalvelin {ns}/{address} antoi vastaukseksi odottamattoman RCODE ({rcode}) SOA-"
"kyselyyn UDP:n yli."

msgctxt "CONNECTIVITY:CN01_WRONG_NS_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on NS queries over UDP."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa väärällä omistajanimellä ({domain_found} eikä "
"{domain_expected}) NS-kyselyihin UDP:n kautta."

msgctxt "CONNECTIVITY:CN01_WRONG_SOA_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on SOA queries over UDP."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa väärällä omistajanimellä ({domain_found} eikä "
"{domain_expected}) SOA-kyselyihin UDP:n yli."

msgctxt "CONNECTIVITY:CN02_MISSING_NS_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds to a NS query with no NS records in the answer "
"section over TCP."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa NS-kyselyyn ilman NS-tietueita vastausosiossa TCP:n "
"yli."

msgctxt "CONNECTIVITY:CN02_MISSING_SOA_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds to a SOA query with no SOA records in the answer "
"section over TCP."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa SOA-kyselyyn ilman SOA-tietueita vastausosiossa TCP:"
"n yli."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_NS_QUERY_TCP"
msgid "Nameserver {ns}/{address} does not respond to NS queries over TCP."
msgstr "Nimipalvelin {ns}/{address} ei vastannut NS-kyselyyn TCP:n yli."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_SOA_QUERY_TCP"
msgid "Nameserver {ns}/{address} does not respond to SOA queries over TCP."
msgstr "Nimipalvelin {ns}/{address} ei vastannut SOA-kyselyyn TCP:n yli."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_TCP"
msgid "Nameserver {ns}/{address} does not respond to any queries over TCP."
msgstr "Nimipalvelin {ns}/{address} ei vastaa kyselyihin TCP:n yli."

msgctxt "CONNECTIVITY:CN02_NS_RECORD_NOT_AA_TCP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an NS query over "
"TCP."
msgstr ""
"Nimipalvelin {ns}/{address} ei anna autoritatiivista vastausta NS-kyselyyn TCP:n yli."

msgctxt "CONNECTIVITY:CN02_SOA_RECORD_NOT_AA_TCP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an SOA query over "
"TCP."
msgstr ""
"Nimipalvelin {ns}/{address} ei vastannut autoritatiivisesti SOA-kyselyyn TCP:n yli."

msgctxt "CONNECTIVITY:CN02_UNEXPECTED_RCODE_NS_QUERY_TCP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an NS query "
"over TCP."
msgstr ""
"Nimipalvelin {ns}/{address} antoi vastaukseksi odottamattoman RCODE ({rcode}) NS-"
"kyselyyn TCP:n yli."

msgctxt "CONNECTIVITY:CN02_UNEXPECTED_RCODE_SOA_QUERY_TCP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an SOA query "
"over TCP."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa odottamattomalla RCODE:lla ({rcode}) SOA-kyselyyn "
"TCP:n yli."

msgctxt "CONNECTIVITY:CN02_WRONG_NS_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on NS queries over TCP."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa väärällä omistajan nimellä ({domain_found} eikä "
"{domain_expected}) NS-kyselyihin TCP:n yli."

msgctxt "CONNECTIVITY:CN02_WRONG_SOA_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on SOA queries over TCP."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa väärällä omistajanimellä ({domain_found} eikä "
"{domain_expected}) SOA-kyselyihin TCP:n yli."

msgctxt "CONNECTIVITY:ASN_INFOS_ANNOUNCE_IN"
msgid "Name server IP address \"{address}\" is announced in prefix \"{prefixes}\"."
msgstr ""
"Nimipalvelimen IP-osoite \"{address}\" ilmoitetaan Prefixissä \"{prefixes}\"."

msgctxt "CONNECTIVITY:ASN_INFOS_RAW"
msgid "The ASN data for name server IP address \"{address}\" is \"{data}\"."
msgstr "Nimipalvelimen IP-osoitteen \"{address}\" ASN-tieto on \"{data}\"."

msgctxt "CONNECTIVITY:CN04_EMPTY_PREFIX_SET"
msgid "Prefix database returned no information for IP address {address}."
msgstr "IP prefix tietokanta ei palauttanut tietoja IP-osoitteesta {address}."

msgctxt "CONNECTIVITY:CN04_ERROR_PREFIX_DATABASE"
msgid "Prefix database error. No data to analyze for IP address {address}."
msgstr ""
"IP Prefix tietokantavirhe. IP-osoitteelle {address} ei ole analysoitavia "
"tietoja."

msgctxt "CONNECTIVITY:CN04_IPV4_SAME_PREFIX"
msgid ""
"The following name server(s) are announced in the same IPv4 prefix "
"({prefixes}): \"{servers}\""
msgstr ""
"Seuraavat nimipalvelimet ilmoitetaan samalla IPv4 prefixillä ({prefixes}): "
"\"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV4_DIFFERENT_PREFIX"
msgid ""
"The following name server(s) are announced in unique IPv4 prefix(es): "
"\"{servers}\""
msgstr ""
"Seuraavat nimipalvelimet ilmoitetaan yksilöllisillä IPv4 prefixeillä: "
"\"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV6_SAME_PREFIX"
msgid ""
"The following name server(s) are announced in the same IPv6 prefix "
"({prefixes}): \"{servers}\""
msgstr ""
"Seuraavat nimipalvelimet ilmoitetaan samalla IPv6 prefixillä ({prefixes}): "
"\"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV6_DIFFERENT_PREFIX"
msgid ""
"The following name server(s) are announced in unique IPv6 prefix(es): "
"\"{servers}\""
msgstr ""
"Seuraavat nimipalvelimet ilmoitetaan yksilöllisillä IPv6 prefixeillä: "
"\"{servers}\""

msgctxt "CONNECTIVITY:ERROR_ASN_DATABASE"
msgid "ASN Database error. No data to analyze for {address}."
msgstr "ASN-tietokantavirhe. Ei analysoitavia tietoja kohteelle {address}."

msgctxt "CONNECTIVITY:EMPTY_ASN_SET"
msgid "AS database returned no informations for IP address {address}."
msgstr "AS-tietokanta ei palauttanut tietoa IP-osoitteesta {address}."

msgctxt "CONNECTIVITY:IPV4_SAME_ASN"
msgid ""
"All authoritative nameservers have their IPv4 addresses in the same AS set "
"({asns})."
msgstr ""
"Kaikkien autoritatiivisten nimipalvelimien IPv4-osoitteet kuuluvat samaan AS-"
"joukkoon ({asns})."

msgctxt "CONNECTIVITY:IPV4_ONE_ASN"
msgid ""
"All authoritative nameservers have their IPv4 addresses in the same AS "
"({asn})."
msgstr ""
"Kaikkien autoritatiivisten nimipalvelimien IPv4-osoitteet kuuluvat samaan AS:"
"ään ({asn})."

msgctxt "CONNECTIVITY:IPV4_DIFFERENT_ASN"
msgid ""
"At least two IPv4 addresses of the authoritative nameservers are announced "
"by different AS sets. A merged list of all AS: ({asns})."
msgstr ""
"Eri AS:t ilmoittavat vähintään kaksi autoritatiivistä nimipalvelinten IPv4-"
"osoitetta. Yhdistetty luettelo kaikista AS:ista: ({asns})."

msgctxt "CONNECTIVITY:IPV6_SAME_ASN"
msgid ""
"All authoritative nameservers have their IPv6 addresses in the same AS set "
"({asns})."
msgstr ""
"Kaikilla autoritatiivisilla nimipalvelimilla on IPv6-osoitteensa samassa AS:"
"ssa ({asns})."

msgctxt "CONNECTIVITY:IPV6_ONE_ASN"
msgid ""
"All authoritative nameservers have their IPv6 addresses in the same AS "
"({asn})."
msgstr ""
"Kaikkien autoritatiivisten nimipalvelimien IPv6-osoitteet kuuluvat samaan AS:"
"ään ({asn})."

msgctxt "CONNECTIVITY:IPV6_DIFFERENT_ASN"
msgid ""
"At least two IPv6 addresses of the authoritative nameservers are announced "
"by different AS sets. A merged list of all AS: ({asns})."
msgstr ""
"Eri AS:t ilmoittavat vähintään kaksi arvovaltaisten nimipalvelinten IPv6-"
"osoitetta. Yhdistetty luettelo kaikista AS:ista: ({asns})."

msgctxt "CONNECTIVITY:ASN_INFOS_ANNOUNCE_BY"
msgid "Name server IP address \"{address}\" is announced by ASN {asns}."
msgstr "Nimipalvelimen IP-osoitteen \"{address}\" ilmoittaa ASN {asns}."

msgctxt "CONSISTENCY:ADDRESSES_MATCH"
msgid "Glue records are consistent between glue and authoritative data."
msgstr "Liimatietueet ovat yhtäpitäviä liiman ja autoritäärisen tiedon kanssa."

msgctxt "CONSISTENCY:CHILD_NS_FAILED"
msgid "Unexpected or erroneous reply from {ns}/{address}."
msgstr "Odottamaton tai virheellinen vastaus kohteelta {ns}/{address}."

msgctxt "CONSISTENCY:CHILD_ZONE_LAME"
msgid "Lame delegation."
msgstr "Delegointivirhe."

msgctxt "CONSISTENCY:EXTRA_ADDRESS_CHILD"
msgid ""
"Child has extra nameserver IP address(es) not listed at parent "
"({addresses})."
msgstr ""
"Alemmalla tasolla on yksi tai useampia nimipalvelimen IP-osoitteita, joita "
"ei ole listattu ylemmällä tasolla ({addresses})."

msgctxt "CONSISTENCY:IN_BAILIWICK_ADDR_MISMATCH"
msgid ""
"In-bailiwick name server listed at parent has a mismatch between glue data "
"at parent ({parent_servers}) and any equivalent address record in child "
"zone ({zone_servers})."
msgstr ""
"Ylemmällä tasolla alueelle listatulla nimipalvelimella on "
"yhteensopimattomuus ylemmän tason liimatietojen ({parent_servers}) ja "
"alemman vyöhykkeen mahdollisten vastaavien osoitetietueiden välillä "
"({zone_servers})."

msgctxt "CONSISTENCY:MULTIPLE_NS_SET"
msgid "Found {count} NS set(s)."
msgstr "NS-joukkoja löydetty {count} kpl."

msgctxt "CONSISTENCY:MULTIPLE_SOA_MNAMES"
msgid "Saw {count} SOA mname."
msgstr "SOA mname -tietoja havaittu {count} kpl."

msgctxt "CONSISTENCY:MULTIPLE_SOA_RNAMES"
msgid "Found {count} SOA rname(s)."
msgstr "SOA rname -tietoja löydetty {count} kpl."

msgctxt "CONSISTENCY:MULTIPLE_SOA_SERIALS"
msgid "Found {count} SOA serial number(s)."
msgstr "SOA-sarjanumeroita löydetty {count} kpl."

msgctxt "CONSISTENCY:MULTIPLE_SOA_TIME_PARAMETER_SET"
msgid "Found {count} SOA time parameter set(s)."
msgstr "SOA-aikaparametrijoukkoja löydetty {count} kpl."

msgctxt "CONSISTENCY:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "Nimipalvelin {ns} ei vastannut."

msgctxt "DNSSEC:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "Nimipalvelin {ns} ei vastannut."

msgctxt "DELEGATION:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "Nimipalvelin {ns} ei vastannut."

msgctxt "ZONE:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "Nimipalvelin {ns} ei vastannut."

msgctxt "CONSISTENCY:NO_RESPONSE_NS_QUERY"
msgid "No response from nameserver {ns}/{address} on NS queries."
msgstr "Nimipalvelin {ns}/{address} ei vastannut NS-kyselyihin."

msgctxt "CONSISTENCY:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver {ns}/{address} on SOA queries."
msgstr "Nimipalvelin {ns}/{address} ei vastannut SOA-kyselyihin."

msgctxt "CONSISTENCY:NS_SET"
msgid "Saw NS set ({ns_set_servers}) on following nameserver set : {servers}."
msgstr ""
"Havaittu NS-joukko ({ns_set_servers}) seuraavassa nimipalvelinjoukossa: "
"{servers}."

msgctxt "CONSISTENCY:ONE_NS_SET"
msgid "A single NS set was found ({servers})."
msgstr "Yksi NS-joukko löydettiin kohteesta ({servers})."

msgctxt "CONSISTENCY:ONE_SOA_MNAME"
msgid "A single SOA mname value was seen ({mname})."
msgstr "Yksi SOA mname -arvo havaittiin kohteessa ({mname})."

msgctxt "CONSISTENCY:ONE_SOA_RNAME"
msgid "A single SOA rname value was found ({rname})."
msgstr "Yksi SOA rname -arvo löydettiin kohteesta ({rname})."

msgctxt "CONSISTENCY:ONE_SOA_SERIAL"
msgid "A single SOA serial number was found ({serial})."
msgstr "Yksi SOA-sarjanumero löydettiin kohteesta ({serial})."

msgctxt "CONSISTENCY:ONE_SOA_TIME_PARAMETER_SET"
msgid ""
"A single SOA time parameter set was seen (REFRESH={refresh},RETRY={retry},"
"EXPIRE={expire},MINIMUM={minimum})."
msgstr ""
"Yksi SOA-aikaparametrijoukko havaittiin (REFRESH={refresh},RETRY={retry},"
"EXPIRE={expire},MINIMUM={minimum})."

msgctxt "CONSISTENCY:OUT_OF_BAILIWICK_ADDR_MISMATCH"
msgid ""
"Out-of-bailiwick name server listed at parent with glue record has a "
"mismatch between the glue at the parent ({parent_servers}) and any "
"equivalent address record found in authoritative zone ({zone_servers})."
msgstr ""
"Ylemmällä tasolla alueen ulkopuolelle listatulla nimipalvelimella on "
"yhteensopimattomuus ylemmän tason liimatietojen ({parent_servers}) ja "
"autoritäärisen alueen mahdollisten vastaavien osoitetietueiden välillä "
"({zone_servers})."

msgctxt "CONSISTENCY:SOA_RNAME"
msgid "Found SOA rname {rname} on following nameserver set : {servers}."
msgstr ""
"Löydetty SOA rname {rname} seuraavasta nimipalvelinjoukosta: {servers}."

msgctxt "CONSISTENCY:SOA_SERIAL"
msgid "Saw SOA serial number {serial} on following nameserver set : {servers}."
msgstr ""
"Havaittu SOA-sarjanumero {serial} seuraavassa nimipalvelinjoukossa: "
"{servers}."

msgctxt "CONSISTENCY:SOA_SERIAL_VARIATION"
msgid ""
"Difference between the smaller serial ({serial_min}) and the bigger one "
"({serial_max}) is greater than the maximum allowed ({max_variation})."
msgstr ""
"Pienemmän sarjanumeron ({serial_min}) ja suuremman ({serial_max}) välinen "
"ero on suurempi kuin suurin mahdollinen sallittu arvo ({max_variation})."

msgctxt "CONSISTENCY:SOA_TIME_PARAMETER_SET"
msgid ""
"Saw SOA time parameter set (REFRESH={refresh}, RETRY={retry}, "
"EXPIRE={expire}, MINIMUM={minimum}) on following nameserver set : {servers}."
msgstr ""
"Havaittu SOA-aikaparametrijoukko (REFRESH={refresh}, RETRY={retry}, "
"EXPIRE={expire}, MINIMUM={minimum}) seuraavassa nimipalvelinjoukossa: "
"{servers}."

msgctxt "DNSSEC:DNSKEY_SMALLER_THAN_REC"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) smaller than the recommended one ({keysizerec})."
msgstr ""
"DNSKEY, jolla on tunniste {keytag} ja joka käyttää algoritmia {algo_num} "
"({algo_descr}), on kooltaan ({keysize}) pienempi kuin suositeltu "
"({keysizerec})."

msgctxt "DNSSEC:DNSKEY_TOO_SMALL_FOR_ALGO"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) smaller than the minimum one ({keysizemin})."
msgstr ""
"DNSKEY, jolla on tunniste {keytag} ja joka käyttää algoritmia {algo_num} "
"({algo_descr}), on kooltaan ({keysize}) pienempi kuin vähimmäiskoko "
"({keysizemin})."

msgctxt "DNSSEC:DNSKEY_TOO_LARGE_FOR_ALGO"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) larger than the maximum one ({keysizemax})."
msgstr ""
"DNSKEY, jolla on tunniste {keytag} ja joka käyttää algoritmia {algo_num} "
"({algo_descr}), on kooltaan ({keysize}) suurempi kuin enimmäiskoko "
"({keysizemax})."

msgctxt "DNSSEC:DS01_DS_ALGO_DEPRECATED"
msgid ""
"DS record for zone {domain} with keytag {keytag} was created by digest "
"algorithm {ds_algo_num} ({ds_algo_mnemo}) which is deprecated. Fetched from "
"the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Zonen {domain} DS-tietue jonka tunniste (keytag) on {keytag} on luotu "
"tiivistealgoritmilla {ds_algo_num} ({ds_algo_mnemo}) joka on poistunut "
"käytöstä. Tiedot on haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_2_MISSING"
msgid ""
"No DS record created by digest algorithm 2 (SHA-256) is present for zone "
"{domain}."
msgstr ""
"Vyöhykkeellä {domain} ei ole tiivistealgoritmilla 2 (SHA-256) luotua DS-"
"tietuetta."

msgctxt "DNSSEC:DS01_DS_ALGO_NOT_DS"
msgid ""
"DS record for zone {domain} with keytag {keytag} was created by digest "
"algorithm {ds_algo_num} ({ds_algo_mnemo}) which is not meant for DS. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Zonen {domain} DS-tietue jonka tunniste (keytag) on {keytag} on luotu "
"tiivistealgoritmilla {ds_algo_num} ({ds_algo_mnemo}) jota ei ole tarkoitettu "
"DS-tietueelle. Tiedot on haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_RESERVED"
msgid ""
"DS record for zone {domain} with keytag {keytag} was created with an "
"unassigned digest algorithm (algorithm number {ds_algo_num}). Fetched from "
"the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Zonen {domain} DS-tietue jonka tunniste (keytag) on {keytag} on luotu "
"määrittämättömällä tiivistealgoritmilla {ds_algo_num}. Tiedot on haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS02_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"DNSKEY-tietue tunnisteella {keytag} käyttää algoritmia {algo_num} "
"({algo_mnemo}) jota Zonemaster ei tue. Tiedot haettu nimipalvelimilta joiden "
"IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS08_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"DNSKEY-tietue tunnisteella {keytag} käyttää algoritmia {algo_num} "
"({algo_mnemo}) jota Zonemaster ei tue. Tiedot haettu nimipalvelimilta joiden "
"IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS09_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"DNSKEY-tietue tunnisteella {keytag} käyttää algoritmia {algo_num} "
"({algo_mnemo}) jota Zonemaster ei tue. Tiedot haettu nimipalvelimilta joiden "
"IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS10_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"DNSKEY-tietue tunnisteella {keytag} käyttää algoritmia {algo_num} "
"({algo_mnemo}) jota Zonemaster ei tue. Tiedot haettu nimipalvelimilta joiden "
"IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_FOR_ZONE_SIGNING"
msgid ""
"Flags field of DNSKEY record with tag {keytag} has not ZONE bit set although "
"DS with same tag is present in parent. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"DNSKEY-tietueen lippu kenttä tunnisteella {keytag} ei ole ZONE bit asetettu "
"vaikka DS-tietue samalla tunnisteella löytyy ylemmältä tasolta. Tiedot "
"haettu nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_SEP"
msgid ""
"Flags field of DNSKEY record with tag {keytag} has not SEP bit set although "
"DS with same tag is present in parent. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"DNSKEY-tietueen tunnisteella {keytag} lippu kentälle ei ole asetettu SEP "
"bittiä vaikka samalla tunnisteella DS-tietue on asetettu ylätasolle. Tiedot "
"haettu nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_SIGNED_BY_ANY_DS"
msgid ""
"The DNSKEY RRset has not been signed by any DNSKEY matched by a DS record. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"DNSKEY RRset ei ole allekirjoitettu millään DS-tietuetta vastaavalla DNSKEY:"
"llä. Haettu nimipalvelimista, joiden IP-osoite on \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_DNSKEY_FOR_DS"
msgid ""
"The DNSKEY record with tag {keytag} that the DS refers to does not exist in "
"the DNSKEY RRset. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"DNSKEY-tietue tunnisteella {keytag} johon DS-tietue osoittaa ei ole "
"olemassa DNSKEY RRsetissä. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_MATCHING_DNSKEY_RRSIG"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY with tag {keytag} that the DS "
"record refers to. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"DNSKEY RRset ei ole allekirjoitettu DNSKEYllä jonka avaimen tunniste "
"(keytag) on {keytag} ja johon DS-tietue viittaa. Tiedot haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_MATCH_DS_DNSKEY"
msgid ""
"The DS record does not match the DNSKEY with tag {keytag} by algorithm or "
"digest. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"DS tietue {keytag} ei täsmää DNSKEY:n tunnisteella {keytag} algoritmin tai "
"tiivisteen osalta. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_VALID_DNSKEY_FOR_ANY_DS"
msgid ""
"There is no valid DNSKEY matched by any of the DS records. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Mikään DS-tietue ei vastaa kelvollista DNSKEY:tä. Haettu nimipalvelimista, "
"joiden IP-osoite on \"{addresses}\"."

msgctxt "DNSSEC:DS02_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"DNSKEY RRset on allekirjoitettu RRSIG:llä jonka tunniste on {keytag} mutta "
"sitä ei voi validoida DNSKEY:llä. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS08_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"DNSKEY RRset on allekirjoitettu RRSIG:llä jonka tunniste on {keytag} mutta "
"sitä ei voi validoida DNSKEY:llä. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type DNSKEY has already expired. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"RRSIG tunnisteella {keytag} ja DNSKEY on jo vanhentunut. Tiedot haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_NOT_YET_VALID"
msgid ""
"RRSIG with keytag {keytag} and covering type DNSKEY has inception date in "
"the future. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"RRSIG tunnisteella {keytag} joka kattaa DNSKEY:n on voimassaolon alkupäivä "
"tulevaisuudessa. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS08_MISSING_RRSIG_IN_RESPONSE"
msgid ""
"The DNSKEY RRset is not signed, which is against expectation. Fetched from "
"the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"DNSKEY RRset ei ole allekirjoitettu. Tiedot haettu nimipalvelimilta joiden "
"IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS08_NO_MATCHING_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which does not "
"match any DNSKEY record. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"DNSKEY RRset on allekirjoitettu RRSIG:llä tunnisteella {keytag} ei täsmää "
"yhteenkään DNSKEY tietueeseen. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS09_MISSING_RRSIG_IN_RESPONSE"
msgid ""
"The SOA RRset is not signed, which is against expectation. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"SOA RRset ei ole allekirjoitettu. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS09_NO_MATCHING_DNSKEY"
msgid ""
"The SOA RRset is signed with an RRSIG with tag {keytag} which does not match "
"any DNSKEY record. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"SOA RRset on allekirjoitettu RRSIG:llä tunnisteella {keytag} mikä ei täsmää "
"yhteenkään DNSKEY tietueeseen. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS09_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The SOA RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"SOA RRset on allekirjoitettu RRSIG:llä tunnisteella {keytag} mutta sitä ei "
"voida validoida vastaavalla DNSKEY RRset:llä. Tiedot haettu nimipalvelimilta "
"joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type SOA has already expired. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"RRSIG tietue {keytag} ei täsmää DNSKEY tietueeseen. Tiedot haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_NOT_YET_VALID"
msgid ""
"RRSIG with keytag {keytag} and covering type SOA has inception date in the "
"future. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"SOA-tietueen RRSIG tietueen {keytag} voimassaolon voimassaolon alku pvm pvm "
"on tulevaisuudessa. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS10_HAS_NSEC"
msgid ""
"The zone has NSEC records. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Zonella on NSEC tietueita. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS10_HAS_NSEC3"
msgid ""
"The zone has NSEC3 records. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Zonella on NSEC3 tietueita. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS10_INCONSISTENT_NSEC_NSEC3"
msgid ""
"The zone is inconsistent on NSEC and NSEC3. NSEC is fetched from nameservers "
"with IP addresses \"{ns_ip_list_nsec}\". NSEC3 is fetched from nameservers "
"with IP addresses \"{ns_ip_list_nsec3}\"."
msgstr ""
"Zone on epäjohdonmukainen NSEC ja NSEC3 osalta. NSEC on haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{ns_ip_list_nsec}\". NSEC3 on "
"haettu nimipalvelimilta joiden IP-osoitteet ovat \"{ns_ip_list_nsec3}\"."

msgctxt "DNSSEC:DS10_MIXED_NSEC_NSEC3"
msgid ""
"Unexpectedly both NSEC and NSEC3 are reported. Fetched from the nameservers "
"with IP addresses \"{addresses}\"."
msgstr ""
"Sekä NSEC että NSEC3 raportoidaan. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS10_NSEC3_MISSING_SIGNATURE"
msgid ""
"Missing signatures (RRSIG) for the NSEC3 record or records. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Allekirjoitukset (RRSIG) puuttuvat NSEC3 tietueelta tai tietueilta. Tiedot "
"haettu nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_VERIFY_ERROR"
msgid ""
"The signatures (RRSIG) for the NSEC3 record or records cannot be verified. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Allekirjoituksia (RRSIG) NSEC3 tietueen osalta ei pystytä varmistamaan. "
"Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS10_NSEC_MISSING_SIGNATURE"
msgid ""
"Missing signatures (RRSIG) for the NSEC record or records. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Allekirjoitukset (RRSIG) puuttuvat NSEC3 tietueen tai tietueiden osalta. "
"Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_VERIFY_ERROR"
msgid ""
"The signatures (RRSIG) for the NSEC record or records cannot be verified. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Allekirjoituksia (RRSIG) NSEC tietueelle tai tietueille ei pystytä "
"varmentamaan. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS11_INCONSISTENT_DS"
msgid "Parent name servers are inconsistent on the existence of DS."
msgstr "Päänimipalvelimien tiedot ovat epäjohdonmukaiset DS-tietueen osalta."

msgctxt "DNSSEC:DS11_INCONSISTENT_SIGNED_ZONE"
msgid ""
"Name servers for the child zone are inconsistent on whether the zone is "
"signed or not."
msgstr ""
"Alemman vyöhykkeen nimipalvelimet palauttavat ristiriitaista tietoa siitä "
"onko vyöhyke (zone) allekirjoitettu vai ei."

msgctxt "DNSSEC:DS11_UNDETERMINED_DS"
msgid ""
"It cannot be determined if the parent zone has DS for the child zone or not."
msgstr ""
"Ei pystytä päättelemään onko ylemmällä vyöhykkeellä DS-tietue alemmalle "
"vyöhykkeelle."

msgctxt "DNSSEC:DS11_UNDETERMINED_SIGNED_ZONE"
msgid "It cannot be determined if the child zone is signed or not."
msgstr "Ei pystytä päättelemään onko alempi vyöhyke allekirjoitettu vai ei."

msgctxt "DNSSEC:DS11_PARENT_WITHOUT_DS"
msgid ""
"No DS record for the child zone found on parent nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Alemmalle vyöhykkeelle (child zone) ei löydy DS-tietueita ylemmän vyöhykkeen "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS11_PARENT_WITH_DS"
msgid ""
"DS record for the child zone found on parent nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Alemman vyöhykkeen DS-tietue löytyi ylemmän vyöhykkeen nimipalvelimilta "
"joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS11_NS_WITH_SIGNED_ZONE"
msgid ""
"Signed child zone found on nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Allekirjoitettu alempi vyöhyke löytyi nimipalvelimilta joiden IP-osoitteet "
"ovat \"{addresses}\"."

msgctxt "DNSSEC:DS11_NS_WITH_UNSIGNED_ZONE"
msgid ""
"Unsigned child zone found on nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Allekirjoittamaton alempi vyöhyke (child zone) löytyi nimipalvelimilta "
"joiden IP-osoitteet ovat \"{addresses}"

msgctxt "DNSSEC:DS11_DS_BUT_UNSIGNED_ZONE"
msgid "The child zone is unsigned, but the parent zone has DS record."
msgstr ""
"Alempi vyöhyke (child zone) on allekirjoittamaton, mutta ylemmällä "
"vyöhykkeellä (parent) on DS-tietue."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_DNSKEY"
msgid ""
"The DNSKEY RRset is not signed by algorithm {algo_num} ({algo_mnemo}) "
"present in the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"DNSKEY RRset ei ole allekirjoitettu algoritmilla {algo_num} ({algo_mnemo}) "
"joka löytyy DNSKEY RRset:stä. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_NS"
msgid ""
"The NS RRset is not signed by algorithm {algo_num} ({algo_mnemo}) present in "
"the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"NS RRset ei ole allekirjoitettu algoritmilla {algo_num} ({algo_mnemo}) joka "
"löytyy DNSKEY RRset:stä Tiedot haettu nimipalvelimilta joiden IP-osoitteet "
"ovat \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_SOA"
msgid ""
"The SOA RRset is not signed by algorithm {algo_num} ({algo_mnemo}) present "
"in the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"SOA RRset ei ole allekirjoitettu algoritmilla {algo_num} ({algo_mnemo}) joka "
"löytyy DNSKEY RRset:stä. Tiedot haettu nimipalvelimilta joiden IP-osoitteet "
"ovat \"{addresses}\"."

msgctxt "DNSSEC:DS15_HAS_CDNSKEY_NO_CDS"
msgid ""
"CDNSKEY RRset is found on nameservers that resolve to IP addresses "
"({addresses}), but no CDS RRset."
msgstr ""
"CDNSKEY RRset löytyy nimipalvelimilta IP-osoitteista ({addresses}), mutta "
"ei CDS RRset asetuksia."

msgctxt "DNSSEC:DS15_HAS_CDS_AND_CDNSKEY"
msgid ""
"CDNSKEY and CDS RRsets are found on nameservers that resolve to IP addresses "
"({addresses})."
msgstr ""
"CDNSKEY ja CDS RRsets löytyvät nimipalvelimilta IP-osoitteista "
"({addresses})."

msgctxt "DNSSEC:DS15_HAS_CDS_NO_CDNSKEY"
msgid ""
"CDS RRset is found on nameservers that resolve to IP addresses "
"({addresses}), but no CDNSKEY RRset."
msgstr ""
"CDS RRset löytyy nimipalvelimilta IP-osoitteista ({addresses}), mutta ei "
"CDNSKEY RRset asetuksia."

msgctxt "DNSSEC:DS15_INCONSISTENT_CDNSKEY"
msgid "All servers do not have the same CDNSKEY RRset."
msgstr "Kaikilla nimipalvelimilla ei ole sama CDNSKEY RRset."

msgctxt "DNSSEC:DS15_INCONSISTENT_CDS"
msgid "All servers do not have the same CDS RRset."
msgstr "Kaikilla nimipalvelimilla ei ole sama CDS RRset."

msgctxt "DNSSEC:DS15_MISMATCH_CDS_CDNSKEY"
msgid ""
"Both CDS and CDNSKEY RRsets are found on nameservers that resolve to IP "
"addresses ({addresses}) but they do not match."
msgstr ""
"CDS ja CDNSKEY RRsets löytyvät nimipalvelimilta IP-osoitteista "
"({addresses}), mutta ne eivät täsmää."

msgctxt "DNSSEC:DS15_NO_CDS_CDNSKEY"
msgid "No CDS or CDNSKEY RRsets are found on any name server."
msgstr "CDS tai CDNSKEY RR eivät löydy yhdeltäkään nimipalvelimista."

msgctxt "DNSSEC:DS16_CDS_INVALID_RRSIG"
msgid ""
"The CDS RRset is signed with an RRSIG with tag {keytag}, but the RRSIG does "
"not match the DNSKEY with the same key tag. Fetched from the nameservers "
"with IP addresses \"{addresses}\"."
msgstr ""
"CDS RRset on allekirjoitettu RRSIG:llä {keytag}, mutta RRSIG ei täsmää "
"DNSKEY:n samalla tunnisteella. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NON_SEP_DNSKEY"
msgid ""
"The CDS record with tag {keytag} matches a DNSKEY record with SEP bit (bit "
"15) unset. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDS tietue {keytag} täsmää DNSKEY tietueeseen jolla SEP bit (bit 15) pois "
"päältä. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NON_ZONE_DNSKEY"
msgid ""
"The CDS record with tag {keytag} matches a DNSKEY record with zone bit (bit "
"7) unset. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDS tietue {keytag} täsmää DNSKEY tietueeseen jolla zone bit (bit 7) pois "
"päältä. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NO_DNSKEY"
msgid ""
"The CDS record with tag {keytag} does not match any DNSKEY record. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDS tietue {keytag} ei täsmää yhteenkään DNSKEY tietueeseen. Tiedot haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_NOT_SIGNED_BY_CDS"
msgid ""
"The CDS RRset is not signed by the DNSKEY that the CDS record with tag "
"{keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"CDS RRset ei ole allekirjoitettu DNSKEY:llä johon CDS-tietue tunnisteella "
"{keytag} osoittaa. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_SIGNED_BY_UNKNOWN_DNSKEY"
msgid ""
"The CDS RRset is signed by RRSIG with tag {keytag} but that is not in the "
"DNSKEY RRset. Fetched from the nameservers with P addresses \"{addresses}\"."
msgstr ""
"CDS RRset on allekirjoitettu RRSIG:llä {keytag} mutta se ei ole DNSKEY RRset:"
"ssä. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_UNSIGNED"
msgid ""
"The CDS RRset is not signed. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"CDS RRset ei ole allekirjoitettu. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_WITHOUT_DNSKEY"
msgid ""
"A CDS RRset exists, but no DNSKEY record exists. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDS RRset on olemassa, mutta DNSKEY tietuetta ei löydy. Tiedot haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS16_DELETE_CDS"
msgid ""
"A single \"delete\" CDS record is found on the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Yksittäinen \"delete\" CDS-tietue löytyi nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}"

msgctxt "DNSSEC:DS16_DNSKEY_NOT_SIGNED_BY_CDS"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY that the CDS record with tag "
"{keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"DNSKEY RRset ei ole allekirjoitettu DNSKEY:llä johon CDS-tietue tunnisteella "
"{keytag} osoittaa. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS16_MIXED_DELETE_CDS"
msgid ""
"The CDS RRset is a mixture between \"delete\" record and other records. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDS RRset on sekoitus \"delete\" tietuetta ja muita tietueita. Tiedot haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_INVALID_RRSIG"
msgid ""
"The CDNSKEY RRset is signed with an RRSIG with tag {keytag}, but the RRSIG "
"does not match the DNSKEY with the same key tag. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDNSKEY RRset on allekirjoitettu RRSIG:llä jonka tunniste on {keytag}, mutta "
"RRSIG ei täsmää DNSKEY:n samalla tunnisteella. Tiedot haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_IS_NON_SEP"
msgid ""
"The CDNSKEY record with tag {keytag} has the SEP bit (bit 15) unset. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDNSKEY tietue tunnisteella (keytag) {keytag} on SEP bit (bit 15) "
"asettamatta. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_IS_NON_ZONE"
msgid ""
"The CDNSKEY record with tag {keytag} has the zone bit (bit 7) unset. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDNSKEY-tietueella tunnisteella (keytag) {keytag} on zone bit (bit 7) "
"asettamatta. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_MATCHES_NO_DNSKEY"
msgid ""
"The CDNSKEY record with tag {keytag} does not match any DNSKEY record. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDNSKEY-tietue tunnisteella {keytag} ei täsmää yhteenkään DNSKEY "
"tietueeseen. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_NOT_SIGNED_BY_CDNSKEY"
msgid ""
"The CDNSKEY RRset is not signed by the DNSKEY that the CDNSKEY record with "
"tag {keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"CDNSKEY RRset ei ole allekirjoitettu DNSKEY:llä johon CDNSKEY tietue "
"tunnisteella {keytag} osoittaa. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_SIGNED_BY_UNKNOWN_DNSKEY"
msgid ""
"The CDNSKEY RRset is signed by RRSIG with tag {keytag} but that is not in "
"the DNSKEY RRset. Fetched from the nameservers with P addresses "
"\"{addresses}\"."
msgstr ""
"CDNSKEY RRset on allekirjoitettu RRSIG:llä jonka tunniste on {keytag} mutta "
"se ei löydy DNSKEY RRset:stä. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_UNSIGNED"
msgid ""
"The CDNSKEY RRset is not signed. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"CDNSKEY RRset ei ole allekirjoitettu. Tiedot haettu nimipalvelimilta joiden "
"IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_WITHOUT_DNSKEY"
msgid ""
"A CDNSKEY RRset exists, but no DNSKEY record exists. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDNSKEY RRset on olemassa, mutta DNSKEY tietuetta ei löydy. Tiedot haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS17_DELETE_CDNSKEY"
msgid ""
"A single \"delete\" CDNSKEY record is found on the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Yksittäinen \"delete\" CDNSKEY tietue löytyy nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS17_DNSKEY_NOT_SIGNED_BY_CDNSKEY"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY that the CDNSKEY record with "
"tag {keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"DNSKEY RRset ei ole allekirjoitettu DNSKEY:llä johon CDNSKEY tietue "
"tunnisteella {keytag} osoittaa. Tiedot haettu nimipalvelimilta joiden IP-"
"osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS17_MIXED_DELETE_CDNSKEY"
msgid ""
"The CDNSKEY RRset is a mixture between \"delete\" record and other records. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDNSKEY RRset on sekoitus \"delete\" tietuetta ja muita tietueita. Tiedot "
"haettu nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS18_NO_MATCH_CDS_RRSIG_DS"
msgid ""
"The CDS RRset is not signed with a DNSKEY record that a DS record points to. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDS RRset ei ole allekirjoitettu DNSKEY tietueella johon DS-tietue osoittaa. "
"Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS18_NO_MATCH_CDNSKEY_RRSIG_DS"
msgid ""
"The CDNSKEY RRset is not signed with a DNSKEY record that a DS record points "
"to. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"CDNSKEY RRset ei ole allekirjoitettu DNSKEY:llä johon DS-tietue osoittaa. "
"Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "DNSSEC:DS19_BADKEY_FERMAT"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus vulnerable to Fermat factorization (close primes) on name server(s) "
"{servers}."
msgstr "DNSKEY, jonka keytag on {keytag} ja algoritmi {algo_descr} ({algo_num}), sisältää RSA-moduluksen, joka on haavoittuva Fermat-faktoroinnille (lähellä olevat alkuluvut) nimipalvelimilla {servers}."

msgctxt "DNSSEC:DS19_BADKEY_PATTERN"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus with suspicious repeating byte pattern on name server(s) {servers}."
msgstr "DNSKEY, jonka keytag on {keytag} ja algoritmi {algo_descr} ({algo_num}), sisältää RSA-moduluksen, jossa on epäilyttävä toistuva tavukuvio nimipalvelimilla {servers}."

msgctxt "DNSSEC:DS19_BADKEY_ROCA"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) is "
"vulnerable to ROCA attack (CVE-2017-15361) on name server(s) {servers}."
msgstr "DNSKEY, jonka keytag on {keytag} ja algoritmi {algo_descr} ({algo_num}), on haavoittuva ROCA-hyökkäykselle (CVE-2017-15361) nimipalvelimilla {servers}."

msgctxt "DNSSEC:DS19_BADKEY_RSA_INVALID"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has "
"invalid RSA parameters ({subtest}) on name server(s) {servers}."
msgstr "DNSKEY, jonka keytag on {keytag} ja algoritmi {algo_descr} ({algo_num}), sisältää virheelliset RSA-parametrit ({subtest}) nimipalvelimilla {servers}."

msgctxt "DNSSEC:DS19_BADKEY_SMALL_D"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"private exponent recoverable via Wiener's attack on name server(s) {servers}."
msgstr "DNSKEY, jonka keytag on {keytag} ja algoritmi {algo_descr} ({algo_num}), sisältää RSA-yksityiseksponentin, joka voidaan palauttaa Wienerin hyökkäyksellä nimipalvelimilla {servers}."

msgctxt "DNSSEC:DS19_BADKEY_SMALL_FACTORS"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus with small prime factors on name server(s) {servers}."
msgstr "DNSKEY, jonka keytag on {keytag} ja algoritmi {algo_descr} ({algo_num}), sisältää RSA-moduluksen, jossa on pieniä alkutekijöitä nimipalvelimilla {servers}."

msgctxt "DNSSEC:DS19_BLOCKLIST_NOT_FOUND"
msgid ""
"Badkeys blocklist data not found. Blocklist check skipped. Run 'gonemaster "
"--badkeys-update' to download the blocklist."
msgstr "Badkeys-estolistan tietoja ei löytynyt. Estolistatarkistus ohitettiin. Suorita 'gonemaster --badkeys-update' ladataksesi estolistan."

msgctxt "DNSSEC:DS19_KEY_OK"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) passed "
"all badkey checks on name server(s) {servers}."
msgstr "DNSKEY, jonka keytag on {keytag} ja algoritmi {algo_descr} ({algo_num}), läpäisi kaikki badkeys-tarkistukset nimipalvelimilla {servers}."

msgctxt "DNSSEC:DS19_NO_DNSKEY"
msgid "No DNSKEY records found at zone apex on name server(s) {servers}."
msgstr "DNSKEY-tietueita ei löytynyt vyöhykkeen huipulta nimipalvelimilla {servers}."

msgctxt "DNSSEC:DS19_NO_RESPONSE"
msgid ""
"No name server produced a usable DNSKEY response for badkey checking on "
"name server(s) {servers}."
msgstr "Yksikään nimipalvelin ei tuottanut käyttökelpoista DNSKEY-vastausta badkeys-tarkistusta varten nimipalvelimilla {servers}."

msgid "{parent} sent a DS record, but {child} did not send a DNSKEY record."
msgstr "{parent} sent a DS record, but {child} did not send a DNSKEY record."

msgctxt "DNSSEC:DURATION_LONG"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a duration of "
"{duration} seconds, which is too long."
msgstr ""
"RRSIG, jolla on avaintunniste {keytag} ja joka kattaa tyypin/tyypit {types}, "
"kestää {duration} sekuntia, mikä on liian kauan."

msgctxt "DNSSEC:DURATION_OK"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a duration of "
"{duration} seconds, which is just fine."
msgstr ""
"RRSIG, jolla on avaintunniste {keytag} ja joka kattaa tyypin/tyypit {types}, "
"kestää {duration} sekuntia, mikä on sopivasti."

msgctxt "DNSSEC:EXTRA_PROCESSING_BROKEN"
msgid ""
"Server at {address} sent {keys} DNSKEY records, and {sigs} RRSIG records."
msgstr ""
"Palvelin kohteessa {address} lähetti {keys} DNSKEY-tietueet ja {sigs} RRSIG-"
"tietueet."

msgctxt "DNSSEC:EXTRA_PROCESSING_OK"
msgid "Server at {address} sent {keys} DNSKEY records and {sigs} RRSIG records."
msgstr ""
"Palvelin kohteessa {address} lähetti {keys} DNSKEY-tietueet ja {sigs} RRSIG-"
"tietueet."

msgctxt "DNSSEC:KEY_SIZE_OK"
msgid "All keys from the DNSKEY RRset have the correct size."
msgstr "Kaikki DNSKEY RRset -joukon avaimet ovat oikean kokoisia."

msgctxt "DNSSEC:NO_RESPONSE_DNSKEY"
msgid "Nameserver {ns}/{address} responded with no DNSKEY record(s)."
msgstr "Nimipalvelimen {ns}/{address} vastauksessa ei ollut DNSKEY-tietueita."

msgctxt "DNSSEC:REMAINING_LONG"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a remaining "
"validity of {duration} seconds, which is too long."
msgstr ""
"RRSIG-tietue, jolla on avaintunniste {keytag} ja joka kattaa tyypin/tyypit "
"{types}, on voimassa vielä {duration} sekuntia, mikä on liian pitkään."

msgctxt "DNSSEC:REMAINING_SHORT"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a remaining "
"validity of {duration} seconds, which is too short."
msgstr ""
"RRSIG-tietue, jolla on avaintunniste {keytag} ja joka kattaa tyypin/tyypit "
"{types}, on voimassa enää {duration} sekuntia, mikä on liian vähän."

msgctxt "DNSSEC:RRSIG_EXPIRATION"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} expires at : {date}."
msgstr ""
"RRSIG-tietueen, jolla on avaintunniste {keytag} ja joka kattaa tyypin/tyypit "
"{types}, voimassaolo päättyy: {date}."

msgctxt "DNSSEC:RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has already expired "
"(expiration is: {expiration})."
msgstr ""
"RRSIG-tietueen, jolla on avaintunniste {keytag} ja joka kattaa tyypin/tyypit "
"{types}, voimassaolo on jo päättynyt (voimassaolon päättymisaika: "
"{expiration})."

msgctxt "DELEGATION:ARE_AUTHORITATIVE"
msgid ""
"All these nameservers are confirmed to be authoritative : {servers}."
msgstr ""
"Vahvistetaan, että kaikki nämä nimipalvelimet ovat autoritäärisiä: "
"{servers}."

msgctxt "DELEGATION:CHILD_DISTINCT_NS_IP"
msgid "All the IP addresses used by the nameservers in child are unique."
msgstr ""
"Kaikki alemman tason nimipalvelinten käyttämät IP-osoitteet ovat "
"ainutkertaisia."

msgctxt "DELEGATION:CHILD_NS_SAME_IP"
msgid "IP {address} in child refers to multiple nameservers ({servers})."
msgstr ""
"IP {address} alemmalla tasolla viittaa useisiin nimipalvelimiin "
"({servers})."

msgctxt "DELEGATION:DEL_DISTINCT_NS_IP"
msgid "All the IP addresses used by the nameservers in parent are unique."
msgstr ""
"Kaikki ylemmän tason nimipalvelinten käyttämät IP-osoitteet ovat "
"ainutkertaisia."

msgctxt "DELEGATION:DEL_NS_SAME_IP"
msgid "IP {address} in parent refers to multiple nameservers ({servers})."
msgstr ""
"IP {address} ylemmällä tasolla viittaa useisiin nimipalvelimiin "
"({servers})."

msgctxt "DELEGATION:DISTINCT_IP_ADDRESS"
msgid "All the IP addresses used by the nameservers are unique."
msgstr "Kaikki nimipalvelinten käyttämät IP-osoitteet ovat ainutkertaisia."

msgctxt "DELEGATION:ENOUGH_IPV4_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers ({servers}) that resolve to "
"IPv4 addresses ({addresses}). Lower limit set to {minimum}."
msgstr ""
"Alemmalla tasolla listataan tarpeeksi ({count}) nimipalvelimia "
"({servers}), joita vastaavat IPv4-osoitteet ({addresses}). Alarajaksi "
"on asetettu {minimum}."

msgctxt "DELEGATION:ENOUGH_IPV4_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers ({servers}) that resolve "
"to IPv4 addresses ({addresses}). Lower limit set to {minimum}."
msgstr ""
"Delegointi listaa tarpeeksi ({count}) nimipalvelimia ({servers}), joita "
"vastaavat IPv4-osoitteet ({addresses}). Alarajaksi on asetettu {minimum}."

msgctxt "DELEGATION:ENOUGH_IPV6_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers ({servers}) that resolve to "
"IPv6 addresses ({addresses}). Lower limit set to {minimum}."
msgstr ""
"Alemmalla tasolla listataan tarpeeksi ({count}) nimipalvelimia "
"({servers}), joita vastaavat IPv6-osoitteet ({addresses}). Alarajaksi "
"on asetettu {minimum}."

msgctxt "DELEGATION:ENOUGH_IPV6_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers ({servers}) that resolve "
"to IPv6 addresses ({addresses}). Lower limit set to {minimum}."
msgstr ""
"Delegointi listaa tarpeeksi ({count}) nimipalvelimia ({servers}), joita "
"vastaavat IPv6-osoitteet ({addresses}). Alarajaksi on asetettu {minimum}."

msgctxt "DELEGATION:ENOUGH_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers ({servers}). Lower limit set to "
"{minimum}."
msgstr ""
"Alemmalla tasolla listataan tarpeeksi ({count}) nimipalvelimia "
"({servers}). Alarajaksi on asetettu {minimum}."

msgctxt "DELEGATION:ENOUGH_NS_DEL"
msgid ""
"Parent lists enough ({count}) nameservers ({servers}). Lower limit set "
"to {minimum}."
msgstr ""
"Ylemmällä tasolla listataan tarpeeksi ({count}) nimipalvelimia "
"({servers}). Alarajaksi on asetettu {minimum}."

msgctxt "DELEGATION:EXTRA_NAME_CHILD"
msgid "Child has nameserver(s) not listed at parent ({extra})."
msgstr ""
"Alemmalla tasolla on yksi tai useampi nimipalvelin, joita ei ole listattu "
"ylemmällä tasolla ({extra})."

msgctxt "DELEGATION:EXTRA_NAME_PARENT"
msgid "Parent has nameserver(s) not listed at the child ({extra})."
msgstr ""
"Ylemmällä tasolla on yksi tai useampi nimipalvelin, joita ei ole listattu "
"alemmalla tasolla ({extra})."

msgctxt "DELEGATION:IS_NOT_AUTHORITATIVE"
msgid "Nameserver {ns}/{address} response is not authoritative on {proto} port 53."
msgstr ""
"Nimipalvelimen {ns}/{address} vastaus ei ole autoritäärinen koskien kohdetta {proto} "
"portissa 53."

msgctxt "DELEGATION:NAMES_MATCH"
msgid "All of the nameserver names are listed both at parent and child."
msgstr ""
"Kaikki nimipalvelimen nimet on listattu sekä alemmalla että ylemmällä "
"tasolla."

msgctxt "DELEGATION:NOT_ENOUGH_IPV4_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers ({servers}) that "
"resolve to IPv4 addresses ({addresses}). Lower limit set to {minimum}."
msgstr ""
"Alemmalla tasolla ei listata tarpeeksi ({count}) nimipalvelimia "
"({servers}), joita vastaavat IPv4-osoitteet ({addresses}). Alarajaksi "
"on asetettu {minimum}."

msgctxt "DELEGATION:NOT_ENOUGH_IPV4_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers ({servers}) that "
"resolve to IPv4 addresses ({addresses}). Lower limit set to {minimum}."
msgstr ""
"Delegointi ei listaa tarpeeksi ({count}) nimipalvelimia ({servers}), "
"joita vastaavat IPv4-osoitteet ({addresses}). Alarajaksi on asetettu "
"{minimum}."

msgctxt "DELEGATION:NOT_ENOUGH_IPV6_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers ({servers}) that "
"resolve to IPv6 addresses ({addresses}). Lower limit set to {minimum}."
msgstr ""
"Alemmalla tasolla ei listata tarpeeksi ({count}) nimipalvelimia "
"({servers}), joita vastaavat IPv6-osoitteet ({addresses}). Alarajaksi "
"on asetettu {minimum}."

msgctxt "DELEGATION:NOT_ENOUGH_IPV6_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers ({servers}) that "
"resolve to IPv6 addresses ({addresses}). Lower limit set to {minimum}."
msgstr ""
"Delegointi ei listaa tarpeeksi ({count}) nimipalvelimia ({servers}), "
"joita vastaavat IPv6-osoitteet ({addresses}). Alarajaksi on asetettu "
"{minimum}."

msgctxt "DELEGATION:NOT_ENOUGH_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers ({servers}). Lower "
"limit set to {minimum}."
msgstr ""
"Alemmalla tasolla ei listata tarpeeksi ({count}) nimipalvelimia "
"({servers}). Alarajaksi on asetettu {minimum}."

msgctxt "DELEGATION:NOT_ENOUGH_NS_DEL"
msgid ""
"Parent does not list enough ({count}) nameservers ({servers}). Lower "
"limit set to {minimum}."
msgstr ""
"Ylemmällä tasolla ei listata tarpeeksi ({count}) nimipalvelimia "
"({servers}). Alarajaksi on asetettu {minimum}."

msgctxt "DELEGATION:NO_IPV4_NS_CHILD"
msgid ""
"Child lists no nameserver that resolves to an IPv4 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Alemmalla tasolla ei listata yhtään nimipalvelinta, joka vastaisi IPv4-"
"osoitetta. Jos niitä olisi olemassa, alin sallittu määrä olisi {minimum}."

msgctxt "DELEGATION:NO_IPV4_NS_DEL"
msgid ""
"Delegation lists no nameserver that resolves to an IPv4 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Delegointi ei listaa yhtään nimipalvelinta, joka vastaisi IPv4-osoitetta. "
"Jos niitä olisi olemassa, alin sallittu määrä olisi {minimum}."

msgctxt "DELEGATION:NO_IPV6_NS_CHILD"
msgid ""
"Child lists no nameserver that resolves to an IPv6 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Alemmalla tasolla ei listata yhtään nimipalvelinta, joka vastaisi IPv6-"
"osoitetta. Jos niitä olisi olemassa, alin sallittu määrä olisi {minimum}."

msgctxt "DELEGATION:NO_IPV6_NS_DEL"
msgid ""
"Delegation lists no nameserver that resolves to an IPv6 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Delegointi ei listaa yhtään nimipalvelinta, joka vastaisi IPv6-osoitetta. "
"Jos niitä olisi olemassa, alin sallittu määrä olisi {minimum}."

msgctxt "DELEGATION:NS_IS_CNAME"
msgid "Nameserver {ns} RR points to CNAME."
msgstr "Nimipalvelimen {ns} RR osoittaa tietueeseen CNAME."

msgctxt "DELEGATION:NO_NS_CNAME"
msgid "No nameserver points to CNAME alias."
msgstr "Mikään nimipalvelin ei osoita CNAME-aliakseen."

msgctxt "DELEGATION:REFERRAL_SIZE_TOO_LARGE"
msgid ""
"The smallest possible legal referral packet is larger than 512 octets (it is "
"{size})."
msgstr ""
"Pienin mahdollinen sallittu ohjauspaketti on suurempi kuin 512 oktettia (eli "
"{size})."

msgctxt "DELEGATION:REFERRAL_SIZE_OK"
msgid ""
"The smallest possible legal referral packet is smaller than 513 octets (it "
"is {size})."
msgstr ""
"Pienin mahdollinen sallittu ohjauspaketti on pienempi kuin 513 oktettia (eli "
"{size})."

msgctxt "DELEGATION:SAME_IP_ADDRESS"
msgid "IP {address} refers to multiple nameservers ({servers})."
msgstr "IP {address} viittaa useisiin nimipalvelimiin ({servers})."

msgctxt "DELEGATION:SOA_EXISTS"
msgid "All the nameservers have SOA record."
msgstr "Kaikilla nimipalvelimilla on SOA-tietue."

msgctxt "DELEGATION:SOA_NOT_EXISTS"
msgid "Empty NOERROR response to SOA query was received from {ns}/{address}."
msgstr "Tyhjä NOERROR-vastaus SOA-kyselyyn vastaanotettiin kohteesta {ns}/{address}."

msgctxt "DELEGATION:TOTAL_NAME_MISMATCH"
msgid "None of the nameservers listed at the parent are listed at the child."
msgstr ""
"Mitään ylemmällä tasolla listatuista nimipalvelimista ei ole listattu "
"alemmalla tasolla."

msgctxt "DELEGATION:UNEXPECTED_RCODE"
msgid "Nameserver {ns} answered query with an unexpected rcode ({rcode})."
msgstr ""
"Nimipalvelin {ns} vastasi kyselyyn odottamattomalla rcode:lla ({rcode})."

msgctxt "NAMESERVER:AAAA_BAD_RDATA"
msgid ""
"Nameserver {ns}/{address} answered AAAA query with an unexpected RDATA length "
"({length} instead of 16)."
msgstr ""
"Nimipalvelin {ns}/{address} vastasi AAAA-kyselyyn odottamattomalla RDATA:n pituudella "
"({length}, ei 16)."

msgctxt "NAMESERVER:AAAA_QUERY_DROPPED"
msgid "Nameserver {ns}/{address} dropped AAAA query."
msgstr "Nimipalvelin {ns}/{address} pudotti AAAA-kyselyn."

msgctxt "NAMESERVER:AAAA_UNEXPECTED_RCODE"
msgid "Nameserver {ns}/{address} answered AAAA query with an unexpected rcode ({rcode})."
msgstr ""
"Nimipalvelin {ns}/{address} vastasi AAAA-kyselyyn odottamattomalla rcode:lla ({rcode})."

msgctxt "NAMESERVER:AAAA_WELL_PROCESSED"
msgid ""
"The following nameservers answer AAAA queries without problems : {servers}."
msgstr ""
"Seuraavat nimipalvelimet vastaavat AAAA-kyselyihin ongelmitta: {servers}."

msgctxt "NAMESERVER:A_UNEXPECTED_RCODE"
msgid "Nameserver {ns}/{address} answered A query with an unexpected rcode ({rcode})."
msgstr ""
"Nimipalvelin {ns}/{address} vastasi A-kyselyyn odottamattomalla rcode:lla ({rcode})."

msgctxt "NAMESERVER:AXFR_AVAILABLE"
msgid "The following nameservers allow zone transfer using AXFR: {servers}."
msgstr "The following nameservers allow zone transfer using AXFR: {servers}."

msgctxt "NAMESERVER:AXFR_FAILURE"
msgid "AXFR not available on the following nameservers: {servers}."
msgstr "AXFR not available on the following nameservers: {servers}."

msgctxt "NAMESERVER:BREAKS_ON_EDNS"
msgid "No response from {ns}/{address} when EDNS is used in query asking for {domain}."
msgstr ""
"Nimipalvelin {ns}/{address} ei vastaa, kun EDNS:ää käytetään kyselyssä, joka koskee "
"kohdetta {domain}."

msgctxt "NAMESERVER:CAN_BE_RESOLVED"
msgid "All nameservers succeeded to resolve to an IP address."
msgstr ""
"Kaikille nimipalvelimille löytyi niitä vastaava IP-osoite onnistuneesti."

msgctxt "NAMESERVER:CAN_NOT_BE_RESOLVED"
msgid ""
"The following nameservers failed to resolve to an IP address : {servers}."
msgstr "Seuraavat nimipalvelimet eivät vastanneet IP-osoitetta: {servers}."

msgctxt "NAMESERVER:CASE_QUERIES_RESULTS_DIFFER"
msgid ""
"When asked for {query_type} records on \"{domain}\" with different cases, all "
"servers do not reply consistently."
msgstr ""
"Pyydettäessä {query_type}-tietueita koskien kohdetta \"{domain}”, jossa käytetään "
"eri merkkikokoja, kaikki palvelimet eivät vastaa yhdenmukaisesti."

msgctxt "NAMESERVER:CASE_QUERIES_RESULTS_OK"
msgid ""
"When asked for {query_type} records on \"{domain}\" with different cases, all "
"servers reply consistently."
msgstr ""
"Pyydettäessä {query_type}-tietueita koskien kohdetta \"{domain}\", jossa käytetään "
"eri merkkikokoja, kaikki palvelimet vastaavat yhdenmukaisesti."

msgctxt "NAMESERVER:CASE_QUERY_DIFFERENT_ANSWER"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns different answers."
msgstr ""
"Pyydettäessä {query_type}-tietueita koskien kohteita \"{query1}\" ja \"{query2}\", "
"nimipalvelin {ns}/{address} antaa erilaiset vastaukset."

msgctxt "NAMESERVER:CASE_QUERY_DIFFERENT_RC"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns different RCODE (\"{rcode1}\" vs \"{rcode2}\")."
msgstr ""
"Pyydettäessä {query_type}-tietueita koskien kohteita \"{query1}\" ja \"{query2}\", "
"nimipalvelin {ns}/{address} palauttaa eri RCODE:t (\"{rcode1}\" vs. \"{rcode2}\")."

msgctxt "NAMESERVER:CASE_QUERY_NO_ANSWER"
msgid ""
"When asked for {query_type} records on \"{domain}\", nameserver {ns}/{address} returns "
"nothing."
msgstr ""
"Pyydettäessä {query_type}-tietueita koskien kohdetta \"{domain}\", nimipalvelin "
"{ns}/{address} ei palauta mitään."

msgctxt "NAMESERVER:CASE_QUERY_SAME_ANSWER"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns same answers."
msgstr ""
"Pyydettäessä {query_type}-tietueita koskien kohteita \"{query1}\" ja\"{query2}\", "
"nimipalvelin {ns}/{address} palauttaa samat vastaukset."

msgctxt "NAMESERVER:CASE_QUERY_SAME_RC"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns same RCODE \"{rcode}\"."
msgstr ""
"Pyydettäessä {query_type}-tietueita koskien kohteita \"{query1}\" ja \"{query2}\", "
"nimipalvelin {ns}/{address} palauttaa saman RCODE:n \"{rcode}\"."

msgctxt "NAMESERVER:DIFFERENT_SOURCE_IP"
msgid ""
"Nameserver {ns}/{address} replies on a SOA query with a different source address "
"({source})."
msgstr "Nimipalvelin {ns}/{address} vastaa SOA-kyselyyn eri lähdeosoitteella ({source})."

msgctxt "NAMESERVER:EDNS_RESPONSE_WITHOUT_EDNS"
msgid ""
"Response without EDNS from {ns}/{address} on query with EDNS0 asking for {domain}."
msgstr ""
"Vastaus ilman EDNS:ää kohteesta {ns}/{address} kyselyyn, jolla on EDNS0 ja joka pyytää "
"kohdetta {domain}."

msgctxt "NAMESERVER:EDNS_VERSION_ERROR"
msgid ""
"Incorrect version of EDNS (expected 0) in response from {ns}/{address} on query with "
"EDNS (version 0) asking for {domain}."
msgstr ""
"Väärä EDNS-versio (odotettu: 0) vastauksessa kohteelta {ns}/{address} kyselyyn, jonka "
"EDNS (versio 0) pyytää kohdetta {domain}."

msgctxt "NAMESERVER:EDNS0_SUPPORT"
msgid "The following nameservers support EDNS0 : {servers}."
msgstr "Seuraavat nimipalvelimet tukevat EDNS0:aa: {servers}."

msgctxt "NAMESERVER:IS_A_RECURSOR"
msgid "The following nameservers are recursors: {servers}."
msgstr "The following nameservers are recursors: {servers}."

msgctxt "NAMESERVER:MISSING_OPT_IN_TRUNCATED"
msgid ""
"Nameserver {ns}/{address} replies on an EDNS query with a truncated response without "
"EDNS."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa EDNS-kyselyyn typistetyllä vastauksella ilman EDNS:"
"ää."

msgctxt "NAMESERVER:NO_EDNS_SUPPORT"
msgid "Nameserver {ns}/{address} does not support EDNS0 (replies with FORMERR)."
msgstr "Nimipalvelin {ns}/{address} ei tue EDNS0:aa (antaa vastaukseksi FORMERR)."

msgctxt "NAMESERVER:NO_RECURSOR"
msgid "The following nameservers are not recursors: {servers}."
msgstr "The following nameservers are not recursors: {servers}."

msgctxt "NAMESERVER:NO_RESOLUTION"
msgid "No nameserver was successfully resolved to an IP address."
msgstr ""
"Millekään nimipalvelimelle ei löytynyt onnistuneesti vastaavaa IP-osoitetta."

msgctxt "NAMESERVER:NO_RESPONSE"
msgid "No response from {ns} asking for {domain}."
msgstr "Ei vastausta kohteelta {ns} kysyttäessä kohteesta {domain}."

msgctxt "SYNTAX:NO_RESPONSE"
msgid "No response from {ns} asking for {domain}."
msgstr "Ei vastausta kohteelta {ns} kysyttäessä kohteesta {domain}."

msgctxt "NAMESERVER:NO_UPWARD_REFERRAL"
msgid ""
"None of the following nameservers returns an upward referral : {servers}."
msgstr ""
"Mikään seuraavista nimipalvelimista ei palauta viittausta ylöspäin: "
"{servers}."

msgctxt "NAMESERVER:NS_ERROR"
msgid "Erroneous response from nameserver {ns}/{address}."
msgstr "Virheellinen vastaus nimipalvelimelta {ns}/{address}."

msgctxt "NAMESERVER:N10_EDNS_RESPONSE_ERROR"
msgid ""
"Expected RCODE but received erroneous response to an EDNS version 1 query. "
"Fetched from the nameservers with IP addresses {addresses}"
msgstr ""
"Odotettiin vastauksessa RCODEa mutta saatiin virheellinen vastaus EDNS "
"version 1 kyselyyn. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}\"."

msgctxt "NAMESERVER:N10_NO_RESPONSE_EDNS1_QUERY"
msgid ""
"No response to an EDNS version 1 query. Fetched from the nameservers with IP "
"addresses {addresses}"
msgstr ""
"Ei saatu vastausta EDNS versiolla 1 tehtyyn kyselyyn. Tiedot haettu "
"nimipalvelimilta joiden IP-osoitteet ovat \"{addresses}\"."

msgctxt "NAMESERVER:N10_UNEXPECTED_RCODE"
msgid ""
"Erroneous RCODE (\"{rcode}\") in response to an EDNS version 1 query. "
"Fetched from the nameservers with IP addresses {addresses}"
msgstr ""
"Saatiin virheellinen RCODE (\"{rcode}\") vastauksena EDNS versiolla 1 "
"tehtyyn kyselyyn. Tiedot haettu nimipalvelimilta joiden IP-osoitteet ovat "
"\"{addresses}"

msgctxt "NAMESERVER:N11_NO_EDNS"
msgid ""
"The DNS response, on query with unknown EDNS option-code, does not contain "
"any EDNS from name servers \"{addresses}\"."
msgstr ""
"Tuntemattomalla EDNS-optiokoodilla tehtyyn kyselyyn DNS-vastaus ei sisällä "
"nimipalvelimien \"{addresses}\" EDNS:ää."

msgctxt "NAMESERVER:N11_NO_RESPONSE"
msgid ""
"There is no response on query with unknown EDNS option-code from name "
"servers \"{addresses}\"."
msgstr ""
"Nimipalvelimien \"{addresses}\" kyselyyn, jossa on tuntematon EDNS-"
"optiokoodi, ei saatu vastausta."

msgctxt "NAMESERVER:N11_RETURNS_UNKNOWN_OPTION_CODE"
msgid ""
"The DNS response contains an unknown EDNS option-code. Returned from name "
"servers \"{addresses}\"."
msgstr ""
"DNS-vastaus sisältää tuntemattoman EDNS-optiokoodin. Palautettu "
"nimipalvelimista \"{addresses}\"."

msgctxt "NAMESERVER:N11_UNEXPECTED_ANSWER_SECTION"
msgid ""
"The DNS response, on query with unknown EDNS option-code, does not contain "
"the expected SOA record in the answer section from name servers "
"\"{addresses}\"."
msgstr ""
"Tuntemattomalla EDNS-optiokoodilla tehdyn kyselyn DNS-vastaus ei sisällä "
"nimipalvelimien \"{addresses}\" vastausosiossa odotettua SOA-tietuetta."

msgctxt "NAMESERVER:N11_UNEXPECTED_RCODE"
msgid ""
"The DNS response, on query with unknown EDNS option-code, has unexpected "
"RCODE name \"{rcode}\" from name servers \"{addresses}\"."
msgstr ""
"Tuntemattomalla EDNS-optiokoodilla tehdyssä kyselyssä DNS-vastauksessa on "
"odottamaton RCODE-nimi \"{rcode}\" nimipalvelimista \"{addresses}\"."

msgctxt "NAMESERVER:N11_UNSET_AA"
msgid ""
"The DNS response, on query with unknown EDNS option-code, is unexpectedly "
"not authoritative from name servers \"{addresses}\"."
msgstr ""
"Tuntemattomalla EDNS-optiokoodilla tehty DNS-vastaus odottamattomasti ei ole "
"nimipalvelimista autoritatiiviselta \"{addresses}\"."

msgctxt "NAMESERVER:N15_SOFTWARE_VERSION"
msgid ""
"The following name server(s) respond to software version query "
"\"{query_name}\" with string \"{string}\". Returned from name servers: "
"\"{addresses}\""
msgstr ""
"Seuraavat nimipalvelimet vastaavat ohjelmistoversiokyselyyn \"{query_name}\" "
"merkkijonolla \"{string}\". Palautettu nimipalvelimista: \"{addresses}\""

msgctxt "NAMESERVER:N16_HAS_NSID"
msgid ""
"The following name server(s) responded to an NSID query (RFC 5001) with "
"NSID value \"{nsid}\". Returned from name servers \"{servers}\""
msgstr ""
"Seuraavat nimipalvelimet vastasivat NSID-kyselyyn (RFC 5001) NSID-arvolla "
"\"{nsid}\". Palautettu nimipalvelimista: \"{servers}\""

msgctxt "NAMESERVER:N16_NO_NSID_REVEALED"
msgid ""
"The following name server(s) did not include an NSID option in response to "
"an NSID query (RFC 5001). Returned from name servers \"{servers}\""
msgstr ""
"Seuraavat nimipalvelimet eivät sisällyttäneet NSID-vaihtoehtoa vastaukseen "
"NSID-kyselyyn (RFC 5001). Palautettu nimipalvelimista: \"{servers}\""

msgctxt "NAMESERVER:N16_NO_RESPONSE"
msgid ""
"The following name server(s) did not respond to an NSID query (RFC 5001). "
"Returned from name servers \"{servers}\""
msgstr ""
"Seuraavat nimipalvelimet eivät vastanneet NSID-kyselyyn (RFC 5001). "
"Palautettu nimipalvelimista: \"{servers}\""

msgctxt "NAMESERVER:N16_UNEXPECTED_RCODE"
msgid ""
"The following name server(s) returned an unexpected RCODE \"{rcode}\" in "
"response to an NSID query (RFC 5001). Returned from name servers: "
"\"{servers}\""
msgstr ""
"Seuraavat nimipalvelimet palauttivat odottamattoman RCODE-arvon \"{rcode}\" "
"vastauksena NSID-kyselyyn (RFC 5001). Palautettu nimipalvelimista: "
"\"{servers}\""

msgctxt "NAMESERVER:QNAME_CASE_INSENSITIVE"
msgid "The following nameservers do not preserve original case of the queried name ({domain}): {servers}."
msgstr "The following nameservers do not preserve original case of the queried name ({domain}): {servers}."

msgctxt "NAMESERVER:QNAME_CASE_SENSITIVE"
msgid "The following nameservers preserve original case of queried names ({domain}): {servers}."
msgstr "The following nameservers preserve original case of queried names ({domain}): {servers}."

msgctxt "NAMESERVER:SAME_SOURCE_IP"
msgid "All nameservers reply with same IP used to query them."
msgstr ""
"Kaikki nimipalvelimet vastaavat samalla IP-osoitteella, jota käytetiin "
"niiden kyselyyn."

msgctxt "NAMESERVER:UPWARD_REFERRAL"
msgid "The following nameservers return an upward referral: {servers}."
msgstr "The following nameservers return an upward referral: {servers}."

msgctxt "NAMESERVER:UPWARD_REFERRAL_IRRELEVANT"
msgid "Upward referral tests skipped for root zone."
msgstr "Juuritason ylöspäin viittauksen testit ohitettu."

msgctxt "NAMESERVER:Z_FLAGS_NOTCLEAR"
msgid "Nameserver {ns}/{address} has one or more unknown EDNS Z flag bits set."
msgstr ""
"Nimipalvelimella {ns}/{address} on asetettu yksi tai useampi tuntematon EDNS Z -"
"lippubitti."

msgctxt "SYNTAX:DISCOURAGED_DOUBLE_DASH"
msgid ""
"Domain name ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Verkkotunnuksella ({domain}) on osa ({label}), jossa on kaksoisyhdysmerkki "
"('--') kohdissa 3 ja 4 (sekä etuliite, joka ei ole 'xn--')."

msgctxt "SYNTAX:INITIAL_HYPHEN"
msgid ""
"Domain name ({domain}) has a label ({label}) starting with an hyphen ('-')."
msgstr ""
"Verkkotunnuksella ({domain}) on osa ({label}), joka alkaa yhdysmerkillä "
"('-')."

msgctxt "SYNTAX:MNAME_DISCOURAGED_DOUBLE_DASH"
msgid ""
"SOA MNAME ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"SOA MNAME:lla ({domain}) on osa ({label}), jossa on kaksoisyhdysmerkki "
"('--') kohdissa 3 ja 4 (sekä etuliite, joka ei ole 'xn--')."

msgctxt "SYNTAX:MNAME_NON_ALLOWED_CHARS"
msgid "Found illegal characters in SOA MNAME ({domain})."
msgstr "Kiellettyjä merkkejä löydetty SOA MNAME:sta ({domain})."

msgctxt "SYNTAX:MNAME_NUMERIC_TLD"
msgid "SOA MNAME ({domain}) within a 'numeric only' TLD ({tld})."
msgstr ""
"SOA MNAME ({domain}) kuuluu ’pelkästään numeerisessa muodossa olevaan’ TLD:"
"hen ({tld})."

msgctxt "SYNTAX:MNAME_SYNTAX_OK"
msgid "SOA MNAME ({domain}) syntax is valid."
msgstr "SOA MNAME:n ({domain}) syntaksi on oikein."

msgctxt "SYNTAX:MX_DISCOURAGED_DOUBLE_DASH"
msgid ""
"Domain name MX ({domain}) has a label ({label}) with a double hyphen ('--') "
"in position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Verkkotunnuksella MX ({domain}) on osa ({label}), jossa on "
"kaksoisyhdysmerkki ('--') kohdissa 3 ja 4 (sekä etuliite, joka ei ole "
"'xn--')."

msgctxt "SYNTAX:MX_NON_ALLOWED_CHARS"
msgid "Found illegal characters in MX ({domain})."
msgstr "Kiellettyjä merkkejä löydetty kohteesta MX ({domain})."

msgctxt "SYNTAX:MX_NUMERIC_TLD"
msgid "Domain name MX ({domain}) within a 'numeric only' TLD ({tld})."
msgstr ""
"Verkkotunnus MX ({domain}) kuuluu ’pelkästään numeerisessa muodossa olevaan’ "
"TLD:hen ({tld})."

msgctxt "SYNTAX:MX_SYNTAX_OK"
msgid "Domain name MX ({domain}) syntax is valid."
msgstr "Verkkotunnuksen MX ({domain}) syntaksi on oikein."

msgctxt "SYNTAX:NAMESERVER_DISCOURAGED_DOUBLE_DASH"
msgid ""
"Nameserver ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Nimipalvelimella ({domain}) on osa ({label}), jossa on kaksoisyhdysmerkki "
"('--') kohdissa 3 ja 4 (sekä etuliite, joka ei ole 'xn--')."

msgctxt "SYNTAX:NAMESERVER_NON_ALLOWED_CHARS"
msgid "Found illegal characters in the nameserver ({domain})."
msgstr "Kiellettyjä merkkejä löydetty nimipalvelimelta ({domain})."

msgctxt "SYNTAX:NAMESERVER_NUMERIC_TLD"
msgid "Nameserver ({domain}) within a 'numeric only' TLD ({tld})."
msgstr ""
"Nimipalvelin ({domain}) kuuluu ’pelkästään numeerisessa muodossa olevaan’ "
"TLD:hen ({tld})."

msgctxt "SYNTAX:NAMESERVER_SYNTAX_OK"
msgid "The following nameservers have valid syntax: {servers}."
msgstr "The following nameservers have valid syntax: {servers}."

msgctxt "SYNTAX:NON_ALLOWED_CHARS"
msgid "Found illegal characters in the domain name ({domain})."
msgstr "Kiellettyjä merkkejä löydetty verkkotunnuksesta ({domain})."

msgctxt "SYNTAX:NO_DOUBLE_DASH"
msgid ""
"Domain name ({domain}) has no label with a double hyphen ('--') in position "
"3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Verkkotunnuksella ({domain}) ei ole osaa, jossa on kaksoisyhdysmerkki ('--') "
"kohdissa 3 ja 4 (sekä etuliite, joka ei ole 'xn--')."

msgctxt "SYNTAX:NO_ENDING_HYPHENS"
msgid "Neither end of any label in the domain name ({domain}) has a hyphen."
msgstr ""
"Minkään verkkotunnuksen ({domain}) osan kummassakaan päässä ei ole "
"yhdysmerkkiä."

msgctxt "SYNTAX:NO_RESPONSE_MX_QUERY"
msgid "No response from nameserver(s) on MX queries."
msgstr "Yksi tai useampi nimipalvelin ei vastaa MX-kyselyihin."

msgctxt "ZONE:NO_RESPONSE_MX_QUERY"
msgid "No response from nameserver(s) on MX queries."
msgstr "Yksi tai useampi nimipalvelin ei vastaa MX-kyselyihin."

msgctxt "SYNTAX:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver(s) on SOA queries."
msgstr "Yksi tai useampi nimipalvelin ei vastaa SOA-kyselyihin."

msgctxt "ZONE:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver(s) on SOA queries."
msgstr "Yksi tai useampi nimipalvelin ei vastaa SOA-kyselyihin."

msgctxt "SYNTAX:ONLY_ALLOWED_CHARS"
msgid "No illegal characters in the domain name ({domain})."
msgstr "Ei kiellettyjä merkkejä verkkotunnuksessa ({domain})."

msgctxt "SYNTAX:RNAME_MAIL_DOMAIN_INVALID"
msgid ""
"The SOA RNAME mail domain ({domain}) cannot be resolved to a mail server "
"with an IP address."
msgstr ""
"SOA RNAME postin verkkotunnukselle ({domain}) ei löydy vastaavaa "
"postipalvelinta, jolla on IP-osoite."

msgctxt "SYNTAX:RNAME_MAIL_DOMAIN_LOCALHOST"
msgid ""
"The SOA RNAME mail domain ({domain}) resolved to a mail server with "
"localhost ({localhost}) IP address."
msgstr ""
"SOA RNAME sähköpostidomaini ({domain}) viittaa postipalvelimeen, jolla on "
"localhost ({localhost}) IP-osoite."

msgctxt "SYNTAX:RNAME_MAIL_ILLEGAL_CNAME"
msgid ""
"The SOA RNAME mail domain ({domain}) refers to an address which is an alias "
"(CNAME)."
msgstr ""
"SOA RNAME sähköpostiosoite ({domain}) viittaa osoitteeseen joka on alias "
"(CNAME)."

msgctxt "SYNTAX:RNAME_MISUSED_AT_SIGN"
msgid "Misused '@' character found in SOA RNAME field ({rname})."
msgstr "Väärin käytetty ’@’-merkki löydetty SOA RNAME -kentästä ({rname})."

msgctxt "SYNTAX:RNAME_NO_AT_SIGN"
msgid "There is no misused '@' character in the SOA RNAME field ({rname})."
msgstr "Ei väärin käytettyjä ’@’-merkkejä SOA RNAME -kentässä ({rname})."

msgctxt "SYNTAX:RNAME_RFC822_INVALID"
msgid "Illegal character(s) found in SOA RNAME field ({rname})."
msgstr ""
"Yksi tai useampi kielletty merkki löydetty SOA RNAME -kentästä ({rname})."

msgctxt "SYNTAX:RNAME_RFC822_VALID"
msgid "The SOA RNAME field ({rname}) is compliant with RFC2822."
msgstr "SOA RNAME -kenttä ({rname}) on RFC2822:n mukainen."

msgctxt "SYNTAX:TERMINAL_HYPHEN"
msgid ""
"Domain name ({domain}) has a label ({label}) ending with a hyphen ('-')."
msgstr ""
"Verkkotunnuksella ({domain}) on osa ({label}), joka päättyy yhdysmerkkiin "
"('-')."

msgctxt "ZONE:RETRY_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'retry' value ({retry}) is less than the recommended one "
"({required_retry})."
msgstr ""
"SOA 'retry' -arvo ({retry}) on pienempi kuin suositus ({required_retry})."

msgctxt "ZONE:RETRY_MINIMUM_VALUE_OK"
msgid ""
"SOA 'retry' value ({retry}) is at least equal to the minimum recommended "
"value ({required_retry})."
msgstr ""
"SOA 'retry' -arvo ({retry}) on vähintään yhtä suuri kuin suositeltu "
"vähimmäisarvo ({required_retry})."

msgctxt "ZONE:MNAME_IS_CNAME"
msgid "SOA 'mname' value ({mname}) refers to a NS which is an alias (CNAME)."
msgstr "SOA 'mname' -arvo ({mname}) viittaa NS:ään, joka on alias (CNAME)."

msgctxt "ZONE:MNAME_IS_NOT_CNAME"
msgid ""
"SOA 'mname' value ({mname}) refers to a NS which is not an alias (CNAME)."
msgstr "SOA 'mname' -arvo ({mname}) viittaa NS:ään, joka ei ole alias (CNAME)."

msgctxt "ZONE:REFRESH_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'refresh' value ({refresh}) is less than the recommended one "
"({required_refresh})."
msgstr ""
"SOA 'refresh' -arvo ({refresh}) on pienempi kuin suositus "
"({required_refresh})."

msgctxt "ZONE:REFRESH_MINIMUM_VALUE_OK"
msgid ""
"SOA 'refresh' value ({refresh}) is at least equal to the minimum recommended "
"value ({required_refresh})."
msgstr ""
"SOA-refresh-arvo ({refresh}) on vähintään yhtä suuri kuin suositeltu "
"vähimmäisarvo ({required_refresh})."

msgctxt "ZONE:EXPIRE_LOWER_THAN_REFRESH"
msgid ""
"SOA 'expire' value ({expire}) is lower than the SOA 'refresh' value "
"({refresh})."
msgstr ""
"SOA 'expire' -arvo ({expire}) on pienempi kuin SOA 'refresh' -arvo "
"({refresh})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_HIGHER"
msgid ""
"SOA 'minimum' value ({minimum}) is higher than the recommended one "
"({highest_minimum})."
msgstr ""
"SOA 'minimum' -arvo ({minimum}) on suurempi kuin suositus "
"({highest_minimum})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_LOWER"
msgid ""
"SOA 'minimum' value ({minimum}) is less than the recommended one "
"({lowest_minimum})."
msgstr ""
"SOA 'minimum' -arvo ({minimum}) on pienempi kuin suositus ({lowest_minimum})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_OK"
msgid ""
"SOA 'minimum' value ({minimum}) is between the recommended ones "
"({lowest_minimum}/{highest_minimum})."
msgstr ""
"SOA 'minimum' -arvo ({minimum}) on suositusten välillä ({lowest_minimum}/"
"{highest_minimum})."

msgctxt "ZONE:EXPIRE_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'expire' value ({expire}) is less than the recommended one "
"({required_expire})."
msgstr ""
"SOA 'expire' -arvo ({expire}) on pienempi kuin suositus ({required_expire})."

msgctxt "ZONE:REFRESH_LOWER_THAN_RETRY"
msgid ""
"SOA 'refresh' value ({refresh}) is lower than the SOA 'retry' value "
"({retry})."
msgstr ""
"SOA 'refresh' -arvo ({refresh}) on pienempi kuin SOA 'retry' -arvo ({retry})."

msgctxt "ZONE:REFRESH_HIGHER_THAN_RETRY"
msgid ""
"SOA 'refresh' value ({refresh}) is higher than the SOA 'retry' value "
"({retry})."
msgstr ""
"SOA 'refresh' -arvo ({refresh}) on suurempi kuin SOA 'retry' -arvo ({retry})."

msgctxt "ZONE:MX_RECORD_IS_CNAME"
msgid "MX record for the domain is pointing to a CNAME."
msgstr "Verkkotunnuksen MX-tietue osoittaa CNAME-tietueeseen."

msgctxt "ZONE:MX_RECORD_IS_NOT_CNAME"
msgid "MX record for the domain is not pointing to a CNAME."
msgstr "Verkkotunnuksen MX-tietue ei osoita CNAME-tietueeseen."

msgctxt "ZONE:MULTIPLE_SOA"
msgid ""
"Nameserver {ns}/{address} responds with multiple ({count}) SOA records on SOA queries."
msgstr ""
"Nimipalvelimen {ns}/{address} vastaa SOA-kyselyihin useammalla kuin yhdellä ({count}) "
"SOA-tietueella."

msgctxt "ZONE:NO_SOA_IN_RESPONSE"
msgid ""
"Response from nameserver {ns}/{address} on SOA queries does not contain SOA record."
msgstr "Nimipalvelimen {ns}/{address} vastaus SOA-kyselyihin ei sisällä SOA-tietuetta."

msgctxt "ZONE:MNAME_HAS_NO_ADDRESS"
msgid "No IP address found for SOA 'mname' nameserver ({mname})."
msgstr "IP-osoitetta ei löytynyt SOA 'mname' -nimipalvelimelle ({mname})."

msgctxt "ZONE:ONE_SOA"
msgid "A unique SOA record is returned by all nameservers of the zone."
msgstr ""
"Vyöhykkeen kaikki nimipalvelimet palauttavat ainutkertaisen SOA-tietueen."

msgctxt "ZONE:EXPIRE_MINIMUM_VALUE_OK"
msgid ""
"SOA 'expire' value ({expire}) is higher than the minimum recommended value "
"({required_expire}) and not lower than the 'refresh' value ({refresh})."
msgstr ""
"SOA 'expire' -arvo ({expire}) on suurempi kuin pienin suositeltu arvo "
"({required_expire}), muttei pienempi kuin 'refresh' -arvo ({refresh})."

msgctxt "ZONE:WRONG_SOA"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({owner} instead of {query_name}) "
"on SOA queries."
msgstr ""
"Nimipalvelin {ns}/{address} vastaa SOA-kyselyihin väärällä omistajan nimellä ({owner}, "
"ei {query_name})."

msgctxt "ZONE:Z01_MNAME_HAS_LOCALHOST_ADDR"
msgid ""
"SOA MNAME name server \"{ns}\" resolves to a localhost IP address "
"({address})."
msgstr ""
"SOA MNAME -nimipalvelimella \"{ns}\" on localhost:n IP-osoitte ({address})."

msgctxt "ZONE:Z01_MNAME_IS_DOT"
msgid ""
"SOA MNAME is specified as \".\" which usually means \"no server\". Fetched "
"from name servers \"{addresses}\"."
msgstr ""
"SOA MNAME on määritetty muodossa \".\" mikä yleensä tarkoittaa \"ei "
"palvelinta\". Haettu nimipalvelimista \"{addresses}\"."

msgctxt "ZONE:Z01_MNAME_IS_LOCALHOST"
msgid ""
"SOA MNAME name server is \"localhost\", which is invalid. Fetched from name "
"servers \"{addresses}\"."
msgstr ""
"SOA MNAME -nimipalvelin on \"localhost\", joka on virheellinen. Haettu "
"nimipalvelimista \"{addresses}\"."

msgctxt "ZONE:Z01_MNAME_IS_MASTER"
msgid "SOA MNAME name server(s) \"{servers}\" appears to be master."
msgstr ""
"SOA MNAME nimipalvelin/nimipalvelimet \"{servers}\" näyttävät olevan master."

msgctxt "ZONE:Z01_MNAME_MISSING_SOA_RECORD"
msgid ""
"SOA MNAME name server \"{ns}/{address}\" responds to an SOA query with no SOA records "
"in the answer section."
msgstr ""
"SOA MNAME -nimipalvelin \"{ns}/{address}\" vastaa SOA-kyselyyn ilman SOA-tietueita "
"vastausosiossa."

msgctxt "ZONE:Z01_MNAME_NO_RESPONSE"
msgid "SOA MNAME name server \"{ns}/{address}\" does not respond to an SOA query."
msgstr "SOA MNAME -nimipalvelin \"{ns}/{address}\" ei vastaa SOA kyselyyn."

msgctxt "ZONE:Z01_MNAME_NOT_AUTHORITATIVE"
msgid "SOA MNAME name server \"{ns}/{address}\" is not authoritative for the zone."
msgstr "SOA MNAME -nimipalvelin \"{ns}/{address}\" ei ole autoritatiivinen vyöhykkeelle."

msgctxt "ZONE:Z01_MNAME_NOT_IN_NS_LIST"
msgid ""
"SOA MNAME name server \"{ns}\" is not listed as NS record for the zone."
msgstr ""
"SOA MNAME -nimipalvelinta \"{ns}\" ei ole listattu vyöhykkeen NS-"
"tietueeksi."

msgctxt "ZONE:Z01_MNAME_NOT_MASTER"
msgid ""
"SOA MNAME name server(s) \"{servers}\" do not have the highest SOA SERIAL "
"(expected \"{soaserial}\" but got \"{soaserial_list}\")"
msgstr ""
"SOA MNAME -nimipalvelimilla \"{servers}\" ei ole korkeinta SOA sarjanumeroa "
"(odotettu \"{soaserial}\", mutta saatiin \"{soaserial_list}\")"

msgctxt "ZONE:Z01_MNAME_NOT_RESOLVE"
msgid ""
"SOA MNAME name server \"{ns}\" cannot be resolved into an IP address."
msgstr ""
"SOA MNAME -nimipalvelinta \"{ns}\" ei voida selvittää IP-osoitteeksi."

msgctxt "ZONE:Z01_MNAME_UNEXPECTED_RCODE"
msgid ""
"SOA MNAME name server \"{ns}/{address}\" gives unexpected RCODE name (\"{rcode}\") in "
"response to an SOA query."
msgstr ""
"SOA MNAME -nimipalvelin \"{ns}/{address}\" antaa odottamattoman RCODE-nimen "
"(\"{rcode}\") vastauksena SOA-kyselyyn."

msgctxt "ZONE:Z09_INCONSISTENT_MX"
msgid "Some name servers return an MX RRset while others return none."
msgstr ""
"Jotkut nimipalvelimet palauttavat MX RRsetin, kun taas toiset eivät palauta "
"yhtään."

msgctxt "ZONE:Z09_INCONSISTENT_MX_DATA"
msgid "The MX RRset data is inconsistent between the name servers."
msgstr "MX RRset -tiedot ovat ristiriidassa nimipalvelimien välillä."

msgctxt "ZONE:Z09_MISSING_MAIL_TARGET"
msgid "The child zone has no mail target (no MX)."
msgstr "Lapsivyöhykkeellä ei ole sähköpostin kohdetta (ei MX:ää)."

msgctxt "ZONE:Z09_MX_DATA"
msgid ""
"Mail targets in the MX RRset \"{mail_targets}\" returned from name "
"servers \"{addresses}\"."
msgstr ""
"Postikohteet MX RRsetissä \"{mail_targets}\" palautettiin "
"nimipalvelimista \"{addresses}\"."

msgctxt "ZONE:Z09_MX_FOUND"
msgid "MX RRset was returned by name servers \"{addresses}\"."
msgstr "Nimipalvelimet \"{addresses}\" palauttivat MX RRsetin."

msgctxt "ZONE:Z09_NON_AUTH_MX_RESPONSE"
msgid ""
"Non-authoritative response on MX query from name servers \"{addresses}\"."
msgstr ""
"Ei autoritatiivinen vastaus MX-kyselyyn nimipalvelimista \"{addresses}\"."

msgctxt "ZONE:Z09_NO_MX_FOUND"
msgid "No MX RRset was returned by name servers \"{addresses}\"."
msgstr "Nimipalvelimet \"{addresses}\" eivät palauttaneet MX RRsetiä."

msgctxt "ZONE:Z09_NO_RESPONSE_MX_QUERY"
msgid "No response on MX query from name servers \"{addresses}\"."
msgstr "Ei vastausta MX-kyselyyn nimipalvelimista \"{addresses}\"."

msgctxt "ZONE:Z09_NULL_MX_NON_ZERO_PREF"
msgid "The zone has a Null MX with non-zero preference."
msgstr "Vyöhykkeellä on Null MX, jossa on nollasta poikkeava prioriteetti."

msgctxt "ZONE:Z09_NULL_MX_WITH_OTHER_MX"
msgid "The zone has a Null MX mixed with other MX records."
msgstr "Zonella on Null MX sekoitettuna muiden MX-tietueiden kanssa."

msgctxt "ZONE:Z09_ROOT_EMAIL_DOMAIN"
msgid "Root zone with an unexpected MX RRset (non-Null MX)."
msgstr "Juurivyöhyke odottamattomalla MX RRsetillä (ei-Null MX)."

msgctxt "ZONE:Z09_TLD_EMAIL_DOMAIN"
msgid "The zone is a TLD and has an unexpected MX RRset (non-Null MX)."
msgstr "Zone on TLD ja sillä on odottamaton MX RRset (ei-Null MX)."

msgctxt "ZONE:Z09_UNEXPECTED_RCODE_MX"
msgid ""
"Unexpected RCODE value ({rcode}) on the MX query from name servers "
"\"{addresses}\"."
msgstr ""
"Odottamaton RCODE-arvo ({rcode}) MX-kyselyssä nimipalvelimista "
"\"{addresses}\"."

msgctxt "ZONE:Z12_CSYNC_FOUND"
msgid ""
"CSYNC record found at zone apex on name server {ns}/{address} with SOA serial "
"{serial}, flags {flags}, and type bitmap {type_bitmap}."
msgstr ""
"CSYNC-tietue löytyi vyöhykkeen kärjestä nimipalvelimelta {ns}/{address} SOA-sarjanumerolla "
"{serial}, lipuilla {flags} ja tyyppibittikartalla {type_bitmap}."

msgctxt "ZONE:Z12_INCONSISTENT_CSYNC"
msgid "CSYNC record content differs across authoritative name servers."
msgstr "CSYNC-tietueen sisältö eroaa auktoritatiivisten nimipalvelimien välillä."

msgctxt "ZONE:Z12_MIXED_PRESENCE"
msgid "CSYNC record is present on some name servers but absent on others."
msgstr "CSYNC-tietue on olemassa joillakin nimipalvelimilla, mutta puuttuu toisilta."

msgctxt "ZONE:Z12_MULTIPLE_CSYNC"
msgid "{count} CSYNC records found at zone apex on name server {ns}/{address}."
msgstr "Nimipalvelimelta {ns}/{address} löytyi {count} CSYNC-tietuetta vyöhykkeen kärjestä."

msgctxt "ZONE:Z12_NO_CSYNC"
msgid "No CSYNC record found at zone apex on name servers: {servers}."
msgstr "CSYNC-tietuetta ei löytynyt vyöhykkeen kärjestä nimipalvelimilta: {servers}."

msgctxt "ZONE:Z12_SERIAL_MISMATCH"
msgid ""
"CSYNC SOA serial {csync_serial} fails RFC 7477 serial precondition against current "
"SOA serial "
"{soa_serial} on name server {ns}."
msgstr ""
"CSYNC:n SOA-sarjanumero {csync_serial} ei vastaa nimipalvelimen {ns} nykyistä "
"SOA-sarjanumeroa {soa_serial}."

msgctxt "ZONE:Z13_NO_SPF_FOUND"
msgid "No SPF record found for {domain}; skipping DNS lookup count check."
msgstr ""
"SPF-tietuetta ei löytynyt verkkotunnukselle {domain}; DNS-hakujen määrän "
"tarkistus ohitetaan."

msgctxt "ZONE:Z13_SPF_LOOKUP_COUNT_EXCEEDED"
msgid ""
"The SPF policy for {domain} requires {count} DNS lookups, exceeding the "
"configured limit of {limit} (RFC 7208 Section 4.6.4)."
msgstr ""
"Verkkotunnuksen {domain} SPF-käytäntö vaatii {count} DNS-hakua, mikä ylittää "
"määritetyn rajan {limit} (RFC 7208 kohta 4.6.4)."

msgctxt "ZONE:Z13_SPF_LOOKUP_COUNT_OK"
msgid ""
"The SPF policy for {domain} requires {count} DNS lookups, within the "
"allowed limit."
msgstr ""
"Verkkotunnuksen {domain} SPF-käytäntö vaatii {count} DNS-hakua, sallitun rajan "
"sisällä."

msgctxt "ZONE:Z13_SPF_LOOKUP_LOOP"
msgid ""
"The SPF policy for {domain} contains a recursive loop: {loop_domain} was "
"visited more than once during include/redirect resolution."
msgstr ""
"Verkkotunnuksen {domain} SPF-käytäntö sisältää rekursiivisen silmukan: "
"{loop_domain} vierailtiin useammin kuin kerran include/redirect-selvityksen aikana."

msgctxt "ZONE:Z13_SPF_PTR_DEPRECATED"
msgid ""
"The SPF policy for {domain} uses the deprecated ptr mechanism "
"(RFC 7208 Section 5.5)."
msgstr ""
"Verkkotunnuksen {domain} SPF-käytäntö käyttää vanhentunutta ptr-mekanismia "
"(RFC 7208 kohta 5.5)."

msgctxt "ZONE:Z13_SPF_RECURSIVE_ERROR"
msgid ""
"The SPF policy for {domain} references {target} via include or redirect, "
"but that target could not be resolved."
msgstr ""
"Verkkotunnuksen {domain} SPF-käytäntö viittaa kohteeseen {target} include- tai "
"redirect-mekanismilla, mutta kohdetta ei voitu selvittää."

msgctxt "ZONE:Z13_UNABLE_TO_CHECK"
msgid ""
"None of the zone's name servers responded with an authoritative response to "
"queries for SPF policies; unable to check DNS lookup count."
msgstr ""
"Yksikään vyöhykkeen nimipalvelimista ei vastannut autoritatiivisesti "
"SPF-käytäntökyselyihin; DNS-hakujen määrää ei voida tarkistaa."

msgctxt "SYSTEM:CANNOT_CONTINUE"
msgid "Not enough data about {domain} was found to be able to run tests."
msgstr "Kohteesta {domain} ei löydetty tarpeeksi tietoa testien ajamiseksi."

msgctxt "SYSTEM:DEPENDENCY_VERSION"
msgid "Using prerequisite module {name} version {version}."
msgstr "Käytetään edellytetyn moduulin {name} versiota {version}."

msgctxt "SYSTEM:GLOBAL_VERSION"
msgid "Using version {version} of the Gonemaster engine."
msgstr "Käytössä on Gonemaster-moottorin versio {version}."

msgctxt "SYSTEM:LOGGER_CALLBACK_ERROR"
msgid "Logger callback died with error: {exception}"
msgstr "Tallentimen takaisinkutsu loppui virheeseen: {exception}"

msgctxt "SYSTEM:MODULE_ERROR"
msgid "Fatal error in {module}: {msg}"
msgstr "Vakava virhe kohteessa {module}: {msg}"

msgctxt "SYSTEM:MODULE_VERSION"
msgid "Using module {module} version {version}."
msgstr "Käytetään moduulin {module} versiota {version}."

msgctxt "SYSTEM:MODULE_END"
msgid "Module {module} finished running."
msgstr "Moduulin {module} ajo päättyi."

msgctxt "SYSTEM:NO_NETWORK"
msgid "Both IPv4 and IPv6 are disabled."
msgstr "Sekä IPv4 että IPv6 ovat pois käytöstä."

msgctxt "SYSTEM:UNKNOWN_METHOD"
msgid "Request to run unknown method {testcase} in module {module}."
msgstr "Pyyntö ajaa tuntematon metodi {testcase} moduulissa {module}."

msgctxt "SYSTEM:UNKNOWN_MODULE"
msgid ""
"Request to run {testcase} in unknown module {module}. Known modules: "
"{module_list}."
msgstr ""
"Pyyntö ajaa {testcase} tuntemattomassa moduulissa {module}. Tunnetut "
"moduulit: {module_list}."

msgctxt "SYSTEM:FAKE_DELEGATION"
msgid "Followed a fake delegation."
msgstr "Seurattu väärää delegointia."

msgctxt "SYSTEM:ADDED_FAKE_DELEGATION"
msgid "Added a fake delegation for domain {domain} to name server {ns}."
msgstr ""
"Lisätty väärä delegointi verkkotunnukselle {domain} nimipalvelimelle {ns}."

msgctxt "SYSTEM:FAKE_DELEGATION_TO_SELF"
msgid ""
"Name server {ns} not adding fake delegation for domain {domain} to itself."
msgstr ""
"Nimipalvelin {ns} ei lisää verkkotunnuksen {domain} väärää delegointia "
"itselleen."

msgctxt "SYSTEM:FAKE_DELEGATION_IN_ZONE_NO_IP"
msgid ""
"The fake delegation of domain {domain} includes an in-zone name server "
"{ns} without mandatory glue (without IP address)."
msgstr ""
"Verkkotunnuksen {domain} väärään delegointiin kuuluu vyöhykkeen sisäinen "
"nimipalvelin {ns} ilman pakollista liimaa (ilman IP-osoitetta)."

msgctxt "SYSTEM:FAKE_DELEGATION_NO_IP"
msgid ""
"The fake delegation of domain {domain} includes a name server {ns} that "
"cannot be resolved to any IP address."
msgstr ""
"Verkkotunnuksen {domain} väärään delegointiin kuuluu nimipalvelin {ns}, "
"joka ei vastaa mitään IP-osoitetta."

msgctxt "SYSTEM:PACKET_BIG"
msgid "Big packet size ({size}) (try with \"{command}\")."
msgstr "Suurikokoinen paketti ({size}) (yritä käyttää komentoa \"{command}\")."

msgctxt "ADDRESS:A01_GLOBALLY_REACHABLE_ADDR"
msgid "All tested nameservers in {servers} are globally reachable."
msgstr "Kaikki testatut nimipalvelimet {servers} ovat globaalisti tavoitettavissa."

msgctxt "DNSSEC:DS01_DS_ALGO_OK"
msgid "DS record with key tag {keytag} and digest algorithm {ds_algo_num} ({ds_algo_descr}) is acceptable. Fetched from name servers {servers}."
msgstr "DS-tietue avaintunnisteella {keytag} ja tiivistealgoritmi {ds_algo_num} ({ds_algo_descr}) on hyväksyttävä. Haettu nimipalvelimilta {servers}."

msgctxt "DNSSEC:DS01_ROOT_N_NO_UNDEL_DS"
msgid "No undelegated DS records provided for the root zone."
msgstr "Juurivyöhykkeelle ei toimitettu delegoimattomia DS-tietueita."

msgctxt "DNSSEC:DS01_UNDEL_N_NO_UNDEL_DS"
msgid "No undelegated DS records provided for this test."
msgstr "Tälle testille ei toimitettu delegoimattomia DS-tietueita."

msgctxt "DNSSEC:DS05_ALGO_OK"
msgid "DNSKEY with key tag {keytag} uses algorithm {algo_num} ({algo_descr}, {algo_mnemo}) which is acceptable. Fetched from name servers {servers}."
msgstr "DNSKEY avaintunnisteella {keytag} käyttää algoritmia {algo_num} ({algo_descr}, {algo_mnemo}), joka on hyväksyttävä. Haettu nimipalvelimilta {servers}."

msgctxt "DNSSEC:DS07_DS_FOR_SIGNED_ZONE"
msgid "DS records are published in the parent zone for the signed zone."
msgstr "DS-tietueet on julkaistu ylävyöhykkeessä allekirjoitetulle vyöhykkeelle."

msgctxt "DNSSEC:DS07_DS_ON_PARENT_SERVER"
msgid "DS records found on parent name servers {servers}."
msgstr "DS-tietueet löydetty ylänimipalvelimilta {servers}."

msgctxt "DNSSEC:DS07_SIGNED"
msgid "The zone is signed with DNSSEC."
msgstr "Vyöhyke on allekirjoitettu DNSSEC:llä."

msgctxt "DNSSEC:DS07_SIGNED_ON_SERVER"
msgid "Signed responses received from name servers {servers}."
msgstr "Allekirjoitetut vastaukset vastaanotettu nimipalvelimilta {servers}."

msgctxt "ZONE:Z11_NO_SPF_NON_MAIL_DOMAIN"
msgid "No SPF policy found for {domain}, which is not a mail domain."
msgstr "SPF-käytäntöä ei löydetty vyöhykkeelle {domain}, joka ei ole sähköpostidomain."

msgctxt "ZONE:Z11_NULL_SPF_NON_MAIL_DOMAIN"
msgid "Null SPF policy found for {domain}, which is not a mail domain."
msgstr "Nolla-SPF-käytäntö löydetty vyöhykkeelle {domain}, joka ei ole sähköpostidomain."

msgctxt "ZONE:Z11_SPF_SYNTAX_OK"
msgid "SPF syntax is correct for {domain}."
msgstr "SPF-syntaksi on oikein vyöhykkeelle {domain}."

msgctxt "SYSTEM:CLI_HEADER_SECONDS"
msgid "Seconds"
msgstr "Sekunnit"

msgctxt "SYSTEM:CLI_HEADER_LEVEL"
msgid "Level"
msgstr "Taso"

msgctxt "SYSTEM:CLI_HEADER_MESSAGE"
msgid "Message"
msgstr "Viesti"

msgctxt "CONNECTIVITY:CN04_ASN_INFOS_ANNOUNCE_IN"
msgid "Name server IP address \"{address}\" is announced in prefix \"{prefixes}\"."
msgstr ""
"Nimipalvelimen IP-osoite \"{address}\" ilmoitetaan Prefixissä \"{prefixes}\"."

msgctxt "CONNECTIVITY:CN04_ASN_INFOS_RAW"
msgid "The ASN data for name server IP address \"{address}\" is \"{data}\"."
msgstr "Nimipalvelimen IP-osoitteen \"{address}\" ASN-tieto on \"{data}\"."

msgctxt "CONSISTENCY:SOA_MNAME"
msgid "Found SOA mname {mname} on following nameserver set : {servers}."
msgstr ""
"Löydetty SOA mname {mname} seuraavasta nimipalvelinjoukosta: {servers}."

msgctxt "BASIC:LOOP_PROTECTION"
msgid "Loop protection triggered in {caller} for child zone {child_zone_name} at zone {zone_name} (query name {intermediate_query_name})."
msgstr "Silmukkasuojaus laukei kohdassa {caller} lapsivyöhykkeelle {child_zone_name} vyöhykkeessä {zone_name} (kyselynimi {intermediate_query_name})."

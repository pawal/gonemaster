msgctxt "SYSTEM:ERROR_CACHE_SKIP"
msgid "Skipping {query_type} query to {query_name} ({query_class}) at {address} over {protocol} for {ttl_seconds}s after network error."
msgstr "Ignorer la requête {query_type} vers {query_name} ({query_class}) à {address} via {protocol} pendant {ttl_seconds}s après une erreur réseau."

msgctxt "BASIC:IPV6_ENABLED"
msgid "IPv6 is enabled, can send \"{query_type}\" query to {ns}/{address}."
msgstr ""
"IPv6 est activé, il est possible de réaliser une requête de type "
"\"{query_type}\" sur le serveur {ns}/{address}."

msgctxt "BASIC:NO_A_RECORDS"
msgid "Nameserver {ns}/{address} did not return \"A\" record(s) for {domain}."
msgstr ""
"Le serveur de noms {ns}/{address} ne renvoie pas d'enregistrement de type \"A\" en "
"réponse à une requête pour '{domain}'."

msgctxt "CONNECTIVITY:CN01_IPV4_DISABLED"
msgid ""
"IPv4 is disabled. No DNS queries are sent to these name servers: "
"\"{servers}\"."
msgstr ""
"IPv4 est désactivé. Aucune requête n’est envoyée aux serveurs de noms : "
"\"{servers}\"."

msgctxt "CONNECTIVITY:CN01_IPV6_DISABLED"
msgid ""
"IPv6 is disabled. No DNS queries are sent to these name servers: "
"\"{servers}\"."
msgstr ""
"IPv6 est désactivé. Aucune requête n’est envoyée aux serveurs de noms : "
"\"{servers}\"."

msgctxt "CONNECTIVITY:CN01_MISSING_NS_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds to a NS query with no NS records in the answer "
"section over UDP."
msgstr ""
"Le serveur de noms {ns}/{address} ne retourne aucun enregistrement de type \"NS\" dans "
"la section \"answer\" de la réponse à une requête de type \"NS\" en UDP."

msgctxt "CONNECTIVITY:CN01_MISSING_SOA_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds to a SOA query with no SOA records in the answer "
"section over UDP."
msgstr ""
"Le serveur de noms {ns}/{address} ne retourne aucun enregistrement de type \"SOA\" "
"dans la section \"answer\" de la réponse à une requête de type \"SOA\" en "
"UDP."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_NS_QUERY_UDP"
msgid "Nameserver {ns}/{address} does not respond to NS queries over UDP."
msgstr ""
"Le serveur de noms {ns}/{address} ne répond pas aux requêtes de type \"NS\" en UDP."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_SOA_QUERY_UDP"
msgid "Nameserver {ns}/{address} does not respond to SOA queries over UDP."
msgstr ""
"Le serveur de noms {ns}/{address} ne répond pas aux requêtes de type \"SOA\" en UDP."

msgctxt "CONNECTIVITY:CN01_NO_RESPONSE_UDP"
msgid "Nameserver {ns}/{address} does not respond to any queries over UDP."
msgstr "Le serveur de noms {ns}/{address} ne répond à aucune requête en UDP."

msgctxt "CONNECTIVITY:CN01_NS_RECORD_NOT_AA_UDP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an NS query over "
"UDP."
msgstr ""
"La réponse du serveur de noms {ns}/{address} à une requête de type \"NS\" en UDP ne "
"fait pas autorité."

msgctxt "CONNECTIVITY:CN01_OK_UDP"
msgid "The following nameservers respond correctly to SOA and NS queries over UDP: \"{servers}\"."
msgstr "Les serveurs de noms suivants répondent correctement aux requêtes SOA et NS via UDP : \"{servers}\"."

msgctxt "CONNECTIVITY:CN01_SOA_RECORD_NOT_AA_UDP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an SOA query over "
"UDP."
msgstr ""
"La réponse du serveur de noms {ns}/{address} à une requête de type \"SOA\" en UDP ne "
"fait pas autorité."

msgctxt "CONNECTIVITY:CN01_UNEXPECTED_RCODE_NS_QUERY_UDP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an NS query "
"over UDP."
msgstr ""
"Le serveur de noms {ns}/{address} a répondu à une requête de type \"NS\" en UDP avec "
"un code retour inattendu ({rcode})."

msgctxt "CONNECTIVITY:CN01_UNEXPECTED_RCODE_SOA_QUERY_UDP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an SOA query "
"over UDP."
msgstr ""
"Le serveur de noms {ns}/{address} a répondu à une requête de type \"SOA\" en UDP avec "
"un code retour inattendu ({rcode})."

msgctxt "CONNECTIVITY:CN01_WRONG_NS_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on NS queries over UDP."
msgstr ""
"Le serveur de noms {ns}/{address} répond aux requêtes de type \"NS\" en UDP avec un "
"nom de domaine erroné ({domain_found} à la place de {domain_expected})."

msgctxt "CONNECTIVITY:CN01_WRONG_SOA_RECORD_UDP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on SOA queries over UDP."
msgstr ""
"Le serveur de noms {ns}/{address} répond aux requêtes de type \"SOA\" en UDP avec un "
"nom de domaine erroné ({domain_found} à la place de {domain_expected})."

msgctxt "CONNECTIVITY:CN02_MISSING_NS_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds to a NS query with no NS records in the answer "
"section over TCP."
msgstr ""
"Le serveur de noms {ns}/{address} ne retourne aucun enregistrement de type \"NS\" dans "
"la section \"answer\" de la réponse à une requête de type \"NS\" en TCP."

msgctxt "CONNECTIVITY:CN02_MISSING_SOA_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds to a SOA query with no SOA records in the answer "
"section over TCP."
msgstr ""
"Le serveur de noms {ns}/{address} ne retourne aucun enregistrement de type \"SOA\" "
"dans la section \"answer\" de la réponse à une requête de type \"SOA\" en "
"TCP."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_NS_QUERY_TCP"
msgid "Nameserver {ns}/{address} does not respond to NS queries over TCP."
msgstr ""
"Le serveur de noms {ns}/{address} ne répond pas aux requêtes de type \"NS\" en TCP."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_SOA_QUERY_TCP"
msgid "Nameserver {ns}/{address} does not respond to SOA queries over TCP."
msgstr ""
"Le serveur de noms {ns}/{address} ne répond pas aux requêtes de type \"SOA\" en TCP."

msgctxt "CONNECTIVITY:CN02_NO_RESPONSE_TCP"
msgid "Nameserver {ns}/{address} does not respond to any queries over TCP."
msgstr "Le serveur de noms {ns}/{address} ne répond à aucune requête en TCP."

msgctxt "CONNECTIVITY:CN02_NS_RECORD_NOT_AA_TCP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an NS query over "
"TCP."
msgstr ""
"La réponse du serveur de noms {ns}/{address} à une requête de type \"NS\" en TCP ne "
"fait pas autorité."

msgctxt "CONNECTIVITY:CN02_SOA_RECORD_NOT_AA_TCP"
msgid ""
"Nameserver {ns}/{address} does not give an authoritative response on an SOA query over "
"TCP."
msgstr ""
"La réponse du serveur de noms {ns}/{address} à une requête de type \"SOA\" en TCP ne "
"fait pas autorité."

msgctxt "CONNECTIVITY:CN02_UNEXPECTED_RCODE_NS_QUERY_TCP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an NS query "
"over TCP."
msgstr ""
"Le serveur de noms {ns}/{address} a répondu à une requête de type \"NS\" en TCP avec "
"un code retour inattendu ({rcode})."

msgctxt "CONNECTIVITY:CN02_UNEXPECTED_RCODE_SOA_QUERY_TCP"
msgid ""
"Nameserver {ns}/{address} responds with an unexpected RCODE ({rcode}) on an SOA query "
"over TCP."
msgstr ""
"Le serveur de noms {ns}/{address} a répondu à une requête de type \"SOA\" en TCP avec "
"un code retour inattendu ({rcode})."

msgctxt "CONNECTIVITY:CN02_WRONG_NS_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on NS queries over TCP."
msgstr ""
"Le serveur de noms {ns}/{address} répond aux requêtes de type \"NS\" en TCP avec un "
"nom de domaine erroné ({domain_found} à la place de {domain_expected})."

msgctxt "CONNECTIVITY:CN02_WRONG_SOA_RECORD_TCP"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({domain_found} instead of "
"{domain_expected}) on SOA queries over TCP."
msgstr ""
"Le serveur de noms {ns}/{address} répond aux requêtes de type \"SOA\" en TCP avec un "
"nom de domaine erroné ({domain_found} à la place de {domain_expected})."

msgctxt "CONNECTIVITY:CN02_OK_TCP"
msgid "The following nameservers respond correctly to SOA and NS queries over TCP: \"{servers}\"."
msgstr "Les serveurs de noms suivants répondent correctement aux requêtes SOA et NS via TCP : \"{servers}\"."

msgctxt "CONNECTIVITY:ASN_INFOS_ANNOUNCE_IN"
msgid "Name server IP address \"{address}\" is announced in prefix \"{prefixes}\"."
msgstr ""
"L'adresse IP du serveur de noms \"{address}\" est annoncée dans le préfixe "
"\"{prefixes}\"."

msgctxt "CONNECTIVITY:ASN_INFOS_RAW"
msgid "The ASN data for name server IP address \"{address}\" is \"{data}\"."
msgstr ""
"Les données d'AS pour le serveur de noms d'adresse \"{address}\" sont "
"\"{data}\"."

msgctxt "CONNECTIVITY:CN04_EMPTY_PREFIX_SET"
msgid "Prefix database returned no information for IP address {address}."
msgstr ""
"La base de données des préfixes IP ne retourne aucune information pour "
"l'adresse IP {address}."

msgctxt "CONNECTIVITY:CN04_ERROR_PREFIX_DATABASE"
msgid "Prefix database error for IP address {address}."
msgstr ""
"Erreur de la base de données des préfixes IP pour l'adresse IP {address}."

msgctxt "CONNECTIVITY:CN04_IPV4_DIFFERENT_PREFIX"
msgid ""
"The following name server(s) are announced in unique IPv4 prefix(es): "
"\"{servers}\""
msgstr ""
"Les serveurs de noms suivants sont annoncés dans des préfixes IPv4 "
"distincts : \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV4_SAME_PREFIX"
msgid ""
"The following name server(s) are announced in the same IPv4 prefix "
"({prefixes}): \"{servers}\""
msgstr ""
"Les serveurs de noms suivants sont annoncés dans le même préfixe IPv4 "
"({prefixes}) : \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV4_SINGLE_PREFIX"
msgid ""
"All name server(s) IPv4 address(es) are announced in the same IPv4 prefix."
msgstr ""
"Toutes les adresses IPv4 des serveurs de noms sont annoncées dans le même "
"préfixe IPv4."

msgctxt "CONNECTIVITY:CN04_IPV6_DIFFERENT_PREFIX"
msgid ""
"The following name server(s) are announced in unique IPv6 prefix(es): "
"\"{servers}\""
msgstr ""
"Les serveurs de noms suivants sont annoncés dans des préfixes IPv6 "
"distincts : \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV6_SAME_PREFIX"
msgid ""
"The following name server(s) are announced in the same IPv6 prefix "
"({prefixes}): \"{servers}\""
msgstr ""
"Les serveurs de noms suivants sont annoncés dans le même préfixe IPv6 "
"({prefixes}) : \"{servers}\""

msgctxt "CONNECTIVITY:CN04_IPV6_SINGLE_PREFIX"
msgid ""
"All name server(s) IPv6 address(es) are announced in the same IPv6 prefix."
msgstr ""
"Toutes les adresses IPv6 des serveurs de noms sont annoncées dans le même "
"préfixe IPv6."

msgctxt "CONNECTIVITY:ERROR_ASN_DATABASE"
msgid "ASN Database error. No data to analyze for {address}."
msgstr ""
"La base de données des numéros d'AS retourne une erreur. Aucune donnée à "
"analyser pour l'adresse IP {address}."

msgctxt "CONNECTIVITY:EMPTY_ASN_SET"
msgid "AS database returned no informations for IP address {address}."
msgstr ""
"La base de données des numéros d'AS ne retourne aucune information pour "
"l'adresse IP {address}."

msgctxt "CONNECTIVITY:IPV4_SAME_ASN"
msgid ""
"All authoritative nameservers have their IPv4 addresses in the same AS set "
"({asns})."
msgstr ""
"Toutes les adresses IPv4 des serveurs faisant autorité se trouvent dans le "
"même ensemble d'AS ({asns})."

msgctxt "CONNECTIVITY:IPV4_ONE_ASN"
msgid ""
"All authoritative nameservers have their IPv4 addresses in the same AS "
"({asn})."
msgstr ""
"Toutes les adresses IPv4 des serveurs faisant autorité se trouvent dans le "
"même AS ({asn})."

msgctxt "CONNECTIVITY:IPV4_DIFFERENT_ASN"
msgid ""
"At least two IPv4 addresses of the authoritative nameservers are announced "
"by different AS sets. A merged list of all AS: ({asns})."
msgstr ""
"Au moins 2 adresses IPv4 des serveurs faisant autorité sont annoncées par "
"des ensembles d'AS différents. Liste de l'ensemble des AS: ({asns})."

msgctxt "CONNECTIVITY:IPV6_SAME_ASN"
msgid ""
"All authoritative nameservers have their IPv6 addresses in the same AS set "
"({asns})."
msgstr ""
"Toutes les adresses IPv6 des serveurs faisant autorité se trouvent dans le "
"même ensemble d'AS ({asns})."

msgctxt "CONNECTIVITY:IPV6_ONE_ASN"
msgid ""
"All authoritative nameservers have their IPv6 addresses in the same AS "
"({asn})."
msgstr ""
"Toutes les adresses IPv6 des serveurs faisant autorité se trouvent dans le "
"même AS ({asn})."

msgctxt "CONNECTIVITY:IPV6_DIFFERENT_ASN"
msgid ""
"At least two IPv6 addresses of the authoritative nameservers are announced "
"by different AS sets. A merged list of all AS: ({asns})."
msgstr ""
"Au moins 2 adresses IPv6 des serveurs faisant autorité sont annoncées par "
"des ensembles d'AS différents. Liste de l'ensemble des AS: ({asns})."

msgctxt "CONNECTIVITY:ASN_INFOS_ANNOUNCE_BY"
msgid "Name server IP address \"{address}\" is announced by ASN {asns}."
msgstr ""
"L'adresse IP du serveur de noms \"{address}\" est annoncée par l'AS {asns}."

msgctxt "CONSISTENCY:ADDRESSES_MATCH"
msgid "Glue records are consistent between glue and authoritative data."
msgstr ""
"La liste des adresses IP des serveurs de noms retournée par les serveurs de "
"noms de la zone parente et par ceux de la zone est identique."

msgctxt "CONSISTENCY:CHILD_NS_FAILED"
msgid "Unexpected or erroneous reply from {ns}/{address}."
msgstr "Réponse inattendue ou erronéeLe du serveur de noms {ns}/{address}."

msgctxt "CONSISTENCY:CHILD_ZONE_LAME"
msgid "Lame delegation."
msgstr "Utilisation d'une configuration DNS alternative (fake delegation)."

msgctxt "CONSISTENCY:EXTRA_ADDRESS_CHILD"
msgid ""
"Child has extra nameserver IP address(es) not listed at parent "
"({addresses})."
msgstr ""
"Les serveurs de noms de la zone retournent des adresses IP pour les serveurs "
"de nom de la zone qui ne sont pas connues par les serveurs de noms de la "
"zone parente ({addresses})."

msgctxt "CONSISTENCY:IN_BAILIWICK_ADDR_MISMATCH"
msgid ""
"In-bailiwick name server listed at parent has a mismatch between glue data "
"at parent ({parent_servers}) and any equivalent address record in child "
"zone ({zone_servers})."
msgstr ""
"Problème de colle(s) pour un serveur de noms \"in-bailiwick\", celles "
"trouvées ({parent_servers}) dans la zone parente sont différentes de "
"celles trouvées ({zone_servers}) sur les serveurs de noms de la zone."

msgctxt "CONSISTENCY:INCONSISTENT_NS_TTL"
msgid "Name servers serve the zone's NS records with {count} distinct TTL values."
msgstr "Les serveurs de noms servent les enregistrements NS de la zone avec {count} valeurs de TTL distinctes."

msgctxt "CONSISTENCY:MULTIPLE_NS_SET"
msgid "Found {count} NS set(s)."
msgstr ""
"Plusieurs ensembles de serveurs de noms ({count}) ont été trouvés dans les "
"différents SOA."

msgctxt "CONSISTENCY:MULTIPLE_SOA_MNAMES"
msgid "Saw {count} SOA mname."
msgstr ""
"Plusieurs noms du serveur primaire de la zone ({count}) différents ont été "
"trouvés dans le champ MNAME des enregistrements SOA."

msgctxt "CONSISTENCY:MULTIPLE_SOA_RNAMES"
msgid "Found {count} SOA rname(s)."
msgstr ""
"Plusieurs adresses mail ({count}) différentes ont été trouvées dans le champ "
"RNAME des enregistrements SOA."

msgctxt "CONSISTENCY:MULTIPLE_SOA_SERIALS"
msgid "Found {count} SOA serial number(s)."
msgstr ""
"Plusieurs numéros de série ({count}) ont été trouvés dans les différents SOA."

msgctxt "CONSISTENCY:MULTIPLE_SOA_TIME_PARAMETER_SET"
msgid "Found {count} SOA time parameter set(s)."
msgstr ""
"Plusieurs ensembles de paramètres temporels ({count}) ont été trouvés dans "
"les différents SOA."

msgctxt "CONSISTENCY:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "Le serveur de noms {ns} n'a pas répondu."

msgctxt "DNSSEC:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "Le serveur de noms {ns} n'a pas répondu."

msgctxt "ZONE:NO_RESPONSE"
msgid "Nameserver {ns} did not respond."
msgstr "Le serveur de noms {ns} n'a pas répondu."

msgctxt "CONSISTENCY:NO_RESPONSE_NS_QUERY"
msgid "No response from nameserver {ns}/{address} on NS queries."
msgstr "Le serveur de noms {ns}/{address} n'a pas répondu aux requêtes de type \"NS\"."

msgctxt "CONSISTENCY:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver {ns}/{address} on SOA queries."
msgstr "Le serveur de noms {ns}/{address} n'a pas répondu aux requêtes de type \"SOA\"."

msgctxt "CONSISTENCY:NS_SET"
msgid "Saw NS set ({ns_set_servers}) on following nameserver set : {servers}."
msgstr ""
"L'ensemble de serveurs de noms ({ns_set_servers}) est défini sur les serveurs "
"suivants : {servers}."

msgctxt "CONSISTENCY:ONE_NS_SET"
msgid "A single NS set was found ({servers})."
msgstr ""
"Un unique ensemble de serveurs de noms est configuré sur les serveurs de la "
"zone testée ({servers})."

msgctxt "CONSISTENCY:ONE_SOA_MNAME"
msgid "A single SOA mname value was seen ({mname})."
msgstr ""
"Un unique serveur primaire a été trouvé dans les enregistrements de type "
"\"SOA\" de la zone testée ({mname})."

msgctxt "CONSISTENCY:ONE_SOA_RNAME"
msgid "A single SOA rname value was found ({rname})."
msgstr ""
"Une unique adresse mail a été trouvée dans les enregistrements de type "
"\"SOA\" de la zone testée ({rname})."

msgctxt "CONSISTENCY:ONE_SOA_SERIAL"
msgid "A single SOA serial number was found ({serial})."
msgstr ""
"Un unique numéro de série a été trouvé dans les enregistrements de type "
"\"SOA\" de la zone testée ({serial})."

msgctxt "CONSISTENCY:ONE_SOA_TIME_PARAMETER_SET"
msgid ""
"A single SOA time parameter set was seen (REFRESH={refresh},RETRY={retry},"
"EXPIRE={expire},MINIMUM={minimum})."
msgstr ""
"Un unique ensemble de paramètres temporels a été trouvé (REFRESH={refresh},"
"RETRY={retry},EXPIRE={expire},MINIMUM={minimum})."

msgctxt "CONSISTENCY:OUT_OF_BAILIWICK_ADDR_MISMATCH"
msgid ""
"Out-of-bailiwick name server listed at parent with glue record has a "
"mismatch between the glue at the parent ({parent_servers}) and any "
"equivalent address record found in authoritative zone ({zone_servers})."
msgstr ""
"Problèmes de colle(s) pour un serveur de noms \"out-of-bailiwick\", celles "
"trouvées ({parent_servers}) dans la zone parente sont différentes de "
"celles trouvées ({zone_servers}) sur les serveurs de noms faisant autorité "
"pour ces données."

msgctxt "CONSISTENCY:SOA_RNAME"
msgid "Found SOA rname {rname} on following nameserver set : {servers}."
msgstr ""
"L'adresse mail {rname} a été récupérée sur les serveurs suivants : {servers}."

msgctxt "CONSISTENCY:SOA_SERIAL"
msgid "Saw SOA serial number {serial} on following nameserver set : {servers}."
msgstr ""
"Le numéro de série {serial} a été récupéré sur les serveurs suivants : "
"{servers}."

msgctxt "CONSISTENCY:SOA_SERIAL_VARIATION"
msgid ""
"Difference between the smaller serial ({serial_min}) and the bigger one "
"({serial_max}) is greater than the maximum allowed ({max_variation})."
msgstr ""
"La différence entre le plus petit numéro de série de la zone récupéré "
"({serial_min}) et le plus grand ({serial_max}) est supérieure au maximum "
"autorisé ({max_variation})."

msgctxt "CONSISTENCY:SOA_TIME_PARAMETER_SET"
msgid ""
"Saw SOA time parameter set (REFRESH={refresh}, RETRY={retry}, "
"EXPIRE={expire}, MINIMUM={minimum}) on following nameserver set : {servers}."
msgstr ""
"L'ensemble de paramètres temporels (REFRESH={refresh}, RETRY={retry}, "
"EXPIRE={expire}, MINIMUM={minimum}) a été récupérée sur les serveurs "
"suivants : {servers}."

msgctxt "DNSSEC:DNSKEY_SMALLER_THAN_REC"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) smaller than the recommended one ({keysizerec})."
msgstr ""
"La clé (DNSKEY) avec le tag {keytag} utilisant l'algorithme {algo_num} "
"({algo_descr}) a une taille ({keysize}) plus petite que la taille "
"recommandée ({keysizerec}) pour cet algorithme."

msgctxt "DNSSEC:DNSKEY_TOO_SMALL_FOR_ALGO"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) smaller than the minimum one ({keysizemin})."
msgstr ""
"La clé (DNSKEY) avec le tag {keytag} utilisant l'algorithme {algo_num} "
"({algo_descr}) a une taille ({keysize}) plus petite que la taille minimum "
"({keysizemin}) spécifiée pour cet algorithme."

msgctxt "DNSSEC:DNSKEY_TOO_LARGE_FOR_ALGO"
msgid ""
"DNSKEY with tag {keytag} and using algorithm {algo_num} ({algo_descr}) has a "
"size ({keysize}) larger than the maximum one ({keysizemax})."
msgstr ""
"La clé (DNSKEY) avec le tag {keytag} utilisant l'algorithme {algo_num} "
"({algo_descr}) a une taille ({keysize}) plus grande que la taille maximum "
"({keysizemax}) spécifiée pour cet algorithme."

msgctxt "DNSSEC:DS01_DS_ALGO_2_MISSING"
msgid ""
"There is a DS record with keytag {keytag}. A DS record using digest "
"algorithm 2 (SHA-256) is missing. Fetched from parent name servers "
"\"{servers}\"."
msgstr ""
"Il y a un enregistrement de type DS avec le tag {keytag}. Il manque un "
"enregistrement de type DS utilisant l'algorithme de condensat 2 (SHA-256). "
"Information retournée par les serveurs de noms parents \"{servers}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_DEPRECATED"
msgid ""
"The DS record with keytag {keytag} uses a deprecated digest algorithm "
"{ds_algo_num} ({ds_algo_descr}). Fetched from parent name servers "
"\"{servers}\"."
msgstr ""
"Un enregistrement de type DS avec le tag {keytag} utilise un algorithme de "
"condensat obsolète {ds_algo_num} ({ds_algo_descr}). Information retournée "
"par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_NOT_DS"
msgid ""
"The DS record with keytag {keytag} uses a digest algorithm {ds_algo_num} "
"({ds_algo_descr}) not meant for DS records. Fetched from parent name servers "
"\"{servers}\"."
msgstr ""
"Un enregistrement de type \"DS\" avec le tag {keytag} utilise un algorithme "
"de condensat {ds_algo_num} ({ds_algo_descr}) qui n'est pas destiné à ce type "
"d'enregistrement. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_PRIVATE"
msgid ""
"The DS record with keytag {keytag} uses a digest algorithm {ds_algo_num} for "
"private use. Fetched from parent name servers \"{servers}\"."
msgstr ""
"Un enregistrement de type \"DS\" avec le tag {keytag} utilise un algorithme "
"de condensat {ds_algo_num} à usage privé. Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_RESERVED"
msgid ""
"The DS record with keytag {keytag} uses a reserved digest algorithm "
"{ds_algo_num} on name servers \"{servers}\"."
msgstr ""
"Un enregistrement de type \"DS\" avec le tag {keytag} utilise un numéro "
"d'algorithme de condensat réservé {ds_algo_num} pour les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS01_DS_ALGO_UNASSIGNED"
msgid ""
"The DS record with keytag {keytag} uses an unassigned digest algorithm "
"{ds_algo_num} on parent name servers \"{servers}\"."
msgstr ""
"Un enregistrement de type \"DS\" avec le tag {keytag} utilise un algorithme "
"de condensat non assigné {ds_algo_num} pour les serveurs de noms parent "
"\"{servers}\"."

msgctxt "DNSSEC:DS01_NO_RESPONSE"
msgid ""
"No response or error in response from all parent name servers on the DS "
"query. Name servers are \"{servers}\"."
msgstr ""
"Aucune réponse ou réponse erronée de tous les serveurs de noms parent à une "
"requête de type DS. Serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS01_PARENT_SERVER_NO_DS"
msgid ""
"The following name servers do not provide DS record or have not been "
"properly configured. Fetched from parent name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants ne fournissent pas d'enregistrement DS ou "
"n'ont pas été configurés correctement. Information retournée par les "
"serveurs de noms parent \"{servers}\"."

msgctxt "DNSSEC:DS01_PARENT_ZONE_NO_DS"
msgid ""
"The parent zone provides no DS records for the child zone. Fetched from "
"parent name servers \"{servers}\"."
msgstr ""
"La zone parente ne fournit pas d'enregistrement DS pour la zone fille. "
"Information retournée par les serveurs de noms parent \"{servers}\"."

msgctxt "DNSSEC:DS01_ROOT_N_NO_UNDEL_DS"
msgid ""
"Tested zone is the root zone, but no undelegated DS has been provided. DS is "
"not tested."
msgstr ""
"La zone testée est la zone racine, mais aucun DS non délégué n'a été fourni. "
"DS n'est pas testé."

msgctxt "DNSSEC:DS01_UNDEL_N_NO_UNDEL_DS"
msgid ""
"Tested zone is undelegated, but no undelegated DS has been provided. DS is "
"not tested."
msgstr ""
"La zone testée est non déléguée, mais aucun DS non délégué n'a été fourni. "
"DS n'est pas testé."

msgctxt "DNSSEC:DS02_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La clé (DNSKEY) avec le tag {keytag} utilise un algorithme {algo_num} "
"({algo_mnemo}) non supporté par cette version installée de Zonemaster. "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS08_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La clé (DNSKEY) avec le tag {keytag} utilise un algorithme {algo_num} "
"({algo_mnemo}) non supporté par cette version installée de Zonemaster. "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS09_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La clé (DNSKEY) avec le tag {keytag} utilise un algorithme {algo_num} "
"({algo_mnemo}) non supporté par cette version installée de Zonemaster. "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_FOR_ZONE_SIGNING"
msgid ""
"Flags field of DNSKEY record with tag {keytag} has not ZONE bit set although "
"DS with same tag is present in parent. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Le champ \"flags\" de l'enregistrement de type \"DNSKEY\" avec le tag "
"{keytag} n'a pas le bit ZONE positionné alors qu'un enregistrement de type "
"\"DS\" avec le même tag existe dans la zone parente. Information retournée "
"par les serveurs de noms ayant une des adresses IP suivantes "
"\"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_SEP"
msgid ""
"Flags field of DNSKEY record with tag {keytag} has not SEP bit set although "
"DS with same tag is present in parent. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Le champ \"flags\" de l'enregistrement de type \"DNSKEY\" avec le tag "
"{keytag} n'a pas le bit SEP positionné alors qu'un enregistrement de type "
"\"DS\" avec le même tag existe dans la zone parente. Information retournée "
"par les serveurs de noms ayant une des adresses IP suivantes "
"\"{addresses}\"."

msgctxt "DNSSEC:DS02_DNSKEY_NOT_SIGNED_BY_ANY_DS"
msgid ""
"The DNSKEY RRset has not been signed by any DNSKEY matched by a DS record. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"DNSKEY\" n'est signé par aucune des "
"clés (DNSKEY) correspondant à un enregistrement de type \"DS\". Information "
"retournée par les serveurs de noms ayant une des adresses IP suivantes "
"\"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_DNSKEY_FOR_DS"
msgid ""
"The DNSKEY record with tag {keytag} that the DS refers to does not exist in "
"the DNSKEY RRset. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"L'enregistrement de type \"DNSKEY\" avec le tag {keytag} auquel "
"l'enregistrement de type \"DS\" fait référence n'a pas été trouvé dans "
"l'ensemble de clés retournées. Information retournée par les serveurs de "
"noms ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_MATCHING_DNSKEY_RRSIG"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY with tag {keytag} that the DS "
"record refers to. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"DNSKEY\" n'est pas signé par la clé "
"correspondant au tag {keytag} à laquelle l'enregistrement de type \"DS\" "
"fait référence. Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_MATCH_DS_DNSKEY"
msgid ""
"The DS record does not match the DNSKEY with tag {keytag} by algorithm or "
"digest. Fetched from the nameservers with IP \"{addresses}\"."
msgstr ""
"Les enregistrements de type \"DS\" et de type \"DNSKEY\" partageant le même "
"tag {keytag} ne sont pas cohérents au niveau de l'algorithme ou du "
"condensat. Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS02_NO_VALID_DNSKEY_FOR_ANY_DS"
msgid ""
"There is no valid DNSKEY matched by any of the DS records. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Aucun DNSKEY valable n’a d’entrée DS correspondante. Information retournée "
"par les serveurs de noms dont les adresses IP sont \"{addresses}\"."

msgctxt "DNSSEC:DS02_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"La signature (RRSIG) de l'ensemble d'enregistrements de type \"DNSKEY\" "
"ayant pour tag {keytag} n'a pas pu être validée par la clé (DNSKEY) "
"correspondante. Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS02_MATCH_DS_DNSKEY"
msgid ""
"The DS record matches the DNSKEY and the DNSKEY RRSIG is valid. Found at "
"the nameservers with IP addresses \"{addresses}\"."
msgstr "L'enregistrement DS correspond au DNSKEY et le RRSIG du DNSKEY est valide. Trouvé sur les serveurs de noms avec les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS08_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"La signature (RRSIG) de l'ensemble d'enregistrements de type \"DNSKEY\" "
"ayant pour tag {keytag} n'a pas pu être validée par la clé (DNSKEY) "
"correspondante. Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS03_ERROR_RESPONSE_NSEC_QUERY"
msgid ""
"The following servers give erroneous response to NSEC query. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants donnent une réponse erronée à la requête NSEC. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_ERR_MULT_NSEC3"
msgid ""
"Multiple NSEC3 records when one is expected. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Plusieurs enregistrements NSEC3 alors qu'un seul est attendu. Information "
"retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_ERR_MULT_NSEC3"
msgid ""
"Multiple NSEC3 records when one is expected. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Plusieurs enregistrements NSEC3 alors qu'un seul est attendu. Information "
"retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_ILLEGAL_HASH_ALGO"
msgid ""
"The following servers respond with an illegal hash algorithm for NSEC3 "
"({algo_num}). Fetched from name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec un numéro d'algorithme de "
"hachage non valable pour NSEC3 ({algo_num}). Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_ILLEGAL_ITERATION_VALUE"
msgid ""
"The following servers respond with the NSEC3 iteration value {int}. The "
"recommended practice is to set this value to 0. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec la valeur d'itération NSEC3 "
"{int}. La pratique recommandée est qu'elle soit réglée à 0. Information "
"retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_ILLEGAL_SALT_LENGTH"
msgid ""
"The following servers respond with a non-empty salt in NSEC3 ({int} octets). "
"The recommended practice is to use an empty salt. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec un sel non-vide pour NSEC3 "
"({int} octets). La pratique recommandée est d'utiliser un sel vide. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_INCONSISTENT_HASH_ALGO"
msgid ""
"Inconsistent hash algorithm in NSEC3 in responses for the child zone from "
"different name servers."
msgstr ""
"Incohérence entre les algorithmes de hachage NSEC3 dans les réponses pour la "
"zone fille venant de différents serveurs de noms."

msgctxt "DNSSEC:DS03_INCONSISTENT_ITERATION"
msgid ""
"Inconsistent NSEC3 iteration value in responses for the child zone from "
"different name servers."
msgstr ""
"Incohérence entre les valeurs d'itération NSEC3 dans les réponses pour la "
"zone fille venant de différents serveurs de noms."

msgctxt "DNSSEC:DS03_INCONSISTENT_NSEC3_FLAGS"
msgid ""
"Inconsistent NSEC3 flag list in responses for the child zone from different "
"name servers."
msgstr ""
"Incohérence entre les listes de fanions NSEC3 dans les réponses pour la zone "
"fille venant de différents serveurs de noms."

msgctxt "DNSSEC:DS03_INCONSISTENT_SALT_LENGTH"
msgid ""
"Inconsistent salt length in NSEC3 in responses for the child zone from "
"different name servers."
msgstr ""
"Incohérence entre les longueurs de sel NSEC3 dans les réponses pour la zone "
"fille venant de différents serveurs de noms."

msgctxt "DNSSEC:DS03_LEGAL_EMPTY_SALT"
msgid ""
"The following servers respond with a legal empty salt in NSEC3. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec un sel NSEC3 vide valable. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_LEGAL_HASH_ALGO"
msgid ""
"The following servers respond with a legal hash algorithm in NSEC3. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec un algorithme de hachage NSEC3 "
"valable. Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_LEGAL_ITERATION_VALUE"
msgid ""
"The following servers respond with NSEC3 iteration value set to zero (as "
"recommended). Fetched from name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec une valeur d'itération NSEC3 à "
"0 (comme recommandé). Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS03_NO_DNSSEC_SUPPORT"
msgid ""
"The zone is not DNSSEC signed or not properly DNSSEC signed. Testing for "
"NSEC3 has been skipped. Fetched from name servers \"{servers}\"."
msgstr ""
"La zone n'est pas signée ou mal signée par DNSSEC. Le test de NSEC3 n'a pas "
"été effectué. Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_NO_NSEC3"
msgid ""
"The zone does not use NSEC3. Testing for NSEC3 has been skipped. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"La zone n'utilise pas NSEC3. Le test de NSEC3 n'a pas été effectué. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_NO_RESPONSE_NSEC_QUERY"
msgid ""
"The following servers do not respond to NSEC query. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants ne répondent pas aux requêtes NSEC. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_NSEC3_OPT_OUT_DISABLED"
msgid ""
"The following servers respond with NSEC3 opt-out disabled (as recommended). "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec l'opt-out NSEC3 désactivé "
"(comme recommandé). Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS03_NSEC3_OPT_OUT_ENABLED_NON_TLD"
msgid ""
"The following servers respond with NSEC3 opt-out enabled. The recommended "
"practice is to disable opt-out. Fetched from name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec l'opt-out NSEC3 activé. La "
"pratique recommandée est de désactiver l'opt-out. Information retournée par "
"les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_NSEC3_OPT_OUT_ENABLED_TLD"
msgid ""
"The following servers respond with NSEC3 opt-out enabled. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec l'opt-out NSEC3 activé. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_SERVER_NO_DNSSEC_SUPPORT"
msgid ""
"The following name servers do not support DNSSEC or have not been properly "
"configured. Testing for NSEC3 has been skipped on those servers. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants ne prennent pas en charge DNSSEC ou n'ont pas "
"été configurés correctement. Le test de NSEC3 n'a pas été effectué sur ces "
"serveurs de noms. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS03_SERVER_NO_NSEC3"
msgid ""
"The following name servers do not use NSEC3, but others do. Testing for "
"NSEC3 has been skipped on the following servers. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Les serveurs de noms suivants n'utilisent pas NSEC3, alors que d'autres "
"l'utilisent. Le test de NSEC3 n'a pas été effectué sur ces serveurs de noms. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS03_UNASSIGNED_FLAG_USED"
msgid ""
"The following servers respond with an NSEC3 record where an unassigned flag "
"is used (bit {int}). Fetched from name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec un enregistrement NSEC3 où un "
"fanion non attribué est utilisé (bit {int}). Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS05_ALGO_DEPRECATED"
msgid ""
"The DNSKEY with tag {keytag} uses deprecated algorithm number {algo_num} "
"(\"{algo_descr}\", {algo_mnemo}). Fetched from name servers \"{servers}\"."
msgstr ""
"La clé DNSKEY avec le tag {keytag} utilise le numéro d'algorithme obsolète "
"{algo_num} (\"{algo_descr}\", {algo_mnemo}). Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS05_ALGO_NOT_RECOMMENDED"
msgid ""
"The DNSKEY with tag {keytag} uses unrecommended algorithm number {algo_num} "
"(\"{algo_descr}\", {algo_mnemo}). Fetched from name servers \"{servers}\"."
msgstr ""
"La clé DNSKEY avec le tag {keytag} utilise le numéro d'algorithme non "
"recommandé {algo_num} (\"{algo_descr}\", {algo_mnemo}). Information "
"retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS05_ALGO_NOT_ZONE_SIGN"
msgid ""
"The DNSKEY with tag {keytag} uses algorithm number {algo_num} "
"(\"{algo_descr}\", {algo_mnemo}) which is not meant for zone signing. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"La clé DNSKEY avec le tag {keytag} utilise le numéro d'algorithme {algo_num} "
"(\"{algo_descr}\", {algo_mnemo}) qui n'est pas destiné à la signature d'une "
"zone. Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS05_ALGO_OK"
msgid ""
"The DNSKEY with tag {keytag} uses algorithm number {algo_num} "
"(\"{algo_descr}\", {algo_mnemo}). Fetched from name servers \"{servers}\"."
msgstr ""
"La clé DNSKEY avec le tag {keytag} utilise le numéro d'algorithme correct "
"{algo_num} (\"{algo_descr}\", {algo_mnemo}). Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS05_ALGO_PRIVATE"
msgid ""
"The DNSKEY with tag {keytag} uses algorithm number {algo_num} which is "
"reserved for private use. Fetched from name servers \"{servers}\"."
msgstr ""
"La clé DNSKEY avec le tag {keytag} utilise le numéro d'algorithme {algo_num} "
"destiné à un usage privé. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS05_ALGO_RESERVED"
msgid ""
"The DNSKEY with tag {keytag} uses reserved algorithm number {algo_num}. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"La clé DNSKEY avec le tag {keytag} utilise le numéro d'algorithme réservé "
"{algo_num}. Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS05_ALGO_UNASSIGNED"
msgid ""
"The DNSKEY with tag {keytag} uses unassigned algorithm number {algo_num}. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"La clé DNSKEY avec le tag {keytag} utilise le numéro d'algorithme non "
"assigné {algo_num}. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS05_NO_RESPONSE"
msgid ""
"No response or error in response from all name servers on the DNSKEY query. "
"Failing name servers \"{servers}\"."
msgstr ""
"Aucune réponse ou réponse erronée de tous les serveurs de noms à une requête "
"de type DNSKEY. Serveurs de noms : \"{servers}\"."

msgctxt "DNSSEC:DS05_SERVER_NO_DNSSEC"
msgid ""
"Some name servers do not support DNSSEC or have not been properly "
"configured. DNSKEY cannot be tested on those servers. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants ne prennent pas en charge DNSSEC ou n'ont pas "
"été configurés correctement. Le test DNSKEY ne peut pas être effectué pour "
"ces serveurs de noms. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS05_ZONE_NO_DNSSEC"
msgid ""
"The zone is not DNSSEC signed or not properly DNSSEC signed. DNSKEY cannot "
"be tested. Fetched from name servers \"{servers}\"."
msgstr ""
"La zone n'est pas signée ou mal signée par DNSSEC. Le test DNSKEY ne peut "
"pas être effectué. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS07_DS_FOR_SIGNED_ZONE"
msgid "DS records are published in the parent zone for the signed zone."
msgstr "Des enregistrements DS sont publiés dans la zone parente pour la zone signée."

msgctxt "DNSSEC:DS07_DS_ON_PARENT_SERVER"
msgid ""
"The following parent name servers respond with DS record or records for the "
"child zone. Name servers: \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants retournent au moins un enregistrement de type "
"DS pour la zone fille. Serveurs de noms : \"{servers}\"."

msgctxt "DNSSEC:DS07_INCONSISTENT_DS"
msgid ""
"Inconsistent responses from parent name servers. Some include DS, others do "
"not."
msgstr ""
"Réponses incohérentes des serveurs de noms parent. Certains ont des "
"enregistrements de type DS, tandis que d'autres n'en ont pas."

msgctxt "DNSSEC:DS07_INCONSISTENT_SIGNED"
msgid ""
"Inconsistent responses from name servers. Some include signed responses, "
"others do not."
msgstr ""
"Réponses incohérentes des serveurs de noms. Certains contiennent des "
"réponses signées, tandis que d'autres n'en ont pas."

msgctxt "DNSSEC:DS07_NON_AUTH_RESPONSE_DNSKEY"
msgid ""
"The following name servers give a non authoritative response on DNSKEY query "
"with DO bit set. Name servers: \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants donnent une réponse non autoritaire à une "
"requête de type DNSKEY avec le drapeau DO. Serveurs de noms : \"{servers}\"."

msgctxt "DNSSEC:DS07_NOT_SIGNED"
msgid "The zone is not signed."
msgstr "La zone n'est pas signée."

msgctxt "DNSSEC:DS07_NOT_SIGNED_ON_SERVER"
msgid ""
"The following name servers respond with no DNSKEY (unsigned child zone). "
"Name servers: \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent sans clé DNSKEY (zone fille non "
"signée). Serveurs de noms : \"{servers}\"."

msgctxt "DNSSEC:DS07_NO_DS_ON_PARENT_SERVER"
msgid ""
"The following parent name servers respond without DS record for the child "
"zone. Name servers: \"{servers}\"."
msgstr ""
"Les serveurs de noms parent suivants répondent sans enregistrement de type "
"DS pour la zone fille. Serveurs de noms : \"{servers}\"."

msgctxt "DNSSEC:DS07_NO_DS_FOR_SIGNED_ZONE"
msgid "The parent zone has no DS record for the signed child zone."
msgstr ""
"La zone parente ne contient pas d'enregistrement DS pour la zone fille "
"signée."

msgctxt "DNSSEC:DS07_NO_RESPONSE_DNSKEY"
msgid ""
"The following name servers do not respond on DNSKEY query with DO bit set. "
"Name servers: \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants ne répondent pas à une requête de type DNSKEY "
"avec le drapeau DO. Serveurs de noms : \"{servers}\"."

msgctxt "DNSSEC:DS07_SIGNED"
msgid "The zone is signed with DNSSEC."
msgstr "La zone est signée avec DNSSEC."

msgctxt "DNSSEC:DS07_SIGNED_ON_SERVER"
msgid ""
"The following name servers respond with DNSKEY (signed child zone). Name "
"servers: \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec une clé DNSKEY (zone fille "
"signée). Serveurs de noms : \"{servers}\"."

msgctxt "DNSSEC:DS07_UNEXP_RCODE_RESP_DNSKEY"
msgid ""
"The following name servers respond with RCODE \"{rcode}\" instead of "
"expected \"NOERROR\" on DNSKEY query with DO bit set. Name servers: "
"\"{servers}\"."
msgstr ""
"Les serveurs de noms suivants répondent avec le RCODE \"{rcode}\" au lieu de "
"\"NOERROR\" comme attendu à une requête de type DNSKEY avec le drapeau DO. "
"Serveurs de noms : \"{servers}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type DNSKEY has already expired. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La signature (RRSIG) avec la clé de tag {keytag} et couvrant les "
"enregistrements de type \"DNSKEY\" a expiré. Information retournée par les "
"serveurs de noms ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_NOT_YET_VALID"
msgid ""
"RRSIG with keytag {keytag} and covering type DNSKEY has inception date in "
"the future. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La signature (RRSIG) avec la clé de tag {keytag} et couvrant les "
"enregistrements de type \"DNSKEY\" a une date de mise en service dans le "
"futur. Information retournée par les serveurs de noms ayant une des adresses "
"IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS08_MISSING_RRSIG_IN_RESPONSE"
msgid ""
"The DNSKEY RRset is not signed, which is against expectation. Fetched from "
"the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Contre toute attente, l'ensemble d'enregistrements de type \"DNSKEY\" n'est "
"pas signé. Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS08_NO_MATCHING_DNSKEY"
msgid ""
"The DNSKEY RRset is signed with an RRSIG with tag {keytag} which does not "
"match any DNSKEY record. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"La signature (RRSIG) de l'ensemble d'enregistrements de type \"DNSKEY\" "
"ayant pour tag {keytag} ne correspond à aucune clé (DNSKEY). Information "
"retournée par les serveurs de noms ayant une des adresses IP suivantes "
"\"{addresses}\"."

msgctxt "DNSSEC:DS08_DNSKEY_RRSIG_VALID"
msgid ""
"The DNSKEY RRset has valid RRSIG records. Found at the nameservers with IP "
"addresses \"{addresses}\"."
msgstr "Le jeu d'enregistrements DNSKEY possède des enregistrements RRSIG valides. Trouvé sur les serveurs de noms avec les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS09_MISSING_RRSIG_IN_RESPONSE"
msgid ""
"The SOA RRset is not signed, which is against expectation. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Contre toute attente, l'ensemble d'enregistrements de type \"SOA\" n'est pas "
"signé. Information retournée par les serveurs de noms ayant une des adresses "
"IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS09_NO_MATCHING_DNSKEY"
msgid ""
"The SOA RRset is signed with an RRSIG with tag {keytag} which does not match "
"any DNSKEY record. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"La signature (RRSIG) de l'ensemble d'enregistrements de type \"SOA\" ayant "
"pour tag {keytag} ne correspond à aucune clé (DNSKEY). Information retournée "
"par les serveurs de noms ayant une des adresses IP suivantes "
"\"{addresses}\"."

msgctxt "DNSSEC:DS09_RRSIG_NOT_VALID_BY_DNSKEY"
msgid ""
"The SOA RRset is signed with an RRSIG with tag {keytag} which cannot be "
"validated by the matching DNSKEY. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"La signature (RRSIG) de l'ensemble d'enregistrements de type \"SOA\" ayant "
"pour tag {keytag} n'a pas pu être validée par la clé (DNSKEY) "
"correspondante. Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type SOA has already expired. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La signature (RRSIG) avec la clé de tag {keytag} et couvrant les "
"enregistrements de type \"SOA\" a expiré. Information retournée par les "
"serveurs de noms ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_NOT_YET_VALID"
msgid ""
"RRSIG with keytag {keytag} and covering type SOA has inception date in the "
"future. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La signature (RRSIG) avec la clé de tag {keytag} et couvrant les "
"enregistrements de type \"SOA\" a une date de mise en service dans le futur. "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS09_SOA_RRSIG_VALID"
msgid ""
"The SOA RRset has valid RRSIG records. Found at the nameservers with IP "
"addresses \"{addresses}\"."
msgstr "Le jeu d'enregistrements SOA possède des enregistrements RRSIG valides. Trouvé sur les serveurs de noms avec les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS10_ALGO_NOT_SUPPORTED_BY_ZM"
msgid ""
"DNSKEY with tag {keytag} uses unsupported algorithm {algo_num} "
"({algo_mnemo}) by this installation of Zonemaster. Fetched from name servers "
"\"{addresses}\"."
msgstr ""
"La clé DNSKEY avec le tag {keytag} utilise un algorithme {algo_num} "
"({algo_mnemo}) non pris en charge par cette installation de Zonemaster. "
"Information retournée par les serveurs de noms \"{addresses}\"."

msgctxt "DNSSEC:DS10_ERR_MULT_NSEC"
msgid ""
"Multiple NSEC records when one is expected. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Plusieurs enregistrements NSEC alors qu'un seul est attendu. Information "
"retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_EXPECTED_NSEC_NSEC3_MISSING"
msgid ""
"The server responded with DNSKEY but not with expected NSEC or NSEC3. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Le serveur de noms répond avec DNSKEY mais pas avec le NSEC ou le NSEC3 "
"attendu. Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_HAS_NSEC"
msgid "The zone has NSEC records. Fetched from name servers \"{servers}\"."
msgstr ""
"La zone contient des enregistrements de type \"NSEC\". Information retournée "
"par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_HAS_NSEC3"
msgid "The zone has NSEC3 records. Fetched from name servers \"{servers}\"."
msgstr ""
"La zone contient des enregistrements de type \"NSEC3\". Information "
"retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_INCONSISTENT_NSEC"
msgid ""
"Inconsistent responses from zone with NSEC. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Réponses NSEC incohérentes pour la zone. Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_INCONSISTENT_NSEC3"
msgid ""
"Inconsistent responses from zone with NSEC3. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Réponses NSEC3 incohérentes pour la zone. Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_INCONSISTENT_NSEC_NSEC3"
msgid "The zone is inconsistent on NSEC and NSEC3. Fetched from name servers \"{servers}\"."
msgstr "Inconsistence au niveau des enregistrements de type NSEC et NSEC3. Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_MIXED_NSEC_NSEC3"
msgid ""
"The zone responds with both NSEC and NSEC3, where only one of them is "
"expected. Fetched from name servers \"{servers}\"."
msgstr ""
"La zone répond avec des enregistrements de types \"NSEC\" et \"NSEC3\", "
"alors qu'un seul des deux types est attendu. Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NONSTANDARD_NSEC_RESPONSE"
msgid ""
"NSEC query returned NSEC in the authority section instead of the answer "
"section (RFC 4470 / RFC 9824). Fetched from name servers \"{servers}\"."
msgstr ""
"La requête NSEC a renvoyé l'enregistrement NSEC dans la section "
"d'autorité au lieu de la section réponse (RFC 4470 / RFC 9824). "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3PARAM_GIVES_ERR_ANSWER"
msgid ""
"Unexpected DNS record in the answer section on an NSEC3PARAM query. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"Enregistrement DNS inattendu dans la section réponse d'une requête "
"NSEC3PARAM. Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3PARAM_MISMATCHES_APEX"
msgid ""
"The returned NSEC3PARAM record has an unexpected non-apex owner name. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"L'enregistrement NSEC3PARAM reçu a un nom de domaine qui ne correspond pas "
"au nom de la zone. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3PARAM_QUERY_RESPONSE_ERR"
msgid ""
"No response or error in response on query for NSEC3PARAM. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Aucune réponse ou réponse erronée pour une requête NSEC3PARAM. Information "
"retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_ERR_TYPE_LIST"
msgid ""
"NSEC3 record for the zone apex with incorrect type list. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"L'enregistrement NSEC3 pour le sommet de la zone contient une liste de types "
"incorrecte. Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_MISMATCHES_APEX"
msgid ""
"The returned NSEC3 record unexpectedly does not match the zone name. Fetched "
"from name servers \"{servers}\"."
msgstr ""
"L'enregistrement NSEC3 reçu ne correspond pas au nom de la zone. Information "
"retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_MISSING_SIGNATURE"
msgid ""
"Missing RRSIG (signature) for the NSEC3 record or records. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Enregistrements RRSIG (signatures) manquants pour les enregistrements NSEC3. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_NODATA_MISSING_SOA"
msgid ""
"Missing SOA record in NODATA response with NSEC3. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Enregistrement SOA manquant dans la réponse NODATA avec NSEC3. Information "
"retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_NODATA_WRONG_SOA"
msgid ""
"Wrong owner name (\"{domain}\") on SOA record in NODATA response with NSEC3. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Nom de domaine erroné (\"{domain}\") de l'enregistrement SOA dans la réponse "
"NODATA pour NSEC3. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_NO_VERIFIED_SIGNATURE"
msgid ""
"The RRSIG (signature) for the NSEC3 record cannot be verified. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"L'enregistrement RRSIG (signature) pour l'enregistrement de type \"NSEC3\" "
"ne peut pas être vérifié. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_EXPIRED"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC3 record has expired. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"L'enregistrement RRSIG (signature) avec le tag {keytag} couvrant les "
"enregistrements de type NSEC3 a expiré. Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_NOT_YET_VALID"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC3 record it not yet "
"valid. Fetched from name servers \"{servers}\"."
msgstr ""
"L'enregistrement RRSIG (signature) avec le tag {keytag} pour "
"l'enregistrement NSEC3 n'est pas encore valable. Information retournée par "
"les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_NO_DNSKEY"
msgid ""
"There is no DNSKEY record matching the RRSIG (signature) with tag {keytag} "
"for the NSEC3 record. Fetched from name servers \"{servers}\"."
msgstr ""
"Il n'y a pas d'enregistement DNSKEY qui correspond au RRSIG (signature) avec "
"le tag {keytag} pour l'enregistrement NSEC3. Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC3_RRSIG_VERIFY_ERROR"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC3 record cannot be "
"verified. Fetched from name servers \"{servers}\"."
msgstr ""
"L'enregistrement RRSIG (signature) avec le tag {keytag} pour "
"l'enregistrement NSEC3 ne peut pas être vérifié. Information retournée par "
"les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_ERR_TYPE_LIST"
msgid ""
"NSEC record for the zone apex with incorrect type list. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Enregistrement NSEC pour le sommet de la zone contenant une liste de types "
"incorrecte. Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_GIVES_ERR_ANSWER"
msgid ""
"Unexpected DNS record in the answer section on an NSEC query. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"Enregistrement DNS inattendu dans la section réponse d'une requête NSEC. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_MISMATCHES_APEX"
msgid ""
"The returned NSEC record has an unexpected non-apex owner name. Fetched from "
"name servers \"{servers}\"."
msgstr ""
"L'enregistrement NSEC reçu ne coïncide pas avec le nom de la zone. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_MISSING_SIGNATURE"
msgid ""
"Missing RRSIG (signature) for the NSEC record or records. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Enregistrements RRSIG (signatures) manquants pour les enregistrements NSEC. "
"Information retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_NODATA_MISSING_SOA"
msgid ""
"Missing SOA record in NODATA response with NSEC. Fetched from name servers "
"\"{servers}\"."
msgstr ""
"Enregistrement SOA manquant dans la réponse NODATA avec NSEC. Information "
"retournée par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_NODATA_WRONG_SOA"
msgid ""
"Wrong owner name (\"{domain}\") on SOA record in NODATA response with NSEC. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Nom de domaine erroné (\"{domain}\") de l'enregistrement SOA dans la réponse "
"NODATA pour NSEC. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_NO_VERIFIED_SIGNATURE"
msgid ""
"There is no RRSIG (signature) for the NSEC record that can be verified. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Il n'y a pas d'enregistrement RRSIG (signature) pour l'enregistrement NSEC "
"qui peut être vérifié. Information retournée par les serveurs de noms "
"\"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_QUERY_RESPONSE_ERR"
msgid ""
"No response or error in response on query for NSEC. Fetched from name "
"servers \"{servers}\"."
msgstr ""
"Aucune réponse ou réponse erronée à une requête NSEC. Information retournée "
"par les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_EXPIRED"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC record has expired. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"L'enregistrement RRSIG (signature) avec le tag {keytag} couvrant les "
"enregistrements de type NSEC a expiré. Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_NOT_YET_VALID"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC record it not yet "
"valid. Fetched from name servers \"{servers}\"."
msgstr ""
"L'enregistrement RRSIG (signature) avec le tag {keytag} pour "
"l'enregistrement NSEC n'est pas encore valable. Information retournée par "
"les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_NO_DNSKEY"
msgid ""
"There is no DNSKEY record matching the RRSIG (signature) with tag {keytag} "
"for the NSEC record. Fetched from name servers \"{servers}\"."
msgstr ""
"Il n'y a pas d'enregistement DNSKEY qui correspond au RRSIG (signature) avec "
"le tag {keytag} pour l'enregistrement NSEC. Information retournée par les "
"serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_NSEC_RRSIG_VERIFY_ERROR"
msgid ""
"The RRSIG (signature) with tag {keytag} for the NSEC record cannot be "
"verified. Fetched from name servers \"{servers}\"."
msgstr ""
"L'enregistrement RRSIG (signature) avec le tag {keytag} pour "
"l'enregistrement NSEC ne peut pas être vérifié. Information retournée par "
"les serveurs de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_SERVER_NO_DNSSEC"
msgid ""
"The following name servers do not support DNSSEC or have not been properly "
"configured. Testing for NSEC and NSEC3 has been skipped on these servers. "
"Fetched from name servers \"{servers}\"."
msgstr ""
"Les serveurs de noms suivants ne supportent pas DNSSEC ou n'ont pas été "
"configurés correctement. Les tests de NSEC et de NSEC3 n'ont pas été "
"effectués sur ces serveurs de noms. Information retournée par les serveurs "
"de noms \"{servers}\"."

msgctxt "DNSSEC:DS10_ZONE_NO_DNSSEC"
msgid ""
"The zone is not DNSSEC signed or not properly DNSSEC signed. Testing for "
"NSEC and NSEC3 has been skipped. Fetched from name servers \"{servers}\"."
msgstr ""
"La zone n'est pas signée ou mal signée par DNSSEC. Les tests de NSEC et de "
"NSEC3 n'ont pas été effectués. Information retournée par les serveurs de "
"noms \"{servers}\"."

msgctxt "DNSSEC:DS11_INCONSISTENT_DS"
msgid "Parent name servers are inconsistent on the existence of DS."
msgstr ""
"Les serveurs de noms de la zone parente ne sont pas consistants quand à "
"l'existence d'un enregistrement de type \"DS\"."

msgctxt "DNSSEC:DS11_INCONSISTENT_SIGNED_ZONE"
msgid ""
"Name servers for the child zone are inconsistent on whether the zone is "
"signed or not."
msgstr ""
"Les serveurs de noms de la zone testée ne sont pas consistants ce qui "
"empêche de déterminer si elle est signée ou non."

msgctxt "DNSSEC:DS11_UNDETERMINED_DS"
msgid ""
"It cannot be determined if the parent zone has DS for the child zone or not."
msgstr ""
"Il n'est pas possible de déterminer si la zone parente contient ou pas des "
"enregistrements de type \"DS\" pour la zone testée."

msgctxt "DNSSEC:DS11_UNDETERMINED_SIGNED_ZONE"
msgid "It cannot be determined if the child zone is signed or not."
msgstr ""
"Il n'est pas possible de déterminer si la zone testée est signée ou non."

msgctxt "DNSSEC:DS11_PARENT_WITHOUT_DS"
msgid ""
"No DS record for the child zone found on parent nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Aucun enregistrement de type \"DS\" trouvé sur les serveurs de noms de la "
"zone parente ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS11_PARENT_WITH_DS"
msgid ""
"DS record for the child zone found on parent nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Enregistrement de type \"DS\" pour la zone testée trouvé sur les serveurs de "
"noms ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS11_NS_WITH_SIGNED_ZONE"
msgid ""
"Signed child zone found on nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Zone signée trouvée sur les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS11_NS_WITH_UNSIGNED_ZONE"
msgid ""
"Unsigned child zone found on nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Zone non signée trouvée sur les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS11_DS_BUT_UNSIGNED_ZONE"
msgid "The child zone is unsigned, but the parent zone has DS record."
msgstr ""
"La zone testée n'est pas signée mais la zone parente publie un "
"enregistrement de type \"DS\"."

msgctxt "DNSSEC:DS11_CONSISTENT_SIGNED"
msgid "Parent DS and child DNSKEY are consistent - the zone is signed."
msgstr "Le DS du parent et le DNSKEY de l'enfant sont cohérents - la zone est signée."

msgctxt "DNSSEC:DS11_NO_PARENT_DS"
msgid "No DS records found at the parent - the zone is unsigned from the parent view."
msgstr "Aucun enregistrement DS trouvé chez le parent - la zone n'est pas signée du point de vue du parent."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_DNSKEY"
msgid ""
"The DNSKEY RRset is not signed by algorithm {algo_num} ({algo_mnemo}) "
"present in the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"DNSKEY\" n'est pas signé en utilisant "
"l'algorithme {algo_num}/{algo_mnemo} pourtant utilisé par une des clés "
"(DNSKEY). Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_NS"
msgid ""
"The NS RRset is not signed by algorithm {algo_num} ({algo_mnemo}) present in "
"the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"NS\" n'est pas signé en utilisant "
"l'algorithme {algo_num}/{algo_mnemo} pourtant utilisé par une des clés "
"(DNSKEY). Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALGO_NOT_SIGNED_SOA"
msgid ""
"The SOA RRset is not signed by algorithm {algo_num} ({algo_mnemo}) present "
"in the DNSKEY RRset. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"SOA\" n'est pas signé en utilisant "
"l'algorithme {algo_num}/{algo_mnemo} pourtant utilisé par une des clés "
"(DNSKEY). Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS13_ALL_ALGOS_SIGNED"
msgid "All DNSKEY algorithms have RRSIG coverage in DNSKEY, SOA, and NS answers."
msgstr "Tous les algorithmes DNSKEY ont une couverture RRSIG dans les réponses DNSKEY, SOA et NS."

msgctxt "DNSSEC:DS15_CDS_NON_MUST_DIGEST"
msgid ""
"CDS records with non-mandatory digest types are found on nameservers that "
"resolve to IP addresses ({addresses}); parents ignore them."
msgstr ""
"Les serveurs de noms ayant une des adresses IP suivantes \"{addresses}\" "
"publient des enregistrements CDS dont le type de condensé n'est pas "
"obligatoire ; les zones parentes les ignorent."

msgctxt "DNSSEC:DS15_HAS_CDNSKEY_NO_CDS"
msgid ""
"CDNSKEY RRset is found on nameservers that resolve to IP addresses "
"({addresses}), but no CDS RRset."
msgstr ""
"Les serveurs de noms ayant une des adresses IP suivantes \"{addresses}\" "
"retournent un ensemble d'enregistrements de type \"CDNSKEY\" mais aucun "
"enregistrement de type \"CDS\"."

msgctxt "DNSSEC:DS15_HAS_CDS_AND_CDNSKEY"
msgid ""
"CDNSKEY and CDS RRsets are found on nameservers that resolve to IP addresses "
"({addresses})."
msgstr ""
"Les serveurs de noms ayant une des adresses IP suivantes \"{addresses}\" "
"retournent un ensemble d'enregistrements de type \"CDNSKEY\" et de type "
"\"CDS\"."

msgctxt "DNSSEC:DS15_HAS_CDS_NO_CDNSKEY"
msgid ""
"CDS RRset is found on nameservers that resolve to IP addresses "
"({addresses}), but no CDNSKEY RRset."
msgstr ""
"Les serveurs de noms ayant une des adresses IP suivantes \"{addresses}\" "
"retournent un ensemble d'enregistrements de type \"CDS\" mais aucun "
"enregistrement de type \"CDNSKEY\"."

msgctxt "DNSSEC:DS15_INCONSISTENT_CDNSKEY"
msgid "All servers do not have the same CDNSKEY RRset."
msgstr ""
"Tous les serveurs de noms n'ont pas le même ensemble d'enregistrements de "
"type \"CDNSKEY\"."

msgctxt "DNSSEC:DS15_INCONSISTENT_CDS"
msgid "All servers do not have the same CDS RRset."
msgstr ""
"Tous les serveurs de noms n'ont pas le même ensemble d'enregistrements de "
"type \"CDS\"."

msgctxt "DNSSEC:DS15_MISMATCH_CDS_CDNSKEY"
msgid ""
"Both CDS and CDNSKEY RRsets are found on nameservers that resolve to IP "
"addresses ({addresses}) but they do not match."
msgstr ""
"Les serveurs de noms ayant une des adresses IP suivantes \"{addresses}\" "
"retournent un ensemble d'enregistrements de type \"CDNSKEY\" et de type "
"\"CDS\" mais ceux-ci ne correspondent pas."

msgctxt "DNSSEC:DS15_NO_CDS_CDNSKEY"
msgid "No CDS or CDNSKEY RRsets are found on any name server."
msgstr ""
"Aucun des serveurs de noms ne retourne d'enregistrements de type \"CDNSKEY\" "
"ou de type \"CDS\"."

msgctxt "DNSSEC:DS16_CDS_INVALID_RRSIG"
msgid ""
"The CDS RRset is signed with an RRSIG with tag {keytag}, but the RRSIG does "
"not match the DNSKEY with the same key tag. Fetched from the nameservers "
"with IP addresses \"{addresses}\"."
msgstr ""
"La signature de l'ensemble d'enregistrements de type \"CDS\" a pour tag "
"{keytag}, mais cette signature (RRSIG) ne correspond pas à la clé (DNSKEY) "
"ayant ce tag. Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NON_SEP_DNSKEY"
msgid ""
"The CDS record with tag {keytag} matches a DNSKEY record with SEP bit (bit "
"15) unset. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"L'enregistrement de type \"CDS\" avec le tag {keytag} correspond à un "
"enregistrement de type \"DNSKEY\" qui n'a pas le bit SEP positionné (bit "
"15). Information retournée par les serveurs de noms ayant une des adresses "
"IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NON_ZONE_DNSKEY"
msgid ""
"The CDS record with tag {keytag} matches a DNSKEY record with zone bit (bit "
"7) unset. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"L'enregistrement de type \"CDS\" avec le tag {keytag} correspond à un "
"enregistrement de type \"DNSKEY\" qui n'a pas le bit ZONE positionné (bit "
"7). Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_MATCHES_NO_DNSKEY"
msgid ""
"The CDS record with tag {keytag} does not match any DNSKEY record. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"L'enregistrement de type \"CDS\" avec le tag {keytag} ne correspond à aucun "
"enregistrement de type \"DNSKEY\". Information retournée par les serveurs de "
"noms ayant une des adresses IP suivantes ({addresses})."

msgctxt "DNSSEC:DS16_CDS_NOT_SIGNED_BY_CDS"
msgid ""
"The CDS RRset is not signed by the DNSKEY that the CDS record with tag "
"{keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"CDS\" n'est pas signé par la clé "
"(DNSKEY) correspondant au tag {keytag} de l'enregistrement de type \"CDS\". "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS16_CDS_SIGNED_BY_UNKNOWN_DNSKEY"
msgid ""
"The CDS RRset is signed by RRSIG with tag {keytag} but that is not in the "
"DNSKEY RRset. Fetched from the nameservers with P addresses \"{addresses}\"."
msgstr ""
"La signature de l'ensemble d'enregistrements de type \"CDS\" a pour tag "
"{keytag} mais cela ne correspond pas à une clé (DNSKEY) existante. "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes ({addresses})."

msgctxt "DNSSEC:DS16_CDS_UNSIGNED"
msgid ""
"The CDS RRset is not signed. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"CDS\" n'est pas signé. Information "
"retournée par les serveurs de noms ayant une des adresses IP suivantes "
"\"({addresses}\"."

msgctxt "DNSSEC:DS16_CDS_WITHOUT_DNSKEY"
msgid ""
"A CDS RRset exists, but no DNSKEY record exists. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Il existe un ensemble d'enregistrements de type \"CDS\" mais aucun "
"enregistrement de type \"DNSKEY\". Information retournée par les serveurs de "
"noms ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS16_DELETE_CDS"
msgid ""
"A single \"delete\" CDS record is found on the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"Un unique enregistrement de type \"delete CDS\" a été retourné par les "
"serveurs de noms ayant une des adresses IP suivantes ({addresses})."

msgctxt "DNSSEC:DS16_DNSKEY_NOT_SIGNED_BY_CDS"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY that the CDS record with tag "
"{keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"DNSKEY\" n'est pas signé par la clé "
"(DNSKEY) correspondant au tag {keytag} de l'enregistrement de type \"CDS\". "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS16_MIXED_DELETE_CDS"
msgid ""
"The CDS RRset is a mixture between \"delete\" record and other records. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Lorsqu'il est présent, l'enregistrement de type \"delete CDS\" ne peut pas "
"être combiné avec d'autres enregistrements de type \"CDS\". Information "
"retournée par les serveurs de noms ayant une des adresses IP suivantes "
"\"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_INVALID_RRSIG"
msgid ""
"The CDNSKEY RRset is signed with an RRSIG with tag {keytag}, but the RRSIG "
"does not match the DNSKEY with the same key tag. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"La signature de l'ensemble d'enregistrements de type \"CDNSKEY\" a pour tag "
"{keytag}, mais cette signature (RRSIG) ne correspond pas à la clé (DNSKEY) "
"ayant ce tag. Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_IS_NON_SEP"
msgid ""
"The CDNSKEY record with tag {keytag} has the SEP bit (bit 15) unset. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"L'enregistrement de type \"CDNSKEY\" avec le tag {keytag} n'a pas le bit SEP "
"positionné (bit 15). Information retournée par les serveurs de noms ayant "
"une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_IS_NON_ZONE"
msgid ""
"The CDNSKEY record with tag {keytag} has the zone bit (bit 7) unset. Fetched "
"from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"L'enregistrement de type \"CDNSKEY\" avec le tag {keytag} n'a pas le bit "
"ZONE positionné (bit 7). Information retournée par les serveurs de noms "
"ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_MATCHES_NO_DNSKEY"
msgid ""
"The CDNSKEY record with tag {keytag} does not match any DNSKEY record. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"L'enregistrement de type \"CDNSKEY\" avec le tag {keytag} ne correspond à "
"aucun enregistrement de type \"DNSKEY\". Information retournée par les "
"serveurs de noms ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_NOT_SIGNED_BY_CDNSKEY"
msgid ""
"The CDNSKEY RRset is not signed by the DNSKEY that the CDNSKEY record with "
"tag {keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"CDNSKEY\" n'est pas signé par la clé "
"(DNSKEY) correspondant au tag {keytag} de l'enregistrement de type "
"\"CDNSKEY\". Information retournée par les serveurs de noms ayant une des "
"adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_SIGNED_BY_UNKNOWN_DNSKEY"
msgid ""
"The CDNSKEY RRset is signed by RRSIG with tag {keytag} but that is not in "
"the DNSKEY RRset. Fetched from the nameservers with P addresses "
"\"{addresses}\"."
msgstr ""
"La signature de l'ensemble d'enregistrements de type \"CDNSKEY\" a pour tag "
"{keytag} mais cela ne correspond pas à une clé (DNSKEY) existante. "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_UNSIGNED"
msgid ""
"The CDNSKEY RRset is not signed. Fetched from the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"CDNSKEY\" n'est pas signé. "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS17_CDNSKEY_WITHOUT_DNSKEY"
msgid ""
"A CDNSKEY RRset exists, but no DNSKEY record exists. Fetched from the "
"nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Il existe un ensemble d'enregistrements de type \"CDNSKEY\" mais aucun "
"enregistrement de type \"DNSKEY\". Information retournée par les serveurs de "
"noms ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS17_DELETE_CDNSKEY"
msgid ""
"A single \"delete\" CDNSKEY record is found on the nameservers with IP "
"addresses \"{addresses}\"."
msgstr ""
"Un unique enregistrement CDNSKEY de type \"delete\" a été retourné par les "
"serveurs de noms ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS17_DNSKEY_NOT_SIGNED_BY_CDNSKEY"
msgid ""
"The DNSKEY RRset is not signed by the DNSKEY that the CDNSKEY record with "
"tag {keytag} points to. Fetched from the nameservers with IP addresses "
"\"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"DNSKEY\" n'est pas signé par la clé "
"correspondant au tag {keytag} de l'enregistrement de type \"CDNSKEY\". "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS17_MIXED_DELETE_CDNSKEY"
msgid ""
"The CDNSKEY RRset is a mixture between \"delete\" record and other records. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"Le jeu d'enregistrements CDNSKEY même un enregistrement de type \"delete\" "
"et d'autres enregistrements. Information retournée par les serveurs de noms "
"ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS18_NO_MATCH_CDS_RRSIG_DS"
msgid ""
"The CDS RRset is not signed with a DNSKEY record that a DS record points to. "
"Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"CDS\" n'est pas signé par une clé "
"(DNSKEY) correspondant au tag de l'enregistrement de type \"DS\". "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS18_NO_MATCH_CDNSKEY_RRSIG_DS"
msgid ""
"The CDNSKEY RRset is not signed with a DNSKEY record that a DS record points "
"to. Fetched from the nameservers with IP addresses \"{addresses}\"."
msgstr ""
"L'ensemble d'enregistrements de type \"CDNSKEY\" n'est pas signé par une clé "
"(DNSKEY) correspondant au tag de l'enregistrement de type \"DS\". "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "DNSSEC:DS18_MATCH_CDNSKEY_RRSIG_DS"
msgid ""
"The CDNSKEY RRset is signed by a DS-linked DNSKEY. Found at the nameservers "
"with IP addresses \"{addresses}\"."
msgstr "Le jeu d'enregistrements CDNSKEY est signé par un DNSKEY lié à un DS. Trouvé sur les serveurs de noms avec les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS18_MATCH_CDS_RRSIG_DS"
msgid ""
"The CDS RRset is signed by a DS-linked DNSKEY. Found at the nameservers "
"with IP addresses \"{addresses}\"."
msgstr "Le jeu d'enregistrements CDS est signé par un DNSKEY lié à un DS. Trouvé sur les serveurs de noms avec les adresses IP \"{addresses}\"."


msgctxt "DNSSEC:DS18_CDS_MATCHES_DS"
msgid "The CDS RRset content matches the parent DS RRset. No key change signaled."
msgstr "Le contenu du jeu d'enregistrements CDS correspond au jeu d'enregistrements DS du parent. Aucun changement de clé n'est signalé."

msgctxt "DNSSEC:DS18_CDS_ROLLOVER_SIGNALED"
msgid "The CDS RRset content differs from the parent DS RRset, signaling a key change. CDS keytags: {cds_keytags}. DS keytags: {ds_keytags}."
msgstr "Le contenu du jeu d'enregistrements CDS diffère du jeu d'enregistrements DS du parent, ce qui signale un changement de clé. Keytags CDS : {cds_keytags}. Keytags DS : {ds_keytags}."

msgctxt "DNSSEC:DS18_CDNSKEY_MATCHES_DS"
msgid "The CDNSKEY RRset content matches the parent DS RRset. No key change signaled."
msgstr "Le contenu du jeu d'enregistrements CDNSKEY correspond au jeu d'enregistrements DS du parent. Aucun changement de clé n'est signalé."

msgctxt "DNSSEC:DS18_CDNSKEY_ROLLOVER_SIGNALED"
msgid "The CDNSKEY RRset content differs from the parent DS RRset, signaling a key change. CDNSKEY keytags: {cdnskey_keytags}. DS keytags: {ds_keytags}."
msgstr "Le contenu du jeu d'enregistrements CDNSKEY diffère du jeu d'enregistrements DS du parent, ce qui signale un changement de clé. Keytags CDNSKEY : {cdnskey_keytags}. Keytags DS : {ds_keytags}."

msgctxt "DNSSEC:DS18_NO_CDS_CDNSKEY_BUT_ROLLOVER_EVIDENCE"
msgid "No CDS or CDNSKEY RRset found, but other rollover evidence is present. The operator likely uses on-demand CDS/CDNSKEY publication."
msgstr "Aucun jeu d'enregistrements CDS ou CDNSKEY n'a été trouvé, mais d'autres indices de rollover sont présents. L'opérateur utilise probablement la publication CDS/CDNSKEY à la demande."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_DOUBLE_SIG"
msgid "The DNSKEY RRset is signed by more than one KSK keytag ({keytags}). A double-signature rollover phase may be in progress."
msgstr "Le jeu d'enregistrements DNSKEY est signé par plusieurs keytags KSK ({keytags}). Une phase de rollover à double signature peut être en cours."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_DNSKEY_WITHOUT_DS"
msgid "Child SEP DNSKEY keytag(s) {keytags} have no matching DS record at the parent. A new KSK may be waiting for the parent DS to be updated."
msgstr "Les keytags SEP DNSKEY {keytags} de la zone enfant n'ont pas d'enregistrement DS correspondant chez le parent. Une nouvelle KSK attend peut-être la mise à jour du DS parent."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_DS_WITHOUT_DNSKEY"
msgid "Parent DS keytag(s) {keytags} have no matching DNSKEY at the child. The old KSK may have been removed from the child zone."
msgstr "Les keytags DS {keytags} du parent n'ont pas de DNSKEY correspondante dans la zone enfant. L'ancienne KSK a peut-être été retirée de la zone enfant."

msgctxt "DNSSEC:DS18_ROLLOVER_EVIDENCE_MULTI_KSK"
msgid "Multiple SEP-flagged DNSKEYs found at the child zone (keytags: {keytags}). A KSK rollover may be in progress."
msgstr "Plusieurs DNSKEY avec le bit SEP positionné ont été trouvées dans la zone enfant (keytags : {keytags}). Un rollover de KSK peut être en cours."

msgctxt "DNSSEC:DS19_BADKEY_BLOCKLIST"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) matches "
"known compromised key in blocklist \"{blocklist_name}\" on name server(s) "
"{servers}."
msgstr "La DNSKEY avec keytag {keytag} et algorithme {algo_descr} ({algo_num}) correspond à une clé compromise connue dans la liste de blocage \"{blocklist_name}\" sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS19_BADKEY_FERMAT"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"key vulnerable to Fermat factorization on name server(s) {servers}."
msgstr "La DNSKEY avec keytag {keytag} et algorithme {algo_descr} ({algo_num}) a une clé RSA vulnérable à la factorisation de Fermat sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS19_BADKEY_PATTERN"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus with repeating byte pattern on name server(s) {servers}."
msgstr "La DNSKEY avec keytag {keytag} et algorithme {algo_descr} ({algo_num}) a un module RSA avec un motif d'octets répétitif suspect sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS19_BADKEY_ROCA"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"key vulnerable to ROCA (CVE-2017-15361) on name server(s) {servers}."
msgstr "La DNSKEY avec keytag {keytag} et algorithme {algo_descr} ({algo_num}) a une clé RSA vulnérable à ROCA (CVE-2017-15361) sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS19_BADKEY_RSA_INVALID"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has "
"invalid RSA public key parameters on name server(s) {servers}."
msgstr "La DNSKEY avec keytag {keytag} et algorithme {algo_descr} ({algo_num}) a des paramètres de clé publique RSA invalides sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS19_BADKEY_SMALL_D"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"key with small private exponent (Wiener attack) on name server(s) {servers}."
msgstr "La DNSKEY avec keytag {keytag} et algorithme {algo_descr} ({algo_num}) a une clé RSA avec un petit exposant privé (attaque de Wiener) sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS19_BADKEY_SMALL_FACTORS"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) has RSA "
"modulus with small prime factors on name server(s) {servers}."
msgstr "La DNSKEY avec keytag {keytag} et algorithme {algo_descr} ({algo_num}) a un module RSA avec de petits facteurs premiers sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS19_BLOCKLIST_NOT_FOUND"
msgid ""
"Badkeys blocklist data not found. Blocklist check skipped. Run 'gonemaster "
"--badkeys-update' to download the blocklist."
msgstr ""
"Données de la liste de blocage badkeys introuvables. Vérification de la "
"liste de blocage ignorée. Exécutez 'gonemaster --badkeys-update' pour "
"télécharger la liste de blocage."

msgctxt "DNSSEC:DS19_KEY_OK"
msgid ""
"DNSKEY with keytag {keytag} and algorithm {algo_descr} ({algo_num}) on name "
"server(s) {servers} passed all badkeys checks."
msgstr "La DNSKEY avec keytag {keytag} et algorithme {algo_descr} ({algo_num}) sur le(s) serveur(s) de noms {servers} a réussi toutes les vérifications badkeys."

msgctxt "DNSSEC:DS19_NO_DNSKEY"
msgid "No DNSKEY records found at zone apex on name server(s) {servers}."
msgstr "Aucun enregistrement DNSKEY trouvé au sommet de la zone sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS19_NO_RESPONSE"
msgid ""
"No usable response from name server(s) {servers} when querying for DNSKEY "
"records."
msgstr "Aucune réponse exploitable du/des serveur(s) de noms {servers} lors de la requête des enregistrements DNSKEY."


msgctxt "DNSSEC:DS20_BITMAP_OK"
msgid "NSEC/NSEC3 type bitmap at the zone apex correctly includes all observed RR types on name server(s) {servers}."
msgstr "Le bitmap de types NSEC/NSEC3 à l'apex de la zone inclut correctement tous les types RR observés sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS20_NO_BITMAP"
msgid "No NSEC or NSEC3 type bitmap could be obtained for the zone apex on name server(s) {servers}."
msgstr "Aucun bitmap de types NSEC ou NSEC3 n'a pu être obtenu pour l'apex de la zone sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS20_NO_DNSSEC"
msgid "No nameserver returned a usable DNSKEY; NSEC/NSEC3 bitmap check skipped on name server(s) {servers}."
msgstr "Aucun serveur de noms n'a retourné de DNSKEY utilisable ; vérification du bitmap NSEC/NSEC3 ignorée sur le(s) serveur(s) de noms {servers}."

msgctxt "DNSSEC:DS20_NSEC3_BITMAP_MISMATCHES_RRTYPE"
msgid "RR type {query_type} exists at the zone apex but is missing from the NSEC3 type bitmap on name server(s) {servers}. This enables cache poisoning via RFC 8198 aggressive negative caching."
msgstr "Le type RR {query_type} existe à l'apex de la zone mais est absent du bitmap de types NSEC3 sur le(s) serveur(s) de noms {servers}. Cela permet l'empoisonnement du cache via la mise en cache négative agressive de la RFC 8198."

msgctxt "DNSSEC:DS20_NSEC_BITMAP_MISMATCHES_RRTYPE"
msgid "RR type {query_type} exists at the zone apex but is missing from the NSEC type bitmap on name server(s) {servers}. This enables cache poisoning via RFC 8198 aggressive negative caching."
msgstr "Le type RR {query_type} existe à l'apex de la zone mais est absent du bitmap de types NSEC sur le(s) serveur(s) de noms {servers}. Cela permet l'empoisonnement du cache via la mise en cache négative agressive de la RFC 8198."
msgctxt "DNSSEC:DS21_ALGO_NOT_SUPPORTED"
msgid "Parent DS RRSIG with keytag {keytag} uses unsupported algorithm {algo_num} ({algo_mnemo}); skipping verification on parent name server(s) {addresses}."
msgstr "La signature (RRSIG) de la zone parente couvrant l'enregistrement DS avec le tag {keytag} utilise un algorithme non pris en charge {algo_num} ({algo_mnemo}). La validation a été ignorée sur les serveurs de noms de la zone parente ayant les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_DS_RRSIG_EXPIRED"
msgid "Parent DS RRSIG with keytag {keytag} has expired on parent name server(s) {addresses}."
msgstr "La signature (RRSIG) de la zone parente couvrant l'enregistrement DS avec le tag {keytag} a expiré sur les serveurs de noms de la zone parente ayant les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_DS_RRSIG_NOT_VALID_BY_DNSKEY"
msgid "Parent DS RRSIG with keytag {keytag} cannot be verified by any matching parent DNSKEY on parent name server(s) {addresses}."
msgstr "La signature (RRSIG) de la zone parente couvrant l'enregistrement DS avec le tag {keytag} n'a pas pu être validée par aucune clé DNSKEY correspondante de la zone parente sur les serveurs de noms de la zone parente ayant les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_DS_RRSIG_NOT_VERIFIABLE"
msgid "Parent returned a signed DS RRset, but no covering RRSIG could be verified against the parent DNSKEY on parent name server(s) {addresses}. Validating resolvers will fail to resolve the child zone."
msgstr "La zone parente a retourné un jeu d'enregistrements DS signé, mais aucune signature (RRSIG) couvrante n'a pu être validée par la DNSKEY de la zone parente sur les serveurs de noms de la zone parente ayant les adresses IP \"{addresses}\". Les résolveurs validants ne pourront pas résoudre la zone fille."

msgctxt "DNSSEC:DS21_DS_RRSIG_NOT_YET_VALID"
msgid "Parent DS RRSIG with keytag {keytag} has an inception time in the future on parent name server(s) {addresses}."
msgstr "La signature (RRSIG) de la zone parente couvrant l'enregistrement DS avec le tag {keytag} a une date de mise en service dans le futur sur les serveurs de noms de la zone parente ayant les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_DS_RRSIG_VERIFIED"
msgid "Parent DS RRset is correctly signed and verifies against the parent DNSKEY on parent name server(s) {addresses}."
msgstr "Le jeu d'enregistrements DS de la zone parente est correctement signé et est validé par la DNSKEY de la zone parente sur les serveurs de noms de la zone parente ayant les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_NO_DNSKEY_FOR_DS_RRSIG"
msgid "Parent DS RRSIG references DNSKEY keytag {keytag}, but no matching DNSKEY is published at the parent apex on parent name server(s) {addresses}."
msgstr "La signature (RRSIG) de la zone parente couvrant l'enregistrement DS référence une DNSKEY avec le tag {keytag}, mais aucune DNSKEY correspondante n'est publiée à l'apex de la zone parente sur les serveurs de noms de la zone parente ayant les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_NO_DS_RRSIG"
msgid "Parent returned the DS RRset without any covering RRSIG on parent name server(s) {addresses}."
msgstr "La zone parente a retourné le jeu d'enregistrements DS sans aucune signature (RRSIG) couvrante sur les serveurs de noms de la zone parente ayant les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DS21_NO_PARENT_ZONE"
msgid "No parent zone is available; DNSSEC21 cannot run."
msgstr "Aucune zone parente n'est disponible. Le test DNSSEC21 ne peut pas être exécuté."

msgctxt "DNSSEC:DS21_PARENT_DNSKEY_MISSING"
msgid "Parent did not return an authoritative DNSKEY response, so DS RRSIG verification was skipped on parent name server(s) {addresses}."
msgstr "La zone parente n'a pas retourné de réponse DNSKEY autoritative ; la validation de la signature (RRSIG) couvrant l'enregistrement DS a été ignorée sur les serveurs de noms de la zone parente ayant les adresses IP \"{addresses}\"."

msgctxt "DNSSEC:DURATION_LONG"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a duration of "
"{duration} seconds, which is too long."
msgstr ""
"La signature (RRSIG) avec la clé de tag {keytag} et couvrant les "
"enregistrements de type(s) \"{types}\" a une durée de {duration} secondes, "
"ce qui est trop long."

msgctxt "DNSSEC:DURATION_OK"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a duration of "
"{duration} seconds, which is just fine."
msgstr ""
"La signature (RRSIG) avec la clé de tag {keytag} et couvrant les "
"enregistrements de type(s) \"{types}\" a une durée de {duration} secondes, "
"ce qui est raisonnable."

msgctxt "DNSSEC:EXTRA_PROCESSING_BROKEN"
msgid ""
"Server at {address} sent {keys} DNSKEY records, and {sigs} RRSIG records."
msgstr ""
"Le serveur de noms {address} retourne des clés (DNSKEY) {keys}, et les "
"signatures (RRSIG) {sigs}."

msgctxt "DNSSEC:EXTRA_PROCESSING_OK"
msgid "Server at {address} sent {keys} DNSKEY records and {sigs} RRSIG records."
msgstr ""
"Le serveur de noms {address} retourne des clés (DNSKEY) {keys} et les "
"signatures (RRSIG) {sigs}."

msgctxt "DNSSEC:KEY_SIZE_OK"
msgid "All keys from the DNSKEY RRset have the correct size."
msgstr "Toutes les clés de l'apex (DNSKEY RRset) ont une taille correcte."

msgctxt "DNSSEC:NO_RESPONSE_DNSKEY"
msgid "Nameserver {ns}/{address} responded with no DNSKEY record(s)."
msgstr ""
"Le serveur de noms {ns}/{address} répond mais ne renvoie aucun enregistrement de type "
"\"DNSKEY\"."

msgctxt "DNSSEC:REMAINING_LONG"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a remaining "
"validity of {duration} seconds, which is too long."
msgstr ""
"La signature (RRSIG) avec la clé de tag {keytag} et couvrant les "
"enregistrements de type(s) \"{types}\" a une durée de validitée restante de "
"{duration} secondes, ce qui est trop long."

msgctxt "DNSSEC:REMAINING_SHORT"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has a remaining "
"validity of {duration} seconds, which is too short."
msgstr ""
"La signature (RRSIG) avec la clé de tag {keytag} et couvrant les "
"enregistrements de type(s) \"{types}\" a une durée de validitée restante de "
"{duration} secondes, ce qui est trop court."

msgctxt "DNSSEC:RRSIG_EXPIRATION"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} expires at : {date}."
msgstr ""
"La signature (RRSIG) avec la champ keytag {keytag} et couvrant les "
"enregistrements de type(s) \"{types}\" expire à la date suivante : {date}."

msgctxt "DNSSEC:RRSIG_EXPIRED"
msgid ""
"RRSIG with keytag {keytag} and covering type(s) {types} has already expired "
"(expiration is: {expiration})."
msgstr ""
"La signature (RRSIG) avec la champ keytag {keytag} et couvrant les "
"enregistrements de type(s) \"{types}\" a expiré (date d'expiration: "
"{expiration})."

msgctxt "DELEGATION:ARE_AUTHORITATIVE"
msgid ""
"All these nameservers are confirmed to be authoritative : {servers}."
msgstr ""
"Ces serveurs de noms ont pu être vérifiés comme faisant autorité : "
"{servers}."

msgctxt "DELEGATION:CHILD_DISTINCT_NS_IP"
msgid "All the IP addresses used by the nameservers in child are unique."
msgstr ""
"Sur les serveurs de noms de la zone, toutes les adresses IP utilisées par "
"les serveurs de noms sont uniques."

# perl-brace-format
msgctxt "DELEGATION:CHILD_NS_SAME_IP"
msgid "IP {address} in child refers to multiple nameservers ({servers})."
msgstr ""
"L'adresse IP {address} retournée par les serveurs de noms de la zone fait "
"référence à plusieurs serveurs de noms ({servers})."

msgctxt "DELEGATION:DEL_DISTINCT_NS_IP"
msgid "All the IP addresses used by the nameservers in parent are unique."
msgstr ""
"Sur les serveurs de noms de la zone parente, toutes les adresses IP "
"utilisées par les serveurs de noms sont uniques."

msgctxt "DELEGATION:DEL_NS_SAME_IP"
msgid "IP {address} in parent refers to multiple nameservers ({servers})."
msgstr ""
"L'adresse IP {address} retournée par les serveurs de noms de la zone parente "
"fait référence à plusieurs serveurs de noms ({servers})."

msgctxt "DELEGATION:DISTINCT_IP_ADDRESS"
msgid "All the IP addresses used by the nameservers are unique."
msgstr ""
"Toutes les adresses IP utilisées par les serveurs de noms sont uniques."

msgctxt "DELEGATION:ENOUGH_IPV4_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers that resolve to IPv4 addresses. "
"Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone retournent suffisamment de serveurs "
"({count}) faisant autorité ayant une adresse IPv4. La limite inférieure "
"étant fixée à {minimum}. Serveurs de noms : {servers}"

msgctxt "DELEGATION:ENOUGH_IPV4_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers that resolve to IPv4 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone parente retournent suffisamment de serveurs "
"({count}) faisant autorité ayant une adresse IPv4. La limite inférieure "
"étant fixée à {minimum}. Serveurs de noms : {servers}"

msgctxt "DELEGATION:ENOUGH_IPV6_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers that resolve to IPv6 addresses. "
"Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone retournent suffisamment de serveurs "
"({count}) faisant autorité ayant une adresse IPv6. La limite inférieure "
"étant fixée à {minimum}. Serveurs de noms : {servers}"

msgctxt "DELEGATION:ENOUGH_IPV6_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers that resolve to IPv6 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone parente retournent suffisamment de serveurs "
"({count}) faisant autorité ayant une adresse IPv6. La limite inférieure "
"étant fixée à {minimum}. Serveurs de noms : {servers}"

msgctxt "DELEGATION:ENOUGH_NS_CHILD"
msgid ""
"Child lists enough ({count}) nameservers. Lower limit set to {minimum}. Name "
"servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone retournent suffisamment de serveurs "
"({count}) faisant autorité. La limite inférieure étant fixée à {minimum}. "
"Serveurs de noms : {servers}"

msgctxt "DELEGATION:ENOUGH_NS_DEL"
msgid ""
"Delegation lists enough ({count}) nameservers. Lower limit set to {minimum}. "
"Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone parente retournent suffisamment de serveurs "
"({count}) faisant autorité. La limite inférieure étant fixée à {minimum}. "
"Serveurs de noms : {servers}"

msgctxt "DELEGATION:EXTRA_NAME_CHILD"
msgid "Child has nameserver(s) not listed at parent ({extra})."
msgstr ""
"Les serveurs de noms de la zone retournent des serveurs faisant autorité "
"({extra}) qui ne le sont pas par les serveurs de noms de la zone parente."

msgctxt "DELEGATION:EXTRA_NAME_PARENT"
msgid "Parent has nameserver(s) not listed at the child ({extra})."
msgstr ""
"Les serveurs de noms de la zone parente retournent des serveurs faisant "
"autorité ({extra}) qui ne le sont pas par les serveurs de noms de la zone."

msgctxt "DELEGATION:IN_BAILIWICK_GLUE_MISSING"
msgid "In-bailiwick nameserver {ns} has no glue address record (A or AAAA) in the parent referral."
msgstr "Le serveur de noms \"in-bailiwick\" {ns} n'a aucun enregistrement de colle (A ou AAAA) dans la délégation de la zone parente."

msgctxt "DELEGATION:IS_NOT_AUTHORITATIVE"
msgid "Nameserver {ns}/{address} response is not authoritative on {proto} port 53."
msgstr ""
"La réponse du serveur de noms {ns}/{address} reçue sur le port 53/{proto} ne fait pas "
"autorité."

msgctxt "DELEGATION:NAMES_MATCH"
msgid "All of the nameserver names are listed both at parent and child."
msgstr ""
"Tous les serveurs de noms de la zone font partie de la liste des serveurs de "
"noms retournés par les serveurs de noms de la zone parente ainsi que par les "
"serveurs de noms de la zone elle-même."

msgctxt "DELEGATION:NO_RESPONSE"
msgid ""
"Nameserver {ns} did not respond to a query for name {query_name} and type "
"{query_type}."
msgstr ""
"Le serveur de noms {ns} n'a pas répondu à une requête pour le nom "
"{query_name} et type {query_type}."

msgctxt "DELEGATION:NOT_ENOUGH_IPV4_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers that resolve to IPv4 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone ne retournent pas assez de serveurs "
"({count}) faisant autorité ayant une adresse IPv4. La limite inférieure "
"étant fixée à {minimum}. Serveurs de noms : {servers}"

msgctxt "DELEGATION:NOT_ENOUGH_IPV4_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers that resolve to IPv4 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone parente ne retournent pas assez de serveurs "
"({count}) faisant autorité ayant une adresse IPv4. La limite inférieure "
"étant fixée à {minimum}. Serveurs de noms : {servers}"

msgctxt "DELEGATION:NOT_ENOUGH_IPV6_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers that resolve to IPv6 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone ne retournent pas assez de serveurs "
"({count}) faisant autorité ayant une adresse IPv6. La limite inférieure "
"étant fixée à {minimum}. Serveurs de noms : {servers}"

msgctxt "DELEGATION:NOT_ENOUGH_IPV6_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers that resolve to IPv6 "
"addresses. Lower limit set to {minimum}. Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone parente ne retournent pas assez de serveurs "
"({count}) faisant autorité ayant une adresse IPv6. La limite inférieure "
"étant fixée à {minimum}. Serveurs de noms : {servers}"

msgctxt "DELEGATION:NOT_ENOUGH_NS_CHILD"
msgid ""
"Child does not list enough ({count}) nameservers. Lower limit set to "
"{minimum}. Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone ne retournent pas assez de serveurs "
"({count}) faisant autorité. La limite inférieure étant fixée à {minimum}. "
"Serveurs de noms : {servers}"

msgctxt "DELEGATION:NOT_ENOUGH_NS_DEL"
msgid ""
"Delegation does not list enough ({count}) nameservers. Lower limit set to "
"{minimum}. Name servers: {servers}"
msgstr ""
"Les serveurs de noms de la zone parente ne retournent pas assez de serveurs "
"({count}) faisant autorité. La limite inférieure étant fixée à {minimum}. "
"Serveurs de noms : {servers}"

msgctxt "DELEGATION:NO_IPV4_NS_CHILD"
msgid ""
"Child lists no nameserver that resolves to an IPv4 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Les serveurs de noms de la zone ne retournent pas de serveurs ayant une "
"adresse IPv4. Si il y en avait, il en faudrait au minimum {minimum}."

msgctxt "DELEGATION:NO_IPV4_NS_DEL"
msgid ""
"Delegation lists no nameserver that resolves to an IPv4 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Les serveurs de noms de la zone parente ne retournent pas de serveurs ayant "
"une adresse IPv4. Si il y en avait, il en faudrait au minimum {minimum}."

msgctxt "DELEGATION:NO_IPV6_NS_CHILD"
msgid ""
"Child lists no nameserver that resolves to an IPv6 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Les serveurs de noms de la zone ne retournent pas de serveurs ayant une "
"adresse IPv6. Si il y en avait, il en faudrait au minimum {minimum}."

msgctxt "DELEGATION:NO_IPV6_NS_DEL"
msgid ""
"Delegation lists no nameserver that resolves to an IPv6 address. If any were "
"present, the minimum allowed would be {minimum}."
msgstr ""
"Les serveurs de noms de la zone parente ne retournent pas de serveurs ayant "
"une adresse IPv6. Si il y en avait, il en faudrait au minimum {minimum}."

msgctxt "DELEGATION:NS_IS_CNAME"
msgid "Nameserver {ns} RR points to CNAME."
msgstr ""
"L'enregistrement pour le serveur de noms {ns} pointe sur un alias "
"(CNAME)."

msgctxt "DELEGATION:NO_NS_CNAME"
msgid "No nameserver points to CNAME alias."
msgstr "Aucun serveur de noms ne pointe sur un alias (CNAME)."

msgctxt "DELEGATION:REFERRAL_SIZE_LARGE"
msgid ""
"The smallest possible legal referral packet is larger than 512 but within "
"1232 octets (it is {size}); it needs EDNS to be returned over UDP."
msgstr ""
"La plus petite taille d'un paquet légal contenant une référence (referral) "
"est supérieure à 512 mais ne dépasse pas 1232 octets (elle est de {size}); "
"elle nécessite EDNS pour être transmise sur UDP."

msgctxt "DELEGATION:REFERRAL_SIZE_TOO_LARGE"
msgid ""
"The smallest possible legal referral packet is larger than 512 octets (it is "
"{size})."
msgstr ""
"La plus petite taille d'un paquet légal contenant une référence (referral) "
"est supérieur à 512 octets (elle est de {size})."

msgctxt "DELEGATION:REFERRAL_SIZE_OK"
msgid ""
"The smallest possible legal referral packet is smaller than 513 octets (it "
"is {size})."
msgstr ""
"La plus petite taille d'un paquet légal contenant une référence (referral) "
"est inférieure à 513 octets (elle est de {size})."

msgctxt "DELEGATION:SAME_IP_ADDRESS"
msgid "IP {address} refers to multiple nameservers ({servers})."
msgstr ""
"L'adresse IP {address} fait référence à plusieurs serveurs de noms "
"({servers})."

msgctxt "DELEGATION:SOA_EXISTS"
msgid "All the nameservers have SOA record."
msgstr ""
"Tous les serveurs de noms retournent un enregistrement de type \"SOA\"."

msgctxt "DELEGATION:SOA_NOT_EXISTS"
msgid "Empty NOERROR response to SOA query was received from {ns}/{address}."
msgstr ""
"Une réponse à une requête pour un enregistrement de type \"SOA\" sur le "
"serveur de noms {ns}/{address} a été reçue vide alors que le code retour est "
"\"NOERROR\"."

msgctxt "DELEGATION:TOTAL_NAME_MISMATCH"
msgid "None of the nameservers listed at the parent are listed at the child."
msgstr ""
"La liste des serveurs de noms retournée par les serveurs de noms de la zone "
"parente et par ceux de la zone est complètement différente."

msgctxt "DELEGATION:UNEXPECTED_RCODE"
msgid ""
"Nameserver {ns} answered query for name {query_name} and type {query_type} with "
"RCODE {rcode}."
msgstr ""
"Le serveur de noms {ns} a répondu à une requête pour le nom {query_name} et "
"type {query_type} avec le RCODE {rcode}."

msgctxt "NAMESERVER:AAAA_BAD_RDATA"
msgid ""
"Nameserver {ns}/{address} answered AAAA query with an unexpected RDATA length "
"({length} instead of 16)."
msgstr ""
"Le serveur de noms {ns}/{address} a répondu à une requête de type \"AAAA\" avec un "
"code taille de champ RDATA inattendu ({length} au lieu de 16)."

msgctxt "NAMESERVER:AAAA_QUERY_DROPPED"
msgid "Nameserver {ns}/{address} dropped AAAA query."
msgstr ""
"Le serveur de noms {ns}/{address} ne répond pas aux requêtes portant sur le type "
"\"AAAA\"."

msgctxt "NAMESERVER:AAAA_UNEXPECTED_RCODE"
msgid "Nameserver {ns}/{address} answered AAAA query with an unexpected rcode ({rcode})."
msgstr ""
"Le serveur de noms {ns}/{address} a répondu à une requête de type \"AAAA\" avec un "
"code retour inattendu ({rcode})."

msgctxt "NAMESERVER:AAAA_WELL_PROCESSED"
msgid ""
"The following nameservers answer AAAA queries without problems : {servers}."
msgstr ""
"Les serveurs de noms suivants répondent correctement aux requêtes de type "
"\"AAAA\" : {servers}."

msgctxt "NAMESERVER:A_UNEXPECTED_RCODE"
msgid "Nameserver {ns}/{address} answered A query with an unexpected rcode ({rcode})."
msgstr ""
"Le serveur de noms {ns}/{address} a répondu à une requête de type \"AAAA\" avec un "
"code retour inattendu ({rcode})."

msgctxt "NAMESERVER:AXFR_AVAILABLE"
msgid "The following nameservers allow zone transfer using AXFR: {servers}."
msgstr "Il est possible de réaliser un transfert de zone depuis les serveurs de noms suivants : {servers}."

msgctxt "NAMESERVER:AXFR_FAILURE"
msgid "AXFR not available on the following nameservers: {servers}."
msgstr "Il n'est pas possible de réaliser un transfert de zone depuis les serveurs de noms suivants : {servers}."

msgctxt "NAMESERVER:BREAKS_ON_EDNS"
msgid "No response from {ns}/{address} when EDNS is used in query asking for {domain}."
msgstr ""
"Aucune réponse de {ns}/{address} sur le nom de domaine '{domain}' lorsque EDNS est "
"utilisé."

msgctxt "NAMESERVER:CAN_BE_RESOLVED"
msgid "All nameservers succeeded to resolve to an IP address."
msgstr ""
"Il a été possible de trouver au moins une adresse IP pour tous les serveurs "
"de noms."

msgctxt "NAMESERVER:CAN_NOT_BE_RESOLVED"
msgid ""
"The following nameservers failed to resolve to an IP address : {servers}."
msgstr ""
"Aucune adresse IP n'a pu être trouvée pour les serveurs de noms suivants : "
"{servers}."

msgctxt "NAMESERVER:CASE_QUERIES_RESULTS_DIFFER"
msgid ""
"When asked for {query_type} records on \"{domain}\" with different cases, all "
"servers do not reply consistently."
msgstr ""
"Lors d'une requête de type {query_type} pour la ressource \"{domain}\" avec des "
"casses différentes, tous les serveurs ne répondent pas de manière "
"consistante."

msgctxt "NAMESERVER:CASE_QUERIES_RESULTS_OK"
msgid ""
"When asked for {query_type} records on \"{domain}\" with different cases, all "
"servers reply consistently."
msgstr ""
"Lors d'une requête de type {query_type} pour la ressource \"{domain}\" avec des "
"casses différentes, tous les serveurs retournent les mêmes résultats."

msgctxt "NAMESERVER:CASE_QUERY_DIFFERENT_ANSWER"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns different answers."
msgstr ""
"Lors d'une requête de type {query_type} pour les ressources \"{query1}\" et "
"\"{query2}\", le serveur de noms {ns}/{address} ne répond pas la même chose."

msgctxt "NAMESERVER:CASE_QUERY_DIFFERENT_RC"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns different RCODE (\"{rcode1}\" vs \"{rcode2}\")."
msgstr ""
"Lors d'une requête de type {query_type} pour les ressources \"{query1}\" et "
"\"{query2}\", le serveur de noms {ns}/{address} ne renvoie pas le même code de retour "
"(\"{rcode1}\" vs \"{rcode2}\")."

msgctxt "NAMESERVER:CASE_QUERY_NO_ANSWER"
msgid ""
"When asked for {query_type} records on \"{domain}\", nameserver {ns}/{address} returns "
"nothing."
msgstr ""
"Lors d'une requête de type {query_type} pour la ressource\"{domain}\", le serveur "
"de noms {ns}/{address} ne répond pas."

msgctxt "NAMESERVER:CASE_QUERY_SAME_ANSWER"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns same answers."
msgstr ""
"Lors d'une requête de type {query_type} pour les ressources \"{query1}\" et "
"\"{query2}\", le serveur de noms {ns}/{address} répond la même chose."

msgctxt "NAMESERVER:CASE_QUERY_SAME_RC"
msgid ""
"When asked for {query_type} records on \"{query1}\" and \"{query2}\", nameserver "
"{ns}/{address} returns same RCODE \"{rcode}\"."
msgstr ""
"Lors d'une requête de type {query_type} pour les ressources \"{query1}\" et "
"\"{query2}\", le serveur de noms {ns}/{address} renvoie le même code de retour "
"\"{rcode}\"."

msgctxt "NAMESERVER:DIFFERENT_SOURCE_IP"
msgid ""
"Nameserver {ns}/{address} replies on a SOA query with a different source address "
"({source})."
msgstr ""
"Le serveur de noms {ns}/{address} répond depuis une autre adresse ({source}) que celle "
"à laquelle la requête a été envoyée."

msgctxt "NAMESERVER:EDNS_RESPONSE_WITHOUT_EDNS"
msgid ""
"Response without EDNS from {ns}/{address} on query with EDNS0 asking for {domain}."
msgstr ""
"Réponse sans enregistrement de type OPT de {ns}/{address} sur le nom de domaine "
"'{domain}' lorsque EDNS est utilisé."

msgctxt "NAMESERVER:EDNS_VERSION_ERROR"
msgid ""
"Incorrect version of EDNS (expected 0) in response from {ns}/{address} on query with "
"EDNS (version 0) asking for {domain}."
msgstr ""
"Réponse incorrecte de {ns}/{address} sur le nom de domaine '{domain}' lorsque EDNS est "
"utilisé (La version EDNS devrait être 0)."

msgctxt "NAMESERVER:EDNS0_SUPPORT"
msgid "The following nameservers support EDNS0 : {servers}."
msgstr "Les serveurs de noms suivants supportent EDNS0 : {servers}."

msgctxt "NAMESERVER:IS_A_RECURSOR"
msgid "The following nameservers are recursors: {servers}."
msgstr "Les serveurs de noms suivants autorisent la récursion : {servers}."

msgctxt "NAMESERVER:MISSING_OPT_IN_TRUNCATED"
msgid ""
"Nameserver {ns}/{address} replies on an EDNS query with a truncated response without "
"EDNS."
msgstr ""
"La réponse du serveur de noms {ns}/{address} à une requête EDNS est tronquée et sans "
"EDNS."

msgctxt "NAMESERVER:NO_EDNS_SUPPORT"
msgid "Nameserver {ns}/{address} does not support EDNS0 (replies with FORMERR)."
msgstr ""
"Le serveur de noms {ns}/{address} ne supporte pas EDNS0 (retourne le code FORMERR)."

msgctxt "NAMESERVER:NO_RECURSOR"
msgid "The following nameservers are not recursors: {servers}."
msgstr "Les serveurs de noms suivants ne sont pas des récurseurs : {servers}."

msgctxt "NAMESERVER:NO_RESOLUTION"
msgid "No nameserver was successfully resolved to an IP address."
msgstr ""
"Il a été impossible de trouver une adresse IP pour les serveurs de noms."

msgctxt "NAMESERVER:NO_RESPONSE"
msgid "No response from {ns} asking for {domain}."
msgstr "Aucune réponse de {ns} sur le nom de domaine '{domain}'."

msgctxt "SYNTAX:NO_RESPONSE"
msgid "No response from {ns} asking for {domain}."
msgstr "Aucune réponse de {ns} sur le nom de domaine '{domain}'."

msgctxt "NAMESERVER:NO_UPWARD_REFERRAL"
msgid ""
"None of the following nameservers returns an upward referral : {servers}."
msgstr ""
"Aucun des serveurs de noms suivants ne répond à la requête de type \"NS\" "
"sur la racine '.' (upward referral) : {servers}."

msgctxt "NAMESERVER:NS_ERROR"
msgid "Erroneous response from nameserver {ns}/{address}."
msgstr "Le serveur de noms {ns}/{address} n'a pas répondu aux requêtes de type \"NS\"."

msgctxt "NAMESERVER:N10_EDNS_RESPONSE_ERROR"
msgid ""
"Expected RCODE but received erroneous response to an EDNS version 1 query. "
"Fetched from the nameservers with IP addresses {addresses}"
msgstr ""
"RCODE attendu, mais réponse erronée reçue à une requête EDNS version 1. "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "NAMESERVER:N10_NO_RESPONSE_EDNS1_QUERY"
msgid ""
"No response to an EDNS version 1 query. Fetched from the nameservers with IP "
"addresses {addresses}"
msgstr ""
"Pas de réponse à une requête EDNS version 1. Information retournée par les "
"serveurs de noms ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "NAMESERVER:N10_UNEXPECTED_RCODE"
msgid ""
"Erroneous RCODE (\"{rcode}\") in response to an EDNS version 1 query. "
"Fetched from the nameservers with IP addresses {addresses}"
msgstr ""
"RCODE erroné (\"{rcode}\") reçu en réponse à une requête EDNS version 1. "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "NAMESERVER:N11_NO_EDNS"
msgid ""
"The DNS response, on query with unknown EDNS option-code, does not contain "
"any EDNS from name servers \"{addresses}\"."
msgstr ""
"La réponse DNS, suite à une requête avec un code d'option EDNS inconnu, ne "
"contient pas d'EDNS depuis les serveurs de noms \"{addresses}\"."

msgctxt "NAMESERVER:N11_NO_RESPONSE"
msgid ""
"There is no response on query with unknown EDNS option-code from name "
"servers \"{addresses}\"."
msgstr ""
"Pas de réponse aux requêtes contenant un code d’option EDNS inconnu de la "
"part des serveurs de noms \"{addresses}\"."

msgctxt "NAMESERVER:N11_RETURNS_UNKNOWN_OPTION_CODE"
msgid ""
"The DNS response contains an unknown EDNS option-code. Returned from name "
"servers \"{addresses}\"."
msgstr ""
"La réponse DNS contient un code d’option EDNS inconnu. Information retournée "
"par les serveurs de noms ayant une des adresses IP suivantes "
"\"{addresses}\"."

msgctxt "NAMESERVER:N11_UNEXPECTED_ANSWER_SECTION"
msgid ""
"The DNS response, on query with unknown EDNS option-code, does not contain "
"the expected SOA record in the answer section from name servers "
"\"{addresses}\"."
msgstr ""
"La réponse DNS à une requête contenant un code d’option EDNS inconnu, ne "
"contient pas l’enregistrement SOA attendu dans la section \"answer\". "
"Information retournée par les serveurs de noms ayant une des adresses IP "
"suivantes \"{addresses}\"."

msgctxt "NAMESERVER:N11_UNEXPECTED_RCODE"
msgid ""
"The DNS response, on query with unknown EDNS option-code, has unexpected "
"RCODE name \"{rcode}\" from name servers \"{addresses}\"."
msgstr ""
"La réponse DNS à une requête contenant un code d’option EDNS inconnu, a le "
"code de retour inattendu \"{rcode}\". Information retournée par les serveurs "
"de noms ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "NAMESERVER:N11_UNSET_AA"
msgid ""
"The DNS response, on query with unknown EDNS option-code, is unexpectedly "
"not authoritative from name servers \"{addresses}\"."
msgstr ""
"La réponse DNS à une requête contenant un code d’option EDNS inconnu ne fait "
"inopinément pas autorité. Information retournée par les serveurs de noms "
"ayant une des adresses IP suivantes \"{addresses}\"."

msgctxt "NAMESERVER:N15_ERROR_ON_VERSION_QUERY"
msgid ""
"The following name server(s) do not respond or respond with SERVFAIL to "
"software version query \"{query_name}\". Returned from name servers: "
"\"{servers}\""
msgstr ""
"Les serveurs de noms suivants ne répondent pas ou répondent SERVFAIL aux "
"requêtes de version logicielle \"{query_name}\". Information retournée par "
"les serveurs de noms : \"{servers}\""

msgctxt "NAMESERVER:N15_NO_VERSION_REVEALED"
msgid ""
"The following name server(s) do not reveal the software version. Returned "
"from name servers \"{servers}\""
msgstr ""
"Les serveurs de noms suivants ne répondent pas aux requêtes de version "
"logicielle. Information retournée par les serveurs de noms : \"{servers}\""

msgctxt "NAMESERVER:N15_SOFTWARE_VERSION"
msgid ""
"The following name server(s) respond to software version query "
"\"{query_name}\" with string \"{string}\". Returned from name servers: "
"\"{servers}\""
msgstr ""
"Les serveurs de noms suivants répondent aux requêtes de version logicielle "
"\"{query_name}\" avec la chaîne \"{string}\". Information retournée par les "
"serveurs de noms : \"{servers}\""

msgctxt "NAMESERVER:N15_WRONG_CLASS"
msgid ""
"The following name server(s) do not return CH class record(s) on CH class "
"query. Returned from name servers \"{servers}\""
msgstr ""
"Les serveurs de noms suivants ne répondent pas d'enregistrements de classe "
"CH pour une requête de classe CH. Information retournée par les serveurs de "
"noms : \"{servers}\""

msgctxt "NAMESERVER:N16_HAS_NSID"
msgid ""
"The following name server(s) responded to an NSID query (RFC 5001) with "
"NSID value \"{nsid}\". Returned from name servers \"{servers}\""
msgstr ""
"Les serveurs de noms suivants ont répondu à une requête NSID (RFC 5001) "
"avec la valeur NSID \"{nsid}\". Information retournée par les serveurs de "
"noms : \"{servers}\""

msgctxt "NAMESERVER:N16_NO_NSID_REVEALED"
msgid ""
"The following name server(s) did not include an NSID option in response to "
"an NSID query (RFC 5001). Returned from name servers \"{servers}\""
msgstr ""
"Les serveurs de noms suivants n'ont pas inclus l'option NSID dans leur "
"réponse à une requête NSID (RFC 5001). Information retournée par les "
"serveurs de noms : \"{servers}\""

msgctxt "NAMESERVER:N16_NO_RESPONSE"
msgid ""
"The following name server(s) did not respond to an NSID query (RFC 5001). "
"Returned from name servers \"{servers}\""
msgstr ""
"Les serveurs de noms suivants n'ont pas répondu à une requête NSID "
"(RFC 5001). Information retournée par les serveurs de noms : \"{servers}\""

msgctxt "NAMESERVER:N16_UNEXPECTED_RCODE"
msgid ""
"The following name server(s) returned an unexpected RCODE \"{rcode}\" in "
"response to an NSID query (RFC 5001). Returned from name servers: "
"\"{servers}\""
msgstr ""
"Les serveurs de noms suivants ont retourné un RCODE inattendu \"{rcode}\" "
"en réponse à une requête NSID (RFC 5001). Information retournée par les "
"serveurs de noms : \"{servers}\""

msgctxt "NAMESERVER:N17_COOKIE_SUPPORTED"
msgid "The following name server(s) returned a well-formed DNS Cookie (RFC 7873): \"{servers}\"."
msgstr "Les serveurs de noms suivants ont retourné un DNS Cookie bien formé (RFC 7873) : \"{servers}\"."

msgctxt "NAMESERVER:N17_COOKIE_ENFORCED"
msgid "The following name server(s) enforce DNS Cookies and returned a well-formed Server Cookie (RFC 7873): \"{servers}\"."
msgstr "Les serveurs de noms suivants exigent des DNS Cookies et ont retourné un Server Cookie bien formé (RFC 7873) : \"{servers}\"."

msgctxt "NAMESERVER:N17_NO_COOKIE"
msgid "The following name server(s) did not return a DNS Cookie (RFC 7873): \"{servers}\"."
msgstr "Les serveurs de noms suivants n'ont pas retourné de DNS Cookie (RFC 7873) : \"{servers}\"."

msgctxt "NAMESERVER:N17_COOKIE_ROUNDTRIP_OK"
msgid "The following name server(s) did not reject the Server Cookie they issued on a follow-up query (RFC 7873): \"{servers}\"."
msgstr "Les serveurs de noms suivants n'ont pas rejeté le Server Cookie qu'ils avaient émis lors d'une requête de suivi (RFC 7873) : \"{servers}\"."

msgctxt "NAMESERVER:N17_COOKIE_CLIENT_ONLY"
msgid "The following name server(s) echoed only the Client Cookie and returned no Server Cookie (RFC 7873): \"{servers}\"."
msgstr "Les serveurs de noms suivants n'ont renvoyé que le Client Cookie sans fournir de Server Cookie (RFC 7873) : \"{servers}\"."

msgctxt "NAMESERVER:N17_COOKIE_MALFORMED"
msgid "The following name server(s) returned a malformed DNS Cookie of {cookie_bytes} bytes (RFC 7873 allows 8 or 16 to 40): \"{servers}\"."
msgstr "Les serveurs de noms suivants ont retourné un DNS Cookie mal formé de {cookie_bytes} octets (RFC 7873 autorise 8 ou 16 à 40) : \"{servers}\"."

msgctxt "NAMESERVER:N17_COOKIE_SELF_REJECT"
msgid "The following name server(s) rejected with BADCOOKIE, even after a retry, a Server Cookie they had just issued (RFC 7873): \"{servers}\"."
msgstr "Les serveurs de noms suivants ont rejeté avec BADCOOKIE, même après une nouvelle tentative, un Server Cookie qu'ils venaient d'émettre (RFC 7873) : \"{servers}\"."

msgctxt "NAMESERVER:N17_NO_RESPONSE"
msgid "The following name server(s) did not respond to a DNS Cookie probe (RFC 7873): \"{servers}\"."
msgstr "Les serveurs de noms suivants n'ont pas répondu à une sonde DNS Cookie (RFC 7873) : \"{servers}\"."

msgctxt "NAMESERVER:QNAME_CASE_INSENSITIVE"
msgid "The following nameservers do not preserve original case of the queried name ({domain}): {servers}."
msgstr "Les serveurs de noms suivants ne conservent pas la casse des noms requêtés dans les réponses ({domain}) : {servers}."

msgctxt "NAMESERVER:QNAME_CASE_SENSITIVE"
msgid "The following nameservers preserve original case of queried names ({domain}): {servers}."
msgstr "Les serveurs de noms suivants conservent la casse des noms requêtés dans les réponses ({domain}) : {servers}."

msgctxt "NAMESERVER:SAME_SOURCE_IP"
msgid "All nameservers reply with same IP used to query them."
msgstr ""
"Tous les serveurs de noms répondent avec la même adresse IP que celle "
"utilisée lors de leur requêtage."

msgctxt "NAMESERVER:UPWARD_REFERRAL"
msgid "The following nameservers return an upward referral: {servers}."
msgstr "Les serveurs de noms suivants répondent avec un upward referral : {servers}."

msgctxt "NAMESERVER:UPWARD_REFERRAL_IRRELEVANT"
msgid "Upward referral tests skipped for root zone."
msgstr ""
"Les tests de type \"Upward Referral\" n'ont pas de sens pour la racine '.'."

msgctxt "NAMESERVER:Z_FLAGS_NOTCLEAR"
msgid "Nameserver {ns}/{address} has one or more unknown EDNS Z flag bits set."
msgstr ""
"Le serveur de noms {ns}/{address} répond à une requête avec un ou plusieurs bits "
"\"Z\" (EDNS) positionnés."

msgctxt "SYNTAX:DISCOURAGED_DOUBLE_DASH"
msgid ""
"Domain name ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Le nom de domaine '{domain}' contient un label ({label}) avec un double "
"tiret ('--') en positions 3 et 4 (avec un préfixe différent de 'xn--')."

msgctxt "SYNTAX:INITIAL_HYPHEN"
msgid ""
"Domain name ({domain}) has a label ({label}) starting with an hyphen ('-')."
msgstr ""
"Le nom de domaine '{domain}' contient un label ({label})commençant par un "
"tiret ('-')."

msgctxt "SYNTAX:MNAME_DISCOURAGED_DOUBLE_DASH"
msgid ""
"SOA MNAME ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Le serveur primaire défini dans le champ MNAME du SOA ({domain}) contient un "
"label ({label}) avec un double tiret ('--') en positions 3 et 4 (avec un "
"préfixe différent de 'xn--')."

msgctxt "SYNTAX:MNAME_NON_ALLOWED_CHARS"
msgid "Found illegal characters in SOA MNAME ({domain})."
msgstr ""
"Des caractères interdits ont été trouvés dans le nom du serveur primaire "
"défini dans le SOA, 'mname' ({domain})."

msgctxt "SYNTAX:MNAME_NUMERIC_TLD"
msgid "SOA MNAME ({domain}) within a 'numeric only' TLD ({tld})."
msgstr ""
"Le serveur primaire défini dans le SOA, 'mname' ({domain}), se trouve dans "
"un TLD 'numeric only' ({tld})."

msgctxt "SYNTAX:MNAME_SYNTAX_OK"
msgid "SOA MNAME ({domain}) syntax is valid."
msgstr ""
"La syntaxe du nom du serveur primaire défini dans le SOA, 'mname' ({domain}) "
"est valide."

msgctxt "SYNTAX:MX_DISCOURAGED_DOUBLE_DASH"
msgid ""
"Domain name MX ({domain}) has a label ({label}) with a double hyphen ('--') "
"in position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Le relais de messagerie ({domain}) contient un label ({label}) avec un "
"double tiret ('--') en positions 3 et 4 (avec un préfixe différent de "
"'xn--')."

msgctxt "SYNTAX:MX_NON_ALLOWED_CHARS"
msgid "Found illegal characters in MX ({domain})."
msgstr ""
"Des caractères interdits ont été trouvés dans le nom du relais de messagerie "
"({domain})."

msgctxt "SYNTAX:MX_NUMERIC_TLD"
msgid "Domain name MX ({domain}) within a 'numeric only' TLD ({tld})."
msgstr ""
"Le relais de messagerie ({domain}) se trouve dans un TLD 'numeric "
"only' ({tld})."

msgctxt "SYNTAX:MX_SYNTAX_OK"
msgid "Domain name MX ({domain}) syntax is valid."
msgstr "La syntaxe du nom du relais de messagerie ({domain}) est valide."

msgctxt "SYNTAX:NAMESERVER_DISCOURAGED_DOUBLE_DASH"
msgid ""
"Nameserver ({domain}) has a label ({label}) with a double hyphen ('--') in "
"position 3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Le serveur de noms ({domain}) contient un label ({label}) avec un double "
"tiret ('--') en positions 3 et 4 (avec un préfixe différent de 'xn--')."

msgctxt "SYNTAX:NAMESERVER_NON_ALLOWED_CHARS"
msgid "Found illegal characters in the nameserver ({domain})."
msgstr ""
"Des caractères interdits ont été trouvés dans le nom du serveur de noms "
"({domain})."

msgctxt "SYNTAX:NAMESERVER_NUMERIC_TLD"
msgid "Nameserver ({domain}) within a 'numeric only' TLD ({tld})."
msgstr ""
"Le serveur de noms ({domain}) se trouve dans un TLD 'numeric only' ({tld})."

msgctxt "SYNTAX:NAMESERVER_SYNTAX_OK"
msgid "The following nameservers have valid syntax: {servers}."
msgstr "La syntaxe des serveurs de noms suivants est valide : {servers}."

msgctxt "SYNTAX:NON_ALLOWED_CHARS"
msgid "Found illegal characters in the domain name ({domain})."
msgstr ""
"Des caractères interdits ont été trouvés dans le nom de domaine '{domain}'."

msgctxt "SYNTAX:NO_DOUBLE_DASH"
msgid ""
"Domain name ({domain}) has no label with a double hyphen ('--') in position "
"3 and 4 (with a prefix which is not 'xn--')."
msgstr ""
"Le nom de domaine '{domain}' n'a aucun label contenant un double tiret "
"('--') en positions 3 et 4 (avec un préfixe différent de 'xn--')."

msgctxt "SYNTAX:NO_ENDING_HYPHENS"
msgid "Neither end of any label in the domain name ({domain}) has a hyphen."
msgstr ""
"Aucune des extrémités des labels du nom de domain '{domain}' n'est un tiret "
"'-'."

msgctxt "SYNTAX:NO_RESPONSE_MX_QUERY"
msgid "No response from nameserver(s) on MX queries."
msgstr "Aucune réponse des serveurs de noms sur une requête de type \"MX\"."

msgctxt "ZONE:NO_RESPONSE_MX_QUERY"
msgid "No response from nameserver(s) on MX queries."
msgstr "Aucune réponse des serveurs de noms sur une requête de type \"MX\"."

msgctxt "SYNTAX:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver(s) on SOA queries."
msgstr "Aucune réponse des serveurs de noms sur une requête de type \"SOA\"."

msgctxt "ZONE:NO_RESPONSE_SOA_QUERY"
msgid "No response from nameserver(s) on SOA queries."
msgstr "Aucune réponse des serveurs de noms sur une requête de type \"SOA\"."

msgctxt "SYNTAX:ONLY_ALLOWED_CHARS"
msgid "No illegal characters in the domain name ({domain})."
msgstr "Le nom de domaine '{domain}' ne contient aucun caractère interdit."

msgctxt "SYNTAX:RNAME_MAIL_DOMAIN_INVALID"
msgid ""
"The SOA RNAME mail domain ({domain}) cannot be resolved to a mail server "
"with an IP address."
msgstr ""
"L'adresse mail du SOA du nom de domaine ({domain}) ne peut pas être résolue "
"en un serveur de messagerie avec une adresse IP."

msgctxt "SYNTAX:RNAME_MAIL_DOMAIN_LOCALHOST"
msgid ""
"The SOA RNAME mail domain ({domain}) resolved to a mail server with "
"localhost ({localhost}) IP address."
msgstr ""
"Le nom de domaine ({domain}) de l'adresse mail dans le RNAME du SOA a pour "
"adresse IP une adresse locale ({localhost})."

msgctxt "SYNTAX:RNAME_MAIL_ILLEGAL_CNAME"
msgid ""
"The SOA RNAME mail domain ({domain}) refers to an address which is an alias "
"(CNAME)."
msgstr ""
"Le nom de domaine ({domain}) de l'adresse mail dans le RNAME du SOA fait "
"référence à une adresse qui est un alias (CNAME)."

msgctxt "SYNTAX:RNAME_MISUSED_AT_SIGN"
msgid "Misused '@' character found in SOA RNAME field ({rname})."
msgstr ""
"Il ne doit pas y avoir de caractère '@' dans le champ RNAME ({rname}) du SOA."

msgctxt "SYNTAX:RNAME_NO_AT_SIGN"
msgid "There is no misused '@' character in the SOA RNAME field ({rname})."
msgstr "Il n'y a aucun caractère '@' dans le champ RNAME ({rname}) du SOA."

msgctxt "SYNTAX:RNAME_RFC822_INVALID"
msgid "Illegal character(s) found in SOA RNAME field ({rname})."
msgstr ""
"Le champ RNAME ({rname}) du SOA n'est pas conforme aux règles définies dans "
"le RFC2822."

msgctxt "SYNTAX:RNAME_RFC822_VALID"
msgid "The SOA RNAME field ({rname}) is compliant with RFC2822."
msgstr ""
"Le champ RNAME ({rname}) du SOA est conforme aux règles définies dans le "
"RFC2822."

msgctxt "SYNTAX:TERMINAL_HYPHEN"
msgid ""
"Domain name ({domain}) has a label ({label}) ending with a hyphen ('-')."
msgstr ""
"Le nom de domaine '{domain}' contient un label ({label}) se terminant par un "
"tiret '-'."

msgctxt "ZONE:RETRY_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'retry' value ({retry}) is less than the recommended one "
"({required_retry})."
msgstr ""
"Dans le SOA, la valeur du champ 'retry' ({retry}) est plus petite que la "
"valeur recommandée ({required_retry})."

msgctxt "ZONE:RETRY_MINIMUM_VALUE_OK"
msgid ""
"SOA 'retry' value ({retry}) is at least equal to the minimum recommended "
"value ({required_retry})."
msgstr ""
"Dans le SOA, la valeur du champ 'retry' ({retry}) est au moins égale à la "
"valeur minimale recommandée ({required_retry})."

msgctxt "ZONE:MNAME_IS_CNAME"
msgid "SOA 'mname' value ({mname}) refers to a NS which is an alias (CNAME)."
msgstr ""
"Le serveur primaire défini dans le SOA, 'mname' ({mname}), fait référence à "
"un serveur de noms qui est un alias (CNAME)."

msgctxt "ZONE:MNAME_IS_NOT_CNAME"
msgid ""
"SOA 'mname' value ({mname}) refers to a NS which is not an alias (CNAME)."
msgstr ""
"Le serveur primaire défini dans le SOA, 'mname' ({mname}), fait référence à "
"un serveur de noms qui n'est pas un alias (CNAME)."

msgctxt "ZONE:REFRESH_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'refresh' value ({refresh}) is less than the recommended one "
"({required_refresh})."
msgstr ""
"Dans le SOA, la valeur du champ 'refresh' ({refresh}) est plus petite que la "
"valeur recommandée ({required_refresh})."

msgctxt "ZONE:REFRESH_MINIMUM_VALUE_OK"
msgid ""
"SOA 'refresh' value ({refresh}) is at least equal to the minimum recommended "
"value ({required_refresh})."
msgstr ""
"Dans le SOA, la valeur du champ 'refresh' ({refresh}) est au moins égale à "
"la valeur minimale recommandée ({required_refresh})."

msgctxt "ZONE:EXPIRE_LOWER_THAN_REFRESH"
msgid ""
"SOA 'expire' value ({expire}) is lower than the SOA 'refresh' value "
"({refresh})."
msgstr ""
"Dans le SOA, la valeur du champ 'expire' ({expire}) est plus petite que la "
"valeur du champ 'refresh' ({refresh})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_HIGHER"
msgid ""
"SOA 'minimum' value ({minimum}) is higher than the recommended one "
"({highest_minimum})."
msgstr ""
"Dans le SOA, la valeur du champ 'minimum' ({minimum}) est plus grande que la "
"valeur recommandée ({highest_minimum})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_LOWER"
msgid ""
"SOA 'minimum' value ({minimum}) is less than the recommended one "
"({lowest_minimum})."
msgstr ""
"Dans le SOA, la valeur du champ 'minimum' ({minimum}) est plus petite que la "
"valeur recommandée ({lowest_minimum})."

msgctxt "ZONE:SOA_DEFAULT_TTL_MAXIMUM_VALUE_OK"
msgid ""
"SOA 'minimum' value ({minimum}) is between the recommended ones "
"({lowest_minimum}/{highest_minimum})."
msgstr ""
"Dans le SOA, la valeur du champ 'minimum' ({minimum}) est comprise dans "
"l'interval de valeurs recommandées ({lowest_minimum}/{highest_minimum})."

msgctxt "ZONE:EXPIRE_MINIMUM_VALUE_LOWER"
msgid ""
"SOA 'expire' value ({expire}) is less than the recommended one "
"({required_expire})."
msgstr ""
"Dans le SOA, la valeur du champ 'expire' ({expire}) est plus petite que la "
"valeur recommandée ({required_expire})."

msgctxt "ZONE:REFRESH_LOWER_THAN_RETRY"
msgid ""
"SOA 'refresh' value ({refresh}) is lower than the SOA 'retry' value "
"({retry})."
msgstr ""
"Dans le SOA, la valeur du champ 'refresh' ({refresh}) est plus petite que la "
"valeur du champ 'retry' ({retry})."

msgctxt "ZONE:REFRESH_HIGHER_THAN_RETRY"
msgid ""
"SOA 'refresh' value ({refresh}) is higher than the SOA 'retry' value "
"({retry})."
msgstr ""
"Dans le SOA, la valeur du champ 'refresh' ({refresh}) est plus grande que la "
"valeur du champ 'retry' ({retry})."

msgctxt "ZONE:MX_RECORD_IS_CNAME"
msgid "MX record for the domain is pointing to a CNAME."
msgstr ""
"L'enregistrement de type \"MX\" pour le domaine pointe sur un alias (CNAME)."

msgctxt "ZONE:MX_RECORD_IS_NOT_CNAME"
msgid "MX record for the domain is not pointing to a CNAME."
msgstr ""
"L'enregistrement de type \"MX\" pour le domaine ne pointe pas sur un alias "
"(CNAME)."

msgctxt "ZONE:MULTIPLE_SOA"
msgid ""
"Nameserver {ns}/{address} responds with multiple ({count}) SOA records on SOA queries."
msgstr ""
"Le serveur de noms {ns}/{address} répond aux requêtes de type \"SOA\" avec plusieurs "
"enregistrements ({count})."

msgctxt "ZONE:NO_SOA_IN_RESPONSE"
msgid ""
"Response from nameserver {ns}/{address} on SOA queries does not contain SOA record."
msgstr ""
"La réponse du serveur de noms {ns}/{address} à une requête de type \"SOA\" ne contient "
"aucun enregistrement de type \"SOA\"."

msgctxt "ZONE:MNAME_HAS_NO_ADDRESS"
msgid "No IP address found for SOA 'mname' nameserver ({mname})."
msgstr ""
"Aucune adresse IP trouvée pour le serveur primaire défini dans le SOA, "
"'mname' ({mname})."

msgctxt "ZONE:ONE_SOA"
msgid "A unique SOA record is returned by all nameservers of the zone."
msgstr ""
"L'ensemble des serveurs de la zone ont retourné un enregistrement de type "
"\"SOA\" unique."

msgctxt "ZONE:EXPIRE_MINIMUM_VALUE_OK"
msgid ""
"SOA 'expire' value ({expire}) is higher than the minimum recommended value "
"({required_expire}) and not lower than the 'refresh' value ({refresh})."
msgstr ""
"Dans le SOA, la valeur du champ 'expire' ({expire}) est plus grande que la "
"valeur minimale recommandée ({required_expire}) et pas plus petite que la "
"valeur du champ 'refresh' ({refresh})."

msgctxt "ZONE:WRONG_SOA"
msgid ""
"Nameserver {ns}/{address} responds with a wrong owner name ({owner} instead of {query_name}) "
"on SOA queries."
msgstr ""
"Le serveur de noms {ns}/{address} répond aux requêtes de type \"SOA\" avec un nom de "
"domaine erroné ({owner} au lieu de {query_name})."

msgctxt "ZONE:Z01_MNAME_HAS_LOCALHOST_ADDR"
msgid ""
"SOA MNAME name server \"{ns}\" resolves to a localhost IP address "
"({address})."
msgstr ""
"La résolution du nom du serveur de noms du SOA MNAME \"{ns}\" donne une "
"adresse localhost ({address})."

msgctxt "ZONE:Z01_MNAME_IS_DOT"
msgid ""
"SOA MNAME is specified as \".\" which usually means \"no server\". Fetched "
"from name servers \"{addresses}\"."
msgstr ""
"Le nom du serveur de noms du SOA MNAME est \".\", ce qui signifie en général "
"\"aucun serveur\". Information retournée par les serveurs de noms dont les "
"adresses IP sont \"{addresses}\"."

msgctxt "ZONE:Z01_MNAME_IS_LOCALHOST"
msgid ""
"SOA MNAME name server is \"localhost\", which is invalid. Fetched from name "
"servers \"{addresses}\"."
msgstr ""
"Le champ MNAME du SOA est \"localhost\", ce qui n’est pas valable. "
"Information retournée par les serveurs de noms dont les adresses IP sont "
"\"{addresses}\"."

msgctxt "ZONE:Z01_MNAME_IS_MASTER"
msgid "SOA MNAME name server(s) \"{servers}\" appears to be master."
msgstr ""
"Le(s) serveur(s) de noms \"{servers}\" du SOA MNAME semblent être les "
"serveurs primaires."

msgctxt "ZONE:Z01_MNAME_MISSING_SOA_RECORD"
msgid ""
"SOA MNAME name server \"{ns}/{address}\" responds to an SOA query with no SOA records "
"in the answer section."
msgstr ""
"Le serveur de noms du SOA MNAME \"{ns}/{address}\" ne retourne aucun enregistrement de "
"type \"SOA\" dans la section \"answer\" de la réponse à une requête de type "
"\"SOA\"."

msgctxt "ZONE:Z01_MNAME_NO_RESPONSE"
msgid "SOA MNAME name server \"{ns}/{address}\" does not respond to an SOA query."
msgstr ""
"Le serveur de noms du SOA MNAME \"{ns}/{address}\" ne répond pas aux requêtes de type "
"\"SOA\"."

msgctxt "ZONE:Z01_MNAME_NOT_AUTHORITATIVE"
msgid "SOA MNAME name server \"{ns}/{address}\" is not authoritative for the zone."
msgstr ""
"Le serveur de noms primaire défini dans le SOA MNAME, \"{ns}/{address}\", ne fait pas "
"autorité pour la zone."

msgctxt "ZONE:Z01_MNAME_NOT_IN_NS_LIST"
msgid ""
"SOA MNAME name server \"{ns}\" is not listed as NS record for the zone."
msgstr ""
"Le serveur primaire défini dans le SOA MNAME, ({ns}), ne fait pas partie "
"des enregistrements de type \"NS\" listés par la zone."

msgctxt "ZONE:Z01_MNAME_NOT_MASTER"
msgid ""
"SOA MNAME name server(s) \"{servers}\" do not have the highest SOA SERIAL "
"(expected \"{soaserial}\" but got \"{soaserial_list}\")"
msgstr ""
"Le(s) serveur(s) de noms \"{servers}\" du SOA MNAME n’ont pas le numéro de "
"série SOA le plus élevé (numéro de série attendu : \"{soaserial}\" ; numéros "
"de série obtenus : \"{soaserial_list}\")."

msgctxt "ZONE:Z01_MNAME_NOT_RESOLVE"
msgid ""
"SOA MNAME name server \"{ns}\" cannot be resolved into an IP address."
msgstr ""
"Le serveur de noms primaire du SOA MNAME \"{ns}\" ne peut pas être "
"résolu en une adresse IP."

msgctxt "ZONE:Z01_MNAME_UNEXPECTED_RCODE"
msgid ""
"SOA MNAME name server \"{ns}/{address}\" gives unexpected RCODE name (\"{rcode}\") in "
"response to an SOA query."
msgstr ""
"Le serveur de noms du SOA MNAME \"{ns}/{address}\" a répondu à une requête de type "
"\"SOA\" avec un code de retour inattendu ({rcode})."

msgctxt "ZONE:Z09_INCONSISTENT_MX"
msgid "Some name servers return an MX RRset while others return none."
msgstr ""
"Certains serveurs de noms renvoient un ensemble d’enregistrements MX tandis "
"que d’autres n’en renvoient pas."

msgctxt "ZONE:Z09_INCONSISTENT_MX_DATA"
msgid "The MX RRset data is inconsistent between the name servers."
msgstr ""
"Les ensembles d’enregistrements MX renvoyés par les serveurs de noms ne sont "
"pas cohérents entre eux."

msgctxt "ZONE:Z09_MISSING_MAIL_TARGET"
msgid "The child zone has no mail target (no MX)."
msgstr "La zone n’a pas de cible de messagerie associée (pas de MX)."

msgctxt "ZONE:Z09_MX_DATA"
msgid ""
"Mail targets in the MX RRset \"{mail_targets}\" returned from name "
"servers \"{addresses}\"."
msgstr ""
"Les cibles de messagerie de l’ensemble d’enregistrements MX "
"\"{mail_targets}\" ont été obtenues des serveurs de noms {addresses}."

msgctxt "ZONE:Z09_MX_FOUND"
msgid "MX RRset was returned by name servers \"{addresses}\"."
msgstr ""
"Un ensemble d’enregistrements MX a été obtenu des serveurs de noms "
"\"{addresses}\"."

msgctxt "ZONE:Z09_NON_AUTH_MX_RESPONSE"
msgid ""
"Non-authoritative response on MX query from name servers \"{addresses}\"."
msgstr ""
"La réponse des serveurs de noms \"{addresses}\" à une requête de type "
"\"MX\" ne fait pas autorité."

msgctxt "ZONE:Z09_NO_MX_FOUND"
msgid "No MX RRset was returned by name servers \"{addresses}\"."
msgstr ""
"Aucun enregistrement MX n’a été renvoyé par les serveurs de noms "
"\"{addresses}\"."

msgctxt "ZONE:Z09_NO_RESPONSE_MX_QUERY"
msgid "No response on MX query from name servers \"{addresses}\"."
msgstr ""
"Les serveurs de noms \"{addresses}\" ne répondent pas aux requêtes MX."

msgctxt "ZONE:Z09_NULL_MX_NON_ZERO_PREF"
msgid "The zone has a Null MX with non-zero preference."
msgstr "La zone a un « null MX » avec un champ préférence différent de zéro."

msgctxt "ZONE:Z09_NULL_MX_WITH_OTHER_MX"
msgid "The zone has a Null MX mixed with other MX records."
msgstr "La zone a un « null MX » mêlé à d’autres enregistrements MX."

msgctxt "ZONE:Z09_ROOT_EMAIL_DOMAIN"
msgid "Root zone with an unexpected MX RRset (non-Null MX)."
msgstr ""
"Zone racine contenant un ensemble d’enregistrements MX inattendu, différent "
"de « null MX »."

msgctxt "ZONE:Z09_TLD_EMAIL_DOMAIN"
msgid "The zone is a TLD and has an unexpected MX RRset (non-Null MX)."
msgstr ""
"La zone est un domaine de premier niveau et contient un ensemble "
"d’enregistrements MX inattendu, différent de « null MX »."

msgctxt "ZONE:Z09_UNEXPECTED_RCODE_MX"
msgid ""
"Unexpected RCODE value ({rcode}) on the MX query from name servers "
"\"{addresses}\"."
msgstr ""
"Code de retour inattendu ({rcode}) en réponse à une requête de type MX des "
"serveurs de noms \"{addresses}\"."

msgctxt "ZONE:Z11_DIFFERENT_SPF_POLICIES_FOUND"
msgid ""
"The following name servers returned the same SPF policy. Name servers: "
"{servers}."
msgstr ""
"Les serveurs de noms suivants renvoient la même politique SPF. Serveurs de "
"noms : {servers}."

msgctxt "ZONE:Z11_INCONSISTENT_SPF_POLICIES"
msgid ""
"One or more name servers do not publish the same SPF policy as the others."
msgstr ""
"Un ou plusieurs serveurs de noms ne publient pas la même politique SPF que "
"les autres."

msgctxt "ZONE:Z11_NO_SPF_FOUND"
msgid "No SPF policy was found for {domain}."
msgstr "Aucune politique SPF trouvée pour {domain}."

msgctxt "ZONE:Z11_NO_SPF_NON_MAIL_DOMAIN"
msgid ""
"No SPF policy was found for {domain}, which is a type of domain (root, TLD "
"or under .ARPA) not expected to be used for email."
msgstr ""
"Aucune politique SPF n'a été trouvée pour {domain}, qui est un type de "
"domaine (racine, TLD ou sous .ARPA) qui n'est pas prévu d'être utilisé pour "
"du courrier électronique."

msgctxt "ZONE:Z11_NON_NULL_SPF_NON_MAIL_DOMAIN"
msgid ""
"A non-null SPF policy was found on {domain}, although this type of domain "
"(root, TLD or under .ARPA) is not expected to be used for email."
msgstr ""
"Une politique SPF non nulle a été trouvée pour {domain}, bien que ce type de "
"domaine (racine, TLD, ou sous .ARPA) ne soit pas prévu d'être utilisé pour "
"du courrier électronique."

msgctxt "ZONE:Z11_NULL_SPF_NON_MAIL_DOMAIN"
msgid ""
"A null SPF policy was found on {domain}, which is a type of domain (root, "
"TLD or under .ARPA) not expected to be used for email."
msgstr ""
"Une politique SPF nulle a été trouvée pour {domain}, bien que ce type de "
"domaine (racine, TLD, ou sous .ARPA) ne soit pas prévu d'être utilisé pour "
"du courrier électronique."

msgctxt "ZONE:Z11_SPF_MULTIPLE_RECORDS"
msgid ""
"The following name servers returned more than one SPF policy. Name servers: "
"{servers}."
msgstr ""
"Les serveurs de noms suivants retournent plus d'une politique SPF. Serveurs "
"de noms : {servers}."

msgctxt "ZONE:Z11_SPF_SYNTAX_ERROR"
msgid ""
"The SPF policy of {domain} has a syntax error. Policy retrieved from the "
"following nameservers: {servers}."
msgstr ""
"La politique SPF de {domain} a une erreur de syntaxe. Politique reçue des "
"serveurs de noms suivants : {servers}."

msgctxt "ZONE:Z11_SPF_SYNTAX_OK"
msgid "SPF syntax is correct for {domain}."
msgstr "La syntaxe SPF est correcte pour {domain}."

msgctxt "ZONE:Z11_UNABLE_TO_CHECK_FOR_SPF"
msgid ""
"None of the zone’s name servers responded with an authoritative response to "
"queries for SPF policies."
msgstr ""
"Aucun des serveurs de noms de la zone n'a répondu avec une réponse faisant "
"autorité pour les requêtes de politiques SPF."

msgctxt "ZONE:Z12_CSYNC_FOUND"
msgid "CSYNC record found at zone apex on the following nameservers with SOA serial {serial}, flags {flags}, and type bitmap {type_bitmap}: {servers}."
msgstr "Un enregistrement CSYNC a été trouvé à l'apex de la zone sur les serveurs de noms suivants avec le numéro de série SOA {serial}, les indicateurs {flags} et la carte de types {type_bitmap} : {servers}."

msgctxt "ZONE:Z12_INCONSISTENT_CSYNC"
msgid "CSYNC record content differs across authoritative name servers."
msgstr "Le contenu de l'enregistrement CSYNC diffère entre les serveurs de noms faisant autorité."

msgctxt "ZONE:Z12_MIXED_PRESENCE"
msgid "CSYNC record is present on some name servers but absent on others."
msgstr "L'enregistrement CSYNC est présent sur certains serveurs de noms mais absent sur d'autres."

msgctxt "ZONE:Z12_MULTIPLE_CSYNC"
msgid "{count} CSYNC records found at zone apex on name server {ns}/{address}."
msgstr "{count} enregistrements CSYNC trouvés à l'apex de la zone sur le serveur de noms {ns}/{address}."

msgctxt "ZONE:Z12_NO_CSYNC"
msgid "No CSYNC record found at zone apex on name servers: {servers}."
msgstr "Aucun enregistrement CSYNC trouvé à l'apex de la zone sur les serveurs de noms : {servers}."

msgctxt "ZONE:Z12_SERIAL_MISMATCH"
msgid ""
"CSYNC SOA serial {csync_serial} fails RFC 7477 serial precondition against current "
"SOA serial "
"{soa_serial} on name server {ns}."
msgstr ""
"Le numéro de série SOA CSYNC {csync_serial} ne correspond pas au numéro de série "
"SOA actuel {soa_serial} sur le serveur de noms {ns}."

msgctxt "ZONE:Z13_NO_SPF_FOUND"
msgid "No SPF record found for {domain}; skipping DNS lookup count check."
msgstr ""
"Aucun enregistrement SPF trouvé pour {domain} ; vérification du nombre de "
"résolutions DNS ignorée."

msgctxt "ZONE:Z13_SPF_LOOKUP_COUNT_EXCEEDED"
msgid ""
"The SPF policy for {domain} requires {count} DNS lookups, exceeding the "
"configured limit of {limit} (RFC 7208 Section 4.6.4)."
msgstr ""
"La politique SPF de {domain} nécessite {count} résolutions DNS, dépassant la "
"limite configurée de {limit} (RFC 7208 section 4.6.4)."

msgctxt "ZONE:Z13_SPF_LOOKUP_COUNT_OK"
msgid ""
"The SPF policy for {domain} requires {count} DNS lookups, within the "
"allowed limit."
msgstr ""
"La politique SPF de {domain} nécessite {count} résolutions DNS, dans la limite "
"autorisée."

msgctxt "ZONE:Z13_SPF_LOOKUP_LOOP"
msgid ""
"The SPF policy for {domain} contains a recursive loop: {loop_domain} was "
"visited more than once during include/redirect resolution."
msgstr ""
"La politique SPF de {domain} contient une boucle récursive : {loop_domain} a été "
"visité plus d'une fois lors de la résolution include/redirect."

msgctxt "ZONE:Z13_SPF_MACRO_TARGET"
msgid ""
"The SPF policy for {domain} references {target} via include or redirect, "
"but the target contains SPF macros that can only be expanded at SMTP time "
"(RFC 7208 Section 7); its DNS lookup count is not audited."
msgstr ""
"La politique SPF de {domain} référence {target} via include ou redirect, "
"mais la cible contient des macros SPF qui ne peuvent être développées qu'au "
"moment SMTP (RFC 7208 section 7) ; le nombre de requêtes DNS de cette "
"branche n'est pas audité."

msgctxt "ZONE:Z13_SPF_PTR_DEPRECATED"
msgid ""
"The SPF policy for {domain} uses the deprecated ptr mechanism "
"(RFC 7208 Section 5.5)."
msgstr ""
"La politique SPF de {domain} utilise le mécanisme ptr obsolète "
"(RFC 7208 section 5.5)."

msgctxt "ZONE:Z13_SPF_RECURSIVE_ERROR"
msgid ""
"The SPF policy for {domain} references {target} via include or redirect, "
"but that target could not be resolved."
msgstr ""
"La politique SPF de {domain} fait référence à {target} via include ou redirect, "
"mais la cible n'a pas pu être résolue."

msgctxt "ZONE:Z13_UNABLE_TO_CHECK"
msgid ""
"None of the zone's name servers responded with an authoritative response to "
"queries for SPF policies; unable to check DNS lookup count."
msgstr ""
"Aucun des serveurs de noms de la zone n'a répondu de manière autoritative aux "
"requêtes de politique SPF ; impossible de vérifier le nombre de résolutions DNS."

msgctxt "ZONE:Z14_DUPLICATE_SCHEME_HASH"
msgid ""
"ZONEMD records at zone apex on name server {ns} contain duplicate "
"(Scheme, Hash) pair: scheme {scheme}, hash {hash}."
msgstr ""
"Les enregistrements ZONEMD au sommet de la zone sur le serveur de noms {ns} "
"contiennent un doublon de paire (Schéma, Hachage) : schéma {scheme}, "
"hachage {hash}."

msgctxt "ZONE:Z14_INCONSISTENT_ZONEMD"
msgid "ZONEMD record content differs across authoritative name servers."
msgstr "Le contenu des enregistrements ZONEMD diffère entre les serveurs de noms faisant autorité."

msgctxt "ZONE:Z14_MIXED_PRESENCE"
msgid "ZONEMD record is present on some name servers but absent on others."
msgstr "L'enregistrement ZONEMD est présent sur certains serveurs de noms mais absent sur d'autres."

msgctxt "ZONE:Z14_NO_ZONEMD"
msgid "No ZONEMD record found at zone apex on name servers: {servers}."
msgstr "Aucun enregistrement ZONEMD trouvé au sommet de la zone sur les serveurs de noms : {servers}."

msgctxt "ZONE:Z14_SERIAL_MISMATCH"
msgid ""
"ZONEMD serial {zonemd_serial} does not match current SOA serial "
"{soa_serial} on name server {ns}."
msgstr ""
"Le numéro de série ZONEMD {zonemd_serial} ne correspond pas au numéro de série "
"SOA actuel {soa_serial} sur le serveur de noms {ns}."

msgctxt "ZONE:Z14_UNSUPPORTED_HASH"
msgid ""
"ZONEMD record on name server {ns} uses hash algorithm {hash}, which is "
"outside the IANA-assigned set verifiable by standard tooling (1 = SHA-384, "
"2 = SHA-512)."
msgstr ""
"L'enregistrement ZONEMD sur le serveur de noms {ns} utilise l'algorithme de "
"hachage {hash}, qui se situe en dehors de l'ensemble attribué par l'IANA "
"vérifiable par les outils standard (1 = SHA-384, 2 = SHA-512)."

msgctxt "ZONE:Z14_ZONEMD_FOUND"
msgid ""
"ZONEMD record found at zone apex: serial {serial}, scheme {scheme}, "
"hash algorithm {hash}, digest {digest}. Name servers: {servers}."
msgstr ""
"Enregistrement ZONEMD trouvé au sommet de la zone : numéro de série {serial}, "
"schéma {scheme}, algorithme de hachage {hash}, digest {digest}. "
"Serveurs de noms : {servers}."

msgctxt "SYSTEM:CANNOT_CONTINUE"
msgid "Not enough data about {domain} was found to be able to run tests."
msgstr ""
"Pas assez d'informations obtenues sur la zone '{domain}' pour permettre la "
"poursuite des tests."

msgctxt "SYSTEM:DEPENDENCY_VERSION"
msgid "Using prerequisite module {name} version {version}."
msgstr "Utilisation du module prérequis {name} version {version}."

msgctxt "SYSTEM:GLOBAL_VERSION"
msgid "Using version {version} of the Gonemaster engine."
msgstr "Utilisation de la version {version} du moteur Gonemaster."

msgctxt "SYSTEM:IPV6_AUTO_DISABLED"
msgid "IPv6 automatically disabled: {reason}."
msgstr "IPv6 automatiquement désactivé: {reason}."

msgctxt "SYSTEM:LOGGER_CALLBACK_ERROR"
msgid "Logger callback died with error: {exception}"
msgstr ""
"L'appel au système de log (Callback) s'est terminé avec l'erreur suivante: "
"{exception}."

msgctxt "SYSTEM:MODULE_ERROR"
msgid "Fatal error in {module}: {msg}"
msgstr "Erreur fatale dans le module {module}: {msg}."

msgctxt "SYSTEM:MODULE_VERSION"
msgid "Using module {module} version {version}."
msgstr "Utilisation du module {module} version {version}."

msgctxt "SYSTEM:MODULE_END"
msgid "Module {module} finished running."
msgstr "Exécution du module {module} terminée."

msgctxt "SYSTEM:NON_GLOBAL_QUERY_BLOCKED"
msgid "Query to {ns} skipped: {address} is a private or non-globally-reachable address."
msgstr "Requête vers {ns} ignorée : {address} est une adresse privée ou non joignable globalement."

msgctxt "SYSTEM:NO_NETWORK"
msgid "Both IPv4 and IPv6 are disabled."
msgstr "IPv6 et IPv4 sont désactivés."

msgctxt "SYSTEM:UNKNOWN_METHOD"
msgid "Request to run unknown method {testcase} in module {module}."
msgstr ""
"Demande d'exécuter une méthode inconnue {testcase} pour le module {module}."

msgctxt "SYSTEM:UNKNOWN_MODULE"
msgid ""
"Request to run {testcase} in unknown module {module}. Known modules: "
"{module_list}."
msgstr ""
"Demande d'exécuter une méthode {testcase} pour le module inconnu {module}. "
"Liste des modules connus: {module_list}."

msgctxt "SYSTEM:FAKE_DELEGATION_TO_SELF"
msgid ""
"Name server {ns} not adding fake delegation for domain {domain} to itself."
msgstr ""
"Refus d'ajout de configuration DNS alternative au serveur de noms {ns} pour "
"le domaine '{domain}' sur lui-même."

msgctxt "SYSTEM:FAKE_DELEGATION_IN_ZONE_NO_IP"
msgid ""
"The fake delegation of domain {domain} includes an in-zone name server "
"{ns} without mandatory glue (without IP address)."
msgstr ""
"Ajout de configuration DNS alternative (fake delegation) pour le domaine "
"'{domain}' au serveur de noms 'in-bailiwick' {ns} sans adresse IP."

msgctxt "SYSTEM:FAKE_DELEGATION_NO_IP"
msgid ""
"The fake delegation of domain {domain} includes a name server {ns} that "
"cannot be resolved to any IP address."
msgstr ""
"Ajout de configuration DNS alternative (fake delegation) pour le domaine "
"'{domain}' au serveur de noms {ns} sans adresse IP."

msgctxt "SYSTEM:PACKET_BIG"
msgid "Big packet size ({size}) (try with \"{command}\")."
msgstr ""
"La taille du paquet ({size} octets) est trop importante (tester avec la "
"commande \"{command}\")."

msgctxt "BASIC:B01_CHILD_NOT_EXIST"
msgid "The zone \"{domain}\" does not exist as a zone."
msgstr "La zone \"{domain}\" n'existe pas en tant que zone."

msgctxt "DNSSEC:DS01_DS_ALGO_OK"
msgid "DS record with key tag {keytag} and digest algorithm {ds_algo_num} ({ds_algo_descr}) is acceptable. Fetched from name servers {servers}."
msgstr "L'enregistrement DS avec le tag de clé {keytag} et l'algorithme de condensé {ds_algo_num} ({ds_algo_descr}) est acceptable. Récupéré depuis les serveurs de noms {servers}."

msgctxt "SYSTEM:CLI_HEADER_SECONDS"
msgid "Seconds"
msgstr "Secondes"

msgctxt "SYSTEM:CLI_HEADER_LEVEL"
msgid "Level"
msgstr "Niveau"

msgctxt "SYSTEM:CLI_HEADER_MESSAGE"
msgid "Message"
msgstr "Message"

msgctxt "CONNECTIVITY:CN04_ASN_INFOS_ANNOUNCE_IN"
msgid "Name server IP address \"{address}\" is announced in prefix \"{prefixes}\"."
msgstr ""
"L'adresse IP du serveur de noms \"{address}\" est annoncée dans le préfixe "
"\"{prefixes}\"."

msgctxt "CONNECTIVITY:CN04_ASN_INFOS_RAW"
msgid "The ASN data for name server IP address \"{address}\" is \"{data}\"."
msgstr ""
"Les données d'AS pour le serveur de noms d'adresse \"{address}\" sont "
"\"{data}\"."

msgctxt "CONSISTENCY:SOA_MNAME"
msgid "Found SOA mname {mname} on following nameserver set : {servers}."
msgstr ""
"L'adresse mail {mname} a été récupérée sur les serveurs suivants : {servers}."

msgctxt "BASIC:LOOP_PROTECTION"
msgid "Loop protection triggered in {caller} for child zone {child_zone_name} at zone {zone_name} (query name {intermediate_query_name})."
msgstr "La protection de boucle s'est déclenchée dans {caller} pour la zone enfant {child_zone_name} au niveau de la zone {zone_name} (nom de requête {intermediate_query_name})."

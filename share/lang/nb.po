msgctxt "BASIC:A_QUERY_NO_RESPONSES"
msgid "Nameservers did not respond to A query."
msgstr "Navnetjener svarte ikke på A-spørring."

msgctxt "BASIC:B01_CHILD_IS_ALIAS"
msgid ""
"\"{domain_child}\" is not a zone. It is an alias for \"{domain_target}\". "
"Run a test for \"{domain_target}\" instead. Returned from name servers "
"\"{servers}\"."
msgstr ""
"\"{domain_child}\" er ikke en sone. Det er et alias for \"{domain_target}\". "
"Kjør en test for \"{domain_target}\" i stedet. Returnert fra navnetjenere "
"\"{servers}\"."

msgctxt "BASIC:B01_CHILD_FOUND"
msgid "The zone \"{domain}\" is found."
msgstr "Sonen \"{domain}\" er funnet."

msgctxt "BASIC:B01_INCONSISTENT_ALIAS"
msgid "The alias for \"{domain}\" is inconsistent between name servers."
msgstr ""
"Aliaset for \"{domain}\" er inkonsekvent fra navnetjener til navnetjener."

msgctxt "BASIC:B01_INCONSISTENT_DELEGATION"
msgid ""
"The name servers for parent zone \"{domain_parent}\" give inconsistent "
"delegation of \"{domain_child}\". Returned from name servers \"{servers}\"."
msgstr ""
"Navnetjenerne for foreldresone \"{domain_parent}\" gir inkonsekvent "
"delegering av \"{domain_child}\". Returnert fra navnetjenere \"{servers}\"."

msgctxt "BASIC:B01_NO_CHILD"
msgid ""
"\"{domain_child}\" does not exist as a DNS zone. Try to test "
"\"{domain_super}\" instead."
msgstr ""
"\"{domain_child}\" finnes ikke som en DNS-sone. Prøv å teste "
"\"{domain_super}\" i stedet."

msgctxt "BASIC:B01_PARENT_DISREGARDED"
msgid ""
"This is a test of an undelegated domain so finding the parent zone is "
"disregarded."
msgstr ""
"Dette er en test av et ikke-delegert domene, så det ses bort fra å finne den "
"foreldresonen."

msgctxt "BASIC:B01_PARENT_FOUND"
msgid ""
"The parent zone is \"{domain}\" as returned from name servers \"{servers}\"."
msgstr ""
"Den foreldresonen er \"{domain}\" som returneres fra navnetjenere "
"\"{servers}\"."

msgctxt "BASIC:B01_PARENT_NOT_FOUND"
msgid "The parent zone cannot be found."
msgstr "Den foreldresonen ble ikke funnet."

msgctxt "BASIC:B01_PARENT_NXDOMAIN_HIDES_DELEGATION"
msgid ""
"Parent nameserver \"{ns}/{address}\" returns NXDOMAIN for \"{query_name}\" but "
"also has a delegation for \"{domain_child}\". This violates RFC 8020. The zone "
"is still testable through the delegation, but the parent operator should fix "
"this."
msgstr ""
"Foreldresonens navneserver \"{ns}/{address}\" returnerer NXDOMAIN for "
"\"{query_name}\" men har likevel en delegering av \"{domain_child}\". Dette "
"er i strid med RFC 8020. Sonen kan fremdeles testes via delegeringen, men "
"operatøren av foreldresonen bør rette dette."

msgctxt "BASIC:B01_PARENT_UNDETERMINED"
msgid "The parent zone cannot be determined on name servers \"{servers}\"."
msgstr ""
"Den foreldresonen kan ikke bestemmes for navnetjenere \"{servers}\"."

msgctxt "BASIC:B01_ROOT_HAS_NO_PARENT"
msgid "This is a test of the root zone which has no parent zone."
msgstr "Dette er en test av rotsonen som ikke har noen foreldresone."

msgctxt "BASIC:B01_SERVER_ZONE_ERROR"
msgid ""
"Unexpected response on query for \"{query_name}\" with query type "
"\"{query_type}\" to \"{ns}/{address}\"."
msgstr ""
"Uventet svar på spørringen for \"{query_name}\" med spørringstypen "
"\"{query_type}\" til \"{ns}/{address}\"."

msgctxt "BASIC:B02_AUTH_RESPONSE_SOA"
msgid ""
"Authoritative answer on SOA query for \"{domain}\" is returned by name "
"servers \"{servers}\"."
msgstr ""
"Autoritativt svar på SOA-spørring for \"{domain}\" returneres fra "
"navnetjenere \"{servers}\"."

msgctxt "BASIC:B02_NO_DELEGATION"
msgid ""
"There is no delegation (name servers) for \"{domain}\" which means it does "
"not exist as a zone."
msgstr ""
"Det er ingen delegering (navnetjenere) for \"{domain}\", noe som betyr at "
"den ikke eksisterer som en sone."

msgctxt "BASIC:B02_NO_WORKING_NS"
msgid "There is no working name server for \"{domain}\" so it is unreachable."
msgstr ""
"Det er ingen fungerende navnetjener for \"{domain}\", så den er ikke "
"tilgjengelig."

msgctxt "BASIC:B02_NS_BROKEN"
msgid "Broken response from name server \"{ns}\" on an SOA query."
msgstr "Ødelagt svar fra navnetjener \"{ns}\" på SOA-spørring."

msgctxt "BASIC:B02_NS_NOT_AUTH"
msgid ""
"Name server \"{ns}\" does not give an authoritative answer on an SOA query."
msgstr "Navnetjener \"{ns}\" svarte ikke autoritativt på SOA-spørring."

msgctxt "BASIC:B02_NS_NO_IP_ADDR"
msgid "Name server \"{ns}\" cannot be resolved into an IP address."
msgstr "Navnetjener \"{ns}\" kan ikke resolves til en IP-adresse."

msgctxt "BASIC:B02_NS_NO_RESPONSE"
msgid "Name server \"{ns}\" does not respond to an SOA query."
msgstr "Navnetjener \"{ns}\" svarte ikke på SOA-spørring."

msgctxt "BASIC:B02_UNEXPECTED_RCODE"
msgid ""
"Name server \"{ns}\" responds with an unexpected RCODE name (\"{rcode}\") on "
"an SOA query."
msgstr ""
"Navnetjener \"{ns}\" svarte på en SOA-spørring med svarkoden (\"{rcode}\"), "
"som ikke var forventet."

msgctxt "ADDRESS:CNAME_CHAIN_TOO_LONG"
msgid "CNAME chain for {query_name} exceeds the maximum allowed length."
msgstr ""
"CNAME-kjeden for {query_name} overskrider den tillatte maksimumslengden."

msgctxt "BASIC:CNAME_CHAIN_TOO_LONG"
msgid "CNAME chain for {query_name} exceeds the maximum allowed length."
msgstr ""
"CNAME-kjeden for {query_name} overskrider den tillatte maksimumslengden."

msgctxt "CONNECTIVITY:CNAME_CHAIN_TOO_LONG"
msgid "CNAME chain for {query_name} exceeds the maximum allowed length."
msgstr ""
"CNAME-kjeden for {query_name} overskrider den tillatte maksimumslengden."

msgctxt "ADDRESS:CNAME_TARGET_UNRESOLVED"
msgid "CNAME target {cname_target} for {query_name} could not be resolved."
msgstr ""
"CNAME-målet {cname_target} for {query_name} kunne ikke løses."

msgctxt "BASIC:CNAME_TARGET_UNRESOLVED"
msgid "CNAME target {cname_target} for {query_name} could not be resolved."
msgstr ""
"CNAME-målet {cname_target} for {query_name} kunne ikke løses."

msgctxt "CONNECTIVITY:CNAME_TARGET_UNRESOLVED"
msgid "CNAME target {cname_target} for {query_name} could not be resolved."
msgstr ""
"CNAME-målet {cname_target} for {query_name} kunne ikke løses."

msgctxt "ADDRESS:CNAME_TOO_MANY_RECORDS"
msgid "Too many CNAME records in the answer for {query_name}."
msgstr "For mange CNAME-poster i svaret for {query_name}."

msgctxt "BASIC:CNAME_TOO_MANY_RECORDS"
msgid "Too many CNAME records in the answer for {query_name}."
msgstr "For mange CNAME-poster i svaret for {query_name}."

msgctxt "CONNECTIVITY:CNAME_TOO_MANY_RECORDS"
msgid "Too many CNAME records in the answer for {query_name}."
msgstr "For mange CNAME-poster i svaret for {query_name}."

msgctxt "BASIC:HAS_A_RECORDS"
msgid "Nameserver {ns}/{address} returned \"A\" record(s) for {domain}."
msgstr "Navnetjener {ns}/{address} svarte med A-poster for {domain}."

msgctxt "BASIC:HAS_NAMESERVER_NO_WWW_A_TEST"
msgid "Functional nameserver found. \"A\" query for www.{zname} test skipped."
msgstr ""
"En fungerende navnetjener funnet. Trenger ingen spørring om A-post for www."
"{zname}."


msgid "Ambiguous downcasing of character \"{unicode_name}\" in the domain name. Use all lower case instead."
msgstr "Dubbelzinnige omzetting naar kleine letters van teken \"{unicode_name}\" in de domeinnaam. Gebruik in plaats daarvan alleen kleine letters."

msgid "Domain name is too long (more than 253 characters with no final dot)."
msgstr "Domeinnaam is te lang (meer dan 253 tekens zonder afsluitende punt)."

msgid "Domain name is empty."
msgstr "Domeinnaam is leeg."

msgid "Domain name starts with dot."
msgstr "Domeinnaam begint met een punt."

msgid "Domain name has an ASCII label (\"{label}\") with a character not permitted."
msgstr "Domeinnaam heeft een ASCII-label (\"{label}\") met een niet-toegestaan teken."

msgid "Domain name has a non-ASCII label (\"{label}\") which is not a valid U-label."
msgstr "Domeinnaam heeft een niet-ASCII-label (\"{label}\") dat geen geldig U-label is."

msgid "Domain name has repeated dots."
msgstr "Domeinnaam heeft herhaalde punten."

msgid "Domain name has a label that is too long (more than 63 characters), \"{label}\"."
msgstr "Domeinnaam heeft een label dat te lang is (meer dan 63 tekens), \"{label}\"."

msgctxt "ADDRESS:NAMESERVER_IP_WITHOUT_REVERSE"
msgid "Nameserver {ns} has an IP address ({address}) without PTR configured."
msgstr "Naamserver {ns} heeft een IP-adres ({address}) zonder geconfigureerde PTR."

msgctxt "ADDRESS:NAMESERVER_IP_PTR_MISMATCH"
msgid "Nameserver {ns} has an IP address ({address}) with mismatched PTR result ({ptr_names})."
msgstr "Naamserver {ns} heeft een IP-adres ({address}) met een niet-overeenkomend PTR-resultaat ({ptr_names})."

msgctxt "ADDRESS:NAMESERVERS_IP_WITH_REVERSE"
msgid "Reverse DNS entry exists for each Nameserver IP address."
msgstr "Voor elk IP-adres van een naamserver bestaat er een reverse DNS-vermelding."

msgctxt "ADDRESS:NAMESERVER_IP_PTR_MATCH"
msgid "Every reverse DNS entry matches name server name."
msgstr "Elke reverse DNS-vermelding komt overeen met de naam van de naamserver."

msgctxt "ADDRESS:NO_RESPONSE_PTR_QUERY"
msgid "No response from nameserver(s) on PTR query ({domain})."
msgstr "Geen antwoord van naamserver(s) op PTR-query ({domain})."


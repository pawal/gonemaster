msgctxt "BASIC:A_QUERY_NO_RESPONSES"
msgid "Nameservers did not respond to A query."
msgstr "Naamservers reageerden niet op de A-query."

msgctxt "BASIC:B01_CHILD_IS_ALIAS"
msgid "\"{domain_child}\" is not a zone. It is an alias for \"{domain_target}\". Run a test for \"{domain_target}\" instead. Returned from name servers \"{servers}\"."
msgstr "\"{domain_child}\" is geen zone. Het is een alias voor \"{domain_target}\". Voer in plaats daarvan een test uit voor \"{domain_target}\". Geretourneerd door naamservers \"{servers}\"."

msgctxt "BASIC:B01_CHILD_FOUND"
msgid "The zone \"{domain}\" is found."
msgstr "De zone \"{domain}\" is gevonden."

msgctxt "BASIC:B01_INCONSISTENT_ALIAS"
msgid "The alias for \"{domain}\" is inconsistent between name servers."
msgstr "De alias voor \"{domain}\" is inconsistent tussen naamservers."

msgctxt "BASIC:B01_INCONSISTENT_DELEGATION"
msgid "The name servers for parent zone \"{domain_parent}\" give inconsistent delegation of \"{domain_child}\". Returned from name servers \"{servers}\"."
msgstr "De naamservers voor de bovenliggende zone \"{domain_parent}\" geven een inconsistente delegatie van \"{domain_child}\". Geretourneerd door naamservers \"{servers}\"."

msgctxt "BASIC:B01_NO_CHILD"
msgid "\"{domain_child}\" does not exist as a DNS zone. Try to test \"{domain_super}\" instead."
msgstr "\"{domain_child}\" bestaat niet als DNS-zone. Probeer in plaats daarvan \"{domain_super}\" te testen."

msgctxt "BASIC:B01_PARENT_DISREGARDED"
msgid "This is a test of an undelegated domain so finding the parent zone is disregarded."
msgstr "Dit is een test van een niet-gedelegeerd domein, dus het vinden van de bovenliggende zone wordt buiten beschouwing gelaten."

msgctxt "BASIC:B01_PARENT_FOUND"
msgid "The parent zone is \"{domain}\" as returned from name servers \"{servers}\"."
msgstr "De bovenliggende zone is \"{domain}\", zoals geretourneerd door naamservers \"{servers}\"."

msgctxt "BASIC:B01_PARENT_NOT_FOUND"
msgid "The parent zone cannot be found."
msgstr "De bovenliggende zone kan niet worden gevonden."

msgctxt "BASIC:B01_PARENT_NXDOMAIN_HIDES_DELEGATION"
msgid "Parent nameserver \"{ns}/{address}\" returns NXDOMAIN for \"{query_name}\" but also has a delegation for \"{domain_child}\". This violates RFC 8020. The zone is still testable through the delegation, but the parent operator should fix this."
msgstr "Bovenliggende naamserver \"{ns}/{address}\" retourneert NXDOMAIN voor \"{query_name}\", maar heeft ook een delegatie voor \"{domain_child}\". Dit is in strijd met RFC 8020. De zone is nog steeds testbaar via de delegatie, maar de beheerder van de bovenliggende zone zou dit moeten oplossen."

msgctxt "BASIC:B01_PARENT_UNDETERMINED"
msgid "The parent zone cannot be determined on name servers \"{servers}\"."
msgstr "De bovenliggende zone kan niet worden bepaald op naamservers \"{servers}\"."

msgctxt "BASIC:B01_ROOT_HAS_NO_PARENT"
msgid "This is a test of the root zone which has no parent zone."
msgstr "Dit is een test van de rootzone, die geen bovenliggende zone heeft."

msgctxt "BASIC:B01_SERVER_ZONE_ERROR"
msgid "Unexpected response on query for \"{query_name}\" with query type \"{query_type}\" to \"{ns}/{address}\"."
msgstr "Onverwacht antwoord op de query voor \"{query_name}\" met querytype \"{query_type}\" naar \"{ns}/{address}\"."

msgctxt "BASIC:B02_AUTH_RESPONSE_SOA"
msgid "Authoritative answer on SOA query for \"{domain}\" is returned by name servers \"{servers}\"."
msgstr "Autoritatief antwoord op de SOA-query voor \"{domain}\" wordt geretourneerd door naamservers \"{servers}\"."

msgctxt "BASIC:B02_NO_DELEGATION"
msgid "There is no delegation (name servers) for \"{domain}\" which means it does not exist as a zone."
msgstr "Er is geen delegatie (naamservers) voor \"{domain}\", wat betekent dat het niet als zone bestaat."

msgctxt "BASIC:B02_NO_WORKING_NS"
msgid "There is no working name server for \"{domain}\" so it is unreachable."
msgstr "Er is geen werkende naamserver voor \"{domain}\", dus het is onbereikbaar."

msgctxt "BASIC:B02_NS_BROKEN"
msgid "Broken response from name server \"{ns}\" on an SOA query."
msgstr "Onjuist antwoord van naamserver \"{ns}\" op een SOA-query."

msgctxt "BASIC:B02_NS_NOT_AUTH"
msgid "Name server \"{ns}\" does not give an authoritative answer on an SOA query."
msgstr "Naamserver \"{ns}\" geeft geen autoritatief antwoord op een SOA-query."

msgctxt "BASIC:B02_NS_NO_IP_ADDR"
msgid "Name server \"{ns}\" cannot be resolved into an IP address."
msgstr "Naamserver \"{ns}\" kan niet worden herleid naar een IP-adres."

msgctxt "BASIC:B02_NS_NO_RESPONSE"
msgid "Name server \"{ns}\" does not respond to an SOA query."
msgstr "Naamserver \"{ns}\" reageert niet op een SOA-query."

msgctxt "BASIC:B02_UNEXPECTED_RCODE"
msgid "Name server \"{ns}\" responds with an unexpected RCODE name (\"{rcode}\") on an SOA query."
msgstr "Naamserver \"{ns}\" reageert met een onverwachte RCODE-naam (\"{rcode}\") op een SOA-query."

msgctxt "ADDRESS:CNAME_CHAIN_TOO_LONG"
msgid "CNAME chain for {query_name} exceeds the maximum allowed length."
msgstr "De CNAME-keten voor {query_name} overschrijdt de maximaal toegestane lengte."

msgctxt "BASIC:CNAME_CHAIN_TOO_LONG"
msgid "CNAME chain for {query_name} exceeds the maximum allowed length."
msgstr "De CNAME-keten voor {query_name} overschrijdt de maximaal toegestane lengte."

msgctxt "CONNECTIVITY:CNAME_CHAIN_TOO_LONG"
msgid "CNAME chain for {query_name} exceeds the maximum allowed length."
msgstr "De CNAME-keten voor {query_name} overschrijdt de maximaal toegestane lengte."

msgctxt "ADDRESS:CNAME_TARGET_UNRESOLVED"
msgid "CNAME target {cname_target} for {query_name} could not be resolved."
msgstr "Het CNAME-doel {cname_target} voor {query_name} kan niet worden herleid."

msgctxt "BASIC:CNAME_TARGET_UNRESOLVED"
msgid "CNAME target {cname_target} for {query_name} could not be resolved."
msgstr "Het CNAME-doel {cname_target} voor {query_name} kon niet worden herleid."

msgctxt "CONNECTIVITY:CNAME_TARGET_UNRESOLVED"
msgid "CNAME target {cname_target} for {query_name} could not be resolved."
msgstr "Het CNAME-doel {cname_target} voor {query_name} kon niet worden herleid."

msgctxt "ADDRESS:CNAME_TOO_MANY_RECORDS"
msgid "Too many CNAME records in the answer for {query_name}."
msgstr "Te veel CNAME-records in het antwoord voor {query_name}."

msgctxt "BASIC:CNAME_TOO_MANY_RECORDS"
msgid "Too many CNAME records in the answer for {query_name}."
msgstr "Te veel CNAME-records in het antwoord voor {query_name}."

msgctxt "CONNECTIVITY:CNAME_TOO_MANY_RECORDS"
msgid "Too many CNAME records in the answer for {query_name}."
msgstr "Te veel CNAME-records in het antwoord voor {query_name}."

msgctxt "BASIC:HAS_A_RECORDS"
msgid "Nameserver {ns}/{address} returned \"A\" record(s) for {domain}."
msgstr "Naamserver {ns}/{address} retourneerde \"A\"-record(s) voor {domain}."

msgctxt "BASIC:HAS_NAMESERVER_NO_WWW_A_TEST"
msgid "Functional nameserver found. \"A\" query for www.{zname} test skipped."
msgstr "Functionele naamserver gevonden. \"A\"-query voor www.{zname} test overgeslagen."

msgctxt "BASIC:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 is uitgeschakeld, \"{query_type}\"-query wordt niet verzonden naar {ns}/{address}."

msgctxt "CONNECTIVITY:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 is uitgeschakeld; \"{query_type}\"-query wordt niet naar {ns}/{address} gestuurd."

msgctxt "CONSISTENCY:IPV4_DISABLED"

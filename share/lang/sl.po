msgid ""
"Ambiguous downcasing of character \"{unicode_name}\" in the domain name. Use "
"all lower case instead."
msgstr ""
"Dvoumno zapisovanje znakov \"{unicode_name}\" v imenu domene. Uporabite samo "
"male črke."

msgid "Domain name is too long (more than 253 characters with no final dot)."
msgstr "Domena je predolga (več kot 253 znakov brez končne pike)."

msgid "Domain name is empty."
msgstr "Domena je prazna."

msgid "Domain name starts with dot."
msgstr "Domena se začne s piko."

msgid ""
"Domain name has an ASCII label (\"{label}\") with a character not permitted."
msgstr "Domena ima oznako ASCII (\"{label}\") z znakom, ki ni dovoljen."

msgid ""
"Domain name has a non-ASCII label (\"{label}\") which is not a valid U-label."
msgstr "Domena ima ne-ASCII oznako (\"{label}\"), ki ni veljaven U-label."

msgid "Domain name has repeated dots."
msgstr "Domena ima ponavljajujoče se pike."

msgid ""
"Domain name has a label that is too long (more than 63 characters), "
"\"{label}\"."
msgstr "Domena ima predolgo oznako (več kot 63 znakov), \"{label}\"."

msgctxt "ADDRESS:A01_ADDR_NOT_GLOBALLY_REACHABLE"
msgid "IP address(es) not listed as globally reachable: \"{servers}\"."
msgstr "IP-naslov(i) ni(so) naveden(i) kot globalno dosegljivi: \"{servers}\"."

msgctxt "ADDRESS:A01_DOCUMENTATION_ADDR"
msgid "IP address(es) intended for documentation purposes: \"{servers}\"."
msgstr "IP-naslov(i) je(so) namenjen(i) za dokumentacijske namene: \"{servers}\"."

msgctxt "ADDRESS:A01_NO_GLOBALLY_REACHABLE_ADDR"
msgid "None of the name servers IP addresses are listed as globally reachable."
msgstr "Noben IP-naslov domenskih strežnikov ni naveden kot globalno dosegljiv."

msgctxt "ADDRESS:A01_NO_NAME_SERVERS_FOUND"
msgid "No name servers found."
msgstr "Ni najdenih domenskih strežnikov."

msgctxt "ADDRESS:NAMESERVER_IP_WITHOUT_REVERSE"
msgid "Nameserver {ns} has an IP address ({address}) without PTR configured."
msgstr ""
"Domenski strežnik {ns} ima IP-naslov ({address}) brez \"PTR\" zapisa."

msgctxt "ADDRESS:NAMESERVER_IP_PTR_MISMATCH"
msgid ""
"Nameserver {ns} has an IP address ({address}) with mismatched PTR result "
"({ptr_names})."
msgstr ""
"Domenski strežnik {ns} ima IP-naslov ({address}), ki se ne ujema z \"PTR\" "
"rezultati ({ptr_names}) zanj."

msgctxt "ADDRESS:NAMESERVERS_IP_WITH_REVERSE"
msgid "Reverse DNS entry exists for each Nameserver IP address."
msgstr "Vsi IP-naslovi domenski strežniki imajo povratni zapis DNS."

msgctxt "ADDRESS:NAMESERVER_IP_PTR_MATCH"
msgid "Every reverse DNS entry matches name server name."
msgstr "Vsak povratni vnos DNS se ujema z imenom domenskega strežnika."

msgctxt "ADDRESS:NO_RESPONSE_PTR_QUERY"
msgid "No response from nameserver(s) on PTR query ({domain})."
msgstr "Ni odgovora od domenskega strežnika za \"PTR\" ({domain})."


msgctxt "DNSSEC:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 je onemogočen, \"{query_type}\" poizvedba ni bila poslana na {ns}/{address}."

msgctxt "NAMESERVER:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 je onemogočen, \"{query_type}\" poizvedba ni bila poslana na {ns}/{address}."

msgctxt "SYNTAX:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 je onemogočen, \"{query_type}\" poizvedba ni bila poslana na {ns}/{address}."

msgctxt "ZONE:IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 je onemogočen, \"{query_type}\" poizvedba ni bila poslana na {ns}/{address}."

msgctxt "SYSTEM:SKIP_IPV4_DISABLED"
msgid "IPv4 is disabled, not sending \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 je onemogočen, \"{query_type}\" poizvedba ni bila poslana na {ns}/{address}."

msgctxt "BASIC:IPV4_ENABLED"
msgid "IPv4 is enabled, can send \"{query_type}\" query to {ns}/{address}."
msgstr "IPv4 je omogočen, lahko pošljemo \"{query_type}\" poizvedbo na {ns}/{address}."

